<?xml version='1.0' encoding='utf-8'?>
<roblox version="4">
  <Item class="Script" referent="RBX_SHARP_PLUGIN_ROOT">
    <Properties>
      <string name="Name">SharpBridgePlugin</string>
      <ProtectedString name="Source">--!strict
--[[
	SharpBridgePlugin (init.server.luau)
	Connects Roblox Studio Edit mode to Sharp MCP Server on 127.0.0.1:&lt;port&gt; (default 58421).
	Features:
	- Boots strictly in RunService:IsEdit() (never runs inside Playtest Server/Client VMs)
	- Cleans up leaked ChangeHistoryService recordings on reload
	- Auto-opens DockWidget on boot ONLY if HttpService.HttpEnabled == false
	- Enforces 3-tier Safety Mode (Read-Only / Safe Mutate / Full + Upload)
	- Executes incoming jobs via task.spawn with 5s /v1/heartbeat loop until completion
	- Supports direct module_op dispatch (SharpGuiTools, SharpTreeTools, &amp; embedded skill modules)
	  AND compiledLuau inside SharpUndo.withRecording(..., verifyFn)
	- Single-encode UTF-8 boundary-safe chunking for large responses (&gt; 900 KB)
	- Stops cleanly on plugin.Unloading
]]

local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

if not plugin then
	return
end

local okEdit, isEdit = pcall(function()
	return RunService:IsEdit()
end)
if not okEdit or not isEdit then
	return
end

local SharpUndo = require(script:WaitForChild("SharpUndo"))
local DockWidget = require(script:WaitForChild("DockWidget"))
local SharpGuiTools = require(script:WaitForChild("SharpGuiTools"))
local SharpTreeTools = require(script:WaitForChild("SharpTreeTools"))

SharpUndo.cleanupLeakedRecording()

local rawPort = tonumber(plugin:GetSetting("SharpBridgePort"))
local BRIDGE_PORT = if rawPort and rawPort &gt;= 1 and rawPort &lt;= 65535
	then math.floor(rawPort)
	else 58421
local BRIDGE_BASE = string.format("http://127.0.0.1:%d", BRIDGE_PORT)

local ui = DockWidget.new(plugin, BRIDGE_PORT)
local isShuttingDown = false
local sessionToken = ""
local serverEpoch = ""
local studioSessionId = HttpService:GenerateGUID(false)

-- Auto-open DockWidget on boot ONLY when HttpService.HttpEnabled == false
local initialHttpEnabled = HttpService.HttpEnabled
ui:setHttpOnboarding(initialHttpEnabled)
ui:showIfNeeded(not initialHttpEnabled)

plugin.Unloading:Connect(function()
	isShuttingDown = true
	SharpUndo.cleanupLeakedRecording()
	ui:destroy()
end)

local function splitUtf8Chunks(str: string, maxBytes: number): { string }
	local chunks: { string } = {}
	local n = #str
	local pos = 1
	while pos &lt;= n do
		local stopIdx = math.min(n, pos + maxBytes - 1)
		if stopIdx &lt; n then
			-- Walk backward if next byte is a UTF-8 continuation byte (10xxxxxx = 0x80..0xBF)
			while stopIdx &gt; pos do
				local nextByte = string.byte(str, stopIdx + 1)
				if nextByte and bit32.band(nextByte, 0xC0) == 0x80 then
					stopIdx -= 1
				else
					break
				end
			end
		end
		table.insert(chunks, string.sub(str, pos, stopIdx))
		pos = stopIdx + 1
	end
	return chunks
end

local function makeAuthHeaders(includeContentType: boolean): { [string]: string }
	local hdrs: { [string]: string } = {
		["Authorization"] = "Bearer " .. sessionToken,
		["X-Sharp-Server-Epoch"] = serverEpoch,
	}
	if includeContentType then
		hdrs["Content-Type"] = "application/json"
	end
	return hdrs
end

local function postBridgeJson(path: string, bodyJson: string): (boolean, number)
	local ok, resp = pcall(function()
		return HttpService:RequestAsync({
			Url = BRIDGE_BASE .. path,
			Method = "POST",
			Headers = makeAuthHeaders(true),
			Body = bodyJson,
		})
	end)
	if ok and typeof(resp) == "table" and typeof(resp.StatusCode) == "number" then
		return resp.StatusCode &gt;= 200 and resp.StatusCode &lt; 300, resp.StatusCode
	end
	return false, 0
end

local function sendResult(requestId: string, envelope: { [string]: any })
	envelope.requestId = requestId
	envelope.placeId = game.PlaceId
	envelope.studioSessionId = studioSessionId
	local encoded = HttpService:JSONEncode(envelope)

	if #encoded &lt;= 900000 then
		local okSend, statusCode = postBridgeJson("/v1/result", encoded)
		if not okSend then
			ui:appendLog(string.format("[ERR] result post failed (HTTP %d)", statusCode))
		end
	else
		local parts = splitUtf8Chunks(encoded, 800000)
		local allChunksOk = true
		for idx, part in ipairs(parts) do
			local chunkBody = HttpService:JSONEncode({
				requestId = requestId,
				chunkIndex = idx,
				chunkData = part,
			})
			local chunkOk = false
			local lastStatus = 0
			for attempt = 1, 3 do
				chunkOk, lastStatus = postBridgeJson("/v1/result_chunk", chunkBody)
				if chunkOk then
					break
				end
				if lastStatus &gt;= 400 and lastStatus &lt; 500 and lastStatus ~= 408 and lastStatus ~= 429 then
					break
				end
				if attempt &lt; 3 then
					task.wait(0.25 * attempt)
				end
			end
			if not chunkOk then
				allChunksOk = false
				ui:appendLog(string.format("[ERR] result_chunk %d/%d failed (HTTP %d); aborting commit", idx, #parts, lastStatus))
				break
			end
		end
		if not allChunksOk then
			return
		end
		local commitOk, commitStatus = postBridgeJson("/v1/result_commit", HttpService:JSONEncode({ requestId = requestId }))
		if not commitOk then
			ui:appendLog(string.format("[ERR] result_commit failed (HTTP %d)", commitStatus))
		end
	end
end

local DESTRUCTIVE_CLEAR_SERVICES: { string } = {
	"Workspace",
	"StarterGui",
	"ReplicatedStorage",
	"ServerScriptService",
}

local function isDestructiveRequest(toolName: string, args: { [string]: any }, compiledLuau: string?): boolean
	local opArgs = if typeof(args.args) == "table" then args.args :: { [string]: any } else {}
	if args.allowDestructive == true or args.destructive == true or opArgs.allowDestructive == true then
		return true
	end
	local lowerTool = string.lower(toolName)
	if string.find(lowerTool, "open_cloud", 1, true)
		or string.find(lowerTool, "publish", 1, true)
		or string.find(lowerTool, "wipe", 1, true)
	then
		return true
	end
	if typeof(compiledLuau) == "string" and #compiledLuau &gt; 0 then
		if string.find(compiledLuau, "Terrain%s*:%s*Clear%s*%(") then
			return true
		end
		if string.find(compiledLuau, "workspace%s*:%s*ClearAllChildren%s*%(") then
			return true
		end
		for _, svcName in ipairs(DESTRUCTIVE_CLEAR_SERVICES) do
			if string.find(compiledLuau, svcName .. "%s*:%s*ClearAllChildren%s*%(")
				or string.find(
					compiledLuau,
					":%s*GetService%s*%(?%s*[\"']" .. svcName .. "[\"']%s*%)?%s*:%s*ClearAllChildren%s*%("
				)
			then
				return true
			end
		end
	end
	return false
end

local function verifyMutationResult(res: any): (boolean, string?)
	if typeof(res) == "table" then
		if res.verified == false then
			local errList = res.errors
			local msg = if typeof(errList) == "table" and #errList &gt; 0
				then table.concat(errList, "; ")
				else tostring(res.message or "Post-write readback verification failed.")
			return false, msg
		end
		if res.ok == false then
			return false, tostring(res.message or res.code or "Mutation reported ok=false.")
		end
	end
	return true, nil
end

local function dispatchModuleOpInternal(moduleName: string, opName: string, opArgs: { [string]: any }): (boolean, any)
	if moduleName == "SharpGuiTools" then
		if opName == "inspect" then
			local out = SharpGuiTools.inspect(opArgs)
			return out.ok ~= false, out
		elseif opName == "patch" then
			return SharpGuiTools.patch(opArgs)
		elseif opName == "deviceSim" then
			local out = SharpGuiTools.deviceSim(opArgs)
			return out.ok ~= false, out
		else
			return false, { code = "UNKNOWN_MODULE_OP", message = "Unknown SharpGuiTools op: " .. opName }
		end
	elseif moduleName == "SharpTreeTools" then
		if opName == "searchTree" then
			local out = SharpTreeTools.searchTree(opArgs)
			return out.ok ~= false, out
		elseif opName == "inspectInstance" then
			local out = SharpTreeTools.inspectInstance(opArgs)
			return out.ok ~= false, out
		elseif opName == "readScript" then
			local out = SharpTreeTools.readScript(opArgs)
			return out.ok ~= false, out
		elseif opName == "updateScript" then
			return SharpTreeTools.updateScript(opArgs)
		elseif opName == "readConsoleLogs" then
			local out = SharpTreeTools.readConsoleLogs(opArgs)
			return out.ok ~= false, out
		else
			return false, { code = "UNKNOWN_MODULE_OP", message = "Unknown SharpTreeTools op: " .. opName }
		end
	end

	return SharpTreeTools.dispatchModuleOp(script, moduleName, opName, opArgs)
end

local function executeJobAsync(job: { [string]: any })
	local reqId = tostring(job.requestId or "")
	local kind = tostring(job.kind or "read")
	local toolName = tostring(job.tool or "unknown")
	local args = (job.args or {}) :: { [string]: any }
	local compiledLuau = if typeof(args.compiledLuau) == "string" then args.compiledLuau else nil

	if kind == "write" and ui.safetyMode == "Read-Only" then
		ui:appendLog("[BLOCKED Read-Only] " .. toolName)
		sendResult(reqId, {
			ok = false,
			code = "SAFETY_READ_ONLY",
			message = "SharpBridgePlugin DockWidget is set to Read-Only mode.",
			recordingStatus = "Rejected",
		})
		return
	end

	if kind == "write" and ui.safetyMode == "Safe Mutate" and isDestructiveRequest(toolName, args, compiledLuau) then
		ui:appendLog("[BLOCKED Safe Mutate] " .. toolName)
		sendResult(reqId, {
			ok = false,
			code = "SAFETY_REQUIRES_FULL_UPLOAD",
			message = "Destructive or upload operations require SharpSafetyMode = 'Full + Upload'.",
			recordingStatus = "Rejected",
		})
		return
	end

	-- Start 5s heartbeat loop while job runs so lease never expires on long operations
	local jobFinished = false
	local heartbeatThread = task.spawn(function()
		while not jobFinished and not isShuttingDown do
			task.wait(5.0)
			if jobFinished or isShuttingDown or sessionToken == "" then
				break
			end
			pcall(function()
				HttpService:RequestAsync({
					Url = BRIDGE_BASE .. "/v1/heartbeat",
					Method = "POST",
					Headers = makeAuthHeaders(true),
					Body = HttpService:JSONEncode({
						requestId = reqId,
						placeId = game.PlaceId,
						studioSessionId = studioSessionId,
					}),
				})
			end)
		end
	end)

	local function finishHeartbeat()
		jobFinished = true
		pcall(task.cancel, heartbeatThread)
	end

	-- Mode A: Direct module_op dispatch (no loadstring)
	if args.mode == "module_op" then
		local moduleName = tostring(args.module or "")
		local opName = tostring(args.op or "")
		local opArgs = (if typeof(args.args) == "table" then args.args else {}) :: { [string]: any }

		local okRun: boolean = false
		local runOut: any = nil
		local recStatus: string = "None"

		local execCallOk, execErr = pcall(function()
			if kind == "write" then
				local recOk, recRes, recState = SharpUndo.withRecording(
					"Sharp_" .. moduleName .. "_" .. opName,
					"Sharp MCP: " .. moduleName .. "." .. opName,
					function()
						local opOk, opRes = dispatchModuleOpInternal(moduleName, opName, opArgs)
						if not opOk and typeof(opRes) ~= "table" then
							return { ok = false, message = tostring(opRes) }
						end
						if not opOk and typeof(opRes) == "table" and opRes.ok == nil then
							opRes.ok = false
						end
						return opRes
					end,
					verifyMutationResult
				)
				okRun = recOk
				runOut = recRes
				recStatus = recState
			else
				local opOk, opRes = dispatchModuleOpInternal(moduleName, opName, opArgs)
				okRun = opOk
				runOut = opRes
				recStatus = "None"
			end
		end)

		finishHeartbeat()

		if not execCallOk then
			okRun = false
			runOut = { code = "PLUGIN_EXEC_ERROR", message = tostring(execErr) }
			recStatus = "Cancelled"
		end

		ui:appendLog((if okRun then "[OK] " else "[ERR] ") .. moduleName .. "." .. opName)
		sendResult(reqId, {
			ok = okRun,
			result = runOut,
			recordingStatus = recStatus,
		})
		return
	end

	-- Mode B: Compiled Luau payload inside SharpUndo.withRecording(..., verifyFn)
	if compiledLuau and #compiledLuau &gt; 0 then
		local fn, loadErr = loadstring(compiledLuau)
		if not fn then
			finishHeartbeat()
			ui:appendLog("[SYNTAX ERR] " .. toolName)
			sendResult(reqId, {
				ok = false,
				code = "LOADSTRING_SYNTAX_ERROR",
				message = tostring(loadErr),
				recordingStatus = "Rejected",
			})
			return
		end

		local okRun: boolean = false
		local runOut: any = nil
		local recStatus: string = "None"

		local execCallOk, execErr = pcall(function()
			if kind == "write" and toolName ~= "sharp_snapshot_and_undo" then
				okRun, runOut, recStatus = SharpUndo.withRecording(
					"Sharp_" .. toolName,
					"Sharp MCP: " .. toolName,
					fn :: () -&gt; any,
					verifyMutationResult
				)
			else
				okRun, runOut = xpcall(fn :: () -&gt; any, debug.traceback)
				if kind == "read" then
					recStatus = "None"
				else
					recStatus = if okRun then "Committed" else "Cancelled"
				end
			end
		end)

		finishHeartbeat()

		if not execCallOk then
			okRun = false
			runOut = { code = "PLUGIN_EXEC_ERROR", message = tostring(execErr) }
			recStatus = "Cancelled"
		end

		ui:appendLog((if okRun then "[OK] " else "[ERR] ") .. toolName)
		sendResult(reqId, {
			ok = okRun,
			result = runOut,
			recordingStatus = recStatus,
		})
		return
	end

	-- Mode C: Ping / status probe
	finishHeartbeat()
	ui:appendLog("[PING] " .. toolName)
	sendResult(reqId, {
		ok = true,
		result = {
			pong = true,
			safetyMode = ui.safetyMode,
			placeId = game.PlaceId,
			studioSessionId = studioSessionId,
		},
		recordingStatus = "None",
	})
end

task.spawn(function()
	while not isShuttingDown do
		local httpEnabled = HttpService.HttpEnabled
		ui:setHttpOnboarding(httpEnabled)

		if not httpEnabled then
			ui:setStatus("HttpService.HttpEnabled = OFF")
			task.wait(3.0)
			continue
		end

		if sessionToken == "" then
			local okHello, resp = pcall(function()
				return HttpService:RequestAsync({
					Url = BRIDGE_BASE .. "/v1/hello",
					Method = "POST",
					Headers = { ["Content-Type"] = "application/json" },
					Body = HttpService:JSONEncode({
						studioSessionId = studioSessionId,
						placeId = game.PlaceId,
						universeId = game.GameId,
						placeName = game.Name,
						pluginVersion = "0.5.0",
						safetyMode = ui.safetyMode,
						httpEnabled = httpEnabled,
						capabilities = {
							moduleOp = true,
							sharpGuiTools = true,
							sharpTreeTools = true,
							heartbeat = true,
						},
					}),
				})
			end)
			if okHello and resp and resp.StatusCode == 200 then
				local decoded = HttpService:JSONDecode(resp.Body)
				sessionToken = tostring(decoded.sessionToken or "")
				serverEpoch = tostring(decoded.serverEpoch or "")
				ui:setStatus(string.format("Connected • 127.0.0.1:%d", BRIDGE_PORT))
				ui:appendLog("Handshake OK (" .. serverEpoch .. ")")
			else
				ui:setStatus("Standby (Waiting for Sharp MCP)")
				task.wait(3.0)
				continue
			end
		end

		local okPoll, pollResp = pcall(function()
			return HttpService:RequestAsync({
				Url = BRIDGE_BASE .. "/v1/poll?timeoutMs=8000",
				Method = "GET",
				Headers = makeAuthHeaders(false),
			})
		end)

		if not okPoll or not pollResp then
			sessionToken = ""
			ui:setStatus("Disconnected • Retrying...")
			task.wait(2.0)
		elseif pollResp.StatusCode == 200 and #pollResp.Body &gt; 0 then
			local okDec, job = pcall(function()
				return HttpService:JSONDecode(pollResp.Body)
			end)
			if okDec and type(job) == "table" then
				task.spawn(executeJobAsync, job)
			end
		elseif pollResp.StatusCode == 401 or pollResp.StatusCode == 409 then
			sessionToken = ""
			task.wait(0.5)
		else
			task.wait(0.1)
		end
	end
end)
</ProtectedString>
    </Properties>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_1">
      <Properties>
        <string name="Name">SharpUndo</string>
        <ProtectedString name="Source">--!strict
--[[
	SharpUndo
	Atomic ChangeHistoryService recording engine for SharpBridgePlugin.
	1. Never sets a permanent sticky disable flag if TryBeginRecording returns nil.
	2. Supports optional post-write verifyFn(result) -&gt; (boolean, string?) BEFORE Commit;
	   if verifyFn fails or returns false, cancels the recording cleanly.
	3. Cleans up any leaked __SharpActiveRecordingId attribute on plugin reload/startup.
]]

local ChangeHistoryService = game:GetService("ChangeHistoryService")

local REC_ID_ATTR = "__SharpActiveRecordingId"
local REC_TS_ATTR = "__SharpActiveRecordingTs"

export type VerifyFn = (any) -&gt; (boolean, string?)

local SharpUndo = {}

function SharpUndo.cleanupLeakedRecording(): number
	local staleId = ChangeHistoryService:GetAttribute(REC_ID_ATTR)
	if typeof(staleId) == "string" and #staleId &gt; 0 then
		pcall(function()
			ChangeHistoryService:FinishRecording(staleId, Enum.FinishRecordingOperation.Cancel)
		end)
		ChangeHistoryService:SetAttribute(REC_ID_ATTR, nil)
		ChangeHistoryService:SetAttribute(REC_TS_ATTR, nil)
		return 1
	end
	return 0
end

local function runVerify(verifyFn: VerifyFn?, res: any): (boolean, string?)
	if not verifyFn then
		return true, nil
	end
	local callOk, passOrErr, msg = pcall(verifyFn, res)
	if not callOk then
		return false, "Readback verifier threw error: " .. tostring(passOrErr)
	end
	if passOrErr == false then
		return false, msg or "Post-write readback verification failed."
	end
	return true, nil
end

function SharpUndo.withRecording(
	actionName: string,
	displayName: string,
	fn: () -&gt; any,
	verifyFn: VerifyFn?
): (boolean, any, string)
	local existingId = ChangeHistoryService:GetAttribute(REC_ID_ATTR)
	if typeof(existingId) == "string" and #existingId &gt; 0 then
		local okNested, resNested = xpcall(fn, debug.traceback)
		if not okNested then
			return false, { code = "EXECUTION_ERROR", message = tostring(resNested) }, "Cancelled"
		end
		local vOk, vMsg = runVerify(verifyFn, resNested)
		if not vOk then
			return false, { code = "READBACK_VERIFICATION_FAILED", message = vMsg }, "Cancelled"
		end
		return true, resNested, "Committed"
	end

	local recId = ChangeHistoryService:TryBeginRecording(actionName, displayName)
	if not recId then
		local okFallback, resFallback = xpcall(fn, debug.traceback)
		if not okFallback then
			return false, { code = "EXECUTION_ERROR", message = tostring(resFallback) }, "Cancelled"
		end
		local vOk, vMsg = runVerify(verifyFn, resFallback)
		if not vOk then
			return false, { code = "READBACK_VERIFICATION_FAILED", message = vMsg }, "Cancelled"
		end
		return true, resFallback, "NoRecording"
	end

	ChangeHistoryService:SetAttribute(REC_ID_ATTR, recId)
	ChangeHistoryService:SetAttribute(REC_TS_ATTR, os.time())

	local ok, res = xpcall(fn, debug.traceback)

	ChangeHistoryService:SetAttribute(REC_ID_ATTR, nil)
	ChangeHistoryService:SetAttribute(REC_TS_ATTR, nil)

	if not ok then
		pcall(function()
			ChangeHistoryService:FinishRecording(recId, Enum.FinishRecordingOperation.Cancel)
		end)
		return false, { code = "EXECUTION_ERROR", message = tostring(res) }, "Cancelled"
	end

	local vOk, vMsg = runVerify(verifyFn, res)
	if not vOk then
		pcall(function()
			ChangeHistoryService:FinishRecording(recId, Enum.FinishRecordingOperation.Cancel)
		end)
		return false, { code = "READBACK_VERIFICATION_FAILED", message = vMsg }, "Cancelled"
	end

	local finOk, finErr = pcall(function()
		ChangeHistoryService:FinishRecording(recId, Enum.FinishRecordingOperation.Commit)
	end)
	if not finOk then
		return false, { code = "RECORDING_COMMIT_FAILED", message = tostring(finErr) }, "CommitError"
	end
	return true, res, "Committed"
end

return SharpUndo
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_2">
      <Properties>
        <string name="Name">DockWidget</string>
        <ProtectedString name="Source">--!strict
--[[
	DockWidget
	Builds and manages the Sharp MCP Companion DockWidgetPluginGui in Roblox Studio.
	Provides:
	- Connection status badge (127.0.0.1:&lt;port&gt; + HttpService.HttpEnabled status)
	- Copyable HttpService onboarding banner when HttpService.HttpEnabled == false
	- 3-Tier Safety Mode selector (Read-Only / Safe Mutate / Full + Upload)
	- Quick Undo button + 20-item live command execution feed
]]

local ChangeHistoryService = game:GetService("ChangeHistoryService")

export type SafetyMode = "Read-Only" | "Safe Mutate" | "Full + Upload"

local ONBOARDING_CMD = 'game:GetService("HttpService").HttpEnabled = true'

local DockWidget = {}
DockWidget.__index = DockWidget

function DockWidget.new(pluginObj: Plugin, port: number?)
	local self = setmetatable({}, DockWidget)
	local activePort = port or 58421
	self._plugin = pluginObj
	self._port = activePort
	self.safetyMode = (pluginObj:GetSetting("SharpSafetyMode") or "Safe Mutate") :: SafetyMode
	self._logs = {} :: { string }

	local toolbar = pluginObj:CreateToolbar("Sharp MCP")
	self._button = toolbar:CreateButton(
		"SharpCompanionToggle",
		"Open Sharp MCP Companion Panel",
		"rbxassetid://4458901886",
		"Sharp MCP"
	)

	local info = DockWidgetPluginGuiInfo.new(
		Enum.InitialDockState.Right,
		false,
		false,
		330,
		460,
		260,
		320
	)
	local widget = pluginObj:CreateDockWidgetPluginGuiAsync("SharpCompanionWidget", info)
	widget.Title = string.format("Sharp MCP (%d)", activePort)
	self._widget = widget

	local root = Instance.new("Frame")
	root.Name = "Root"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundColor3 = Color3.fromRGB(22, 24, 32)
	root.BorderSizePixel = 0
	root.Parent = widget

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 10)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = root

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 8)
	layout.Parent = root

	local statusLbl = Instance.new("TextLabel")
	statusLbl.Name = "StatusLabel"
	statusLbl.LayoutOrder = 1
	statusLbl.Size = UDim2.new(1, 0, 0, 28)
	statusLbl.BackgroundColor3 = Color3.fromRGB(34, 38, 52)
	statusLbl.TextColor3 = Color3.fromRGB(230, 235, 245)
	statusLbl.Font = Enum.Font.GothamBold
	statusLbl.TextSize = 13
	statusLbl.Text = string.format("Status: Connecting (127.0.0.1:%d)...", activePort)
	statusLbl.Parent = root
	self._statusLbl = statusLbl

	local onboardingFrame = Instance.new("Frame")
	onboardingFrame.Name = "HttpOnboardingFrame"
	onboardingFrame.LayoutOrder = 2
	onboardingFrame.Size = UDim2.new(1, 0, 0, 84)
	onboardingFrame.BackgroundColor3 = Color3.fromRGB(64, 42, 24)
	onboardingFrame.BorderSizePixel = 0
	onboardingFrame.Visible = false
	onboardingFrame.Parent = root
	self._onboardingFrame = onboardingFrame

	local onboardPad = Instance.new("UIPadding")
	onboardPad.PaddingTop = UDim.new(0, 6)
	onboardPad.PaddingBottom = UDim.new(0, 6)
	onboardPad.PaddingLeft = UDim.new(0, 8)
	onboardPad.PaddingRight = UDim.new(0, 8)
	onboardPad.Parent = onboardingFrame

	local onboardTitle = Instance.new("TextLabel")
	onboardTitle.Name = "OnboardingNotice"
	onboardTitle.Size = UDim2.new(1, 0, 0, 28)
	onboardTitle.BackgroundTransparency = 1
	onboardTitle.TextColor3 = Color3.fromRGB(255, 224, 166)
	onboardTitle.Font = Enum.Font.GothamBold
	onboardTitle.TextSize = 11
	onboardTitle.TextXAlignment = Enum.TextXAlignment.Left
	onboardTitle.TextWrapped = true
	onboardTitle.Text = "HttpService is OFF. Copy &amp; run in Studio Command Bar:"
	onboardTitle.Parent = onboardingFrame

	local cmdBox = Instance.new("TextBox")
	cmdBox.Name = "HttpCommandTextBox"
	cmdBox.Position = UDim2.new(0, 0, 0, 32)
	cmdBox.Size = UDim2.new(1, 0, 0, 38)
	cmdBox.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
	cmdBox.TextColor3 = Color3.fromRGB(160, 240, 190)
	cmdBox.Font = Enum.Font.Code
	cmdBox.TextSize = 11
	cmdBox.TextXAlignment = Enum.TextXAlignment.Left
	cmdBox.TextWrapped = true
	cmdBox.ClearTextOnFocus = false
	cmdBox.TextEditable = false
	cmdBox.Text = ONBOARDING_CMD
	cmdBox.Parent = onboardingFrame
	self._cmdBox = cmdBox

	local modeBtn = Instance.new("TextButton")
	modeBtn.Name = "SafetyModeButton"
	modeBtn.LayoutOrder = 3
	modeBtn.Size = UDim2.new(1, 0, 0, 30)
	modeBtn.BackgroundColor3 = Color3.fromRGB(45, 110, 75)
	modeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	modeBtn.Font = Enum.Font.GothamBold
	modeBtn.TextSize = 13
	modeBtn.Text = "Safety Mode: " .. self.safetyMode
	modeBtn.Parent = root
	self._modeBtn = modeBtn

	modeBtn.Activated:Connect(function()
		if self.safetyMode == "Read-Only" then
			self.safetyMode = "Safe Mutate"
		elseif self.safetyMode == "Safe Mutate" then
			self.safetyMode = "Full + Upload"
		else
			self.safetyMode = "Read-Only"
		end
		pluginObj:SetSetting("SharpSafetyMode", self.safetyMode)
		modeBtn.Text = "Safety Mode: " .. self.safetyMode
	end)

	local undoBtn = Instance.new("TextButton")
	undoBtn.Name = "UndoButton"
	undoBtn.LayoutOrder = 4
	undoBtn.Size = UDim2.new(1, 0, 0, 28)
	undoBtn.BackgroundColor3 = Color3.fromRGB(55, 62, 82)
	undoBtn.TextColor3 = Color3.fromRGB(240, 240, 250)
	undoBtn.Font = Enum.Font.GothamMedium
	undoBtn.TextSize = 12
	undoBtn.Text = "Undo Last Sharp Action"
	undoBtn.Parent = root
	undoBtn.Activated:Connect(function()
		pcall(function()
			ChangeHistoryService:Undo()
		end)
	end)

	local logBox = Instance.new("TextLabel")
	logBox.Name = "ActionLog"
	logBox.LayoutOrder = 5
	logBox.Size = UDim2.new(1, 0, 1, -112)
	logBox.BackgroundColor3 = Color3.fromRGB(16, 18, 24)
	logBox.TextColor3 = Color3.fromRGB(190, 200, 215)
	logBox.Font = Enum.Font.Code
	logBox.TextSize = 11
	logBox.TextXAlignment = Enum.TextXAlignment.Left
	logBox.TextYAlignment = Enum.TextYAlignment.Top
	logBox.TextWrapped = true
	logBox.Text = "Sharp Companion ready."
	logBox.Parent = root
	self._logBox = logBox

	self._button.Click:Connect(function()
		widget.Enabled = not widget.Enabled
	end)

	return self
end

function DockWidget:setHttpOnboarding(httpEnabled: boolean)
	if self._onboardingFrame then
		self._onboardingFrame.Visible = not httpEnabled
	end
	if self._cmdBox and not httpEnabled then
		self._cmdBox.Text = ONBOARDING_CMD
	end
	if self._logBox then
		local reserved = if httpEnabled then 112 else 204
		self._logBox.Size = UDim2.new(1, 0, 1, -reserved)
	end
end

function DockWidget:showIfNeeded(autoShow: boolean)
	if autoShow and self._widget then
		self._widget.Enabled = true
	end
end

function DockWidget:setStatus(text: string)
	if self._statusLbl then
		self._statusLbl.Text = text
	end
end

function DockWidget:appendLog(entry: string)
	table.insert(self._logs, 1, os.date("%H:%M:%S") .. " " .. entry)
	while #self._logs &gt; 20 do
		table.remove(self._logs)
	end
	if self._logBox then
		self._logBox.Text = table.concat(self._logs, "\n")
	end
end

function DockWidget:destroy()
	if self._widget then
		self._widget:Destroy()
	end
end

return DockWidget
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_3">
      <Properties>
        <string name="Name">SharpGuiTools</string>
        <ProtectedString name="Source">--!strict
--[[
	SharpGuiTools
	Direct surgical GUI inspection, non-destructive patching with readback verification,
	and StudioDeviceSimulatorService control for SharpBridgePlugin (no loadstring required).
]]

local GuiService = game:GetService("GuiService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local HANDLE_ATTR = "SharpHandle"
local KEY_MODIFIED_PROPS: { string } = {
	"Size",
	"Position",
	"BackgroundColor3",
	"TextColor3",
	"ImageColor3",
}
local INSPECT_EXTRA_PROPS: { string } = {
	"Size",
	"Position",
	"AnchorPoint",
	"BackgroundColor3",
	"BackgroundTransparency",
	"Text",
	"TextColor3",
	"TextSize",
	"Image",
	"ImageColor3",
	"ImageTransparency",
	"ScaleType",
	"SliceCenter",
	"SliceScale",
	"ImageRectOffset",
	"ImageRectSize",
	"ZIndex",
	"LayoutOrder",
	"PaddingTop",
	"PaddingBottom",
	"PaddingLeft",
	"PaddingRight",
	"CornerRadius",
	"FillDirection",
	"Padding",
	"Color",
	"Thickness",
}

local SharpGuiTools = {}

local function getOrCreateHandle(inst: Instance): string
	local existing = inst:GetAttribute(HANDLE_ATTR)
	if typeof(existing) == "string" and #existing &gt; 0 then
		return existing
	end
	local handle = "sh_" .. HttpService:GenerateGUID(false)
	inst:SetAttribute(HANDLE_ATTR, handle)
	return handle
end

local function getInstancePath(inst: Instance): string
	local parts: { string } = {}
	local curr: Instance? = inst
	while curr and curr ~= game do
		table.insert(parts, 1, curr.Name)
		curr = curr.Parent
	end
	return table.concat(parts, ".")
end

local function resolvePath(pathStr: string): Instance?
	if pathStr == "" then
		return nil
	end
	local cleaned = pathStr
	if string.sub(cleaned, 1, 5) == "game." then
		cleaned = string.sub(cleaned, 6)
	end
	local curr: Instance = game
	local first = true
	for segment in string.gmatch(cleaned, "[^%.]+") do
		local nxt: Instance? = nil
		if first and curr == game then
			local okSvc, svc = pcall(function()
				return game:GetService(segment)
			end)
			if okSvc and svc then
				nxt = svc
			else
				nxt = game:FindFirstChild(segment)
			end
			first = false
		else
			nxt = curr:FindFirstChild(segment)
		end
		if not nxt then
			return nil
		end
		curr = nxt
	end
	return curr
end

local function findByHandleInContainers(handle: string): Instance?
	local containers: { Instance } = {
		StarterGui,
		ReplicatedStorage,
	}
	local lp = Players.LocalPlayer
	if lp then
		local pg = lp:FindFirstChild("PlayerGui")
		if pg then
			table.insert(containers, pg)
		end
	end
	for _, serviceName in ipairs({ "StarterPlayer", "Workspace", "ReplicatedFirst" }) do
		local ok, svc = pcall(function()
			return game:GetService(serviceName)
		end)
		if ok and svc then
			table.insert(containers, svc)
		end
	end
	for _, root in ipairs(containers) do
		if root:GetAttribute(HANDLE_ATTR) == handle then
			return root
		end
		for _, desc in ipairs(root:GetDescendants()) do
			if desc:GetAttribute(HANDLE_ATTR) == handle then
				return desc
			end
		end
	end
	return nil
end

local function resolveTarget(spec: { [string]: any }): Instance?
	local handle = spec.sharpHandle or spec.handle
	if typeof(handle) == "string" and #handle &gt; 0 then
		local byHandle = findByHandleInContainers(handle)
		if byHandle then
			return byHandle
		end
	end
	local pathStr = spec.path
	if typeof(pathStr) == "string" and #pathStr &gt; 0 then
		return resolvePath(pathStr)
	end
	return nil
end

local function encodeValue(val: any): any
	local t = typeof(val)
	if val == nil or t == "boolean" or t == "number" or t == "string" then
		return val
	elseif t == "Vector2" then
		local v = val :: Vector2
		return { X = v.X, Y = v.Y }
	elseif t == "Vector3" then
		local v = val :: Vector3
		return { X = v.X, Y = v.Y, Z = v.Z }
	elseif t == "UDim" then
		local u = val :: UDim
		return { Scale = u.Scale, Offset = u.Offset }
	elseif t == "UDim2" then
		local u = val :: UDim2
		return {
			XScale = u.X.Scale,
			XOffset = u.X.Offset,
			YScale = u.Y.Scale,
			YOffset = u.Y.Offset,
		}
	elseif t == "Color3" then
		local c = val :: Color3
		return {
			R = math.round(c.R * 255),
			G = math.round(c.G * 255),
			B = math.round(c.B * 255),
			Hex = "#" .. c:ToHex(),
		}
	elseif t == "Rect" then
		local r = val :: Rect
		return {
			Min = { X = r.Min.X, Y = r.Min.Y },
			Max = { X = r.Max.X, Y = r.Max.Y },
		}
	elseif t == "ColorSequence" then
		local cs = val :: ColorSequence
		local kps: { any } = {}
		for _, kp in ipairs(cs.Keypoints) do
			table.insert(kps, {
				time = kp.Time,
				color = encodeValue(kp.Value),
			})
		end
		return kps
	elseif t == "NumberSequence" then
		local ns = val :: NumberSequence
		local kps: { any } = {}
		for _, kp in ipairs(ns.Keypoints) do
			table.insert(kps, {
				time = kp.Time,
				value = kp.Value,
				envelope = kp.Envelope,
			})
		end
		return kps
	elseif t == "EnumItem" then
		return tostring(val)
	elseif t == "Font" then
		local f = val :: Font
		return {
			family = f.Family,
			weight = f.Weight.Name,
			style = f.Style.Name,
		}
	elseif t == "Instance" then
		local instVal = val :: Instance
		return {
			Name = instVal.Name,
			ClassName = instVal.ClassName,
			Path = getInstancePath(instVal),
			SharpHandle = getOrCreateHandle(instVal),
		}
	end
	return tostring(val)
end

local function decodeEnum(raw: any, hintEnumType: Enum?): EnumItem?
	if typeof(raw) == "EnumItem" then
		return raw
	end
	if typeof(raw) == "string" then
		if string.sub(raw, 1, 5) == "Enum." then
			local rest = string.sub(raw, 6)
			local dotIdx = string.find(rest, "%.")
			if dotIdx then
				local enumName = string.sub(rest, 1, dotIdx - 1)
				local itemName = string.sub(rest, dotIdx + 1)
				local ok, item = pcall(function()
					return (Enum :: any)[enumName][itemName]
				end)
				if ok and typeof(item) == "EnumItem" then
					return item
				end
			end
		elseif hintEnumType then
			local ok, item = pcall(function()
				return (hintEnumType :: any)[raw]
			end)
			if ok and typeof(item) == "EnumItem" then
				return item
			end
		end
	elseif typeof(raw) == "table" and raw.type == "Enum" and typeof(raw.value) == "string" then
		return decodeEnum(raw.value, hintEnumType)
	end
	return nil
end

local function decodeColor3(raw: any): Color3
	if typeof(raw) == "Color3" then
		return raw
	end
	if typeof(raw) == "string" then
		local hex = if string.sub(raw, 1, 1) == "#" then string.sub(raw, 2) else raw
		return Color3.fromHex(hex)
	end
	if typeof(raw) == "table" then
		if typeof(raw.hex) == "string" or typeof(raw.Hex) == "string" then
			local h = tostring(raw.hex or raw.Hex)
			if string.sub(h, 1, 1) == "#" then
				h = string.sub(h, 2)
			end
			return Color3.fromHex(h)
		end
		local arr = raw.rgb or raw.value or raw
		if typeof(arr) == "table" and arr[1] ~= nil and arr[2] ~= nil and arr[3] ~= nil then
			local r = tonumber(arr[1]) or 0
			local g = tonumber(arr[2]) or 0
			local b = tonumber(arr[3]) or 0
			if r &gt; 1 or g &gt; 1 or b &gt; 1 or raw.fromRGB == true then
				return Color3.fromRGB(r, g, b)
			end
			return Color3.new(r, g, b)
		end
		local r = tonumber(raw.R or raw.r) or 0
		local g = tonumber(raw.G or raw.g) or 0
		local b = tonumber(raw.B or raw.b) or 0
		if r &gt; 1 or g &gt; 1 or b &gt; 1 or raw.fromRGB == true then
			return Color3.fromRGB(r, g, b)
		end
		return Color3.new(r, g, b)
	end
	error("Invalid Color3 specification")
end

local function decodeUDim(raw: any): UDim
	if typeof(raw) == "UDim" then
		return raw
	end
	if typeof(raw) == "table" then
		local arr = raw.value or raw
		if typeof(arr) == "table" and arr[1] ~= nil and arr[2] ~= nil then
			return UDim.new(tonumber(arr[1]) or 0, tonumber(arr[2]) or 0)
		end
		return UDim.new(tonumber(raw.Scale or raw.scale) or 0, tonumber(raw.Offset or raw.offset) or 0)
	end
	error("Invalid UDim specification")
end

local function decodeUDim2(raw: any): UDim2
	if typeof(raw) == "UDim2" then
		return raw
	end
	if typeof(raw) == "table" then
		if typeof(raw.X) == "table" and typeof(raw.Y) == "table" then
			return UDim2.new(
				tonumber(raw.X.Scale or raw.X.scale) or 0,
				tonumber(raw.X.Offset or raw.X.offset) or 0,
				tonumber(raw.Y.Scale or raw.Y.scale) or 0,
				tonumber(raw.Y.Offset or raw.Y.offset) or 0
			)
		end
		local arr = raw.value or raw
		if typeof(arr) == "table" and arr[1] ~= nil and arr[2] ~= nil and arr[3] ~= nil and arr[4] ~= nil then
			return UDim2.new(
				tonumber(arr[1]) or 0,
				tonumber(arr[2]) or 0,
				tonumber(arr[3]) or 0,
				tonumber(arr[4]) or 0
			)
		end
		return UDim2.new(
			tonumber(raw.XScale or raw.xScale or raw.scaleX) or 0,
			tonumber(raw.XOffset or raw.xOffset or raw.offsetX) or 0,
			tonumber(raw.YScale or raw.yScale or raw.scaleY) or 0,
			tonumber(raw.YOffset or raw.yOffset or raw.offsetY) or 0
		)
	end
	error("Invalid UDim2 specification")
end

local function decodeVector2(raw: any): Vector2
	if typeof(raw) == "Vector2" then
		return raw
	end
	if typeof(raw) == "table" then
		local arr = raw.value or raw
		if typeof(arr) == "table" and arr[1] ~= nil and arr[2] ~= nil then
			return Vector2.new(tonumber(arr[1]) or 0, tonumber(arr[2]) or 0)
		end
		return Vector2.new(tonumber(raw.X or raw.x) or 0, tonumber(raw.Y or raw.y) or 0)
	end
	error("Invalid Vector2 specification")
end

local function decodeRect(raw: any): Rect
	if typeof(raw) == "Rect" then
		return raw
	end
	if typeof(raw) == "table" then
		if typeof(raw.Min) == "table" and typeof(raw.Max) == "table" then
			return Rect.new(
				tonumber(raw.Min.X or raw.Min.x) or 0,
				tonumber(raw.Min.Y or raw.Min.y) or 0,
				tonumber(raw.Max.X or raw.Max.x) or 0,
				tonumber(raw.Max.Y or raw.Max.y) or 0
			)
		end
		local arr = raw.value or raw
		if typeof(arr) == "table" and arr[1] ~= nil and arr[4] ~= nil then
			return Rect.new(
				tonumber(arr[1]) or 0,
				tonumber(arr[2]) or 0,
				tonumber(arr[3]) or 0,
				tonumber(arr[4]) or 0
			)
		end
	end
	error("Invalid Rect specification")
end

local function decodeColorSequence(raw: any): ColorSequence
	if typeof(raw) == "ColorSequence" then
		return raw
	end
	local list = if typeof(raw) == "table" and typeof(raw.keypoints) == "table"
		then raw.keypoints
		elseif typeof(raw) == "table" and typeof(raw.value) == "table" then raw.value
		else raw
	if typeof(list) ~= "table" or #list == 0 then
		error("ColorSequence requires a non-empty array of keypoints")
	end
	local kps: { ColorSequenceKeypoint } = {}
	for _, entry in ipairs(list) do
		local tVal = tonumber(entry.time or entry.Time) or 0
		local cVal = decodeColor3(entry.color or entry.Color or entry.value or entry.Value)
		table.insert(kps, ColorSequenceKeypoint.new(tVal, cVal))
	end
	table.sort(kps, function(a, b)
		return a.Time &lt; b.Time
	end)
	return ColorSequence.new(kps)
end

local function inferPropertyTypeHint(propName: string): string?
	local lower = string.lower(propName)
	if string.find(lower, "colorsequence", 1, true) or propName == "Color" then
		-- Note: UIGradient.Color is ColorSequence, while UIStroke.Color is Color3; caller currentVal refines this
		return nil
	end
	if string.find(lower, "color", 1, true) then
		return "Color3"
	end
	if propName == "Size" or propName == "Position" then
		return "UDim2"
	end
	if string.find(lower, "padding", 1, true) or propName == "CornerRadius" then
		return "UDim"
	end
	if propName == "AnchorPoint" or string.find(lower, "rectoffset", 1, true) or string.find(lower, "rectsize", 1, true) then
		return "Vector2"
	end
	if propName == "SliceCenter" then
		return "Rect"
	end
	return nil
end

local function decodeTypedValue(raw: any, targetTypeHint: string?, existingValue: any?): any
	if typeof(raw) == "table" then
		local explicitType = raw.__type or raw.type
		if typeof(explicitType) == "string" then
			if explicitType == "UDim2" then
				return decodeUDim2(raw)
			elseif explicitType == "UDim" then
				return decodeUDim(raw)
			elseif explicitType == "Vector2" then
				return decodeVector2(raw)
			elseif explicitType == "Color3" then
				return decodeColor3(raw)
			elseif explicitType == "ColorSequence" then
				return decodeColorSequence(raw)
			elseif explicitType == "Rect" then
				return decodeRect(raw)
			elseif explicitType == "Enum" then
				local enumItem = decodeEnum(raw, if typeof(existingValue) == "EnumItem" then existingValue.EnumType else nil)
				if enumItem then
					return enumItem
				end
			end
		end
	end

	local resolvedType = if existingValue ~= nil then typeof(existingValue) else targetTypeHint
	if resolvedType == "EnumItem" then
		local enumItem = decodeEnum(raw, (existingValue :: EnumItem).EnumType)
		if enumItem then
			return enumItem
		end
	elseif resolvedType == "UDim2" then
		return decodeUDim2(raw)
	elseif resolvedType == "UDim" then
		return decodeUDim(raw)
	elseif resolvedType == "Vector2" then
		return decodeVector2(raw)
	elseif resolvedType == "Color3" then
		return decodeColor3(raw)
	elseif resolvedType == "ColorSequence" then
		return decodeColorSequence(raw)
	elseif resolvedType == "Rect" then
		return decodeRect(raw)
	elseif resolvedType == "Font" and typeof(raw) == "table" then
		local fam = tostring(raw.family or "rbxasset://fonts/families/BuilderSans.json")
		local weightItem = decodeEnum(raw.weight or "Regular", Enum.FontWeight) or Enum.FontWeight.Regular
		local styleItem = decodeEnum(raw.style or "Normal", Enum.FontStyle) or Enum.FontStyle.Normal
		return Font.new(fam, (weightItem :: any) :: Enum.FontWeight, (styleItem :: any) :: Enum.FontStyle)
	end

	if typeof(raw) == "string" and string.sub(raw, 1, 5) == "Enum." then
		local enumItem = decodeEnum(raw, nil)
		if enumItem then
			return enumItem
		end
	end
	if typeof(raw) == "string" and string.match(raw, "^#%x%x%x%x%x%x$") then
		return Color3.fromHex(string.sub(raw, 2))
	end
	if typeof(raw) == "table" and raw[1] ~= nil and typeof(raw[1]) == "table" and raw[1].color ~= nil then
		return decodeColorSequence(raw)
	end
	return raw
end

local function approxEqual(a: any, b: any): boolean
	if typeof(a) ~= typeof(b) then
		return false
	end
	local t = typeof(a)
	local eps = 1e-3
	if t == "number" then
		return math.abs((a :: number) - (b :: number)) &lt;= eps
	elseif t == "Vector2" then
		local va, vb = a :: Vector2, b :: Vector2
		return math.abs(va.X - vb.X) &lt;= eps and math.abs(va.Y - vb.Y) &lt;= eps
	elseif t == "UDim" then
		local ua, ub = a :: UDim, b :: UDim
		return math.abs(ua.Scale - ub.Scale) &lt;= eps and math.abs(ua.Offset - ub.Offset) &lt;= 1
	elseif t == "UDim2" then
		local ua, ub = a :: UDim2, b :: UDim2
		return math.abs(ua.X.Scale - ub.X.Scale) &lt;= eps
			and math.abs(ua.X.Offset - ub.X.Offset) &lt;= 1
			and math.abs(ua.Y.Scale - ub.Y.Scale) &lt;= eps
			and math.abs(ua.Y.Offset - ub.Y.Offset) &lt;= 1
	elseif t == "Color3" then
		local ca, cb = a :: Color3, b :: Color3
		return math.abs(ca.R - cb.R) &lt;= 0.01
			and math.abs(ca.G - cb.G) &lt;= 0.01
			and math.abs(ca.B - cb.B) &lt;= 0.01
	elseif t == "Rect" then
		local ra, rb = a :: Rect, b :: Rect
		return math.abs(ra.Min.X - rb.Min.X) &lt;= eps
			and math.abs(ra.Min.Y - rb.Min.Y) &lt;= eps
			and math.abs(ra.Max.X - rb.Max.X) &lt;= eps
			and math.abs(ra.Max.Y - rb.Max.Y) &lt;= eps
	elseif t == "ColorSequence" then
		local csa, csb = a :: ColorSequence, b :: ColorSequence
		if #csa.Keypoints ~= #csb.Keypoints then
			return false
		end
		for i = 1, #csa.Keypoints do
			if math.abs(csa.Keypoints[i].Time - csb.Keypoints[i].Time) &gt; eps then
				return false
			end
			if not approxEqual(csa.Keypoints[i].Value, csb.Keypoints[i].Value) then
				return false
			end
		end
		return true
	end
	return a == b
end

local function collectStyleSheetSummary(sheet: StyleSheet): { [string]: any }
	local rules: { any } = {}
	for _, ch in ipairs(sheet:GetChildren()) do
		if ch:IsA("StyleRule") then
			local okProps, rawProps = pcall(function()
				return ch:GetProperties()
			end)
			local propOut: { [string]: any } = {}
			if okProps and typeof(rawProps) == "table" then
				for k, v in pairs(rawProps) do
					propOut[tostring(k)] = encodeValue(v)
				end
			end
			local okErr, selErr = pcall(function()
				return ch.SelectorError
			end)
			table.insert(rules, {
				Name = ch.Name,
				SharpHandle = getOrCreateHandle(ch),
				Path = getInstancePath(ch),
				Selector = ch.Selector,
				Priority = ch.Priority,
				SelectorError = if okErr then selErr else "",
				Properties = propOut,
			})
		end
	end
	return {
		Name = sheet.Name,
		SharpHandle = getOrCreateHandle(sheet),
		Path = getInstancePath(sheet),
		RuleCount = #rules,
		Rules = rules,
	}
end

local function inspectNode(inst: Instance, depth: number, maxDepth: number, includeProps: boolean): { [string]: any }
	local node: { [string]: any } = {
		Name = inst.Name,
		ClassName = inst.ClassName,
		SharpHandle = getOrCreateHandle(inst),
		Path = getInstancePath(inst),
	}

	if inst:IsA("LayerCollector") then
		node.Enabled = inst.Enabled
		node.ResetOnSpawn = inst.ResetOnSpawn
		node.ZIndexBehavior = inst.ZIndexBehavior.Name
		if inst:IsA("ScreenGui") then
			node.DisplayOrder = inst.DisplayOrder
			local okInsets, insets = pcall(function()
				return inst.ScreenInsets.Name
			end)
			if okInsets then
				node.ScreenInsets = insets
			end
		end
		node.AbsoluteSize = encodeValue(inst.AbsoluteSize)
	elseif inst:IsA("GuiObject") then
		node.Visible = inst.Visible
		node.AbsolutePosition = encodeValue(inst.AbsolutePosition)
		node.AbsoluteSize = encodeValue(inst.AbsoluteSize)
		node.ZIndex = inst.ZIndex
		node.LayoutOrder = inst.LayoutOrder
	elseif inst:IsA("UIGridStyleLayout") then
		node.AbsoluteContentSize = encodeValue(inst.AbsoluteContentSize)
	elseif inst:IsA("StyleLink") then
		local sheet = inst.StyleSheet
		if sheet then
			node.StyleSheet = {
				Name = sheet.Name,
				SharpHandle = getOrCreateHandle(sheet),
				Path = getInstancePath(sheet),
			}
			local selectors: { string } = {}
			for _, rule in ipairs(sheet:GetChildren()) do
				if rule:IsA("StyleRule") then
					table.insert(selectors, rule.Selector)
				end
			end
			node.StyleRuleSelectors = selectors
		end
	elseif inst:IsA("StyleSheet") then
		local sheetInfo = collectStyleSheetSummary(inst)
		node.RuleCount = sheetInfo.RuleCount
		node.Rules = sheetInfo.Rules
	elseif inst:IsA("StyleRule") then
		node.Selector = inst.Selector
		node.Priority = inst.Priority
		local okErr, selErr = pcall(function()
			return inst.SelectorError
		end)
		if okErr then
			node.SelectorError = selErr
		end
	end

	-- Track active StyleLinks attached directly on this instance
	local linkSelectors: { any } = {}
	for _, child in ipairs(inst:GetChildren()) do
		if child:IsA("StyleLink") then
			local sheet = child.StyleSheet
			if sheet then
				local selectors: { string } = {}
				for _, r in ipairs(sheet:GetChildren()) do
					if r:IsA("StyleRule") then
						table.insert(selectors, r.Selector)
					end
				end
				table.insert(linkSelectors, {
					StyleLink = child.Name,
					StyleSheetPath = getInstancePath(sheet),
					Selectors = selectors,
				})
			end
		end
	end
	if #linkSelectors &gt; 0 then
		node.ActiveStyleLinks = linkSelectors
	end

	-- Track IsPropertyModified on key UI props
	if inst:IsA("GuiObject") then
		local modified: { string } = {}
		for _, propName in ipairs(KEY_MODIFIED_PROPS) do
			local okMod, isMod = pcall(function()
				return inst:IsPropertyModified(propName)
			end)
			if okMod and isMod == true then
				table.insert(modified, propName)
			end
		end
		node.IsPropertyModified = modified
	end

	if includeProps then
		local propSnapshot: { [string]: any } = {}
		for _, propName in ipairs(INSPECT_EXTRA_PROPS) do
			local okRead, val = pcall(function()
				return (inst :: any)[propName]
			end)
			if okRead and val ~= nil and typeof(val) ~= "function" and typeof(val) ~= "RBXScriptSignal" then
				propSnapshot[propName] = encodeValue(val)
			end
		end
		if next(propSnapshot) ~= nil then
			node.Properties = propSnapshot
		end
	end

	if depth &lt; maxDepth then
		local childrenOut: { any } = {}
		for _, child in ipairs(inst:GetChildren()) do
			table.insert(childrenOut, inspectNode(child, depth + 1, maxDepth, includeProps))
		end
		if #childrenOut &gt; 0 then
			node.Children = childrenOut
		end
	else
		local childCount = #inst:GetChildren()
		if childCount &gt; 0 then
			node.TruncatedChildCount = childCount
		end
	end

	return node
end

function SharpGuiTools.inspect(args: { [string]: any }?): { [string]: any }
	local opts = args or {}
	local maxDepth = math.max(0, math.min(12, tonumber(opts.maxDepth) or 5))
	local includeProps = opts.includeProps == true

	local targetInst: Instance? = nil
	if typeof(opts.rootHandle) == "string" or typeof(opts.sharpHandle) == "string" or typeof(opts.handle) == "string" or typeof(opts.rootPath) == "string" then
		targetInst = resolveTarget({
			sharpHandle = opts.rootHandle or opts.sharpHandle or opts.handle,
			path = opts.rootPath,
		})
		if not targetInst then
			return {
				ok = false,
				code = "TARGET_NOT_FOUND",
				message = "Could not resolve requested GUI rootPath/rootHandle.",
			}
		end
	else
		local usePlayerGui = opts.target == "PlayerGui" or (opts.target == nil and RunService:IsRunning())
		local lp = Players.LocalPlayer
		local pg = if lp then lp:FindFirstChild("PlayerGui") else nil
		if usePlayerGui and pg then
			targetInst = pg
		else
			targetInst = StarterGui
		end
	end

	local styleSheets: { any } = {}
	if opts.includeStyleSheets ~= false then
		for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
			if desc:IsA("StyleSheet") then
				table.insert(styleSheets, collectStyleSheetSummary(desc))
			end
		end
		for _, desc in ipairs(StarterGui:GetDescendants()) do
			if desc:IsA("StyleSheet") then
				table.insert(styleSheets, collectStyleSheetSummary(desc))
			end
		end
	end

	local vpSize = Vector2.new(1280, 720)
	local cam = workspace.CurrentCamera
	if cam and cam.ViewportSize.X &gt; 0 and cam.ViewportSize.Y &gt; 0 then
		vpSize = cam.ViewportSize
	end
	local okInset, topbarInset = pcall(function()
		return GuiService.TopbarInset
	end)

	return {
		ok = true,
		rootPath = getInstancePath(targetInst :: Instance),
		viewportSize = encodeValue(vpSize),
		topbarInset = if okInset and topbarInset then encodeValue(topbarInset) else nil,
		tree = inspectNode(targetInst :: Instance, 0, maxDepth, includeProps),
		styleSheets = styleSheets,
	}
end

local function applySingleInstancePatch(spec: { [string]: any }): ({ [string]: any }, { [string]: any }, number, { string })
	local inst = resolveTarget(spec)
	if not inst then
		return {}, {}, 0, { "Target not found for patch spec" }
	end

	local handle = getOrCreateHandle(inst)
	local path = getInstancePath(inst)
	local beforeProps: { [string]: any } = {}
	local afterProps: { [string]: any } = {}
	local expectedSetValues: { [string]: any } = {}
	local resetPropNames: { string } = {}
	local errors: { string } = {}
	local patchedCount = 0

	local resetList = spec.resetProperties
	if typeof(resetList) == "table" then
		for _, propNameAny in ipairs(resetList) do
			local propName = tostring(propNameAny)
			local okOld, oldVal = pcall(function()
				return (inst :: any)[propName]
			end)
			if okOld then
				beforeProps[propName] = encodeValue(oldVal)
			end
			local okReset, resetErr = pcall(function()
				inst:ResetPropertyToDefault(propName)
			end)
			if not okReset then
				table.insert(errors, string.format("%s.%s ResetPropertyToDefault failed: %s", path, propName, tostring(resetErr)))
			else
				table.insert(resetPropNames, propName)
				patchedCount += 1
			end
		end
	end

	local setMap = spec.setProperties
	if typeof(setMap) == "table" then
		for propNameAny, rawTarget in pairs(setMap) do
			local propName = tostring(propNameAny)
			local okOld, oldVal = pcall(function()
				return (inst :: any)[propName]
			end)
			if okOld then
				beforeProps[propName] = encodeValue(oldVal)
			end
			local okDec, decodedVal = pcall(
				decodeTypedValue,
				rawTarget,
				inferPropertyTypeHint(propName),
				if okOld then oldVal else nil
			)
			if not okDec then
				table.insert(errors, string.format("%s.%s decode failed: %s", path, propName, tostring(decodedVal)))
				continue
			end
			local okWrite, writeErr = pcall(function()
				(inst :: any)[propName] = decodedVal
			end)
			if not okWrite then
				table.insert(errors, string.format("%s.%s write failed: %s", path, propName, tostring(writeErr)))
			else
				expectedSetValues[propName] = decodedVal
				patchedCount += 1
			end
		end
	end

	-- Readback verification
	for propName, expectedVal in pairs(expectedSetValues) do
		local okRead, actualVal = pcall(function()
			return (inst :: any)[propName]
		end)
		if not okRead then
			table.insert(errors, string.format("%s.%s readback failed", path, propName))
		else
			afterProps[propName] = encodeValue(actualVal)
			if not approxEqual(actualVal, expectedVal) then
				table.insert(errors, string.format("%s.%s readback mismatch", path, propName))
			end
		end
	end

	for _, propName in ipairs(resetPropNames) do
		local okRead, actualVal = pcall(function()
			return (inst :: any)[propName]
		end)
		if okRead then
			afterProps[propName] = encodeValue(actualVal)
		end
		local okMod, isMod = pcall(function()
			return inst:IsPropertyModified(propName)
		end)
		if okMod and isMod == true then
			table.insert(errors, string.format("%s.%s still reports IsPropertyModified=true after reset", path, propName))
		end
	end

	local beforeRecord = { SharpHandle = handle, Path = path, Properties = beforeProps }
	local afterRecord = { SharpHandle = handle, Path = path, Properties = afterProps }
	return beforeRecord, afterRecord, patchedCount, errors
end

local function applyStyleRuleUpdate(spec: { [string]: any }): ({ [string]: any }, { [string]: any }, number, { string })
	local targetInst = resolveTarget(spec)
	if not targetInst and typeof(spec.styleSheetPath) == "string" and typeof(spec.name) == "string" then
		local sheet = resolvePath(spec.styleSheetPath)
		if sheet and sheet:IsA("StyleSheet") then
			targetInst = sheet:FindFirstChild(spec.name)
		end
	end
	if not targetInst or not targetInst:IsA("StyleRule") then
		return {}, {}, 0, { "StyleRule target not found" }
	end

	local rule = targetInst :: StyleRule
	local handle = getOrCreateHandle(rule)
	local path = getInstancePath(rule)
	local errors: { string } = {}
	local patchedCount = 0

	local okOldProps, oldPropsMap = pcall(function()
		return rule:GetProperties()
	end)
	local beforeRecord: { [string]: any } = {
		SharpHandle = handle,
		Path = path,
		Selector = rule.Selector,
		Priority = rule.Priority,
		Properties = {},
	}
	if okOldProps and typeof(oldPropsMap) == "table" then
		local serOld: { [string]: any } = {}
		for k, v in pairs(oldPropsMap) do
			serOld[tostring(k)] = encodeValue(v)
		end
		beforeRecord.Properties = serOld
	end

	if typeof(spec.selector) == "string" then
		local okSel, selErr = pcall(function()
			rule.Selector = spec.selector
		end)
		if not okSel then
			table.insert(errors, path .. " Selector write failed: " .. tostring(selErr))
		else
			patchedCount += 1
		end
	end
	if typeof(spec.priority) == "number" then
		local okPri, priErr = pcall(function()
			rule.Priority = spec.priority
		end)
		if not okPri then
			table.insert(errors, path .. " Priority write failed: " .. tostring(priErr))
		else
			patchedCount += 1
		end
	end

	local propsInput = spec.setProperties or spec.properties
	local expectedRuleProps: { [string]: any } = {}
	if typeof(propsInput) == "table" then
		local decodedMap: { [string]: any } = {}
		for propNameAny, rawVal in pairs(propsInput) do
			local propName = tostring(propNameAny)
			local existingVal = if okOldProps and typeof(oldPropsMap) == "table" then oldPropsMap[propName] else nil
			local okDec, decVal = pcall(decodeTypedValue, rawVal, inferPropertyTypeHint(propName), existingVal)
			if not okDec then
				table.insert(errors, string.format("%s StyleRule.%s decode failed: %s", path, propName, tostring(decVal)))
			else
				decodedMap[propName] = decVal
				expectedRuleProps[propName] = decVal
			end
		end
		if next(decodedMap) ~= nil then
			local okSet, setErr = pcall(function()
				rule:SetProperties(decodedMap)
			end)
			if not okSet then
				table.insert(errors, path .. " SetProperties failed: " .. tostring(setErr))
			else
				patchedCount += 1
			end
		end
	end

	-- Readback verification
	local okNewProps, newPropsMap = pcall(function()
		return rule:GetProperties()
	end)
	local serNew: { [string]: any } = {}
	if okNewProps and typeof(newPropsMap) == "table" then
		for k, v in pairs(newPropsMap) do
			serNew[tostring(k)] = encodeValue(v)
		end
		for propName, expectedVal in pairs(expectedRuleProps) do
			local actualVal = newPropsMap[propName]
			if actualVal == nil or not approxEqual(actualVal, expectedVal) then
				table.insert(errors, string.format("%s StyleRule.%s readback mismatch", path, propName))
			end
		end
	end
	if typeof(spec.selector) == "string" and rule.Selector ~= spec.selector then
		table.insert(errors, path .. " Selector readback mismatch")
	end
	local okSelErr, selErrMsg = pcall(function()
		return rule.SelectorError
	end)
	if okSelErr and typeof(selErrMsg) == "string" and #selErrMsg &gt; 0 then
		table.insert(errors, path .. " SelectorError: " .. selErrMsg)
	end

	local afterRecord: { [string]: any } = {
		SharpHandle = handle,
		Path = path,
		Selector = rule.Selector,
		Priority = rule.Priority,
		SelectorError = if okSelErr then selErrMsg else "",
		Properties = serNew,
	}
	return beforeRecord, afterRecord, patchedCount, errors
end

function SharpGuiTools.patch(args: { [string]: any }?): (boolean, { [string]: any })
	local opts = args or {}
	local beforeList: { any } = {}
	local afterList: { any } = {}
	local allErrors: { string } = {}
	local totalPatched = 0

	local patches = if typeof(opts.patches) == "table" then opts.patches else nil
	if patches then
		for _, patchSpec in ipairs(patches) do
			if typeof(patchSpec) == "table" then
				local b, a, cnt, errs = applySingleInstancePatch(patchSpec)
				table.insert(beforeList, b)
				table.insert(afterList, a)
				totalPatched += cnt
				for _, e in ipairs(errs) do
					table.insert(allErrors, e)
				end
			end
		end
	elseif opts.sharpHandle ~= nil or opts.handle ~= nil or opts.path ~= nil then
		local b, a, cnt, errs = applySingleInstancePatch(opts)
		table.insert(beforeList, b)
		table.insert(afterList, a)
		totalPatched += cnt
		for _, e in ipairs(errs) do
			table.insert(allErrors, e)
		end
	end

	local styleRuleUpdates = if typeof(opts.styleRuleUpdates) == "table" then opts.styleRuleUpdates else nil
	if styleRuleUpdates then
		for _, ruleSpec in ipairs(styleRuleUpdates) do
			if typeof(ruleSpec) == "table" then
				local b, a, cnt, errs = applyStyleRuleUpdate(ruleSpec)
				table.insert(beforeList, b)
				table.insert(afterList, a)
				totalPatched += cnt
				for _, e in ipairs(errs) do
					table.insert(allErrors, e)
				end
			end
		end
	end

	if totalPatched == 0 and #allErrors == 0 then
		table.insert(allErrors, "No valid patch targets or operations provided")
	end

	local verified = (#allErrors == 0) and (totalPatched &gt; 0)
	local payload: { [string]: any } = {
		ok = verified,
		before = beforeList,
		after = afterList,
		patchedCount = totalPatched,
		verified = verified,
		errors = allErrors,
	}
	return verified, payload
end

function SharpGuiTools.deviceSim(args: { [string]: any }?): { [string]: any }
	local opts = args or {}
	local op = tostring(opts.action or opts.op or opts.mode or "get_device")

	local okSvc, simSvc = pcall(function()
		return game:GetService("StudioDeviceSimulatorService")
	end)
	if not okSvc or not simSvc then
		return {
			ok = false,
			code = "DEVICE_SIMULATOR_UNAVAILABLE",
			message = "StudioDeviceSimulatorService is not available in this Studio environment.",
		}
	end

	if op == "list_devices" then
		local okList, listOrErr = pcall(function()
			return (simSvc :: any):GetDeviceListAsync()
		end)
		if not okList then
			return { ok = false, code = "DEVICE_SIM_ERROR", message = tostring(listOrErr) }
		end
		local devicesOut: { any } = {}
		if typeof(listOrErr) == "table" then
			for _, dev in ipairs(listOrErr) do
				if typeof(dev) == "table" then
					local copy: { [string]: any } = {}
					for k, v in pairs(dev) do
						copy[tostring(k)] = encodeValue(v)
					end
					table.insert(devicesOut, copy)
				else
					table.insert(devicesOut, tostring(dev))
				end
			end
		end
		return { ok = true, op = op, devices = devicesOut }
	elseif op == "get_device" then
		local okCur, curOrErr = pcall(function()
			local svcAny = simSvc :: any
			if typeof(svcAny.GetCurrentDeviceAsync) == "function" then
				return svcAny:GetCurrentDeviceAsync()
			elseif svcAny.CurrentDeviceId ~= nil then
				return svcAny.CurrentDeviceId
			end
			return nil
		end)
		local okOri, ori = pcall(function()
			return (simSvc :: any).Orientation
		end)
		local cam = workspace.CurrentCamera
		return {
			ok = okCur,
			op = op,
			currentDevice = if okCur then encodeValue(curOrErr) else nil,
			orientation = if okOri and ori ~= nil then encodeValue(ori) else nil,
			viewportSize = if cam then encodeValue(cam.ViewportSize) else nil,
			error = if not okCur then tostring(curOrErr) else nil,
		}
	elseif op == "set_device" then
		local deviceId = tostring(opts.deviceId or opts.device or "default")
		local okSet, setErr = pcall(function()
			if deviceId == "default" or deviceId == "" then
				local svcAny = simSvc :: any
				local okDef = pcall(function()
					svcAny:SetDeviceAsync("default")
				end)
				if not okDef and typeof(svcAny.StopSimulationAsync) == "function" then
					svcAny:StopSimulationAsync()
				end
			else
				(simSvc :: any):SetDeviceAsync(deviceId)
			end
		end)
		return {
			ok = okSet,
			op = op,
			deviceId = deviceId,
			error = if not okSet then tostring(setErr) else nil,
		}
	elseif op == "set_resolution" then
		local width = math.max(100, math.floor(tonumber(opts.width) or 1280))
		local height = math.max(100, math.floor(tonumber(opts.height) or 720))
		local okRes, resErr = pcall(function()
			(simSvc :: any):SetResolutionAsync(width, height)
		end)
		if not okRes then
			local okVec, vecErr = pcall(function()
				(simSvc :: any):SetResolutionAsync(Vector2.new(width, height))
			end)
			okRes = okVec
			resErr = vecErr
		end
		return {
			ok = okRes,
			op = op,
			width = width,
			height = height,
			error = if not okRes then tostring(resErr) else nil,
		}
	elseif op == "set_orientation" then
		local orientation = opts.orientation or "LandscapeLeft"
		local okOri, oriErr = pcall(function()
			local svcAny = simSvc :: any
			if typeof(svcAny.SetOrientationAsync) == "function" then
				local enumVal = decodeEnum(orientation, Enum.ScreenOrientation)
				svcAny:SetOrientationAsync(enumVal or orientation)
			else
				local enumVal = decodeEnum(orientation, Enum.ScreenOrientation)
				svcAny.Orientation = enumVal or orientation
			end
		end)
		return {
			ok = okOri,
			op = op,
			orientation = tostring(orientation),
			error = if not okOri then tostring(oriErr) else nil,
		}
	elseif op == "stop" then
		local okStop, stopErr = pcall(function()
			(simSvc :: any):StopSimulationAsync()
		end)
		return {
			ok = okStop,
			op = op,
			error = if not okStop then tostring(stopErr) else nil,
		}
	end

	return {
		ok = false,
		code = "UNKNOWN_DEVICE_SIM_OP",
		message = "Unsupported deviceSim op: " .. op,
	}
end

return SharpGuiTools
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_4">
      <Properties>
        <string name="Name">SharpTreeTools</string>
        <ProtectedString name="Source">--!strict
--[[
	SharpTreeTools
	Standalone Place tree browsing, GUID SharpHandle resolution, surgical script
	reading/editing via ScriptEditorService, bounded console logs, and embedded
	ModuleScript operation dispatch for SharpBridgePlugin.
]]

local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local LogService = game:GetService("LogService")
local ScriptEditorService = game:GetService("ScriptEditorService")

local HANDLE_ATTR = "SharpHandle"

local SAFE_DATAMODEL_SERVICES: { string } = {
	"Workspace",
	"ReplicatedStorage",
	"ReplicatedFirst",
	"ServerScriptService",
	"ServerStorage",
	"StarterGui",
	"StarterPack",
	"StarterPlayer",
	"Lighting",
	"SoundService",
	"TextChatService",
	"Teams",
	"Players",
}

local SharpTreeTools = {}

local function getOrCreateHandle(inst: Instance, assignIfMissing: boolean?): string?
	local existing = inst:GetAttribute(HANDLE_ATTR)
	if typeof(existing) == "string" and #existing &gt; 0 then
		return existing
	end
	if assignIfMissing == false then
		return nil
	end
	local handle = "sh_" .. HttpService:GenerateGUID(false)
	local ok = pcall(function()
		inst:SetAttribute(HANDLE_ATTR, handle)
	end)
	return if ok then handle else nil
end

local function getInstancePath(inst: Instance): string
	local parts: { string } = {}
	local curr: Instance? = inst
	while curr and curr ~= game do
		table.insert(parts, 1, curr.Name)
		curr = curr.Parent
	end
	return table.concat(parts, ".")
end

local function resolvePath(pathStr: string): Instance?
	if pathStr == "" then
		return nil
	end
	local cleaned = pathStr
	if cleaned == "game" then
		return game
	end
	if string.sub(cleaned, 1, 5) == "game." then
		cleaned = string.sub(cleaned, 6)
	end
	local curr: Instance = game
	local first = true
	for segment in string.gmatch(cleaned, "[^%.]+") do
		local nxt: Instance? = nil
		if first and curr == game then
			local okSvc, svc = pcall(function()
				return game:GetService(segment)
			end)
			if okSvc and svc then
				nxt = svc
			else
				nxt = game:FindFirstChild(segment)
			end
			first = false
		else
			nxt = curr:FindFirstChild(segment)
		end
		if not nxt then
			return nil
		end
		curr = nxt
	end
	return curr
end

local function getSafeRoots(): { Instance }
	local roots: { Instance } = {}
	for _, svcName in ipairs(SAFE_DATAMODEL_SERVICES) do
		local ok, svc = pcall(function()
			return game:GetService(svcName)
		end)
		if ok and svc then
			table.insert(roots, svc)
		end
	end
	return roots
end

local function findByHandle(handle: string): Instance?
	for _, root in ipairs(getSafeRoots()) do
		local okRootAttr, rootAttr = pcall(function()
			return root:GetAttribute(HANDLE_ATTR)
		end)
		if okRootAttr and rootAttr == handle then
			return root
		end
		local okDesc, descs = pcall(function()
			return root:GetDescendants()
		end)
		if okDesc and typeof(descs) == "table" then
			for _, desc in ipairs(descs) do
				local okAttr, attr = pcall(function()
					return desc:GetAttribute(HANDLE_ATTR)
				end)
				if okAttr and attr == handle then
					return desc
				end
			end
		end
	end
	return nil
end

local function resolveTarget(args: { [string]: any }): Instance?
	local handle = args.sharpHandle or args.handle
	if typeof(handle) == "string" and #handle &gt; 0 then
		local found = findByHandle(handle)
		if found then
			return found
		end
	end
	local pathStr = args.path or args.rootPath
	if typeof(pathStr) == "string" and #pathStr &gt; 0 then
		return resolvePath(pathStr)
	end
	return nil
end

local function computeRevision(source: string): string
	-- Deterministic 32-bit FNV-1a checksum paired with byte length for optimistic edit checks
	local hash = 2166136261
	for i = 1, #source do
		hash = bit32.bxor(hash, string.byte(source, i))
		hash = (hash * 16777619) % 4294967296
	end
	return string.format("%d:%08x", #source, hash)
end

local function encodeSimpleValue(val: any): any
	local t = typeof(val)
	if val == nil or t == "boolean" or t == "number" or t == "string" then
		return val
	elseif t == "Vector3" then
		local v = val :: Vector3
		return { X = v.X, Y = v.Y, Z = v.Z }
	elseif t == "Vector2" then
		local v = val :: Vector2
		return { X = v.X, Y = v.Y }
	elseif t == "CFrame" then
		local cf = val :: CFrame
		return { cf:GetComponents() }
	elseif t == "Color3" then
		local c = val :: Color3
		return { R = math.round(c.R * 255), G = math.round(c.G * 255), B = math.round(c.B * 255), Hex = "#" .. c:ToHex() }
	elseif t == "UDim2" then
		local u = val :: UDim2
		return { XScale = u.X.Scale, XOffset = u.X.Offset, YScale = u.Y.Scale, YOffset = u.Y.Offset }
	elseif t == "UDim" then
		local u = val :: UDim
		return { Scale = u.Scale, Offset = u.Offset }
	elseif t == "EnumItem" then
		return tostring(val)
	elseif t == "Instance" then
		return getInstancePath(val :: Instance)
	end
	return tostring(val)
end

function SharpTreeTools.searchTree(args: { [string]: any }?): { [string]: any }
	local opts = args or {}
	local query = if typeof(opts.query) == "string" and #opts.query &gt; 0
		then string.lower(opts.query)
		else nil
	local className = if typeof(opts.className) == "string" and #opts.className &gt; 0
		then opts.className
		else nil
	local tagFilter = if typeof(opts.tag) == "string" and #opts.tag &gt; 0 then opts.tag else nil
	local maxDepth = math.max(0, math.min(16, tonumber(opts.maxDepth) or 4))
	local limit = math.max(1, math.min(500, tonumber(opts.limit) or 100))
	local assignHandles = opts.assignHandles ~= false

	local roots: { Instance }
	if opts.rootPath ~= nil or opts.sharpHandle ~= nil or opts.handle ~= nil then
		local resolvedRoot = resolveTarget(opts)
		if not resolvedRoot then
			return {
				ok = false,
				code = "ROOT_NOT_FOUND",
				message = "Could not resolve searchTree root target.",
			}
		end
		roots = if resolvedRoot == game then getSafeRoots() else { resolvedRoot }
	else
		roots = getSafeRoots()
	end

	local items: { any } = {}
	local truncated = false

	local function visit(inst: Instance, depth: number)
		if #items &gt;= limit then
			truncated = true
			return
		end

		local matches = true
		if query then
			local nLower = string.lower(inst.Name)
			local cLower = string.lower(inst.ClassName)
			if not string.find(nLower, query, 1, true) and not string.find(cLower, query, 1, true) then
				matches = false
			end
		end
		if matches and className then
			local okIsA, isMatch = pcall(function()
				return inst:IsA(className)
			end)
			if not okIsA or not isMatch then
				matches = false
			end
		end
		if matches and tagFilter then
			local okTag, hasTag = pcall(function()
				return CollectionService:HasTag(inst, tagFilter)
			end)
			if not okTag or not hasTag then
				matches = false
			end
		end

		if matches then
			local okTags, tags = pcall(function()
				return CollectionService:GetTags(inst)
			end)
			local okCh, chList = pcall(function()
				return inst:GetChildren()
			end)
			table.insert(items, {
				Name = inst.Name,
				ClassName = inst.ClassName,
				SharpHandle = getOrCreateHandle(inst, assignHandles),
				Path = getInstancePath(inst),
				ChildCount = if okCh and typeof(chList) == "table" then #chList else 0,
				Tags = if okTags then tags else {},
			})
		end

		if depth &lt; maxDepth and #items &lt; limit then
			local okCh, children = pcall(function()
				return inst:GetChildren()
			end)
			if okCh and typeof(children) == "table" then
				for _, child in ipairs(children) do
					visit(child, depth + 1)
					if #items &gt;= limit then
						truncated = true
						break
					end
				end
			end
		end
	end

	for _, r in ipairs(roots) do
		visit(r, 0)
		if #items &gt;= limit then
			break
		end
	end

	return {
		ok = true,
		count = #items,
		truncated = truncated,
		items = items,
	}
end

function SharpTreeTools.inspectInstance(args: { [string]: any }?): { [string]: any }
	local opts = args or {}
	local inst = resolveTarget(opts)
	if not inst then
		return {
			ok = false,
			code = "TARGET_NOT_FOUND",
			message = "Could not resolve instance by sharpHandle or path.",
		}
	end

	local handle = getOrCreateHandle(inst, true)
	local attrs: { [string]: any } = {}
	local okAttrs, rawAttrs = pcall(function()
		return inst:GetAttributes()
	end)
	if okAttrs and typeof(rawAttrs) == "table" then
		for k, v in pairs(rawAttrs) do
			attrs[tostring(k)] = encodeSimpleValue(v)
		end
	end

	local okTags, tags = pcall(function()
		return CollectionService:GetTags(inst)
	end)

	local childrenSummary: { any } = {}
	local okCh, chList = pcall(function()
		return inst:GetChildren()
	end)
	if okCh and typeof(chList) == "table" then
		for idx, ch in ipairs(chList) do
			if idx &gt; 100 then
				break
			end
			table.insert(childrenSummary, {
				Name = ch.Name,
				ClassName = ch.ClassName,
				SharpHandle = getOrCreateHandle(ch, true),
				Path = getInstancePath(ch),
			})
		end
	end

	local props: { [string]: any } = {}
	if opts.includeProps ~= false then
		local probeNames = {
			"Archivable",
			"Position",
			"Size",
			"CFrame",
			"Anchored",
			"CanCollide",
			"Transparency",
			"Color",
			"Material",
			"Enabled",
			"Visible",
			"Text",
			"Value",
			"RunContext",
			"PrimaryPart",
			"ModelStreamingMode",
		}
		for _, propName in ipairs(probeNames) do
			local okRead, val = pcall(function()
				return (inst :: any)[propName]
			end)
			if okRead and val ~= nil and typeof(val) ~= "function" and typeof(val) ~= "RBXScriptSignal" then
				props[propName] = encodeSimpleValue(val)
			end
		end
	end

	return {
		ok = true,
		Name = inst.Name,
		ClassName = inst.ClassName,
		SharpHandle = handle,
		Path = getInstancePath(inst),
		Attributes = attrs,
		Tags = if okTags then tags else {},
		ChildCount = if okCh and typeof(chList) == "table" then #chList else 0,
		Children = childrenSummary,
		Properties = props,
	}
end

local function readScriptSourceInternal(scriptInst: LuaSourceContainer): string
	local okEd, edSrc = pcall(function()
		return ScriptEditorService:GetEditorSource(scriptInst)
	end)
	if okEd and typeof(edSrc) == "string" then
		return edSrc
	end
	return (scriptInst :: any).Source
end

function SharpTreeTools.readScript(args: { [string]: any }?): { [string]: any }
	local opts = args or {}
	local inst = resolveTarget(opts)
	if not inst or not inst:IsA("LuaSourceContainer") then
		return {
			ok = false,
			code = "SCRIPT_NOT_FOUND",
			message = "Target could not be resolved to a Script, LocalScript, or ModuleScript.",
		}
	end

	local scriptInst = inst :: LuaSourceContainer
	local src = readScriptSourceInternal(scriptInst)
	local lines = string.split(src, "\n")
	local revision = computeRevision(src)
	local handle = getOrCreateHandle(scriptInst, true)

	local outSource = src
	local startLine = tonumber(opts.startLine)
	local endLine = tonumber(opts.endLine)
	if startLine or endLine then
		local s = math.max(1, math.floor(startLine or 1))
		local e = math.min(#lines, math.floor(endLine or #lines))
		local sliced: { string } = {}
		for i = s, e do
			table.insert(sliced, lines[i])
		end
		outSource = table.concat(sliced, "\n")
	end

	return {
		ok = true,
		Name = scriptInst.Name,
		ClassName = scriptInst.ClassName,
		SharpHandle = handle,
		Path = getInstancePath(scriptInst),
		revision = revision,
		length = #src,
		lineCount = #lines,
		source = if opts.includeSource == false then nil else outSource,
	}
end

function SharpTreeTools.updateScript(args: { [string]: any }?): (boolean, { [string]: any })
	local opts = args or {}
	local inst = resolveTarget(opts)
	if not inst or not inst:IsA("LuaSourceContainer") then
		return false, {
			ok = false,
			code = "SCRIPT_NOT_FOUND",
			message = "Target could not be resolved to a Script, LocalScript, or ModuleScript.",
		}
	end

	local scriptInst = inst :: LuaSourceContainer
	local expectedRev = if typeof(opts.expectedRevision) == "string" then opts.expectedRevision else nil
	local expectedLen = if typeof(opts.expectedLength) == "number" then opts.expectedLength else nil

	local currentSrc = readScriptSourceInternal(scriptInst)
	local oldRev = computeRevision(currentSrc)
	local oldLen = #currentSrc

	if expectedRev and oldRev ~= expectedRev then
		return false, {
			ok = false,
			code = "REVISION_MISMATCH",
			message = string.format("Expected revision '%s' but current is '%s'.", expectedRev, oldRev),
			currentRevision = oldRev,
			currentLength = oldLen,
		}
	end
	if expectedLen and oldLen ~= expectedLen then
		return false, {
			ok = false,
			code = "REVISION_MISMATCH",
			message = string.format("Expected length %d but current is %d.", expectedLen, oldLen),
			currentRevision = oldRev,
			currentLength = oldLen,
		}
	end

	local function buildUpdatedSource(baseSrc: string): (boolean, string, string?)
		if typeof(opts.newSource) == "string" then
			return true, opts.newSource, nil
		elseif typeof(opts.source) == "string" then
			return true, opts.source, nil
		end
		if typeof(opts.findText) == "string" and typeof(opts.replaceText) == "string" then
			local idx = string.find(baseSrc, opts.findText, 1, true)
			if not idx then
				return false, baseSrc, "findText pattern not found in script source"
			end
			local beforePart = string.sub(baseSrc, 1, idx - 1)
			local afterPart = string.sub(baseSrc, idx + #opts.findText)
			return true, beforePart .. opts.replaceText .. afterPart, nil
		end
		return false, baseSrc, "Must provide either newSource, source, or findText + replaceText"
	end

	local okPrep, targetSrc, prepErr = buildUpdatedSource(currentSrc)
	if not okPrep then
		return false, {
			ok = false,
			code = "INVALID_SCRIPT_EDIT",
			message = prepErr or "Invalid script update payload",
		}
	end

	local callbackError: string? = nil
	local okEditor, errEditor = pcall(function()
		ScriptEditorService:UpdateSourceAsync(scriptInst, function(liveSrc: string): string
			if expectedRev and computeRevision(liveSrc) ~= expectedRev then
				callbackError = "REVISION_MISMATCH during UpdateSourceAsync"
				return liveSrc
			end
			if expectedLen and #liveSrc ~= expectedLen then
				callbackError = "LENGTH_MISMATCH during UpdateSourceAsync"
				return liveSrc
			end
			local okInner, nextText, innerErr = buildUpdatedSource(liveSrc)
			if not okInner then
				callbackError = innerErr or "Invalid script edit"
				return liveSrc
			end
			targetSrc = nextText
			return nextText
		end)
	end)

	if callbackError then
		return false, {
			ok = false,
			code = "REVISION_MISMATCH",
			message = callbackError,
		}
	end

	local usedFallback = false
	if not okEditor then
		local okFallback, errFallback = pcall(function()
			(scriptInst :: any).Source = targetSrc
		end)
		if not okFallback then
			return false, {
				ok = false,
				code = "SCRIPT_UPDATE_FAILED",
				message = string.format("UpdateSourceAsync (%s) and Source fallback (%s) failed.", tostring(errEditor), tostring(errFallback)),
			}
		end
		usedFallback = true
	end

	local afterSrc = readScriptSourceInternal(scriptInst)
	local newRev = computeRevision(afterSrc)
	local verified = (afterSrc == targetSrc)

	local payload: { [string]: any } = {
		ok = verified,
		Name = scriptInst.Name,
		ClassName = scriptInst.ClassName,
		SharpHandle = getOrCreateHandle(scriptInst, true),
		Path = getInstancePath(scriptInst),
		oldRevision = oldRev,
		newRevision = newRev,
		oldLength = oldLen,
		newLength = #afterSrc,
		usedSourceFallback = usedFallback,
		verified = verified,
	}
	return verified, payload
end

function SharpTreeTools.readConsoleLogs(args: { [string]: any }?): { [string]: any }
	local opts = args or {}
	local limit = math.max(1, math.min(500, tonumber(opts.limit) or 50))
	local msgFilter = if typeof(opts.messageType) == "string" and #opts.messageType &gt; 0
		then string.lower(opts.messageType)
		else nil

	local okHist, history = pcall(function()
		return LogService:GetLogHistory()
	end)
	if not okHist or typeof(history) ~= "table" then
		return {
			ok = false,
			code = "LOG_HISTORY_UNAVAILABLE",
			message = "Unable to read LogService:GetLogHistory().",
		}
	end

	local collected: { any } = {}
	for i = #history, 1, -1 do
		local entry = history[i]
		local mType = tostring(entry.messageType)
		local shortType = string.gsub(mType, "^Enum%.MessageType%.Message", "")
		if not msgFilter or string.find(string.lower(shortType), msgFilter, 1, true) then
			table.insert(collected, 1, {
				message = tostring(entry.message or ""),
				messageType = shortType,
				timestamp = entry.timestamp,
			})
			if #collected &gt;= limit then
				break
			end
		end
	end

	return {
		ok = true,
		totalAvailable = #history,
		returnedCount = #collected,
		logs = collected,
	}
end

local function findModuleFunction(mod: { [any]: any }, opName: string): ((any) -&gt; ...any)?
	if typeof(mod[opName]) == "function" then
		return mod[opName]
	end
	local firstUpper = string.upper(string.sub(opName, 1, 1)) .. string.sub(opName, 2)
	if typeof(mod[firstUpper]) == "function" then
		return mod[firstUpper]
	end
	local firstLower = string.lower(string.sub(opName, 1, 1)) .. string.sub(opName, 2)
	if typeof(mod[firstLower]) == "function" then
		return mod[firstLower]
	end
	local targetLower = string.lower(opName)
	for k, v in pairs(mod) do
		if typeof(v) == "function" and string.lower(tostring(k)) == targetLower then
			return v
		end
	end
	return nil
end

function SharpTreeTools.dispatchModuleOp(
	embeddedRoot: Instance,
	moduleName: string,
	opName: string,
	args: { [string]: any }?
): (boolean, any)
	local modInst = embeddedRoot:FindFirstChild(moduleName)
	if not modInst then
		local targetLower = string.lower(moduleName)
		for _, ch in ipairs(embeddedRoot:GetChildren()) do
			if ch:IsA("ModuleScript") and string.lower(ch.Name) == targetLower then
				modInst = ch
				break
			end
		end
	end
	if not modInst or not modInst:IsA("ModuleScript") then
		return false, {
			code = "MODULE_NOT_FOUND",
			module = moduleName,
			message = string.format("Embedded ModuleScript '%s' not found.", moduleName),
		}
	end

	local reqOk, modOrErr = pcall(require, modInst)
	if not reqOk then
		return false, {
			code = "MODULE_REQUIRE_ERROR",
			module = moduleName,
			message = tostring(modOrErr),
		}
	end

	if typeof(modOrErr) ~= "table" then
		if opName == "" or string.lower(opName) == "run" or string.lower(opName) == "execute" then
			return true, modOrErr
		end
		return false, {
			code = "MODULE_NOT_TABLE",
			module = moduleName,
			op = opName,
			message = string.format("Module '%s' returned %s instead of function table.", moduleName, typeof(modOrErr)),
		}
	end

	local fn = findModuleFunction(modOrErr, opName)
	if not fn then
		return false, {
			code = "UNKNOWN_MODULE_OP",
			module = moduleName,
			op = opName,
			message = string.format("Operation '%s' not found on module '%s'.", opName, moduleName),
		}
	end

	local callOk, r1, r2 = xpcall(function()
		return fn(args or {})
	end, debug.traceback)
	if not callOk then
		return false, {
			code = "MODULE_OP_ERROR",
			module = moduleName,
			op = opName,
			message = tostring(r1),
		}
	end

	if typeof(r1) == "boolean" and r2 ~= nil then
		return r1, r2
	end
	return true, r1
end

return SharpTreeTools
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_5">
      <Properties>
        <string name="Name">ProbeRig</string>
        <ProtectedString name="Source">--!strict
-- probe_rig.luau
-- Dumps ANY Roblox Studio rig (R15, R6, AnimationConstraint, Motor6D, Skinned MeshPart+Bone,
-- held Weapons/Shields, or Non-Humanoid Model) into compact JSON for Blender rig building.
--
-- Usage in execute_luau (datamodel_type = "Edit"):
--   1. Select the target Model in Studio Explorer (or set TARGET_PATH below), OR
--   2. Leave nothing selected to dump a freshly created standard Blocky R15 rig.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local Selection = game:GetService("Selection")

-- Optional explicit path, e.g. "Workspace.MyCreature". Empty = use Selection or spawn temp R15.
local TARGET_PATH: string = ""
-- If spawning a temporary avatar when nothing is selected: "R15" or "R6"
local DEFAULT_FALLBACK_RIG: "R15" | "R6" = "R15"

local function resolvePath(path: string): Instance?
	if path == "" then
		return nil
	end
	local current: Instance = game
	for segment in string.gmatch(path, "[^%.]+") do
		local nextInst = if current == game
			then (pcall(function() return game:GetService(segment) end) and game:GetService(segment) or current:FindFirstChild(segment))
			else current:FindFirstChild(segment)
		if not nextInst then
			return nil
		end
		current = nextInst
	end
	return current
end

local function cfComponents(cf: CFrame): { number }
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	return {
		math.round(x * 1e6) / 1e6, math.round(y * 1e6) / 1e6, math.round(z * 1e6) / 1e6,
		math.round(r00 * 1e6) / 1e6, math.round(r01 * 1e6) / 1e6, math.round(r02 * 1e6) / 1e6,
		math.round(r10 * 1e6) / 1e6, math.round(r11 * 1e6) / 1e6, math.round(r12 * 1e6) / 1e6,
		math.round(r20 * 1e6) / 1e6, math.round(r21 * 1e6) / 1e6, math.round(r22 * 1e6) / 1e6,
	}
end

local targetModel: Model? = nil
local cleanupModel = false

local explicit = resolvePath(TARGET_PATH)
if explicit and explicit:IsA("Model") then
	targetModel = explicit
elseif #Selection:Get() &gt; 0 then
	local first = Selection:Get()[1]
	if first:IsA("Model") then
		targetModel = first
	end
end

if not targetModel then
	local desc = Instance.new("HumanoidDescription")
	local rigType = if DEFAULT_FALLBACK_RIG == "R6" then Enum.HumanoidRigType.R6 else Enum.HumanoidRigType.R15
	targetModel = Players:CreateHumanoidModelFromDescriptionAsync(desc, rigType)
	desc:Destroy()
	cleanupModel = true
end

assert(targetModel ~= nil, "Failed to resolve or spawn target Model")

local parts: { [string]: any } = {}
local joints: { [string]: any } = {}
local bones: { [string]: any } = {}
local grips: { [string]: any } = {}
local seenPartNames: { [string]: number } = {}

local function uniqueKey(map: { [string]: any }, counts: { [string]: number }, baseName: string): string
	if map[baseName] == nil then
		counts[baseName] = 1
		return baseName
	end
	local n = (counts[baseName] or 1) + 1
	counts[baseName] = n
	return baseName .. "_" .. tostring(n)
end

for _, inst in ipairs(targetModel:GetDescendants()) do
	if inst:IsA("BasePart") then
		local key = uniqueKey(parts, seenPartNames, inst.Name)
		parts[key] = {
			name = inst.Name,
			class = inst.ClassName,
			size = {
				math.round(inst.Size.X * 1e5) / 1e5,
				math.round(inst.Size.Y * 1e5) / 1e5,
				math.round(inst.Size.Z * 1e5) / 1e5,
			},
			cf = cfComponents(inst.CFrame),
			anchored = inst.Anchored,
		}
	elseif inst:IsA("AnimationConstraint") then
		local a0 = inst.Attachment0
		local a1 = inst.Attachment1
		if a0 and a1 and a0.Parent and a1.Parent then
			table.insert(joints, {
				name = inst.Name,
				kind = "AnimationConstraint",
				p0 = a0.Parent.Name,
				p1 = a1.Parent.Name,
				c0 = cfComponents(a0.CFrame),
				c1 = cfComponents(a1.CFrame),
				isKinematic = inst.IsKinematic,
			})
		end
	elseif inst:IsA("Motor6D") then
		if inst.Part0 and inst.Part1 then
			table.insert(joints, {
				name = inst.Name,
				kind = "Motor6D",
				p0 = inst.Part0.Name,
				p1 = inst.Part1.Name,
				c0 = cfComponents(inst.C0),
				c1 = cfComponents(inst.C1),
			})
		end
	elseif inst:IsA("Bone") then
		local parent = inst.Parent
		local hostPart = inst:FindFirstAncestorWhichIsA("BasePart")
		table.insert(bones, {
			name = inst.Name,
			parent = if parent then parent.Name else nil,
			parentIsBone = if parent then parent:IsA("Bone") else false,
			hostPart = if hostPart then hostPart.Name else nil,
			cf = cfComponents(inst.CFrame),
			worldCf = cfComponents(inst.WorldCFrame),
		})
	elseif inst:IsA("Attachment") and not inst:IsA("Bone") then
		if string.find(inst.Name, "Grip") or string.find(inst.Name, "Socket") then
			local parentPart = inst.Parent
			if parentPart and parentPart:IsA("BasePart") then
				grips[parentPart.Name .. "." .. inst.Name] = {
					name = inst.Name,
					parent = parentPart.Name,
					cf = cfComponents(inst.CFrame),
				}
			end
		end
	end
end

local humanoid = targetModel:FindFirstChildOfClass("Humanoid")
local animController = targetModel:FindFirstChildOfClass("AnimationController")
local rootPart = targetModel:FindFirstChild("HumanoidRootPart") :: BasePart?
	or targetModel.PrimaryPart
	or targetModel:FindFirstChildWhichIsA("BasePart")

local rigKind = "Custom"
if humanoid then
	rigKind = if humanoid.RigType == Enum.HumanoidRigType.R6 then "R6" else "R15"
elseif #bones &gt; 0 and #joints == 0 then
	rigKind = "Skinned"
end

local payload = {
	modelName = targetModel.Name,
	rigKind = rigKind,
	hasHumanoid = humanoid ~= nil,
	hasAnimationController = animController ~= nil,
	rootName = if rootPart then rootPart.Name else nil,
	hipHeight = if humanoid then humanoid.HipHeight else nil,
	parts = parts,
	joints = joints,
	bones = bones,
	grips = grips,
}

if cleanupModel then
	targetModel:Destroy()
end

local json = HttpService:JSONEncode(payload)
return json
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_6">
      <Properties>
        <string name="Name">StudioTestAnim</string>
        <ProtectedString name="Source">--!strict
-- studio_test_anim.luau
-- Registers any KeyframeSequence or CurveAnimation in Studio via AnimationClipProvider,
-- saves a copy to ServerStorage.RBX_ANIMSAVES for Animation Editor inspection, and plays
-- it on the target rig (Humanoid or AnimationController) with marker &amp; joint verification.
--
-- Run in Edit or Play mode via execute_luau.

local AnimationClipProvider = game:GetService("AnimationClipProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Selection = game:GetService("Selection")

-- Configure or override before running:
local CLIP_PATH: string = "" -- e.g. "ReplicatedStorage.Animations.Walk_Forward" (empty = first clip in ReplicatedStorage.Animations)
local RIG_PATH: string = ""  -- e.g. "Workspace.Rig" (empty = Selection[1] or LocalPlayer.Character or Workspace rig)
local SAVE_TO_ANIMSAVES: boolean = true
local PLAY_NOW: boolean = true

local function findPath(path: string): Instance?
	if path == "" then
		return nil
	end
	local curr: Instance = game
	for seg in string.gmatch(path, "[^%.]+") do
		local nxt = if curr == game
			then (pcall(function() return game:GetService(seg) end) and game:GetService(seg) or curr:FindFirstChild(seg))
			else curr:FindFirstChild(seg)
		if not nxt then
			return nil
		end
		curr = nxt
	end
	return curr
end

local clip: AnimationClip? = nil
local foundClip = findPath(CLIP_PATH)
if foundClip and foundClip:IsA("AnimationClip") then
	clip = foundClip
else
	local animFolder = ReplicatedStorage:FindFirstChild("Animations")
	if animFolder then
		for _, ch in ipairs(animFolder:GetChildren()) do
			if ch:IsA("AnimationClip") then
				clip = ch
				break
			end
		end
	end
end
assert(clip ~= nil, "No KeyframeSequence or CurveAnimation found. Set CLIP_PATH or place clips in ReplicatedStorage.Animations.")

local rig: Model? = nil
local foundRig = findPath(RIG_PATH)
if foundRig and foundRig:IsA("Model") then
	rig = foundRig
elseif #Selection:Get() &gt; 0 and Selection:Get()[1]:IsA("Model") then
	rig = Selection:Get()[1] :: Model
else
	for _, ch in ipairs(workspace:GetChildren()) do
		if ch:IsA("Model") and (ch:FindFirstChildOfClass("Humanoid") or ch:FindFirstChildOfClass("AnimationController")) then
			rig = ch
			break
		end
	end
end
assert(rig ~= nil, "No animated Model (with Humanoid or AnimationController) found in Workspace.")

-- 1. Save editable copy to ServerStorage.RBX_ANIMSAVES.&lt;RigName&gt;.&lt;ClipName&gt;
if SAVE_TO_ANIMSAVES then
	local rootSaves = ServerStorage:FindFirstChild("RBX_ANIMSAVES")
	if not rootSaves then
		rootSaves = Instance.new("Folder")
		rootSaves.Name = "RBX_ANIMSAVES"
		rootSaves.Parent = ServerStorage
	end
	local rigSaves = rootSaves:FindFirstChild(rig.Name)
	if not rigSaves then
		rigSaves = Instance.new("Folder")
		rigSaves.Name = rig.Name
		rigSaves.Parent = rootSaves
	end
	local prev = rigSaves:FindFirstChild(clip.Name)
	if prev then
		prev:Destroy()
	end
	local clone = clip:Clone()
	clone.Parent = rigSaves
end

-- 2. Register with modern AnimationClipProvider (works in Studio Edit &amp; Play without cloud upload)
local clipAssetId = AnimationClipProvider:RegisterAnimationClip(clip)

-- 3. Ensure Animator exists under Humanoid or AnimationController
local controller: Instance? = rig:FindFirstChildOfClass("Humanoid") or rig:FindFirstChildOfClass("AnimationController")
assert(controller ~= nil, "Target rig must contain a Humanoid or AnimationController.")

local animator = controller:FindFirstChildOfClass("Animator")
if not animator then
	animator = Instance.new("Animator")
	animator.Parent = controller
end

-- Destroy default Animate script if present so Core/Idle tracks don't fight test playback
local defaultAnimate = rig:FindFirstChild("Animate")
if defaultAnimate then
	defaultAnimate:Destroy()
end

local animFolder = rig:FindFirstChild("SharpAnimations")
if not animFolder then
	animFolder = Instance.new("Folder")
	animFolder.Name = "SharpAnimations"
	animFolder.Parent = rig
end

local animObj = animFolder:FindFirstChild(clip.Name) :: Animation?
if not animObj then
	animObj = Instance.new("Animation")
	animObj.Name = clip.Name
	animObj.Parent = animFolder
end
animObj.AnimationId = clipAssetId

-- Weak-keyed Animator -&gt; { [key]: AnimationTrack } cache (avoids leaking tracks past 256 limit)
local _SharpTrackCache = setmetatable({}, { __mode = "k" }) :: { [Animator]: { [string]: AnimationTrack } }
local function getCachedTrack(targetAnimator: Animator, anim: Animation): AnimationTrack
	local perAnim = _SharpTrackCache[targetAnimator]
	if not perAnim then
		perAnim = {}
		_SharpTrackCache[targetAnimator] = perAnim
	end
	local key = anim.AnimationId ~= "" and anim.AnimationId or anim.Name
	local existing = perAnim[key]
	if existing then
		return existing
	end
	local loaded = targetAnimator:LoadAnimation(anim)
	perAnim[key] = loaded
	return loaded
end

local result: { string } = {
	"Clip=" .. clip.Name .. " (" .. clip.ClassName .. ")",
	"RegisteredId=" .. clipAssetId,
	"Rig=" .. rig:GetFullName(),
}

if PLAY_NOW then
	local track = getCachedTrack(animator, animObj)
	track.Priority = clip.Priority
	track.Looped = clip.Loop

	local markersFired: { string } = {}
	track:GetMarkerReachedSignal("HitStart"):Connect(function(v)
		table.insert(markersFired, "HitStart:" .. tostring(v))
	end)

	track:Play(0.1)
	task.wait(0.15)
	table.insert(result, string.format("IsPlaying=%s Length=%.3fs Priority=%s Looped=%s",
		tostring(track.IsPlaying), track.Length, tostring(track.Priority), tostring(track.Looped)))
	if #markersFired &gt; 0 then
		table.insert(result, "Markers=" .. table.concat(markersFired, ","))
	end
end

return table.concat(result, " | ")
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_7">
      <Properties>
        <string name="Name">TerrainChunkedBuilder</string>
        <ProtectedString name="Source">--!strict
-- terrain_chunked_builder.luau
-- Production chunked procedural Terrain builder for Roblox Studio &amp; Server scripts.
-- Supports:
--   * 4x4x4 stud grid alignment (:ExpandToGrid(4)) &amp; automatic &lt;= 4,194,304 voxel chunking
--   * fBM + ridged multifractal noise (native math.noise) with compact seed offsets
--   * Smoothstep circular &amp; box flatten plateaus for buildings, spawns, and roads
--   * Custom prompt height layers (crater, river, ridge, terrace, plateau) &amp; material rules
--   * Slope- &amp; altitude-based biome material painting (Alpine, Meadow, Desert, Volcanic, Arctic, Coast)
--   * Modern WriteVoxelChannels (SolidMaterial / SolidMaterialIndex + SolidOccupancy + LiquidOccupancy)
--     with optional WriteVoxels fallback and task.wait() yielding between chunks
--   * Geometric carving/stamping helpers (FillBlock / FillCylinder / FillBall / FillWedge / ReplaceMaterial)

local TerrainBuilder = {}

local VOXEL_SIZE = 4
local MAX_VOXELS_PER_CALL = 4194304
local DEFAULT_CHUNK_CELLS = 64
local OCC_EPSILON = 1 / 256

export type BiomeName = "Alpine" | "Meadow" | "Desert" | "Volcanic" | "Arctic" | "Coast" | "Canyon"

export type FlattenZone = {
	x: number,
	z: number,
	h: number,
	shape: ("Circle" | "Box")?,
	r0: number?,
	r1: number?,
	halfX: number?,
	halfZ: number?,
	blend: number?,
	material: Enum.Material?,
}

export type Vec2Point = {
	x: number,
	z: number,
}

export type HeightLayer = {
	type: string,
	x: number?,
	z: number?,
	x1: number?,
	z1: number?,
	x2: number?,
	z2: number?,
	radius: number?,
	depth: number?,
	height: number?,
	rimHeight: number?,
	rimWidth: number?,
	width: number?,
	stepHeight: number?,
	blend: number?,
	minY: number?,
	maxY: number?,
	waterFill: boolean?,
	waterLevel: number?,
	material: Enum.Material?,
	points: { Vec2Point }?,
}

export type MaterialRule = {
	minY: number?,
	maxY: number?,
	minSlope: number?,
	maxSlope: number?,
	x: number?,
	z: number?,
	minRadius: number?,
	maxRadius: number?,
	material: Enum.Material,
}

export type BiomePalette = {
	low: Enum.Material,
	shore: Enum.Material,
	underwater: Enum.Material,
	mid: Enum.Material,
	cliff: Enum.Material,
	high: Enum.Material,
}

export type BuildConfig = {
	min: Vector3?,
	max: Vector3?,
	center: Vector3?,
	size: Vector3?,
	seed: number?,
	biome: BiomeName?,
	palette: BiomePalette?,
	baseHeight: number?,
	mountainHeight: number?,
	noiseWeight: number?,
	noiseScale: number?,
	octaves: number?,
	lacunarity: number?,
	persistence: number?,
	ridgeWeight: number?,
	waterLevel: number?,
	flattenZones: { FlattenZone }?,
	heightLayers: { HeightLayer }?,
	materialRules: { MaterialRule }?,
	chunkCellsXZ: number?,
	useVoxelChannels: boolean?,
	yieldPerChunk: boolean?,
	solidSlotResolver: ((mat: Enum.Material, wx: number, height: number, slope: number) -&gt; number)?,
}

export type Vec3Coords = {
	X: number,
	Y: number,
	Z: number,
}

export type BuildReport = {
	apiUsed: string,
	regionMin: Vec3Coords,
	regionMax: Vec3Coords,
	cellsSize: Vec3Coords,
	chunksWritten: number,
	voxelsProcessed: number,
	solidVoxelsWritten: number,
	waterVoxelsWritten: number,
	elapsedSeconds: number,
}

TerrainBuilder.BIOME_PALETTES = {
	Alpine = {
		low = Enum.Material.Grass,
		shore = Enum.Material.Sand,
		underwater = Enum.Material.Ground,
		mid = Enum.Material.LeafyGrass,
		cliff = Enum.Material.Rock,
		high = Enum.Material.Snow,
	},
	Meadow = {
		low = Enum.Material.Grass,
		shore = Enum.Material.Sand,
		underwater = Enum.Material.Mud,
		mid = Enum.Material.LeafyGrass,
		cliff = Enum.Material.Rock,
		high = Enum.Material.Grass,
	},
	Desert = {
		low = Enum.Material.Sand,
		shore = Enum.Material.Sand,
		underwater = Enum.Material.Sandstone,
		mid = Enum.Material.Sandstone,
		cliff = Enum.Material.Limestone,
		high = Enum.Material.Rock,
	},
	Volcanic = {
		low = Enum.Material.Basalt,
		shore = Enum.Material.Ground,
		underwater = Enum.Material.Basalt,
		mid = Enum.Material.Slate,
		cliff = Enum.Material.Basalt,
		high = Enum.Material.CrackedLava,
	},
	Arctic = {
		low = Enum.Material.Snow,
		shore = Enum.Material.Ice,
		underwater = Enum.Material.Glacier,
		mid = Enum.Material.Glacier,
		cliff = Enum.Material.Rock,
		high = Enum.Material.Snow,
	},
	Coast = {
		low = Enum.Material.Grass,
		shore = Enum.Material.Sand,
		underwater = Enum.Material.Sand,
		mid = Enum.Material.Grass,
		cliff = Enum.Material.Limestone,
		high = Enum.Material.Rock,
	},
	Canyon = {
		low = Enum.Material.Sandstone,
		shore = Enum.Material.Sand,
		underwater = Enum.Material.Slate,
		mid = Enum.Material.Sandstone,
		cliff = Enum.Material.Limestone,
		high = Enum.Material.Slate,
	},
} :: { [BiomeName]: BiomePalette }

local function orderedMinMax(a: Vector3, b: Vector3): (Vector3, Vector3)
	return Vector3.new(math.min(a.X, b.X), math.min(a.Y, b.Y), math.min(a.Z, b.Z)),
		Vector3.new(math.max(a.X, b.X), math.max(a.Y, b.Y), math.max(a.Z, b.Z))
end

local function smoothstep01(t: number): number
	local c = math.clamp(t, 0, 1)
	return c * c * (3 - 2 * c)
end

local function distPointToSegment2D(px: number, pz: number, ax: number, az: number, bx: number, bz: number): number
	local vx = bx - ax
	local vz = bz - az
	local lenSq = vx * vx + vz * vz
	if lenSq &lt;= 1e-8 then
		return math.sqrt((px - ax) ^ 2 + (pz - az) ^ 2)
	end
	local t = math.clamp(((px - ax) * vx + (pz - az) * vz) / lenSq, 0, 1)
	local cx = ax + vx * t
	local cz = az + vz * t
	return math.sqrt((px - cx) ^ 2 + (pz - cz) ^ 2)
end

local function distToLayerPath2D(wx: number, wz: number, layer: HeightLayer): number?
	local pts = layer.points
	if pts and #pts &gt;= 2 then
		local best = math.huge
		for idx = 1, #pts - 1 do
			local a = pts[idx]
			local b = pts[idx + 1]
			local d = distPointToSegment2D(wx, wz, a.x, a.z, b.x, b.z)
			if d &lt; best then
				best = d
			end
		end
		return best
	elseif pts and #pts == 1 then
		local p = pts[1]
		return math.sqrt((wx - p.x) ^ 2 + (wz - p.z) ^ 2)
	end

	local x1, z1, x2, z2 = layer.x1, layer.z1, layer.x2, layer.z2
	if x1 ~= nil and z1 ~= nil and x2 ~= nil and z2 ~= nil then
		return distPointToSegment2D(wx, wz, x1, z1, x2, z2)
	end

	local lx, lz = layer.x, layer.z
	if lx ~= nil and lz ~= nil then
		return math.sqrt((wx - lx) ^ 2 + (wz - lz) ^ 2)
	end
	return nil
end

function TerrainBuilder.AlignRegionToGrid(minPos: Vector3, maxPos: Vector3): Region3
	local lo, hi = orderedMinMax(minPos, maxPos)
	-- Ensure non-zero extent along every axis before expanding to 4-stud grid
	if hi.X - lo.X &lt; VOXEL_SIZE then
		hi = Vector3.new(lo.X + VOXEL_SIZE, hi.Y, hi.Z)
	end
	if hi.Y - lo.Y &lt; VOXEL_SIZE then
		hi = Vector3.new(hi.X, lo.Y + VOXEL_SIZE, hi.Z)
	end
	if hi.Z - lo.Z &lt; VOXEL_SIZE then
		hi = Vector3.new(hi.X, hi.Y, lo.Z + VOXEL_SIZE)
	end
	return Region3.new(lo, hi):ExpandToGrid(VOXEL_SIZE)
end

function TerrainBuilder.ComputeVoxelCount(region: Region3): number
	local cells = region.Size / VOXEL_SIZE
	return math.round(cells.X) * math.round(cells.Y) * math.round(cells.Z)
end

function TerrainBuilder.ResolveBounds(config: BuildConfig): Region3
	if config.min and config.max then
		return TerrainBuilder.AlignRegionToGrid(config.min, config.max)
	end
	local center = config.center or Vector3.new(0, 64, 0)
	local size = config.size or Vector3.new(256, 128, 256)
	local half = size * 0.5
	return TerrainBuilder.AlignRegionToGrid(center - half, center + half)
end

function TerrainBuilder.ApplyFlattenZones(
	baseHeight: number,
	wx: number,
	wz: number,
	zones: { FlattenZone }?
): (number, Enum.Material?, number)
	if not zones or #zones == 0 then
		return baseHeight, nil, 0
	end
	local h = baseHeight
	local overrideMat: Enum.Material? = nil
	local maxPadWeight = 0

	for _, zone in ipairs(zones) do
		local shape = zone.shape or "Circle"
		local weight = 0
		if shape == "Box" then
			local hx = zone.halfX or zone.r0 or 20
			local hz = zone.halfZ or zone.r0 or 20
			local blend = math.max(zone.blend or ((zone.r1 or (math.max(hx, hz) + 20)) - math.max(hx, hz)), 0.001)
			local dx = math.max(math.abs(wx - zone.x) - hx, 0)
			local dz = math.max(math.abs(wz - zone.z) - hz, 0)
			local outsideDist = math.sqrt(dx * dx + dz * dz)
			if outsideDist &lt;= 0 then
				weight = 1
			elseif outsideDist &lt; blend then
				weight = 1 - smoothstep01(outsideDist / blend)
			end
		else
			local r0 = zone.r0 or 20
			local r1 = math.max(zone.r1 or (r0 * 2), r0 + 0.001)
			local dist = math.sqrt((wx - zone.x) ^ 2 + (wz - zone.z) ^ 2)
			if dist &lt;= r0 then
				weight = 1
			elseif dist &lt; r1 then
				weight = 1 - smoothstep01((dist - r0) / (r1 - r0))
			end
		end

		if weight &gt; 0 then
			h = h + (zone.h - h) * weight
			if zone.material and weight &gt;= 0.75 and weight &gt;= maxPadWeight then
				overrideMat = zone.material
			end
			if weight &gt; maxPadWeight then
				maxPadWeight = weight
			end
		end
	end

	return h, overrideMat, maxPadWeight
end

function TerrainBuilder.ApplyHeightLayers(
	baseHeight: number,
	wx: number,
	wz: number,
	layers: { HeightLayer }?
): (number, Enum.Material?, number?)
	if not layers or #layers == 0 then
		return baseHeight, nil, nil
	end
	local h = baseHeight
	local overrideMat: Enum.Material? = nil
	local overrideWater: number? = nil

	for _, layer in ipairs(layers) do
		local kind = string.lower(layer.type or "")
		if kind == "crater" then
			local cx = layer.x or 0
			local cz = layer.z or 0
			local r = math.max(layer.radius or 40, 1)
			local depth = layer.depth or 24
			local rimH = if layer.rimHeight ~= nil then layer.rimHeight else depth * 0.35
			local rimW = math.max(layer.rimWidth or (r * 0.45), 1)
			local d = math.sqrt((wx - cx) ^ 2 + (wz - cz) ^ 2)
			if d &lt;= r then
				local u = d / r
				local bowl = (1 - u * u) * depth
				local rim = smoothstep01((u - 0.55) / 0.45) * rimH
				h += rim - bowl
				if layer.material and u &lt;= 0.85 then
					overrideMat = layer.material
				end
			elseif d &lt; r + rimW then
				local v = (d - r) / rimW
				h += (1 - smoothstep01(v)) * rimH
			end
		elseif kind == "river" then
			local minDist = distToLayerPath2D(wx, wz, layer)
			if minDist ~= nil then
				local halfW = math.max((layer.width or 16) * 0.5, 1)
				local blend = math.max(layer.blend or (halfW * 0.85), 1)
				local depth = layer.depth or 14
				if minDist &lt; halfW + blend then
					local factor = if minDist &lt;= halfW
						then (1 - 0.25 * (minDist / halfW) ^ 2)
						else (1 - smoothstep01((minDist - halfW) / blend))
					local bankHeight = h
					h -= depth * factor
					local fillWater = if layer.waterFill == nil then true else layer.waterFill
					if fillWater and minDist &lt;= halfW + blend * 0.45 then
						local wl = if layer.waterLevel ~= nil
							then layer.waterLevel
							else (bankHeight - math.min(depth * 0.28, 3.5))
						overrideWater = if overrideWater ~= nil then math.max(overrideWater, wl) else wl
					end
					if layer.material and minDist &lt;= halfW * 0.9 then
						overrideMat = layer.material
					end
				end
			end
		elseif kind == "ridge" then
			local minDist = distToLayerPath2D(wx, wz, layer)
			if minDist ~= nil then
				local halfW = math.max((layer.width or 24) * 0.5, 1)
				local blend = math.max(layer.blend or halfW, 1)
				local ridgeH = layer.height or layer.rimHeight or 32
				local totalW = halfW + blend
				if minDist &lt; totalW then
					local t = math.clamp(minDist / totalW, 0, 1)
					local crest = (1 - smoothstep01(t)) * (1 - 0.35 * t)
					h += ridgeH * crest
					if layer.material and t &lt;= 0.45 then
						overrideMat = layer.material
					end
				end
			end
		elseif kind == "terrace" then
			local stepH = math.max(layer.stepHeight or 8, 1)
			local weight = 1
			local lx, lz = layer.x, layer.z
			if lx ~= nil and lz ~= nil then
				local r = math.max(layer.radius or 80, 1)
				local blend = math.max(layer.blend or (r * 0.35), 1)
				local d = math.sqrt((wx - lx) ^ 2 + (wz - lz) ^ 2)
				if d &gt;= r + blend then
					weight = 0
				elseif d &gt; r then
					weight = 1 - smoothstep01((d - r) / blend)
				end
			end
			if layer.minY ~= nil and h &lt; layer.minY then
				weight = 0
			end
			if layer.maxY ~= nil and h &gt; layer.maxY then
				weight = 0
			end
			if weight &gt; 0 then
				local band = h / stepH
				local fl = math.floor(band)
				local frac = band - fl
				local sharp = 0.35
				local stepFrac = smoothstep01((frac - (0.5 - sharp * 0.5)) / sharp)
				local terraced = (fl + stepFrac) * stepH
				h = h + (terraced - h) * weight
				if layer.material and weight &gt;= 0.75 then
					overrideMat = layer.material
				end
			end
		elseif kind == "plateau" then
			local cx = layer.x or 0
			local cz = layer.z or 0
			local r = math.max(layer.radius or 40, 1)
			local targetH = layer.height or 96
			local blend = math.max(layer.blend or (r * 0.5), 1)
			local d = math.sqrt((wx - cx) ^ 2 + (wz - cz) ^ 2)
			local weight = 0
			if d &lt;= r then
				weight = 1
			elseif d &lt; r + blend then
				weight = 1 - smoothstep01((d - r) / blend)
			end
			if weight &gt; 0 then
				h = h + (targetH - h) * weight
				if layer.material and weight &gt;= 0.75 then
					overrideMat = layer.material
				end
			end
		end
	end

	return h, overrideMat, overrideWater
end

function TerrainBuilder.ResolveMaterialRules(
	wx: number,
	wz: number,
	height: number,
	slope: number,
	rules: { MaterialRule }?
): Enum.Material?
	if not rules or #rules == 0 then
		return nil
	end
	for _, rule in ipairs(rules) do
		local minY = rule.minY
		local maxY = rule.maxY
		local minSlope = rule.minSlope
		local maxSlope = rule.maxSlope
		local minRadius = rule.minRadius
		local maxRadius = rule.maxRadius

		local ok = true
		if minY ~= nil and height &lt; minY then
			ok = false
		elseif maxY ~= nil and height &gt; maxY then
			ok = false
		elseif minSlope ~= nil and slope &lt; minSlope then
			ok = false
		elseif maxSlope ~= nil and slope &gt; maxSlope then
			ok = false
		elseif minRadius ~= nil or maxRadius ~= nil then
			local rx = rule.x or 0
			local rz = rule.z or 0
			local d = math.sqrt((wx - rx) ^ 2 + (wz - rz) ^ 2)
			if minRadius ~= nil and d &lt; minRadius then
				ok = false
			end
			if maxRadius ~= nil and d &gt; maxRadius then
				ok = false
			end
		end
		if ok then
			return rule.material
		end
	end
	return nil
end

function TerrainBuilder.SampleHeightFbm(wx: number, wz: number, config: BuildConfig): (number, Enum.Material?, number?)
	local seed = config.seed or 42
	-- Keep offsets well under 10k so math.noise retains full floating-point precision
	local sx = ((seed * 73) % 9973) * 0.137
	local sy = ((seed * 199) % 7919) * 0.071
	local sz = ((seed * 313) % 9967) * 0.193

	local baseHeight = config.baseHeight or 56
	local mountainHeight = config.mountainHeight or 84
	local noiseWeight = if config.noiseWeight == nil then 1.0 else config.noiseWeight
	local scale = config.noiseScale or (1 / 140)
	local octaves = math.clamp(config.octaves or 4, 1, 8)
	local lacunarity = config.lacunarity or 2.05
	local persistence = config.persistence or 0.48
	local ridgeWeight = math.clamp(config.ridgeWeight or 0.45, 0, 1)

	local freq = scale
	local amp = 1.0
	local ampSum = 0.0
	local fbmSum = 0.0
	local ridgeSum = 0.0
	local ridgeFactor = 1.0

	for oct = 1, octaves do
		local n = math.noise(wx * freq + sx + oct * 19.3, sy + oct * 7.1, wz * freq + sz - oct * 11.7)
		fbmSum += n * amp

		local ridgeSignal = 1.0 - math.abs(n)
		ridgeSignal = ridgeSignal * ridgeSignal * ridgeFactor
		ridgeFactor = math.clamp(ridgeSignal * 1.4, 0.25, 1.0)
		ridgeSum += ridgeSignal * amp

		ampSum += amp
		amp *= persistence
		freq *= lacunarity
	end

	local fbmNorm = (fbmSum / math.max(ampSum, 1e-6)) * 0.5 + 0.5 -- [0..1] centered ~0.5
	local ridgeNorm = math.clamp(ridgeSum / math.max(ampSum, 1e-6), 0, 1)
	local combined = fbmNorm * (1 - ridgeWeight) + ridgeNorm * ridgeWeight

	-- Shift around baseHeight so valleys can dip below baseHeight while peaks climb cleanly
	local rawHeight = baseHeight + (combined - 0.35) * mountainHeight * noiseWeight
	local layeredHeight, layerMat, layerWater = TerrainBuilder.ApplyHeightLayers(rawHeight, wx, wz, config.heightLayers)
	local finalHeight, padMat, _ = TerrainBuilder.ApplyFlattenZones(layeredHeight, wx, wz, config.flattenZones)
	return finalHeight, (padMat or layerMat), layerWater
end

function TerrainBuilder.ResolveSlopeMaterial(
	height: number,
	slope: number,
	padMat: Enum.Material?,
	config: BuildConfig,
	wx: number?,
	wz: number?,
	waterLevelOverride: number?
): Enum.Material
	if padMat then
		return padMat
	end
	if config.materialRules then
		local ruleMat = TerrainBuilder.ResolveMaterialRules(wx or 0, wz or 0, height, slope, config.materialRules)
		if ruleMat then
			return ruleMat
		end
	end
	local biome: BiomeName = config.biome or "Alpine"
	local palette = config.palette or TerrainBuilder.BIOME_PALETTES[biome] or TerrainBuilder.BIOME_PALETTES.Alpine
	local baseHeight = config.baseHeight or 56
	local mountainHeight = config.mountainHeight or 84
	local waterLevel = if waterLevelOverride ~= nil then waterLevelOverride else config.waterLevel

	if waterLevel and height &lt;= waterLevel - 3 then
		return palette.underwater
	end
	if waterLevel and height &lt;= waterLevel + 3.5 then
		return palette.shore
	end
	if slope &gt; 0.62 then
		return palette.cliff
	end
	if height &gt; baseHeight + mountainHeight * 0.52 then
		return palette.high
	end
	if height &gt; baseHeight + mountainHeight * 0.25 or slope &gt; 0.35 then
		return palette.mid
	end
	return palette.low
end

function TerrainBuilder.BuildRegion(config: BuildConfig): BuildReport
	local t0 = os.clock()
	local terrain = workspace.Terrain
	local region = TerrainBuilder.ResolveBounds(config)
	local regionMin = region.CFrame.Position - region.Size * 0.5
	local regionMax = region.CFrame.Position + region.Size * 0.5
	local totalCells = region.Size / VOXEL_SIZE
	local cellsX = math.round(totalCells.X)
	local cellsY = math.round(totalCells.Y)
	local cellsZ = math.round(totalCells.Z)

	local chunkXZ = math.clamp(config.chunkCellsXZ or DEFAULT_CHUNK_CELLS, 4, 128)
	local maxCellsYPerChunk = math.max(1, math.floor(MAX_VOXELS_PER_CALL / (chunkXZ * chunkXZ)))
	local chunkY = math.min(cellsY, maxCellsYPerChunk)

	local useChannels = if config.useVoxelChannels == nil then true else config.useVoxelChannels
	local shouldYield = if config.yieldPerChunk == nil then true else config.yieldPerChunk
	local waterLevel = config.waterLevel
	local slotResolver = config.solidSlotResolver

	local chunksWritten = 0
	local voxelsProcessed = 0
	local solidVoxelsWritten = 0
	local waterVoxelsWritten = 0
	local apiUsed = if useChannels then "WriteVoxelChannels" else "WriteVoxels"

	for bx = 0, cellsX - 1, chunkXZ do
		local sx = math.min(chunkXZ, cellsX - bx)
		for bz = 0, cellsZ - 1, chunkXZ do
			local sz = math.min(chunkXZ, cellsZ - bz)

			-- Precompute height, slope, and surface material once per (x, z) column
			local colH: { { number } } = table.create(sx)
			local colMat: { { Enum.Material } } = table.create(sx)
			local colSlope: { { number } } = table.create(sx)
			local colWater: { { number? } } = table.create(sx)
			for ix = 1, sx do
				colH[ix] = table.create(sz)
				colMat[ix] = table.create(sz)
				colSlope[ix] = table.create(sz)
				colWater[ix] = table.create(sz)
				local wx = regionMin.X + (bx + ix - 0.5) * VOXEL_SIZE
				for iz = 1, sz do
					local wz = regionMin.Z + (bz + iz - 0.5) * VOXEL_SIZE
					local h, padMat, localWater = TerrainBuilder.SampleHeightFbm(wx, wz, config)
					local hx, _ = TerrainBuilder.SampleHeightFbm(wx + VOXEL_SIZE, wz, config)
					local hz, _ = TerrainBuilder.SampleHeightFbm(wx, wz + VOXEL_SIZE, config)
					local slope = math.max(math.abs(hx - h), math.abs(hz - h)) / VOXEL_SIZE
					local effWater = if localWater ~= nil then localWater else waterLevel
					colH[ix][iz] = h
					colSlope[ix][iz] = slope
					colWater[ix][iz] = effWater
					colMat[ix][iz] = TerrainBuilder.ResolveSlopeMaterial(h, slope, padMat, config, wx, wz, effWater)
				end
			end

			for by = 0, cellsY - 1, chunkY do
				local sy = math.min(chunkY, cellsY - by)
				local chunkMin = Vector3.new(
					regionMin.X + bx * VOXEL_SIZE,
					regionMin.Y + by * VOXEL_SIZE,
					regionMin.Z + bz * VOXEL_SIZE
				)
				local chunkMax = chunkMin + Vector3.new(sx * VOXEL_SIZE, sy * VOXEL_SIZE, sz * VOXEL_SIZE)
				local chunkRegion = Region3.new(chunkMin, chunkMax):ExpandToGrid(VOXEL_SIZE)

				if useChannels then
					local solidOcc = table.create(sx)
					local liquidOcc = table.create(sx)
					local solidMat = if slotResolver == nil then table.create(sx) else nil
					local solidIdx = if slotResolver ~= nil then table.create(sx) else nil

					for ix = 1, sx do
						local wx = regionMin.X + (bx + ix - 0.5) * VOXEL_SIZE
						solidOcc[ix] = table.create(sy)
						liquidOcc[ix] = table.create(sy)
						if solidMat then
							solidMat[ix] = table.create(sy)
						end
						if solidIdx then
							solidIdx[ix] = table.create(sy)
						end

						for iy = 1, sy do
							local wy = regionMin.Y + (by + iy - 0.5) * VOXEL_SIZE
							local cellBottom = wy - (VOXEL_SIZE * 0.5)
							solidOcc[ix][iy] = table.create(sz)
							liquidOcc[ix][iy] = table.create(sz)
							if solidMat then
								solidMat[ix][iy] = table.create(sz)
							end
							if solidIdx then
								solidIdx[ix][iy] = table.create(sz)
							end

							for iz = 1, sz do
								local h = colH[ix][iz]
								local colWL = colWater[ix][iz]
								local sOcc = math.clamp((h - cellBottom) / VOXEL_SIZE, 0, 1)
								local lOcc = 0
								local mat = colMat[ix][iz]

								if sOcc &lt;= OCC_EPSILON then
									sOcc = 0
									mat = Enum.Material.Air
								else
									solidVoxelsWritten += 1
								end

								if colWL and cellBottom &lt; colWL and sOcc &lt;= (1 - OCC_EPSILON) then
									lOcc = math.clamp((colWL - cellBottom) / VOXEL_SIZE, 0, 1)
									if lOcc &lt;= OCC_EPSILON then
										lOcc = 0
									else
										waterVoxelsWritten += 1
									end
								end

								solidOcc[ix][iy][iz] = sOcc
								liquidOcc[ix][iy][iz] = lOcc
								if solidMat then
									-- Water is invalid in SolidMaterial; only solid/Air materials belong here
									solidMat[ix][iy][iz] = mat
								elseif solidIdx and slotResolver then
									if mat == Enum.Material.Air then
										solidIdx[ix][iy][iz] = 0
									else
										solidIdx[ix][iy][iz] = slotResolver(mat, wx, h, colSlope[ix][iz])
									end
								end
							end
						end
					end

					local payload: { [string]: any } = {
						SolidOccupancy = solidOcc,
						LiquidOccupancy = liquidOcc,
					}
					if solidIdx then
						payload.SolidMaterialIndex = solidIdx
					else
						payload.SolidMaterial = solidMat
					end

					local ok, err = pcall(function()
						terrain:WriteVoxelChannels(chunkRegion, VOXEL_SIZE, payload)
					end)
					if not ok then
						error(string.format("WriteVoxelChannels failed on chunk (%d,%d,%d): %s", bx, by, bz, tostring(err)))
					end
				else
					local materials = table.create(sx)
					local occupancies = table.create(sx)
					for ix = 1, sx do
						materials[ix] = table.create(sy)
						occupancies[ix] = table.create(sy)
						for iy = 1, sy do
							local wy = regionMin.Y + (by + iy - 0.5) * VOXEL_SIZE
							local cellBottom = wy - (VOXEL_SIZE * 0.5)
							materials[ix][iy] = table.create(sz)
							occupancies[ix][iy] = table.create(sz)
							for iz = 1, sz do
								local h = colH[ix][iz]
								local colWL = colWater[ix][iz]
								local occ = math.clamp((h - cellBottom) / VOXEL_SIZE, 0, 1)
								if occ &lt;= OCC_EPSILON then
									if colWL and cellBottom &lt; colWL then
										materials[ix][iy][iz] = Enum.Material.Water
										occupancies[ix][iy][iz] = math.clamp((colWL - cellBottom) / VOXEL_SIZE, 0, 1)
										waterVoxelsWritten += 1
									else
										materials[ix][iy][iz] = Enum.Material.Air
										occupancies[ix][iy][iz] = 0
									end
								else
									materials[ix][iy][iz] = colMat[ix][iz]
									occupancies[ix][iy][iz] = occ
									solidVoxelsWritten += 1
								end
							end
						end
					end
					terrain:WriteVoxels(chunkRegion, VOXEL_SIZE, materials, occupancies)
				end

				chunksWritten += 1
				voxelsProcessed += sx * sy * sz
				if shouldYield then
					task.wait()
				end
			end
		end
	end

	return {
		apiUsed = apiUsed,
		regionMin = { X = regionMin.X, Y = regionMin.Y, Z = regionMin.Z },
		regionMax = { X = regionMax.X, Y = regionMax.Y, Z = regionMax.Z },
		cellsSize = { X = cellsX, Y = cellsY, Z = cellsZ },
		chunksWritten = chunksWritten,
		voxelsProcessed = voxelsProcessed,
		solidVoxelsWritten = solidVoxelsWritten,
		waterVoxelsWritten = waterVoxelsWritten,
		elapsedSeconds = os.clock() - t0,
	}
end

function TerrainBuilder.StampBuildingPad(
	center: Vector3,
	size: Vector3,
	padMaterial: Enum.Material?,
	clearHeadroomStuds: number?
): ()
	local terrain = workspace.Terrain
	local mat = padMaterial or Enum.Material.Cobblestone
	local headroom = clearHeadroomStuds or 32
	local padCFrame = CFrame.new(center)
	terrain:FillBlock(padCFrame, size, mat)
	if headroom &gt; 0 then
		local airCenter = center + Vector3.new(0, size.Y * 0.5 + headroom * 0.5, 0)
		terrain:FillBlock(CFrame.new(airCenter), Vector3.new(size.X, headroom, size.Z), Enum.Material.Air)
	end
end

function TerrainBuilder.ClearRegion(minPos: Vector3, maxPos: Vector3): Region3
	local region = TerrainBuilder.AlignRegionToGrid(minPos, maxPos)
	workspace.Terrain:FillRegion(region, VOXEL_SIZE, Enum.Material.Air)
	return region
end

return TerrainBuilder
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_8">
      <Properties>
        <string name="Name">AtmospherePresets</string>
        <ProtectedString name="Source">--!strict
--[[
	AtmospherePresets
	Curated Roblox Lighting, Atmosphere, Clouds, Sky, GlobalWind, Terrain Water/Grass,
	and PostEffect presets with non-destructive snapshot/restore support.

	Verified engine guardrails:
	- NEVER writes Lighting.Technology (RobloxScriptSecurity + deprecated). Uses
	  Lighting.LightingStyle + Lighting.PrioritizeLightingQuality instead.
	- ALWAYS parents Clouds under Workspace.Terrain (Clouds elsewhere never renders).
	- ALWAYS parents ColorGradingEffect under Lighting (ignored under Camera/elsewhere).
	- Ensures Atmosphere.Haze &gt; 0 whenever Glare &gt; 0 (Decay also requires Haze &gt; 0 and Glare &gt; 0).
]]

local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

export type PresetName =
	"DaylightMeadow"
	| "GoldenSunset"
	| "GoldenHour"
	| "StormyCoast"
	| "MoonlitNight"
	| "VolcanicAsh"
	| "ClearMedDay"
	| "MistyDawn"
	| "OvercastStorm"
	| "CyberpunkNight"
	| "DesertHeat"
	| "HorrorFog"

export type LightingSpec = {
	ClockTime: number,
	GeographicLatitude: number,
	Brightness: number,
	Ambient: Color3,
	OutdoorAmbient: Color3,
	ColorShift_Bottom: Color3,
	ColorShift_Top: Color3,
	EnvironmentDiffuseScale: number,
	EnvironmentSpecularScale: number,
	ExposureCompensation: number,
	GlobalShadows: boolean,
	ShadowSoftness: number,
	LightingStyle: Enum.LightingStyle?,
	PrioritizeLightingQuality: boolean?,
}

export type AtmosphereSpec = {
	Density: number,
	Offset: number,
	Color: Color3,
	Decay: Color3,
	Glare: number,
	Haze: number,
}

export type CloudsSpec = {
	Enabled: boolean,
	Cover: number,
	Density: number,
	Color: Color3,
}

export type SkySpec = {
	CelestialBodiesShown: boolean,
	StarCount: number,
	SunAngularSize: number,
	MoonAngularSize: number,
	SkyboxOrientation: Vector3?,
}

export type WaterSpec = {
	WaterColor: Color3,
	WaterTransparency: number,
	WaterReflectance: number,
	WaterWaveSize: number,
	WaterWaveSpeed: number,
}

export type GrassSpec = {
	Decoration: boolean,
	GrassLength: number,
}

export type BloomSpec = {
	Enabled: boolean,
	Intensity: number,
	Size: number,
	Threshold: number,
}

export type ColorCorrectionSpec = {
	Enabled: boolean,
	Brightness: number,
	Contrast: number,
	Saturation: number,
	TintColor: Color3,
}

export type ColorGradingSpec = {
	Enabled: boolean,
	TonemapperPreset: Enum.TonemapperPreset,
}

export type SunRaysSpec = {
	Enabled: boolean,
	Intensity: number,
	Spread: number,
}

export type DepthOfFieldSpec = {
	Enabled: boolean,
	FarIntensity: number,
	FocusDistance: number,
	InFocusRadius: number,
	NearIntensity: number,
}

export type PostEffectsSpec = {
	Bloom: BloomSpec?,
	ColorCorrection: ColorCorrectionSpec?,
	ColorGrading: ColorGradingSpec?,
	SunRays: SunRaysSpec?,
	DepthOfField: DepthOfFieldSpec?,
}

export type PresetSpec = {
	Name: string,
	Description: string,
	Lighting: LightingSpec,
	Atmosphere: AtmosphereSpec,
	Clouds: CloudsSpec,
	Sky: SkySpec,
	GlobalWind: Vector3,
	Water: WaterSpec,
	Grass: GrassSpec,
	PostEffects: PostEffectsSpec,
}

export type ApplyOptions = {
	ApplyWater: boolean?,
	ApplyGrass: boolean?,
	ApplyWind: boolean?,
	ApplyPostEffects: boolean?,
	CleanLegacyFog: boolean?,
}

export type ApplyReport = {
	PresetName: string,
	Warnings: { string },
	CreatedInstances: { string },
	UpdatedInstances: { string },
}

type SnapshotRecord = {
	Instance: Instance?,
	Existed: boolean,
	Parent: Instance?,
	Properties: { [string]: any },
}

export type EnvironmentSnapshot = {
	LightingProps: { [string]: any },
	GlobalWind: Vector3,
	TerrainProps: { [string]: any },
	Atmosphere: SnapshotRecord,
	Sky: SnapshotRecord,
	Clouds: SnapshotRecord,
	PostEffects: { [string]: SnapshotRecord },
	CreatedByPreset: { Instance },
}

local AtmospherePresets = {}

local PRESETS: { [PresetName]: PresetSpec } = {
