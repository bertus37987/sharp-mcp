PRESETS.GoldenHour = PRESETS.GoldenSunset

AtmospherePresets.Presets = PRESETS

local function safeSet(instance: Instance, prop: string, value: any, warnings: { string }?)
	local ok, err = pcall(function()
		(instance :: any)[prop] = value
	end)
	if not ok and warnings then
		table.insert(warnings, string.format("Failed setting %s.%s: %s", instance.Name, prop, tostring(err)))
	end
end

local function safeGet(instance: Instance, prop: string): (boolean, any)
	return pcall(function()
		return (instance :: any)[prop]
	end)
end

local function captureProperties(instance: Instance, propNames: { string }): { [string]: any }
	local out: { [string]: any } = {}
	for _, prop in ipairs(propNames) do
		local ok, val = safeGet(instance, prop)
		if ok then
			out[prop] = val
		end
	end
	return out
end

local function getOrCreateChild(
	parent: Instance,
	className: string,
	defaultName: string,
	report: ApplyReport?
): Instance
	local existing = parent:FindFirstChildOfClass(className)
	if existing then
		if report then
			table.insert(report.UpdatedInstances, existing:GetFullName())
		end
		return existing
	end
	local created = Instance.new(className)
	created.Name = defaultName
	created.Parent = parent
	if report then
		table.insert(report.CreatedInstances, created:GetFullName())
	end
	return created
end

local function captureInstanceSnapshot(parent: Instance, className: string, propNames: { string }): SnapshotRecord
	local inst = parent:FindFirstChildOfClass(className)
	if inst then
		return {
			Instance = inst,
			Existed = true,
			Parent = inst.Parent,
			Properties = captureProperties(inst, propNames),
		}
	end
	return {
		Instance = nil,
		Existed = false,
		Parent = nil,
		Properties = {},
	}
end

function AtmospherePresets.GetPresetNames(): { PresetName }
	local names: { PresetName } = {}
	for k in pairs(PRESETS) do
		table.insert(names, k :: PresetName)
	end
	table.sort(names)
	return names
end

function AtmospherePresets.SnapshotEnvironment(): EnvironmentSnapshot
	local terrain = Workspace.Terrain
	local snapshot: EnvironmentSnapshot = {
		LightingProps = captureProperties(Lighting, {
			"ClockTime",
			"GeographicLatitude",
			"Brightness",
			"Ambient",
			"OutdoorAmbient",
			"ColorShift_Bottom",
			"ColorShift_Top",
			"EnvironmentDiffuseScale",
			"EnvironmentSpecularScale",
			"ExposureCompensation",
			"GlobalShadows",
			"ShadowSoftness",
			"LightingStyle",
			"PrioritizeLightingQuality",
			"FogStart",
			"FogEnd",
			"FogColor",
		}),
		GlobalWind = Workspace.GlobalWind,
		TerrainProps = captureProperties(terrain, {
			"WaterColor",
			"WaterTransparency",
			"WaterReflectance",
			"WaterWaveSize",
			"WaterWaveSpeed",
			"Decoration",
			"GrassLength",
		}),
		Atmosphere = captureInstanceSnapshot(
			Lighting,
			"Atmosphere",
			{ "Density", "Offset", "Color", "Decay", "Glare", "Haze" }
		),
		Sky = captureInstanceSnapshot(
			Lighting,
			"Sky",
			{ "CelestialBodiesShown", "StarCount", "SunAngularSize", "MoonAngularSize", "SkyboxOrientation" }
		),
		Clouds = captureInstanceSnapshot(terrain, "Clouds", { "Enabled", "Cover", "Density", "Color" }),
		PostEffects = {
			BloomEffect = captureInstanceSnapshot(
				Lighting,
				"BloomEffect",
				{ "Enabled", "Intensity", "Size", "Threshold" }
			),
			ColorCorrectionEffect = captureInstanceSnapshot(
				Lighting,
				"ColorCorrectionEffect",
				{ "Enabled", "Brightness", "Contrast", "Saturation", "TintColor" }
			),
			ColorGradingEffect = captureInstanceSnapshot(
				Lighting,
				"ColorGradingEffect",
				{ "Enabled", "TonemapperPreset" }
			),
			SunRaysEffect = captureInstanceSnapshot(Lighting, "SunRaysEffect", { "Enabled", "Intensity", "Spread" }),
			DepthOfFieldEffect = captureInstanceSnapshot(
				Lighting,
				"DepthOfFieldEffect",
				{ "Enabled", "FarIntensity", "FocusDistance", "InFocusRadius", "NearIntensity" }
			),
		},
		CreatedByPreset = {},
	}
	return snapshot
end

function AtmospherePresets.RestoreEnvironment(snapshot: EnvironmentSnapshot)
	local terrain = Workspace.Terrain

	for prop, val in pairs(snapshot.LightingProps) do
		safeSet(Lighting, prop, val, nil)
	end
	Workspace.GlobalWind = snapshot.GlobalWind
	for prop, val in pairs(snapshot.TerrainProps) do
		safeSet(terrain, prop, val, nil)
	end

	local function restoreRecord(record: SnapshotRecord, parentFallback: Instance, className: string)
		if record.Existed and record.Instance then
			record.Instance.Parent = record.Parent or parentFallback
			for prop, val in pairs(record.Properties) do
				safeSet(record.Instance, prop, val, nil)
			end
		elseif not record.Existed then
			local leftover = parentFallback:FindFirstChildOfClass(className)
			if leftover then
				leftover:Destroy()
			end
		end
	end

	restoreRecord(snapshot.Atmosphere, Lighting, "Atmosphere")
	restoreRecord(snapshot.Sky, Lighting, "Sky")
	restoreRecord(snapshot.Clouds, terrain, "Clouds")

	for className, rec in pairs(snapshot.PostEffects) do
		restoreRecord(rec, Lighting, className)
	end

	for _, created in ipairs(snapshot.CreatedByPreset) do
		if created and created.Parent then
			created:Destroy()
		end
	end
end

function AtmospherePresets.ApplyPreset(nameOrSpec: PresetName | PresetSpec, options: ApplyOptions?): ApplyReport
	local spec: PresetSpec
	if type(nameOrSpec) == "string" then
		local found = PRESETS[nameOrSpec :: PresetName]
		assert(found ~= nil, string.format("Unknown preset '%s'", tostring(nameOrSpec)))
		spec = found
	else
		spec = nameOrSpec :: PresetSpec
	end

	local opts: ApplyOptions = options or {}
	local applyWater = if opts.ApplyWater == nil then true else opts.ApplyWater
	local applyGrass = if opts.ApplyGrass == nil then true else opts.ApplyGrass
	local applyWind = if opts.ApplyWind == nil then true else opts.ApplyWind
	local applyPost = if opts.ApplyPostEffects == nil then true else opts.ApplyPostEffects
	local cleanLegacyFog = if opts.CleanLegacyFog == nil then true else opts.CleanLegacyFog

	local report: ApplyReport = {
		PresetName = spec.Name,
		Warnings = {},
		CreatedInstances = {},
		UpdatedInstances = {},
	}

	-- 1. Lighting (NEVER write Lighting.Technology: RobloxScriptSecurity + deprecated)
	local lSpec = spec.Lighting
	Lighting.ClockTime = lSpec.ClockTime
	Lighting.GeographicLatitude = lSpec.GeographicLatitude
	Lighting.Brightness = lSpec.Brightness
	Lighting.Ambient = lSpec.Ambient
	Lighting.OutdoorAmbient = lSpec.OutdoorAmbient
	Lighting.ColorShift_Bottom = lSpec.ColorShift_Bottom
	Lighting.ColorShift_Top = lSpec.ColorShift_Top
	Lighting.EnvironmentDiffuseScale = lSpec.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = lSpec.EnvironmentSpecularScale
	Lighting.ExposureCompensation = lSpec.ExposureCompensation
	Lighting.GlobalShadows = lSpec.GlobalShadows
	Lighting.ShadowSoftness = lSpec.ShadowSoftness
	if lSpec.LightingStyle ~= nil then
		safeSet(Lighting, "LightingStyle", lSpec.LightingStyle, report.Warnings)
	end
	if lSpec.PrioritizeLightingQuality ~= nil then
		safeSet(Lighting, "PrioritizeLightingQuality", lSpec.PrioritizeLightingQuality, report.Warnings)
	end
	if cleanLegacyFog then
		-- Atmosphere automatically suppresses legacy Fog*; push FogEnd high for fallback cleanliness.
		if Lighting.FogEnd &lt; 10000 then
			Lighting.FogEnd = 100000
		end
	end

	-- 2. Atmosphere under Lighting (enforce Haze &gt; 0 when Glare &gt; 0)
	local atmo = getOrCreateChild(Lighting, "Atmosphere", "Atmosphere", report) :: Atmosphere
	local haze = math.clamp(spec.Atmosphere.Haze, 0, 10)
	local glare = math.clamp(spec.Atmosphere.Glare, 0, 10)
	if glare &gt; 0 and haze &lt;= 0 then
		haze = 0.25
		table.insert(report.Warnings, "Atmosphere.Glare &gt; 0 requires Haze &gt; 0; clamped Haze to 0.25.")
	end
	atmo.Density = math.clamp(spec.Atmosphere.Density, 0, 1)
	atmo.Offset = math.clamp(spec.Atmosphere.Offset, 0, 1)
	atmo.Color = spec.Atmosphere.Color
	atmo.Decay = spec.Atmosphere.Decay
	atmo.Glare = glare
	atmo.Haze = haze

	-- 3. Clouds MUST be parented under Workspace.Terrain to render
	local terrain = Workspace.Terrain
	local misplacedClouds = Lighting:FindFirstChildOfClass("Clouds")
	if misplacedClouds then
		table.insert(
			report.Warnings,
			"Found Clouds under Lighting (invisible); Roblox only renders Clouds under Workspace.Terrain."
		)
	end
	local clouds = getOrCreateChild(terrain, "Clouds", "Clouds", report) :: Clouds
	clouds.Enabled = spec.Clouds.Enabled
	clouds.Cover = math.clamp(spec.Clouds.Cover, 0, 1)
	clouds.Density = math.clamp(spec.Clouds.Density, 0, 1)
	clouds.Color = spec.Clouds.Color

	-- 4. Sky under Lighting
	local sky = getOrCreateChild(Lighting, "Sky", "Sky", report) :: Sky
	sky.CelestialBodiesShown = spec.Sky.CelestialBodiesShown
	sky.StarCount = math.clamp(spec.Sky.StarCount, 0, 5000)
	sky.SunAngularSize = math.clamp(spec.Sky.SunAngularSize, 0, 60)
	sky.MoonAngularSize = math.clamp(spec.Sky.MoonAngularSize, 0, 60)
	if spec.Sky.SkyboxOrientation ~= nil then
		safeSet(sky, "SkyboxOrientation", spec.Sky.SkyboxOrientation, report.Warnings)
	end

	-- 5. GlobalWind &amp; Terrain Water / Grass
	if applyWind then
		Workspace.GlobalWind = spec.GlobalWind
	end
	if applyWater then
		terrain.WaterColor = spec.Water.WaterColor
		terrain.WaterTransparency = math.clamp(spec.Water.WaterTransparency, 0, 1)
		terrain.WaterReflectance = math.clamp(spec.Water.WaterReflectance, 0, 1)
		terrain.WaterWaveSize = math.clamp(spec.Water.WaterWaveSize, 0, 1)
		terrain.WaterWaveSpeed = math.clamp(spec.Water.WaterWaveSpeed, 0, 100)
	end
	if applyGrass then
		safeSet(terrain, "Decoration", spec.Grass.Decoration, report.Warnings)
		safeSet(terrain, "GrassLength", math.clamp(spec.Grass.GrassLength, 0.1, 1.0), report.Warnings)
	end

	-- 6. PostEffects under Lighting (ColorGradingEffect ONLY works under Lighting)
	if applyPost then
		local pfx = spec.PostEffects
		if pfx.Bloom then
			local bloom = getOrCreateChild(Lighting, "BloomEffect", "Bloom", report) :: BloomEffect
			bloom.Enabled = pfx.Bloom.Enabled
			bloom.Intensity = pfx.Bloom.Intensity
			bloom.Size = pfx.Bloom.Size
			bloom.Threshold = pfx.Bloom.Threshold
		end
		if pfx.ColorCorrection then
			local cc = getOrCreateChild(Lighting, "ColorCorrectionEffect", "ColorCorrection", report) :: ColorCorrectionEffect
			cc.Enabled = pfx.ColorCorrection.Enabled
			cc.Brightness = pfx.ColorCorrection.Brightness
			cc.Contrast = pfx.ColorCorrection.Contrast
			cc.Saturation = pfx.ColorCorrection.Saturation
			cc.TintColor = pfx.ColorCorrection.TintColor
		end
		if pfx.ColorGrading then
			local cg = getOrCreateChild(Lighting, "ColorGradingEffect", "ColorGrading", report) :: ColorGradingEffect
			cg.Enabled = pfx.ColorGrading.Enabled
			safeSet(cg, "TonemapperPreset", pfx.ColorGrading.TonemapperPreset, report.Warnings)
		end
		if pfx.SunRays then
			local sr = getOrCreateChild(Lighting, "SunRaysEffect", "SunRays", report) :: SunRaysEffect
			sr.Enabled = pfx.SunRays.Enabled
			sr.Intensity = pfx.SunRays.Intensity
			sr.Spread = math.clamp(pfx.SunRays.Spread, 0, 1)
		end
		if pfx.DepthOfField then
			local dof = getOrCreateChild(Lighting, "DepthOfFieldEffect", "DepthOfField", report) :: DepthOfFieldEffect
			dof.Enabled = pfx.DepthOfField.Enabled
			dof.FarIntensity = pfx.DepthOfField.FarIntensity
			dof.FocusDistance = pfx.DepthOfField.FocusDistance
			dof.InFocusRadius = pfx.DepthOfField.InFocusRadius
			dof.NearIntensity = pfx.DepthOfField.NearIntensity
		end
	end

	return report
end

--[[
	Cycles Workspace.GlobalWind periodically between baseWind and (baseWind + gustVector)
	with smooth TweenService transitions. Returns a stop callback that halts the loop
	and restores baseWind.
]]
function AtmospherePresets.StartWindGustLoop(
	baseWind: Vector3,
	gustVector: Vector3,
	cycleDelay: number?,
	cycleDuration: number?
): () -&gt; ()
	local delaySec = math.max(1, cycleDelay or 8)
	local durSec = math.max(0.5, cycleDuration or 3.5)
	local stopped = false
	local activeTween: Tween? = nil

	Workspace.GlobalWind = baseWind
	local gustTweenInfo = TweenInfo.new(durSec * 0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	local settleTweenInfo = TweenInfo.new(durSec * 0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

	task.spawn(function()
		while not stopped do
			task.wait(delaySec)
			if stopped then
				break
			end
			local peakTween = TweenService:Create(Workspace, gustTweenInfo, {
				GlobalWind = baseWind + gustVector,
			})
			activeTween = peakTween
			peakTween:Play()
			peakTween.Completed:Wait()

			if stopped then
				break
			end
			local calmTween = TweenService:Create(Workspace, settleTweenInfo, {
				GlobalWind = baseWind,
			})
			activeTween = calmTween
			calmTween:Play()
			calmTween.Completed:Wait()
		end
	end)

	return function()
		stopped = true
		if activeTween then
			activeTween:Cancel()
			activeTween = nil
		end
		Workspace.GlobalWind = baseWind
	end
end

return AtmospherePresets
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_9">
      <Properties>
        <string name="Name">AuditEnvironment</string>
        <ProtectedString name="Source">--!strict
--[[
	audit_environment.luau
	Non-destructive Roblox Terrain, Lighting, Atmosphere, Sky, Clouds, GlobalWind,
	MaterialService, PostEffect, and Streaming diagnostic.

	Safe across Studio Command Bar, MCP execute_luau, and runtime scripts:
	- Wraps RobloxScriptSecurity / PluginSecurity / PluginOrOpenCloud reads
	  (Lighting.Technology, MaterialService.Use2022Materials, Streaming radii) in pcall.
	- Returns HttpService:JSONEncode(report) with structured passes, warnings,
	  errors, and environment metrics.
]]

local HttpService = game:GetService("HttpService")
local Lighting = game:GetService("Lighting")
local MaterialService = game:GetService("MaterialService")
local Workspace = game:GetService("Workspace")

type AuditReport = {
	status: string,
	passCount: number,
	warningCount: number,
	errorCount: number,
	passes: { string },
	warnings: { string },
	errors: { string },
	metrics: { [string]: any },
}

local function safeReadProp(inst: Instance, prop: string): (boolean, any)
	return pcall(function()
		return (inst :: any)[prop]
	end)
end

local function serializeColor3(c: Color3): { number }
	return {
		math.floor(c.R * 255 + 0.5),
		math.floor(c.G * 255 + 0.5),
		math.floor(c.B * 255 + 0.5),
	}
end

local function addPass(report: AuditReport, msg: string)
	table.insert(report.passes, msg)
end

local function addWarn(report: AuditReport, msg: string)
	table.insert(report.warnings, msg)
end

local function addError(report: AuditReport, msg: string)
	table.insert(report.errors, msg)
end

local function findAllOfClass(roots: { Instance }, className: string): { Instance }
	local matches: { Instance } = {}
	local seen: { [Instance]: boolean } = {}
	for _, root in ipairs(roots) do
		local ok, descendants = pcall(function()
			return root:GetDescendants()
		end)
		if ok and type(descendants) == "table" then
			for _, desc in ipairs(descendants :: { Instance }) do
				if not seen[desc] then
					local okClass, isMatch = pcall(function()
						return desc.ClassName == className
					end)
					if okClass and isMatch then
						seen[desc] = true
						table.insert(matches, desc)
					end
				end
			end
		end
	end
	return matches
end

local function safeAuditRoots(): { Instance }
	local roots: { Instance } = { Workspace, Lighting, MaterialService }
	local okRep, repStorage = pcall(function()
		return game:GetService("ReplicatedStorage")
	end)
	if okRep and repStorage then
		table.insert(roots, repStorage)
	end
	return roots
end

local function runAudit(): AuditReport
	local report: AuditReport = {
		status = "PASS",
		passCount = 0,
		warningCount = 0,
		errorCount = 0,
		passes = {},
		warnings = {},
		errors = {},
		metrics = {},
	}

	local terrain = Workspace.Terrain
	local auditRoots = safeAuditRoots()

	-- 1. Clouds Parenting &amp; Configuration (CRITICAL: Clouds ONLY renders under Workspace.Terrain)
	local allClouds = findAllOfClass(auditRoots, "Clouds")
	local cloudsUnderTerrain: { Clouds } = {}
	local misplacedCloudsPaths: { string } = {}
	for _, inst in ipairs(allClouds) do
		if inst.Parent == terrain then
			table.insert(cloudsUnderTerrain, inst :: Clouds)
		else
			-- Ignore StarterGui/CoreGui/internal non-scene storage? Report explicit workspace/lighting mistakes.
			local fullName = inst:GetFullName()
			if inst:IsDescendantOf(Lighting) or inst:IsDescendantOf(Workspace) then
				table.insert(misplacedCloudsPaths, fullName)
			end
		end
	end

	if #misplacedCloudsPaths &gt; 0 then
		addError(
			report,
			"Clouds must be parented directly under Workspace.Terrain to render; misplaced: "
				.. table.concat(misplacedCloudsPaths, ", ")
		)
	end
	if #cloudsUnderTerrain == 0 then
		addWarn(report, "No Clouds instance directly under Workspace.Terrain (volumetric clouds inactive).")
	elseif #cloudsUnderTerrain &gt; 1 then
		addWarn(
			report,
			string.format("Multiple (%d) Clouds instances under Workspace.Terrain; keep a single Clouds object.", #cloudsUnderTerrain)
		)
	else
		local c = cloudsUnderTerrain[1]
		if c.Enabled then
			addPass(report, string.format("Clouds active under Workspace.Terrain (Cover=%.2f, Density=%.2f).", c.Cover, c.Density))
		else
			addWarn(report, "Clouds exists under Workspace.Terrain but Enabled=false.")
		end
	end
	report.metrics.clouds = {
		underTerrainCount = #cloudsUnderTerrain,
		misplacedCount = #misplacedCloudsPaths,
		misplacedPaths = misplacedCloudsPaths,
		enabled = if #cloudsUnderTerrain &gt; 0 then cloudsUnderTerrain[1].Enabled else false,
		cover = if #cloudsUnderTerrain &gt; 0 then cloudsUnderTerrain[1].Cover else nil,
		density = if #cloudsUnderTerrain &gt; 0 then cloudsUnderTerrain[1].Density else nil,
	}

	-- 2. Lighting (Security-safe read for Technology + LightingStyle)
	local techOk, techVal = safeReadProp(Lighting, "Technology")
	local styleOk, styleVal = safeReadProp(Lighting, "LightingStyle")
	local qualOk, qualVal = safeReadProp(Lighting, "PrioritizeLightingQuality")

	if styleOk then
		addPass(report, string.format("Lighting.LightingStyle = %s.", tostring(styleVal)))
	else
		addWarn(report, "Lighting.LightingStyle unreadable in this script context.")
	end

	if Lighting.GlobalShadows then
		local amb = Lighting.Ambient
		local out = Lighting.OutdoorAmbient
		local ambLum = amb.R + amb.G + amb.B
		local outLum = out.R + out.G + out.B
		if outLum + 0.01 &lt; ambLum then
			addWarn(
				report,
				"Lighting.OutdoorAmbient is darker than Lighting.Ambient while GlobalShadows=true; Roblox clamps OutdoorAmbient &gt;= Ambient."
			)
		else
			addPass(report, "Lighting.GlobalShadows=true with coherent Ambient/OutdoorAmbient.")
		end
	else
		addWarn(report, "Lighting.GlobalShadows=false; terrain and structural shadows are disabled.")
	end

	report.metrics.lighting = {
		clockTime = Lighting.ClockTime,
		geographicLatitude = Lighting.GeographicLatitude,
		brightness = Lighting.Brightness,
		exposureCompensation = Lighting.ExposureCompensation,
		environmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
		environmentSpecularScale = Lighting.EnvironmentSpecularScale,
		globalShadows = Lighting.GlobalShadows,
		shadowSoftness = Lighting.ShadowSoftness,
		ambient = serializeColor3(Lighting.Ambient),
		outdoorAmbient = serializeColor3(Lighting.OutdoorAmbient),
		lightingStyle = if styleOk then tostring(styleVal) else "Inaccessible",
		prioritizeLightingQuality = if qualOk then qualVal else "Inaccessible",
		technologyReadAccess = techOk,
		technology = if techOk then tostring(techVal) else "RobloxScriptSecurity (Studio UI only)",
	}

	-- 3. Atmosphere Coupling Rules (Glare requires Haze &gt; 0; Decay requires Haze &gt; 0 AND Glare &gt; 0)
	local atmospheres: { Atmosphere } = {}
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Atmosphere") then
			table.insert(atmospheres, child)
		end
	end

	if #atmospheres == 0 then
		addWarn(report, "No Atmosphere under Lighting (falling back to legacy FogStart/FogEnd).")
		report.metrics.atmosphere = { present = false }
	else
		if #atmospheres &gt; 1 then
			addWarn(report, string.format("Found %d Atmosphere instances under Lighting; only one should exist.", #atmospheres))
		end
		local atmo = atmospheres[1]
		if atmo.Glare &gt; 0 and atmo.Haze &lt;= 0 then
			addWarn(
				report,
				string.format("Atmosphere.Glare=%.2f has no visible effect because Atmosphere.Haze=%.2f (must be &gt; 0).", atmo.Glare, atmo.Haze)
			)
		else
			addPass(
				report,
				string.format("Atmosphere under Lighting valid (Density=%.2f, Offset=%.2f, Haze=%.2f, Glare=%.2f).", atmo.Density, atmo.Offset, atmo.Haze, atmo.Glare)
			)
		end
		report.metrics.atmosphere = {
			present = true,
			count = #atmospheres,
			density = atmo.Density,
			offset = atmo.Offset,
			haze = atmo.Haze,
			glare = atmo.Glare,
			color = serializeColor3(atmo.Color),
			decay = serializeColor3(atmo.Decay),
		}
	end

	-- 4. Sky Check
	local skies: { Sky } = {}
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Sky") then
			table.insert(skies, child)
		end
	end
	if #skies == 0 then
		addWarn(report, "No Sky instance under Lighting (using engine default skybox).")
	elseif #skies &gt; 1 then
		addWarn(report, string.format("Multiple (%d) Sky instances under Lighting.", #skies))
	else
		addPass(report, "Single Sky instance under Lighting.")
	end
	report.metrics.sky = {
		count = #skies,
		celestialBodiesShown = if #skies &gt; 0 then skies[1].CelestialBodiesShown else nil,
		starCount = if #skies &gt; 0 then skies[1].StarCount else nil,
	}

	-- 5. PostEffects Audit (ColorGradingEffect ONLY works under Lighting!)
	local postClasses = {
		"BloomEffect",
		"BlurEffect",
		"ColorCorrectionEffect",
		"ColorGradingEffect",
		"DepthOfFieldEffect",
		"SunRaysEffect",
	}
	local postMetrics: { [string]: any } = {}
	local cam = Workspace.CurrentCamera
	for _, cls in ipairs(postClasses) do
		local inLighting: { Instance } = {}
		local inCamera: { Instance } = {}
		local misplaced: { string } = {}
		for _, inst in ipairs(findAllOfClass(auditRoots, cls)) do
			if inst.Parent == Lighting then
				table.insert(inLighting, inst)
			elseif cam and inst.Parent == cam then
				table.insert(inCamera, inst)
			elseif inst:IsDescendantOf(Workspace) or inst:IsDescendantOf(Lighting) then
				table.insert(misplaced, inst:GetFullName())
			end
		end

		if #misplaced &gt; 0 then
			addWarn(report, string.format("%s outside Lighting/CurrentCamera does not render: %s", cls, table.concat(misplaced, ", ")))
		end
		if cls == "ColorGradingEffect" then
			if #inCamera &gt; 0 then
				addError(
					report,
					"ColorGradingEffect under Workspace.CurrentCamera is ignored by Roblox; parent ColorGradingEffect directly under Lighting."
				)
			end
			if #inLighting &gt; 1 then
				addWarn(
					report,
					string.format("Multiple (%d) ColorGradingEffect instances under Lighting; only the most recently parented applies.", #inLighting)
				)
			elseif #inLighting == 1 then
				local okPreset, presetVal = safeReadProp(inLighting[1], "TonemapperPreset")
				addPass(
					report,
					string.format(
						"ColorGradingEffect correctly under Lighting (TonemapperPreset=%s).",
						if okPreset then tostring(presetVal) else "Unknown"
					)
				)
			end
		elseif cls == "BlurEffect" then
			if (#inLighting + #inCamera) &gt; 1 then
				addWarn(report, "Multiple BlurEffect instances active; Roblox only renders the one with largest Size.")
			end
		elseif cls == "SunRaysEffect" then
			for _, sr in ipairs(inLighting) do
				local spread = (sr :: SunRaysEffect).Spread
				if spread &lt; 0 or spread &gt; 1 then
					addWarn(report, string.format("SunRaysEffect '%s' Spread=%.2f outside recommended [0, 1].", sr.Name, spread))
				end
			end
		end

		postMetrics[cls] = {
			inLighting = #inLighting,
			inCamera = #inCamera,
			misplaced = misplaced,
		}
	end
	report.metrics.postEffects = postMetrics

	-- 6. MaterialService, MaterialVariants, TerrainDetails, and Expanded Terrain Slots
	local use2022Ok, use2022Val = safeReadProp(MaterialService, "Use2022Materials")
	local variants: { MaterialVariant } = {}
	local badTerrainDetailVariants: { string } = {}
	for _, child in ipairs(MaterialService:GetChildren()) do
		if child:IsA("MaterialVariant") then
			table.insert(variants, child)
			local tdCount = 0
			local seenFaces: { [Enum.TerrainFace]: boolean } = {}
			local dupFace = false
			for _, sub in ipairs(child:GetChildren()) do
				if sub:IsA("TerrainDetail") then
					tdCount += 1
					if seenFaces[sub.Face] then
						dupFace = true
					end
					seenFaces[sub.Face] = true
				end
			end
			if tdCount &gt; 3 or dupFace then
				table.insert(badTerrainDetailVariants, string.format("%s (TerrainDetails=%d, dupFace=%s)", child.Name, tdCount, tostring(dupFace)))
			end
		end
	end
	if #badTerrainDetailVariants &gt; 0 then
		addError(
			report,
			"MaterialVariant TerrainDetail limit/face error (max 3 TerrainDetails, unique Top/Side/Bottom): "
				.. table.concat(badTerrainDetailVariants, ", ")
		)
	else
		addPass(report, string.format("MaterialService valid (%d MaterialVariant children).", #variants))
	end

	local configuredSlots = 0
	local slotProbeSupported = false
	for slot = 2, 63 do
		local okSlot, baseMat = pcall(function()
			return terrain:GetMaterialSlot(slot)
		end)
		if okSlot then
			slotProbeSupported = true
			if baseMat ~= nil then
				configuredSlots += 1
			end
		else
			break
		end
	end
	report.metrics.materials = {
		use2022ReadAccess = use2022Ok,
		use2022Materials = if use2022Ok then use2022Val else "RobloxScriptSecurity (Studio MaterialService UI)",
		materialVariantCount = #variants,
		expandedTerrainSlotApiAvailable = slotProbeSupported,
		configuredMaterialSlots = configuredSlots,
	}

	-- 7. Terrain Grass, Water, Cell Count &amp; GlobalWind
	local cellCount = terrain:CountCells()
	if cellCount == 0 then
		addWarn(report, "Workspace.Terrain:CountCells() == 0 (no terrain voxels present).")
	else
		addPass(report, string.format("Workspace.Terrain populated (~%d non-empty voxel cells).", cellCount))
	end
	local grassLenOk, grassLen = safeReadProp(terrain, "GrassLength")
	local decoOk, decoVal = safeReadProp(terrain, "Decoration")
	if grassLenOk and ((grassLen :: number) &lt; 0.1 or (grassLen :: number) &gt; 1.0) then
		addWarn(report, string.format("Terrain.GrassLength=%.2f outside standard [0.1, 1.0] range.", grassLen :: number))
	end

	report.metrics.terrain = {
		cellCount = cellCount,
		decoration = if decoOk then decoVal else "Unavailable",
		grassLength = if grassLenOk then grassLen else "Unavailable",
		waterColor = serializeColor3(terrain.WaterColor),
		waterTransparency = terrain.WaterTransparency,
		waterReflectance = terrain.WaterReflectance,
		waterWaveSize = terrain.WaterWaveSize,
		waterWaveSpeed = terrain.WaterWaveSpeed,
		globalWind = { Workspace.GlobalWind.X, Workspace.GlobalWind.Y, Workspace.GlobalWind.Z },
	}

	-- 8. StreamingEnabled Interaction Risk (PluginOrOpenCloud reads guarded by pcall)
	local streamingEnabled = Workspace.StreamingEnabled
	local minRadOk, minRad = safeReadProp(Workspace, "StreamingMinRadius")
	local tgtRadOk, tgtRad = safeReadProp(Workspace, "StreamingTargetRadius")
	local integrityOk, integrityVal = safeReadProp(Workspace, "StreamingIntegrityMode")

	if streamingEnabled then
		if minRadOk and (minRad :: number) &lt;= 128 then
			addWarn(
				report,
				string.format(
					"StreamingEnabled=true with StreamingMinRadius=%d; thin terrain features (&lt;16 voxels / 64 studs thick) risk disappearing on low streaming radii.",
					minRad :: number
				)
			)
		else
			addPass(report, "StreamingEnabled=true; keep structural terrain volumes &gt;= 16 voxels (64 studs) thick.")
		end
	else
		addPass(report, "StreamingEnabled=false (full terrain loaded on clients).")
	end

	report.metrics.streaming = {
		streamingEnabled = streamingEnabled,
		streamingMinRadius = if minRadOk then minRad else "PluginOrOpenCloud",
		streamingTargetRadius = if tgtRadOk then tgtRad else "PluginOrOpenCloud",
		streamingIntegrityMode = if integrityOk then tostring(integrityVal) else "PluginOrOpenCloud",
	}

	report.passCount = #report.passes
	report.warningCount = #report.warnings
	report.errorCount = #report.errors
	if report.errorCount &gt; 0 then
		report.status = "FAIL"
	elseif report.warningCount &gt; 0 then
		report.status = "WARN"
	else
		report.status = "PASS"
	end

	return report
end

return HttpService:JSONEncode(runAudit())
</ProtectedString>
