UIKit.Assets = {} :: AssetOverrides

function UIKit.SetAssets(overrides: AssetOverrides?)
	UIKit.Assets = overrides or {}
end

local function syncLiveStyleSheetTokens()
	local stylesFolder = ReplicatedStorage:FindFirstChild("UIStyles")
	if not stylesFolder then
		return
	end
	local tokensSheet = stylesFolder:FindFirstChild("TokensSheet")
	if not tokensSheet or not tokensSheet:IsA("StyleSheet") then
		return
	end
	local c = UIKit.Tokens.Colors :: any
	local r = UIKit.Tokens.Radii :: any
	local attrColors = {
		"BgPanel", "BgCard", "Primary", "PrimaryHover", "PrimaryPress",
		"Secondary", "SecondaryHover", "SecondaryPress",
		"Accent", "AccentHover", "AccentPress",
		"Danger", "DangerHover", "DangerPress",
		"Success", "SuccessHover", "SuccessPress",
		"Warning", "WarningHover", "WarningPress",
		"TextPrimary", "TextOnPrimary", "TextOnSecondary", "TextOnAccent",
		"TextOnSuccess", "TextOnWarning", "TextOnDanger",
		"BorderSubtle", "BorderBright", "OutlineInk",
	}
	for _, key in ipairs(attrColors) do
		if c[key] ~= nil then
			tokensSheet:SetAttribute(key, c[key])
		end
	end
	tokensSheet:SetAttribute("RadiusMd", r.Medium)
	tokensSheet:SetAttribute("RadiusPanel", r.Panel)
	tokensSheet:SetAttribute("RadiusButton", r.Button)
	tokensSheet:SetAttribute("RadiusBadge", r.Badge)
end

local PRESET_ORNAMENT_MAP: { [string]: string } = {
	candy_simulator = "bubble_shine",
	anime_neon = "cyber_slash",
	cozy_pastel = "stitched_warm",
	scifi_holo = "holo_brackets",
	arcade_pop = "comic_stripe",
	rpg_arcane = "arcane_filigree",
}

function UIKit.ApplyDesignSystem(dsOrPreset: any): { [string]: any }
	local ds = dsOrPreset
	if typeof(dsOrPreset) == "string" then
		ds = (UIKit.Presets :: any)[dsOrPreset]
		if not ds then
			warn(string.format("[UIKit.ApplyDesignSystem] Unknown preset '%s'", dsOrPreset))
			return UIKit.Tokens
		end
	elseif typeof(dsOrPreset) == "table" and dsOrPreset.Preset and (UIKit.Presets :: any)[dsOrPreset.Preset] then
		local basePreset = (UIKit.Presets :: any)[dsOrPreset.Preset]
		UIKit.ApplyDesignSystem(basePreset)
	end
	if typeof(ds) ~= "table" then
		return UIKit.Tokens
	end

	if typeof(ds.Meta) == "table" then
		local tMeta = UIKit.Tokens.Meta :: any
		for k, v in pairs(ds.Meta) do
			tMeta[k] = v
		end
	end
	if typeof(ds.TextureStyle) == "string" and ds.TextureStyle ~= "" then
		(UIKit.Tokens.Meta :: any).TextureStyle = ds.TextureStyle
	end
	if typeof(ds.AssetStyle) == "string" and ds.AssetStyle ~= "" then
		(UIKit.Tokens.Meta :: any).AssetStyle = ds.AssetStyle
	end

	if typeof(ds.Colors) == "table" then
		local tc = UIKit.Tokens.Colors :: any
		for k, v in pairs(ds.Colors) do
			if typeof(v) == "Color3" then
				tc[k] = v
			end
		end
		-- Rebuild default glossy gradients for color keys unless explicitly overridden below
		local gradMap = { "Primary", "Secondary", "Accent", "Success", "Warning", "Danger", "Gold" }
		local tGrad = UIKit.Tokens.Gradients :: any
		for _, gk in ipairs(gradMap) do
			if ds.Colors[gk] and (typeof(ds.Gradients) ~= "table" or ds.Gradients[gk] == nil) then
				tGrad[gk] = {
					Rotation = -38,
					Type = "Linear",
					Stops = makeGlossyStops(ds.Colors[gk]),
				}
			end
		end
		if ds.Colors.BgPanel and (typeof(ds.Gradients) ~= "table" or ds.Gradients.Panel == nil) then
			local bp: Color3 = ds.Colors.BgPanel
			local isDark = ds.Meta == nil or ds.Meta.SurfaceMode ~= "light"
			local hi = if isDark then bp:Lerp(Color3.fromRGB(255, 255, 255), 0.08) else bp:Lerp(Color3.fromRGB(255, 255, 255), 0.14)
			local lo = if isDark then bp:Lerp(Color3.fromRGB(0, 0, 0), 0.16) else bp:Lerp(Color3.fromRGB(48, 36, 24), 0.08)
			UIKit.Tokens.Gradients.Panel = {
				Rotation = -42,
				Type = "Linear",
				Stops = {
					{ time = 0.0, color = hi },
					{ time = 0.48, color = bp },
					{ time = 1.0, color = lo },
				},
			}
		end
	end

	if typeof(ds.Rarity) == "table" then
		local tr = UIKit.Tokens.Rarity :: any
		for k, v in pairs(ds.Rarity) do
			if typeof(v) == "Color3" then
				tr[k] = v
			end
		end
	end

	if typeof(ds.Radii) == "table" then
		local tr = UIKit.Tokens.Radii :: any
		for k, v in pairs(ds.Radii) do
			if typeof(v) == "UDim" then
				tr[k] = v
			elseif typeof(v) == "number" then
				tr[k] = if v &gt;= 999 then UDim.new(1, 0) else UDim.new(0, v)
			end
		end
	end

	if typeof(ds.Strokes) == "table" then
		local ts = UIKit.Tokens.Strokes :: any
		for k, v in pairs(ds.Strokes) do
			ts[k] = v
		end
	end

	if typeof(ds.Shadows) == "table" then
		local tsh = UIKit.Tokens.Shadows :: any
		for k, v in pairs(ds.Shadows) do
			tsh[k] = v
		end
	end

	if typeof(ds.Gradients) == "table" then
		local tg = UIKit.Tokens.Gradients :: any
		for k, v in pairs(ds.Gradients) do
			if typeof(v) == "table" then
				tg[k] = v
			end
		end
	end

	if typeof(ds.Fonts) == "table" then
		if typeof(ds.Fonts.TitleFamily) == "string" then
			UIKit.Tokens.Fonts.Title = safeFont(ds.Fonts.TitleFamily, Enum.FontWeight.ExtraBold, Enum.FontStyle.Normal)
		end
		if typeof(ds.Fonts.HeadingFamily) == "string" then
			UIKit.Tokens.Fonts.Heading = safeFont(ds.Fonts.HeadingFamily, Enum.FontWeight.Bold, Enum.FontStyle.Normal)
		end
		if typeof(ds.Fonts.BodyFamily) == "string" then
			UIKit.Tokens.Fonts.Body = safeFont(ds.Fonts.BodyFamily, Enum.FontWeight.Medium, Enum.FontStyle.Normal)
		end
		if typeof(ds.Fonts.MonoFamily) == "string" then
			UIKit.Tokens.Fonts.Mono = safeFont(ds.Fonts.MonoFamily, Enum.FontWeight.Bold, Enum.FontStyle.Normal, "rbxasset://fonts/families/RobotoMono.json")
		end
	end

	if typeof(ds.Motifs) == "table" then
		local tm = UIKit.Tokens.Motifs :: any
		for k, v in pairs(ds.Motifs) do
			tm[k] = v
		end
	end

	local tContent = UIKit.Tokens.Content :: any
	if typeof(ds.Content) ~= "table" and typeof(ds.Meta) == "table" and typeof(ds.Meta.PresetId) == "string" and ds.Preset == nil then
		local metaPreset = (UIKit.Presets :: any)[ds.Meta.PresetId]
		if typeof(metaPreset) == "table" and typeof(metaPreset.Content) == "table" then
			for ck, cv in pairs(metaPreset.Content) do
				if ck == "HotbarSkills" and typeof(cv) == "table" then
					local prevSkills = if typeof(tContent.HotbarSkills) == "table" then tContent.HotbarSkills else {}
					local copied: { string } = {}
					for i = 1, 5 do
						local item = cv[i]
						copied[i] = if typeof(item) == "string" and item ~= ""
							then item
							elseif typeof(prevSkills[i]) == "string" and prevSkills[i] ~= ""
							then prevSkills[i]
							else ("Skill " .. tostring(i))
					end
					tContent.HotbarSkills = copied
				elseif cv ~= nil then
					tContent[ck] = cv
				end
			end
		end
	end

	if typeof(ds.Meta) == "table" then
		if typeof(ds.Meta.GameTitle) == "string" and ds.Meta.GameTitle ~= "" then
			tContent.GameTitle = ds.Meta.GameTitle
		end
		if typeof(ds.Meta.Genre) == "string" and ds.Meta.Genre ~= "" then
			tContent.Genre = ds.Meta.Genre
		end
		if typeof(ds.Meta.PresetId) == "string" and ds.Meta.PresetId ~= "" then
			tContent.PresetId = ds.Meta.PresetId
			if typeof(ds.Content) ~= "table" or ds.Content.OrnamentKind == nil then
				local mappedOrn = PRESET_ORNAMENT_MAP[ds.Meta.PresetId]
				if mappedOrn then
					tContent.OrnamentKind = mappedOrn
				end
			end
		end
	end

	if typeof(ds.Content) == "table" then
		for k, v in pairs(ds.Content) do
			if k == "HotbarSkills" and typeof(v) == "table" then
				local prevSkills = if typeof(tContent.HotbarSkills) == "table" then tContent.HotbarSkills else {}
				local skills: { string } = {}
				for i = 1, 5 do
					local item = v[i]
					if typeof(item) == "string" and item ~= "" then
						skills[i] = item
					elseif typeof(prevSkills[i]) == "string" and prevSkills[i] ~= "" then
						skills[i] = prevSkills[i]
					else
						skills[i] = "Skill " .. tostring(i)
					end
				end
				tContent.HotbarSkills = skills
			elseif v ~= nil then
				tContent[k] = v
			end
		end
		if typeof(ds.Content.PresetId) == "string" and ds.Content.OrnamentKind == nil then
			local mappedOrn = PRESET_ORNAMENT_MAP[ds.Content.PresetId]
			if mappedOrn then
				tContent.OrnamentKind = mappedOrn
			end
		end
	end

	if typeof(ds.MinTouchPx) == "number" then
		UIKit.Tokens.MinTouchPx = math.max(44, ds.MinTouchPx)
	end

	syncLiveStyleSheetTokens()
	return UIKit.Tokens
end

function UIKit.IsReducedMotion(): boolean
	local ok, val = pcall(function()
		return GuiService.ReducedMotionEnabled
	end)
	return ok and val == true
end

function UIKit.GetPreferredInput(): Enum.PreferredInput
	local ok, val = pcall(function()
		return UserInputService.PreferredInput
	end)
	if ok and val then
		return val
	end
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return Enum.PreferredInput.Touch
	end
	return Enum.PreferredInput.KeyboardAndMouse
end

function UIKit.GetDisplaySize(): Enum.DisplaySize
	local ok, val = pcall(function()
		return GuiService.ViewportDisplaySize
	end)
	if ok and val then
		return val
	end
	return Enum.DisplaySize.Medium
end

function UIKit.FormatNumber(n: number): string
	local rounded = math.floor(n + 0.5)
	if math.abs(rounded) &gt;= 1000000 then
		return string.format("%.2fM", rounded / 1000000)
	end
	local formatted = tostring(rounded)
	local k = 1
	while k ~= 0 do
		formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
	end
	return formatted
end

function UIKit.Tween(instance: Instance, tweenInfo: TweenInfo, props: { [string]: any }): Tween?
	if UIKit.IsReducedMotion() then
		local instAny = instance :: any
		for k, v in pairs(props) do
			pcall(function()
				instAny[k] = v
			end)
		end
		return nil
	end
	local tw = TweenService:Create(instance, tweenInfo, props)
	tw:Play()
	return tw
end

local function addRule(
	sheet: StyleSheet,
	selector: string,
	priority: number,
	props: { [string]: any },
	transitionInfo: TweenInfo?
): StyleRule
	local rule = Instance.new("StyleRule")
	rule.Name = selector:gsub("[^%w_]", "_")
	rule.Selector = selector
	rule.Priority = priority
	for k, v in pairs(props) do
		pcall(function()
			rule:SetProperty(k, v)
		end)
	end
	if transitionInfo then
		pcall(function()
			rule:SetDefaultPropertyTransition(transitionInfo)
		end)
	end
	rule.Parent = sheet
	if rule.SelectorError ~= "" then
		warn(string.format("[UIKit.BuildStyleSheet] SelectorError on '%s': %s", selector, rule.SelectorError))
	end
	return rule
end

-- Build layered StyleSheet architecture: TokensSheet -&gt; ThemeSheet -&gt; DesignSheet
function UIKit.BuildStyleSheet(parent: Instance?, tokenOverrides: { [string]: any }?): StyleSheet
	local targetParent = parent or game:GetService("ReplicatedStorage")
	local prev = targetParent:FindFirstChild("UIStyles")
	if prev then
		prev:Destroy()
	end

	local folder = Instance.new("Folder")
	folder.Name = "UIStyles"
	folder.Parent = targetParent

	local tokensSheet = Instance.new("StyleSheet")
	tokensSheet.Name = "TokensSheet"
	tokensSheet:SetAttribute("BgPanel", UIKit.Tokens.Colors.BgPanel)
	tokensSheet:SetAttribute("BgCard", UIKit.Tokens.Colors.BgCard)
	tokensSheet:SetAttribute("Primary", UIKit.Tokens.Colors.Primary)
	tokensSheet:SetAttribute("PrimaryHover", UIKit.Tokens.Colors.PrimaryHover)
	tokensSheet:SetAttribute("PrimaryPress", UIKit.Tokens.Colors.PrimaryPress)
	tokensSheet:SetAttribute("Secondary", UIKit.Tokens.Colors.Secondary)
	tokensSheet:SetAttribute("SecondaryHover", UIKit.Tokens.Colors.SecondaryHover)
	tokensSheet:SetAttribute("SecondaryPress", UIKit.Tokens.Colors.SecondaryPress)
	tokensSheet:SetAttribute("Accent", UIKit.Tokens.Colors.Accent)
	tokensSheet:SetAttribute("AccentHover", UIKit.Tokens.Colors.AccentHover)
	tokensSheet:SetAttribute("AccentPress", UIKit.Tokens.Colors.AccentPress)
	tokensSheet:SetAttribute("Danger", UIKit.Tokens.Colors.Danger)
	tokensSheet:SetAttribute("DangerHover", UIKit.Tokens.Colors.DangerHover)
	tokensSheet:SetAttribute("DangerPress", UIKit.Tokens.Colors.DangerPress)
	tokensSheet:SetAttribute("Success", UIKit.Tokens.Colors.Success)
	tokensSheet:SetAttribute("SuccessHover", UIKit.Tokens.Colors.SuccessHover)
	tokensSheet:SetAttribute("SuccessPress", UIKit.Tokens.Colors.SuccessPress)
	tokensSheet:SetAttribute("Warning", UIKit.Tokens.Colors.Warning)
	tokensSheet:SetAttribute("WarningHover", UIKit.Tokens.Colors.WarningHover)
	tokensSheet:SetAttribute("WarningPress", UIKit.Tokens.Colors.WarningPress)
	tokensSheet:SetAttribute("TextPrimary", UIKit.Tokens.Colors.TextPrimary)
	tokensSheet:SetAttribute("TextOnPrimary", UIKit.Tokens.Colors.TextOnPrimary)
	tokensSheet:SetAttribute("TextOnSecondary", UIKit.Tokens.Colors.TextOnSecondary)
	tokensSheet:SetAttribute("TextOnAccent", UIKit.Tokens.Colors.TextOnAccent)
	tokensSheet:SetAttribute("TextOnSuccess", UIKit.Tokens.Colors.TextOnSuccess)
	tokensSheet:SetAttribute("TextOnWarning", UIKit.Tokens.Colors.TextOnWarning)
	tokensSheet:SetAttribute("TextOnDanger", UIKit.Tokens.Colors.TextOnDanger)
	tokensSheet:SetAttribute("BorderSubtle", UIKit.Tokens.Colors.BorderSubtle)
	tokensSheet:SetAttribute("BorderBright", UIKit.Tokens.Colors.BorderBright)
	tokensSheet:SetAttribute("OutlineInk", UIKit.Tokens.Colors.OutlineInk)
	tokensSheet:SetAttribute("RadiusMd", UIKit.Tokens.Radii.Medium)
	tokensSheet:SetAttribute("RadiusPanel", UIKit.Tokens.Radii.Panel)
	tokensSheet:SetAttribute("RadiusButton", UIKit.Tokens.Radii.Button)
	tokensSheet:SetAttribute("RadiusBadge", UIKit.Tokens.Radii.Badge)
	if tokenOverrides then
		for k, v in pairs(tokenOverrides) do
			tokensSheet:SetAttribute(k, v)
		end
	end
	tokensSheet.Parent = folder

	local themeSheet = Instance.new("StyleSheet")
	themeSheet.Name = "ThemeSheet"
	themeSheet.Parent = folder

	local deriveTokens = Instance.new("StyleDerive")
	deriveTokens.Name = "DeriveTokens"
	deriveTokens.StyleSheet = tokensSheet
	deriveTokens.Priority = 1
	deriveTokens.Parent = themeSheet

	local hoverTween: TweenInfo? = if UIKit.IsReducedMotion()
		then nil
		else TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	addRule(themeSheet, ".CardPanel", 10, {
		BackgroundColor3 = "$BgPanel",
		BorderSizePixel = 0,
	}, nil)
	addRule(themeSheet, ".CardPanel::UICorner", 10, {
		CornerRadius = "$RadiusPanel",
	}, nil)
	addRule(themeSheet, ".CardPanel::UIStroke", 10, {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = "$OutlineInk",
		Thickness = UIKit.Tokens.Strokes.Panel,
		Transparency = 0.08,
	}, nil)

	addRule(themeSheet, ".GlossyPanel", 12, {
		BackgroundColor3 = "$BgPanel",
		BorderSizePixel = 0,
	}, nil)
	addRule(themeSheet, ".GlossyPanel::UICorner", 12, {
		CornerRadius = "$RadiusPanel",
	}, nil)
	addRule(themeSheet, ".GlossyPanel::UIStroke", 12, {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = "$OutlineInk",
		Thickness = UIKit.Tokens.Strokes.Panel,
		Transparency = 0,
	}, nil)

	addRule(themeSheet, ".ButtonPrimary", 20, {
		BackgroundColor3 = "$Primary",
		TextColor3 = "$TextOnPrimary",
		AutoButtonColor = false,
		BorderSizePixel = 0,
	}, hoverTween)
	addRule(themeSheet, ".ButtonPrimary:Hover", 21, {
		BackgroundColor3 = "$PrimaryHover",
	}, hoverTween)
	addRule(themeSheet, ".ButtonPrimary:Press", 22, {
		BackgroundColor3 = "$PrimaryPress",
	}, hoverTween)
	addRule(themeSheet, ".ButtonPrimary:NonInteractable", 23, {
		BackgroundTransparency = 0.45,
	}, hoverTween)

	addRule(themeSheet, ".ButtonSecondary", 20, {
		BackgroundColor3 = "$Secondary",
		TextColor3 = "$TextOnSecondary",
		AutoButtonColor = false,
		BorderSizePixel = 0,
	}, hoverTween)
	addRule(themeSheet, ".ButtonSecondary:Hover", 21, {
		BackgroundColor3 = "$SecondaryHover",
	}, hoverTween)
	addRule(themeSheet, ".ButtonSecondary:Press", 22, {
		BackgroundColor3 = "$SecondaryPress",
	}, hoverTween)
	addRule(themeSheet, ".ButtonSecondary:NonInteractable", 23, {
		BackgroundTransparency = 0.45,
	}, hoverTween)

	addRule(themeSheet, ".ButtonAccent", 20, {
		BackgroundColor3 = "$Accent",
		TextColor3 = "$TextOnAccent",
		AutoButtonColor = false,
		BorderSizePixel = 0,
	}, hoverTween)
	addRule(themeSheet, ".ButtonAccent:Hover", 21, {
		BackgroundColor3 = "$AccentHover",
	}, hoverTween)
	addRule(themeSheet, ".ButtonAccent:Press", 22, {
		BackgroundColor3 = "$AccentPress",
	}, hoverTween)
	addRule(themeSheet, ".ButtonAccent:NonInteractable", 23, {
		BackgroundTransparency = 0.45,
	}, hoverTween)

	addRule(themeSheet, ".ButtonDanger", 20, {
		BackgroundColor3 = "$Danger",
		TextColor3 = "$TextOnDanger",
		AutoButtonColor = false,
		BorderSizePixel = 0,
	}, hoverTween)
	addRule(themeSheet, ".ButtonDanger:Hover", 21, {
		BackgroundColor3 = "$DangerHover",
	}, hoverTween)
	addRule(themeSheet, ".ButtonDanger:Press", 22, {
		BackgroundColor3 = "$DangerPress",
	}, hoverTween)
	addRule(themeSheet, ".ButtonDanger:NonInteractable", 23, {
		BackgroundTransparency = 0.45,
	}, hoverTween)

	addRule(themeSheet, ".ButtonSuccess", 20, {
		BackgroundColor3 = "$Success",
		TextColor3 = "$TextOnSuccess",
		AutoButtonColor = false,
		BorderSizePixel = 0,
	}, hoverTween)
	addRule(themeSheet, ".ButtonSuccess:Hover", 21, {
		BackgroundColor3 = "$SuccessHover",
	}, hoverTween)
	addRule(themeSheet, ".ButtonSuccess:Press", 22, {
		BackgroundColor3 = "$SuccessPress",
	}, hoverTween)
	addRule(themeSheet, ".ButtonSuccess:NonInteractable", 23, {
		BackgroundTransparency = 0.45,
	}, hoverTween)

	addRule(themeSheet, ".ButtonWarning", 20, {
		BackgroundColor3 = "$Warning",
		TextColor3 = "$TextOnWarning",
		AutoButtonColor = false,
		BorderSizePixel = 0,
	}, hoverTween)
	addRule(themeSheet, ".ButtonWarning:Hover", 21, {
		BackgroundColor3 = "$WarningHover",
	}, hoverTween)
	addRule(themeSheet, ".ButtonWarning:Press", 22, {
		BackgroundColor3 = "$WarningPress",
	}, hoverTween)
	addRule(themeSheet, ".ButtonWarning:NonInteractable", 23, {
		BackgroundTransparency = 0.45,
	}, hoverTween)

	-- Desktop/default base rules (keep these properties unset on instances so StyleRules &amp; @ queries win)
	addRule(themeSheet, "#SideRail", 35, {
		Size = UDim2.fromOffset(128, 286),
		Position = UDim2.fromOffset(10, 92),
	}, nil)
	addRule(themeSheet, "#RailLayout", 35, {
		FillDirection = Enum.FillDirection.Vertical,
	}, nil)
	addRule(themeSheet, ".RailBtn", 35, {
		Size = UDim2.fromOffset(124, 52),
	}, nil)
	addRule(themeSheet, ".RailTitle", 35, {
		Visible = true,
	}, nil)
	addRule(themeSheet, ".CompactHide", 35, {
		Visible = true,
	}, nil)
	addRule(themeSheet, ".KeybindPill", 35, {
		Visible = true,
	}, nil)

	-- Responsive built-in @ compound selectors &amp; custom StyleQuery @CompactPhone &gt;&gt; descendant rules
	addRule(themeSheet, ".KeybindPill@PreferredInputTouch", 40, {
		Visible = false,
	}, nil)
	addRule(themeSheet, ".CompactHide@ViewportDisplaySizeSmall", 40, {
		Visible = false,
	}, nil)
	addRule(themeSheet, "@CompactPhone &gt;&gt; .CompactHide", 41, {
		Visible = false,
	}, nil)
	addRule(themeSheet, "@CompactPhone &gt;&gt; #SideRail", 41, {
		Size = UDim2.fromOffset(286, 54),
		Position = UDim2.fromOffset(10, 82),
	}, nil)
	addRule(themeSheet, "@CompactPhone &gt;&gt; #RailLayout", 41, {
		FillDirection = Enum.FillDirection.Horizontal,
	}, nil)
	addRule(themeSheet, "@CompactPhone &gt;&gt; .RailBtn", 41, {
		Size = UDim2.fromOffset(52, 52),
	}, nil)
	addRule(themeSheet, "@CompactPhone &gt;&gt; .RailTitle", 41, {
		Visible = false,
	}, nil)

	local designSheet = Instance.new("StyleSheet")
	designSheet.Name = "DesignSheet"
	designSheet.Parent = folder

	local deriveTheme = Instance.new("StyleDerive")
	deriveTheme.Name = "DeriveTheme"
	deriveTheme.StyleSheet = themeSheet
	deriveTheme.Priority = 2
	deriveTheme.Parent = designSheet

	return designSheet
end

function UIKit.AttachStyleLink(gui: Instance, styleSheet: StyleSheet): StyleLink
	local existing = gui:FindFirstChildOfClass("StyleLink")
	if existing then
		existing.StyleSheet = styleSheet
		return existing
	end
	local link = Instance.new("StyleLink")
	link.Name = "StyleLink"
	link.StyleSheet = styleSheet
	link.Parent = gui
	return link
end

function UIKit.EnsureMinTouchTarget(guiObj: GuiObject, minPx: number?): UISizeConstraint
	local px = math.max(UIKit.Tokens.MinTouchPx, minPx or UIKit.Tokens.MinTouchPx)
	local existing = guiObj:FindFirstChild("MinTouchConstraint")
	if existing and existing:IsA("UISizeConstraint") then
		existing.MinSize = Vector2.new(
			math.max(existing.MinSize.X, px),
			math.max(existing.MinSize.Y, px)
		)
		return existing
	end
	local constraint = Instance.new("UISizeConstraint")
	constraint.Name = "MinTouchConstraint"
	constraint.MinSize = Vector2.new(px, px)
	constraint.Parent = guiObj
	return constraint
end

function UIKit.CreateColorSequenceFromRecipe(recipeOrKey: any, fallbackBase: Color3?): (ColorSequence, number)
	local recipe: any = nil
	if typeof(recipeOrKey) == "string" then
		recipe = (UIKit.Tokens.Gradients :: any)[recipeOrKey]
	elseif typeof(recipeOrKey) == "table" then
		recipe = recipeOrKey
	end

	local rot = -38
	local rawStops: { { time: number, color: Color3 } } = {}
	if typeof(recipe) == "table" then
		if typeof(recipe.Rotation) == "number" then
			rot = recipe.Rotation
		end
		if typeof(recipe.Stops) == "table" then
			for _, st in ipairs(recipe.Stops) do
				if typeof(st) == "table" and typeof(st.color) == "Color3" then
					table.insert(rawStops, {
						time = math.clamp(tonumber(st.time) or 0, 0, 1),
						color = st.color,
					})
				end
			end
		end
	end

	if #rawStops &lt; 2 then
		local base = fallbackBase or UIKit.Tokens.Colors.Primary
		rawStops = makeGlossyStops(base)
	end

	table.sort(rawStops, function(a, b)
		return a.time &lt; b.time
	end)
	rawStops[1].time = 0
	rawStops[#rawStops].time = 1

	local keypoints: { ColorSequenceKeypoint } = {}
	local prevTime = -1
	for idx, st in ipairs(rawStops) do
		local t = st.time
		if idx == #rawStops then
			t = 1
		elseif t &lt;= prevTime then
			t = math.min(0.999, prevTime + 0.001)
		end
		prevTime = t
		table.insert(keypoints, ColorSequenceKeypoint.new(t, st.color))
	end

	return ColorSequence.new(keypoints), rot
end

local function srgbToLinear(c: number): number
	if c &lt;= 0.04045 then
		return c / 12.92
	end
	return ((c + 0.055) / 1.055) ^ 2.4
end

function UIKit.RelativeLuminance(col: Color3): number
	return 0.2126 * srgbToLinear(col.R)
		+ 0.7152 * srgbToLinear(col.G)
		+ 0.0722 * srgbToLinear(col.B)
end

function UIKit.AttachTextStroke(
	label: GuiObject,
	color: Color3?,
	thickness: number?,
	transparency: number?,
	textColorOverride: Color3?
): UIStroke
	local resolvedColor = color or UIKit.Tokens.Colors.OutlineInk
	local resolvedThickness = thickness or UIKit.Tokens.Strokes.Text
	local resolvedTransparency = transparency or 0.1

	local effTextColor: Color3? = textColorOverride
	if not effTextColor and (label:IsA("TextLabel") or label:IsA("TextButton") or label:IsA("TextBox")) then
		effTextColor = (label :: any).TextColor3
	end
	if effTextColor and typeof(effTextColor) == "Color3" then
		if UIKit.RelativeLuminance(effTextColor) &lt; 0.35 and UIKit.RelativeLuminance(resolvedColor) &lt; 0.35 then
			-- Dark text on bright pills/buttons blurs into dark halos with thick strokes; use a whisper-thin subtle light rim.
			resolvedColor = Color3.fromRGB(255, 255, 255)
			resolvedThickness = math.min(0.6, resolvedThickness * 0.3)
			resolvedTransparency = math.max(0.82, resolvedTransparency)
		end
	end

	local existing = label:FindFirstChild("TextStroke")
	if existing and existing:IsA("UIStroke") then
		existing.Color = resolvedColor
		existing.Thickness = resolvedThickness
		existing.Transparency = resolvedTransparency
		return existing
	end
	local stroke = Instance.new("UIStroke")
	stroke.Name = "TextStroke"
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Color = resolvedColor
	stroke.Thickness = resolvedThickness
	stroke.Transparency = resolvedTransparency
	stroke.LineJoinMode = UIKit.Tokens.Strokes.LineJoin
	stroke.Parent = label
	return stroke
end

export type StackedStrokeOptions = {
	OuterColor: Color3?,
	OuterThickness: number?,
	OuterTransparency: number?,
	InnerColor: Color3?,
	InnerThickness: number?,
	InnerTransparency: number?,
	LineJoin: Enum.LineJoinMode?,
	CornerRadius: UDim?,
}

function UIKit.AttachStackedStrokes(target: GuiObject, opts: StackedStrokeOptions?): (UIStroke, Instance)
	local o = opts or ({} :: StackedStrokeOptions)
	local targetCorner = target:FindFirstChildOfClass("UICorner")
	local resolvedRadius = o.CornerRadius or (if targetCorner then targetCorner.CornerRadius else UIKit.Tokens.Radii.Button)
	-- Roblox Miter joins on circular/pill UICorners draw solid bounding corner wedges; always use Round on circles/pills.
	local isCircular = (resolvedRadius.Scale &gt;= 0.49 or resolvedRadius.Offset &gt;= 24)
	local lineJoin = if isCircular then Enum.LineJoinMode.Round else (o.LineJoin or UIKit.Tokens.Strokes.LineJoin)

	local outer = Instance.new("UIStroke")
	outer.Name = "OuterStroke"
	outer.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	outer.Color = o.OuterColor or UIKit.Tokens.Colors.OutlineInk
	outer.Thickness = o.OuterThickness or UIKit.Tokens.Strokes.OuterInk
	outer.Transparency = if o.OuterTransparency ~= nil then o.OuterTransparency else 0
	outer.LineJoinMode = lineJoin
	pcall(function()
		local outerAny = outer :: any
		outerAny.BorderStrokePosition = if isCircular then Enum.BorderStrokePosition.Center else Enum.BorderStrokePosition.Outer
	end)
	outer.Parent = target

	local innerThickness = o.InnerThickness or UIKit.Tokens.Strokes.InnerHighlight
	local innerTrans = if o.InnerTransparency ~= nil then o.InnerTransparency else 0.45
	local innerColor = o.InnerColor or UIKit.Tokens.Colors.InnerHighlight

	local innerStrokeOk, innerStroke = pcall(function()
		local s = Instance.new("UIStroke")
		s.Name = "InnerStroke"
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		s.Color = innerColor
		s.Thickness = innerThickness
		s.Transparency = innerTrans
		s.LineJoinMode = lineJoin
		-- Use Center on circular/pill frames to avoid Inner-stroke artifacts; fails cleanly when BorderStrokePosition is disabled
		local sAny = s :: any
		sAny.BorderStrokePosition = if isCircular then Enum.BorderStrokePosition.Center else Enum.BorderStrokePosition.Inner
		s.Parent = target
		return s
	end)
	if innerStrokeOk and innerStroke then
		return outer, innerStroke
	end

	-- Fallback when Improved UIStrokes (BorderStrokePosition) is unavailable: inset highlight border Frame
	local inset = Instance.new("Frame")
	inset.Name = "InnerHighlight"
	inset.Size = UDim2.new(1, -4, 1, -4)
	inset.Position = UDim2.fromOffset(2, 2)
	inset.BackgroundTransparency = 1
	inset.BorderSizePixel = 0
	inset.ZIndex = math.max(1, target.ZIndex) + 1
	inset.Parent = target

	local existingCorner = target:FindFirstChildOfClass("UICorner")
	local radius = o.CornerRadius or (if existingCorner then existingCorner.CornerRadius else UIKit.Tokens.Radii.Button)
	local iCorner = Instance.new("UICorner")
	iCorner.CornerRadius = UDim.new(radius.Scale, math.max(0, radius.Offset - 2))
	iCorner.Parent = inset

	local iStroke = Instance.new("UIStroke")
	iStroke.Name = "InnerStroke"
	iStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	iStroke.Color = innerColor
	iStroke.Thickness = math.max(1, innerThickness * 0.85)
	iStroke.Transparency = math.min(0.65, innerTrans + 0.08)
	iStroke.LineJoinMode = lineJoin
	iStroke.Parent = inset

	return outer, inset
end

function UIKit.PickReadableTextColor(bgColor: Color3): Color3
	local lum = UIKit.RelativeLuminance(bgColor)
	local lightTxt = Color3.fromRGB(255, 253, 250)
	local darkTxt = Color3.fromRGB(22, 16, 30)
	local cLight = 1.05 / (lum + 0.05)
	local cDark = (lum + 0.05) / 0.062
	return if cLight &gt;= cDark then lightTxt else darkTxt
end

local function tryAttachUIShadow(
	target: GuiObject,
	color: Color3,
	transparency: number,
	blurPx: number,
	ox: number,
	oy: number
): Instance?
	local created: Instance? = nil
	local ok, errOrInst = pcall(function()
		local s = Instance.new("UIShadow")
		created = s
		s.Name = "DropShadow"
		s.Color = color
		s.Transparency = transparency
		pcall(function()
			s.BlurRadius = UDim.new(0, blurPx)
		end)
		pcall(function()
			s.Offset = UDim2.fromOffset(ox, oy)
		end)
		pcall(function()
			local sAny = s :: any
			sAny.ShowBehindParent = true
		end)
		s.ZIndex = -1
		s.Parent = target
		return s
	end)
	if ok and errOrInst then
		return errOrInst
	end
	if created then
		local createdInst = created :: Instance
		pcall(function()
			createdInst:Destroy()
		end)
	end
	return nil
end

function UIKit.AttachDropShadow(
	parent: GuiObject,
	offsetY: number?,
	transparency: number?,
	color: Color3?,
	allowSiblingFallback: boolean?
): Instance?
	local ox = UIKit.Tokens.Shadows.OffsetX
	local oy = offsetY or UIKit.Tokens.Shadows.OffsetY
	local alpha = if transparency ~= nil then transparency else UIKit.Tokens.Shadows.Transparency
	local shadowColor = color or UIKit.Tokens.Shadows.Color
	local blurPx = UIKit.Tokens.Shadows.BlurRadius

	local shadow = tryAttachUIShadow(parent, shadowColor, alpha, blurPx, ox, oy)
	if shadow then
		return shadow
	end

	-- Fallback offset sibling Frame when parent is outside a UIGridStyleLayout
	local host = parent.Parent
	local hasLayout = host ~= nil and host:FindFirstChildWhichIsA("UIGridStyleLayout") ~= nil
	if allowSiblingFallback ~= false and host and (host:IsA("GuiObject") or host:IsA("LayerCollector")) and not hasLayout then
		local fbFrame = Instance.new("Frame")
		fbFrame.Name = parent.Name .. "_DropShadow"
		fbFrame.Size = parent.Size
		fbFrame.AnchorPoint = parent.AnchorPoint
		fbFrame.Position = UDim2.new(
			parent.Position.X.Scale,
			parent.Position.X.Offset + ox,
			parent.Position.Y.Scale,
			parent.Position.Y.Offset + oy
		)
		fbFrame.ZIndex = math.max(0, parent.ZIndex - 1)
		fbFrame.BackgroundColor3 = shadowColor
		fbFrame.BackgroundTransparency = math.clamp(alpha, 0.05, 0.75)
		fbFrame.BorderSizePixel = 0
		fbFrame.Visible = parent.Visible

		local existingCorner = parent:FindFirstChildOfClass("UICorner")
		if existingCorner then
			local c = Instance.new("UICorner")
			c.CornerRadius = existingCorner.CornerRadius
			c.Parent = fbFrame
		end

		fbFrame.Parent = host
		parent.Destroying:Connect(function()
			if fbFrame.Parent then
				fbFrame:Destroy()
			end
		end)
		parent:GetPropertyChangedSignal("Visible"):Connect(function()
			fbFrame.Visible = parent.Visible
		end)
		return fbFrame
	end

	-- Minimal fallback border shadow if inside a layout container without UIShadow
	local existingStroke = parent:FindFirstChildOfClass("UIStroke")
	if not existingStroke then
		local fb = Instance.new("UIStroke")
		fb.Name = "ShadowFallbackStroke"
		fb.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		fb.Color = shadowColor
		fb.Thickness = 3
		fb.Transparency = 0.45
		fb.Parent = parent
		return fb
	end
	return existingStroke
end

function UIKit.AttachShadow(parent: GuiObject, offsetY: number?, transparency: number?)
	return UIKit.AttachDropShadow(parent, offsetY, transparency, nil, true)
end

export type GlossySurfaceOptions = {
	GradientKey: string?,
	BaseColor: Color3?,
	CornerRadius: UDim?,
	StrokeColor: Color3?,
	StrokeThickness: number?,
	InnerHighlight: boolean?,
	MultiplyTint: boolean?,
}

function UIKit.ApplyGlossySurface(target: GuiObject, opts: GlossySurfaceOptions?)
	local o = opts or ({} :: GlossySurfaceOptions)
	local existingCorner = target:FindFirstChildOfClass("UICorner")
	local corner = existingCorner or Instance.new("UICorner")
	corner.CornerRadius = o.CornerRadius or UIKit.Tokens.Radii.Panel
	if not existingCorner then
		corner.Parent = target
	end

	local seq: ColorSequence
	local rot: number
	if o.MultiplyTint then
		seq = ColorSequence.new({
			ColorSequenceKeypoint.new(0.0, Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(0.28, Color3.fromRGB(252, 252, 255)),
			ColorSequenceKeypoint.new(0.65, Color3.fromRGB(232, 236, 246)),
			ColorSequenceKeypoint.new(1.0, Color3.fromRGB(184, 192, 212)),
		})
		rot = -38
	else
		seq, rot = UIKit.CreateColorSequenceFromRecipe(o.GradientKey, o.BaseColor or target.BackgroundColor3)
		target.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	end

	local existingGrad = target:FindFirstChild("GlossGradient")
	local grad = if existingGrad and existingGrad:IsA("UIGradient") then existingGrad else Instance.new("UIGradient")
	grad.Name = "GlossGradient"
	grad.Rotation = rot
	grad.Color = seq
	grad.Parent = target

	if o.InnerHighlight ~= false then
		UIKit.AttachStackedStrokes(target, {
			OuterColor = o.StrokeColor or UIKit.Tokens.Colors.OutlineInk,
			OuterThickness = o.StrokeThickness or UIKit.Tokens.Strokes.Panel,
			CornerRadius = corner.CornerRadius,
		})
	else
		local outer = Instance.new("UIStroke")
		outer.Name = "OuterStroke"
		outer.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		outer.Color = o.StrokeColor or UIKit.Tokens.Colors.OutlineInk
		outer.Thickness = o.StrokeThickness or UIKit.Tokens.Strokes.Panel
		outer.LineJoinMode = if (corner.CornerRadius.Scale &gt;= 0.49 or corner.CornerRadius.Offset &gt;= 24) then Enum.LineJoinMode.Round else UIKit.Tokens.Strokes.LineJoin
		outer.Parent = target
	end
end

export type ShineSweepOptions = {
	Rotation: number?,
	Duration: number?,
	Delay: number?,
	Loop: boolean?,
	AutoPlay: boolean?,
	TriggerOnHover: GuiButton?,
	ZIndex: number?,
}

function UIKit.CreateShineSweep(target: GuiObject, opts: ShineSweepOptions?)
	local o = opts or ({} :: ShineSweepOptions)
	local dur = o.Duration or UIKit.Tokens.Gradients.ShineSweep.Duration
	local rot = o.Rotation or UIKit.Tokens.Gradients.ShineSweep.Rotation

	local container = Instance.new("Frame")
	container.Name = "ShineContainer"
	container.Size = UDim2.fromScale(1, 1)
	container.BackgroundTransparency = 1
	container.ClipsDescendants = true
	container.BorderSizePixel = 0
	container.ZIndex = o.ZIndex or math.max(4, target.ZIndex + 2)
	container.Parent = target

	local targetCorner = target:FindFirstChildOfClass("UICorner")
	if targetCorner then
		local c = Instance.new("UICorner")
		c.CornerRadius = targetCorner.CornerRadius
		c.Parent = container
	end

	local sweep = Instance.new("Frame")
	sweep.Name = "ShineSweep"
	sweep.Size = UDim2.fromScale(1, 1)
	sweep.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	sweep.BackgroundTransparency = 0
	sweep.BorderSizePixel = 0
	sweep.Parent = container

	local grad = Instance.new("UIGradient")
	grad.Name = "SweepGradient"
	grad.Rotation = rot
	grad.Offset = Vector2.new(-1.35, 0)
	grad.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
	grad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0.0, 1.0),
		NumberSequenceKeypoint.new(0.32, 0.96),
		NumberSequenceKeypoint.new(0.50, 0.45),
		NumberSequenceKeypoint.new(0.68, 0.96),
		NumberSequenceKeypoint.new(1.0, 1.0),
	})
	grad.Parent = sweep

	local activeTween: Tween? = nil
	local looping = false
	local lastTrigger = 0

	if UIKit.IsReducedMotion() then
		container.Visible = false
		return {
			Overlay = container,
			Play = function() end,
			Stop = function() end,
		}
	end

	local function playOnce()
		local now = os.clock()
		if now - lastTrigger &lt; (dur * 0.6) then
			return
		end
		lastTrigger = now
		if activeTween then
			activeTween:Cancel()
		end
		grad.Offset = Vector2.new(-1.35, 0)
		local info = TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		activeTween = TweenService:Create(grad, info, { Offset = Vector2.new(1.35, 0) })
		if activeTween then
			activeTween:Play()
		end
	end

	if o.TriggerOnHover then
		o.TriggerOnHover.MouseEnter:Connect(playOnce)
	end

	if o.Loop then
		looping = true
		task.spawn(function()
			local delaySec = o.Delay or 2.8
			while looping and container.Parent ~= nil do
				if not UIKit.IsReducedMotion() then
					playOnce()
				end
				task.wait(dur + delaySec)
			end
		end)
	elseif o.AutoPlay then
		task.defer(playOnce)
	end

	container.AncestryChanged:Connect(function(_, newParent)
		if not newParent then
			looping = false
			if activeTween then
				activeTween:Cancel()
			end
		end
	end)

	return {
		Overlay = container,
		Play = playOnce,
		Stop = function()
			looping = false
			if activeTween then
				activeTween:Cancel()
			end
		end,
	}
end

export type SunburstOptions = {
	Color: Color3?,
	RayCount: number?,
	Transparency: number?,
	RotateSpeed: number?,
	ZIndex: number?,
}

function UIKit.CreateSunburstRays(parent: GuiObject, opts: SunburstOptions?): Frame
	local o = opts or ({} :: SunburstOptions)
	local count = math.clamp(o.RayCount or UIKit.Tokens.Motifs.RayCount or 12, 4, 20)
	local rayColor = o.Color or UIKit.Tokens.Colors.Gold
	local baseAlpha = if o.Transparency ~= nil then o.Transparency else 0.72

	local container = Instance.new("Frame")
	container.Name = "SunburstRays"
	container.Size = UDim2.fromScale(1, 1)
	container.BackgroundTransparency = 1
	container.ClipsDescendants = true
	container.BorderSizePixel = 0
	container.ZIndex = o.ZIndex or math.max(1, parent.ZIndex)
	container.Parent = parent

	local hub = Instance.new("Frame")
	hub.Name = "RayHub"
	hub.Size = UDim2.fromScale(1, 1)
	hub.Position = UDim2.fromScale(0.5, 0.5)
	hub.AnchorPoint = Vector2.new(0.5, 0.5)
	hub.BackgroundTransparency = 1
	hub.Parent = container

	for i = 1, count do
		local angle = (i - 1) * (360 / count)
		local ray = Instance.new("Frame")
		ray.Name = string.format("Ray_%02d", i)
		-- Keep rotated rays inside container bounds so layout/audit bounds stay clean
		ray.Size = UDim2.fromScale(0.76, 0.13)
		ray.Position = UDim2.fromScale(0.5, 0.5)
		ray.AnchorPoint = Vector2.new(0.5, 0.5)
		ray.Rotation = angle
		ray.BackgroundColor3 = rayColor
		ray.BackgroundTransparency = 0
		ray.BorderSizePixel = 0
		ray.Parent = hub

		local uig = Instance.new("UIGradient")
		uig.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0.0, 1.0),
			NumberSequenceKeypoint.new(0.28, baseAlpha),
			NumberSequenceKeypoint.new(0.50, math.max(0.45, baseAlpha - 0.12)),
			NumberSequenceKeypoint.new(0.72, baseAlpha),
			NumberSequenceKeypoint.new(1.0, 1.0),
		})
		uig.Parent = ray
	end

	local speed = o.RotateSpeed or 12
	if speed ~= 0 and RunService:IsRunning() and not UIKit.IsReducedMotion() then
		local conn: RBXScriptConnection? = nil
		conn = RunService.RenderStepped:Connect(function(dt: number)
			if not container.Parent or UIKit.IsReducedMotion() then
				if conn then
					conn:Disconnect()
					conn = nil
				end
				return
			end
			hub.Rotation = (hub.Rotation + speed * dt) % 360
		end)
		container.AncestryChanged:Connect(function(_, newParent)
			if not newParent and conn then
				conn:Disconnect()
				conn = nil
			end
		end)
	end

	return container
end

export type BadgePillOptions = {
	Name: string?,
	Parent: Instance?,
	Text: string,
	Color: Color3?,
	TextColor: Color3?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Rotation: number?,
	TextSize: number?,
	ZIndex: number?,
}

function UIKit.CreateBadgePill(opts: BadgePillOptions): Frame
	local pill = Instance.new("Frame")
	pill.Name = opts.Name or "BadgePill"
	pill.Size = opts.Size or UDim2.fromOffset(78, 24)
	pill.Position = opts.Position or UDim2.new(1, -6, 0, -4)
	pill.AnchorPoint = opts.AnchorPoint or Vector2.new(1, 0)
	pill.Rotation = if opts.Rotation ~= nil then opts.Rotation else UIKit.Tokens.Motifs.BadgeRotation
	pill.BorderSizePixel = 0
	pill.ZIndex = opts.ZIndex or 8

	local baseColor = opts.Color or UIKit.Tokens.Colors.Accent
	UIKit.ApplyGlossySurface(pill, {
		BaseColor = baseColor,
		CornerRadius = UIKit.Tokens.Radii.Pill,
		StrokeColor = UIKit.Tokens.Colors.OutlineInk,
		StrokeThickness = math.max(2, UIKit.Tokens.Strokes.OuterInk * 0.65),
		InnerHighlight = false,
	})

	local lbl = Instance.new("TextLabel")
	lbl.Name = "Text"
	lbl.Size = UDim2.new(1, -10, 1, 0)
	lbl.Position = UDim2.fromOffset(5, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = opts.Text
	lbl.TextColor3 = opts.TextColor or UIKit.PickReadableTextColor(baseColor)
	lbl.TextSize = opts.TextSize or 11
	lbl.FontFace = UIKit.Tokens.Fonts.Title
	lbl.ZIndex = pill.ZIndex + 1
	lbl.Parent = pill
	UIKit.AttachTextStroke(lbl, UIKit.Tokens.Colors.OutlineInk, math.max(1.5, UIKit.Tokens.Strokes.Text * 0.8), 0.1)

	pill.Parent = opts.Parent
	return pill
end

-- Dedicated CanvasGroup container for fade-only modal transitions (stay &lt;= 6 CanvasGroups total)
function UIKit.CreateModalFadeGroup(
	name: string?,
	parent: Instance?,
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?
): CanvasGroup
	local group = Instance.new("CanvasGroup")
	group.Name = name or "ModalFadeGroup"
	group.Size = size or UDim2.fromScale(1, 1)
	group.Position = position or UDim2.fromScale(0.5, 0.5)
	group.AnchorPoint = anchorPoint or Vector2.new(0.5, 0.5)
	group.BackgroundTransparency = 1
	group.BorderSizePixel = 0
	group.GroupTransparency = 0
	group.Parent = parent
	return group
end

function UIKit.AttachButtonJuice(button: GuiButton, visualTarget: GuiObject?, onActivate: (() -&gt; ())?)
	local target = visualTarget or button
	local scale = target:FindFirstChild("JuiceScale") :: UIScale?
	if not scale then
		local newScale = Instance.new("UIScale")
		newScale.Name = "JuiceScale"
		newScale.Scale = 1
		newScale.Parent = target
		scale = newScale
	end
	local uiScale = scale :: UIScale
	local fastTween = TweenInfo.new(0.11, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

	button.MouseEnter:Connect(function()
		UIKit.Tween(uiScale, fastTween, { Scale = 1.03 })
	end)
	button.MouseLeave:Connect(function()
		UIKit.Tween(uiScale, fastTween, { Scale = 1.0 })
	end)
	button.MouseButton1Down:Connect(function()
		UIKit.Tween(uiScale, TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 0.96 })
	end)
	button.MouseButton1Up:Connect(function()
		UIKit.Tween(uiScale, fastTween, { Scale = 1.02 })
	end)
	button.Activated:Connect(function()
		if onActivate then
			onActivate()
		end
	end)
end

function UIKit.AttachPresetOrnament(target: GuiObject, ornamentKind: string?): Instance?
	if target:FindFirstChildWhichIsA("UIGridStyleLayout") ~= nil then
		return nil
	end

	local existing = target:FindFirstChild("PresetOrnament")
	if existing then
		existing:Destroy()
	end

	local resolvedKind = ornamentKind
	if not resolvedKind or resolvedKind == "" then
		local tContent = UIKit.Tokens.Content :: any
		resolvedKind = if typeof(tContent) == "table" and typeof(tContent.OrnamentKind) == "string" and tContent.OrnamentKind ~= ""
			then tContent.OrnamentKind
			else (PRESET_ORNAMENT_MAP[UIKit.Tokens.Meta.PresetId] or "arcane_filigree")
	end

	local c = UIKit.Tokens.Colors
	local container = Instance.new("Frame")
	container.Name = "PresetOrnament"
	container.Size = UDim2.fromScale(1, 1)
	container.Position = UDim2.fromOffset(0, 0)
	container.BackgroundTransparency = 1
	container.BorderSizePixel = 0
	container.ClipsDescendants = true
	container.Active = false
	container.Selectable = false
	container.ZIndex = 0
	container:SetAttribute("OrnamentKind", resolvedKind)

	local existingCorner = target:FindFirstChildOfClass("UICorner")
	if existingCorner then
		local cnr = Instance.new("UICorner")
		cnr.Name = "Corner"
		cnr.CornerRadius = existingCorner.CornerRadius
		cnr.Parent = container
	end

	local function makeDecor(
		name: string,
		size: UDim2,
		pos: UDim2,
		anchor: Vector2,
		color: Color3,
		trans: number,
		rot: number?
	): Frame
		local f = Instance.new("Frame")
		f.Name = name
		f.Size = size
		f.Position = pos
		f.AnchorPoint = anchor
		f.BackgroundColor3 = color
		f.BackgroundTransparency = trans
		f.BorderSizePixel = 0
		f.Rotation = rot or 0
		f.Active = false
		f.Selectable = false
		f.ZIndex = 0
		f.Parent = container
		return f
	end

	if resolvedKind == "holo_brackets" then
		local bracketColor = c.BorderBright
		local accentColor = c.Accent
		makeDecor("BracketTL_H", UDim2.fromOffset(10, 2), UDim2.fromOffset(4, 4), Vector2.new(0, 0), bracketColor, 0.12)
		makeDecor("BracketTL_V", UDim2.fromOffset(2, 10), UDim2.fromOffset(4, 4), Vector2.new(0, 0), bracketColor, 0.12)
		makeDecor("BracketTR_H", UDim2.fromOffset(10, 2), UDim2.new(1, -4, 0, 4), Vector2.new(1, 0), bracketColor, 0.12)
		makeDecor("BracketTR_V", UDim2.fromOffset(2, 10), UDim2.new(1, -4, 0, 4), Vector2.new(1, 0), bracketColor, 0.12)
		makeDecor("BracketBL_H", UDim2.fromOffset(10, 2), UDim2.new(0, 4, 1, -4), Vector2.new(0, 1), bracketColor, 0.12)
		makeDecor("BracketBL_V", UDim2.fromOffset(2, 10), UDim2.new(0, 4, 1, -4), Vector2.new(0, 1), bracketColor, 0.12)
		makeDecor("BracketBR_H", UDim2.fromOffset(10, 2), UDim2.new(1, -4, 1, -4), Vector2.new(1, 1), bracketColor, 0.12)
		makeDecor("BracketBR_V", UDim2.fromOffset(2, 10), UDim2.new(1, -4, 1, -4), Vector2.new(1, 1), bracketColor, 0.12)
		makeDecor("HoloTickTL", UDim2.fromOffset(4, 2), UDim2.fromOffset(16, 4), Vector2.new(0, 0), accentColor, 0.25)
		makeDecor("HoloTickBR", UDim2.fromOffset(4, 2), UDim2.new(1, -16, 1, -4), Vector2.new(1, 1), accentColor, 0.25)
		makeDecor("HoloTopScan", UDim2.new(0.28, 0, 0, 1), UDim2.new(0.5, 0, 0, 4), Vector2.new(0.5, 0), accentColor, 0.55)
	elseif resolvedKind == "cyber_slash" then
		local s1 = makeDecor("SlashTL_Main", UDim2.fromOffset(24, 3), UDim2.fromOffset(20, 9), Vector2.new(0.5, 0.5), c.Accent, 0.16, -18)
		local g1 = Instance.new("UIGradient")
		g1.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05),
			NumberSequenceKeypoint.new(0.7, 0.15),
			NumberSequenceKeypoint.new(1, 0.85),
		})
		g1.Parent = s1
		makeDecor("SlashTL_Sub", UDim2.fromOffset(14, 2), UDim2.fromOffset(24, 14), Vector2.new(0.5, 0.5), c.Primary, 0.24, -18)

		local s2 = makeDecor("SlashBR_Main", UDim2.fromOffset(24, 3), UDim2.new(1, -20, 1, -9), Vector2.new(0.5, 0.5), c.Primary, 0.16, -18)
		local g2 = Instance.new("UIGradient")
		g2.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.85),
			NumberSequenceKeypoint.new(0.3, 0.15),
			NumberSequenceKeypoint.new(1, 0.05),
		})
		g2.Parent = s2
		makeDecor("SlashBR_Sub", UDim2.fromOffset(14, 2), UDim2.new(1, -24, 1, -14), Vector2.new(0.5, 0.5), c.Accent, 0.24, -18)
	elseif resolvedKind == "bubble_shine" then
		local sheen = makeDecor("GlossPillTL", UDim2.new(0.32, 0, 0, 5), UDim2.fromOffset(10, 5), Vector2.new(0, 0), c.InnerHighlight, 0.60)
		local sc = Instance.new("UICorner")
		sc.CornerRadius = UDim.new(1, 0)
		sc.Parent = sheen
		local sg = Instance.new("UIGradient")
		sg.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.0),
			NumberSequenceKeypoint.new(0.65, 0.25),
			NumberSequenceKeypoint.new(1, 1.0),
		})
		sg.Parent = sheen

		local d1 = makeDecor("SpecularDotA", UDim2.fromOffset(6, 6), UDim2.new(1, -14, 0, 6), Vector2.new(0.5, 0), c.InnerHighlight, 0.56)
		local c1 = Instance.new("UICorner")
		c1.CornerRadius = UDim.new(1, 0)
		c1.Parent = d1

		local d2 = makeDecor("SpecularDotB", UDim2.fromOffset(4, 4), UDim2.new(1, -23, 0, 8), Vector2.new(0.5, 0), c.InnerHighlight, 0.66)
		local c2 = Instance.new("UICorner")
		c2.CornerRadius = UDim.new(1, 0)
		c2.Parent = d2
	elseif resolvedKind == "comic_stripe" then
		local stripe1 = makeDecor("ComicRibbonTR", UDim2.fromOffset(22, 5), UDim2.new(1, -20, 0, 10), Vector2.new(0.5, 0.5), c.Accent, 0.14, -16)
		local st1 = Instance.new("UIStroke")
		st1.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		st1.Color = c.OutlineInk
		st1.Thickness = 1.4
		st1.Transparency = 0.15
		st1.Parent = stripe1

		makeDecor("ComicRibbonTR_Sub", UDim2.fromOffset(12, 3), UDim2.new(1, -15, 0, 16), Vector2.new(0.5, 0.5), c.Primary, 0.20, -16)
		makeDecor("ComicRibbonBL", UDim2.fromOffset(14, 4), UDim2.new(0, 16, 1, -9), Vector2.new(0.5, 0.5), c.Accent, 0.24, -16)
	elseif resolvedKind == "stitched_warm" then
		local inset = makeDecor("WarmInsetBorder", UDim2.new(1, -10, 1, -10), UDim2.fromOffset(5, 5), Vector2.new(0, 0), c.Gold, 1)
		local insetCorner = Instance.new("UICorner")
		local baseR = if existingCorner then existingCorner.CornerRadius else UIKit.Tokens.Radii.Panel
		insetCorner.CornerRadius = UDim.new(baseR.Scale, math.max(0, baseR.Offset - 4))
		insetCorner.Parent = inset
		local insetStroke = Instance.new("UIStroke")
		insetStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		insetStroke.Color = c.Gold
		insetStroke.Thickness = 1.2
		insetStroke.Transparency = 0.58
		insetStroke.Parent = inset

		local function makeStitch(sName: string, pos: UDim2, anchor: Vector2, col: Color3)
			local st = makeDecor(sName, UDim2.fromOffset(7, 2), pos, anchor, col, 0.45)
			local sc = Instance.new("UICorner")
			sc.CornerRadius = UDim.new(1, 0)
			sc.Parent = st
		end
		makeStitch("StitchTL", UDim2.fromOffset(14, 4), Vector2.new(0, 0), c.InnerHighlight)
		makeStitch("StitchTR", UDim2.new(1, -14, 0, 4), Vector2.new(1, 0), c.Gold)
		makeStitch("StitchBL", UDim2.new(0, 14, 1, -4), Vector2.new(0, 1), c.Gold)
		makeStitch("StitchBR", UDim2.new(1, -14, 1, -4), Vector2.new(1, 1), c.InnerHighlight)
	else
		-- "arcane_filigree" (default)
		makeDecor("DiamondTL", UDim2.fromOffset(6, 6), UDim2.fromOffset(8, 8), Vector2.new(0.5, 0.5), c.Gold, 0.18, 45)
		makeDecor("DiamondTR", UDim2.fromOffset(6, 6), UDim2.new(1, -8, 0, 8), Vector2.new(0.5, 0.5), c.Accent, 0.24, 45)
		makeDecor("DiamondBL", UDim2.fromOffset(6, 6), UDim2.new(0, 8, 1, -8), Vector2.new(0.5, 0.5), c.Accent, 0.24, 45)
		makeDecor("DiamondBR", UDim2.fromOffset(6, 6), UDim2.new(1, -8, 1, -8), Vector2.new(0.5, 0.5), c.Gold, 0.18, 45)
		makeDecor("FiligreeTop", UDim2.new(1, -30, 0, 1), UDim2.fromOffset(15, 7), Vector2.new(0, 0), c.Gold, 0.58)
		makeDecor("FiligreeBottom", UDim2.new(1, -30, 0, 1), UDim2.new(0, 15, 1, -8), Vector2.new(0, 0), c.Gold, 0.58)
	end

	container.Parent = target
	return container
end

local function resolveDefaultAnchorPoint(position: UDim2?, anchorPoint: Vector2?): Vector2
	if anchorPoint ~= nil then
		return anchorPoint
	end
	if
		position ~= nil
		and position.X.Scale == 0
		and position.Y.Scale == 0
		and (position.X.Offset ~= 0 or position.Y.Offset ~= 0)
	then
		return Vector2.zero
	end
	return Vector2.new(0.5, 0.5)
end

export type PanelOptions = {
	Name: string?,
	Parent: Instance?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	BackgroundColor3: Color3?,
	BackgroundTransparency: number?,
	CornerRadius: UDim?,
	StrokeColor: Color3?,
	StrokeThickness: number?,
	Use9Slice: boolean?,
	AddShadow: boolean?,
	Glossy: boolean?,
	NoOrnament: boolean?,
}

function UIKit.CreatePanel(opts: PanelOptions): GuiObject
	local assets = UIKit.Assets
	local resolvedAnchor = resolveDefaultAnchorPoint(opts.Position, opts.AnchorPoint)
	if opts.Use9Slice and assets.Panel9SliceId and assets.Panel9SliceCenter then
		local img = Instance.new("ImageLabel")
		img.Name = opts.Name or "Panel"
		img.Size = opts.Size or UDim2.fromOffset(320, 240)
		img.Position = opts.Position or UDim2.fromScale(0.5, 0.5)
		img.AnchorPoint = resolvedAnchor
		img.BackgroundTransparency = 1
		img.Image = assets.Panel9SliceId
		img.ScaleType = Enum.ScaleType.Slice
		img.SliceCenter = assets.Panel9SliceCenter
		img.SliceScale = assets.PanelSliceScale or 0.22
		if opts.NoOrnament ~= true then
			UIKit.AttachPresetOrnament(img)
		end
		img.Parent = opts.Parent
		return img
	end

	local frame = Instance.new("Frame")
	frame.Name = opts.Name or "Panel"
	frame.Size = opts.Size or UDim2.fromOffset(320, 240)
	frame.Position = opts.Position or UDim2.fromScale(0.5, 0.5)
	frame.AnchorPoint = resolvedAnchor
	frame.BackgroundColor3 = opts.BackgroundColor3 or UIKit.Tokens.Colors.BgPanel
	frame.BackgroundTransparency = if opts.BackgroundTransparency ~= nil then opts.BackgroundTransparency else 0.04
	frame.BorderSizePixel = 0

	local radius = opts.CornerRadius or UIKit.Tokens.Radii.Panel
	local corner = Instance.new("UICorner")
	corner.Name = "Corner"
	corner.CornerRadius = radius
	corner.Parent = frame

	if opts.Glossy ~= false and opts.BackgroundColor3 == nil then
		local seq, rot = UIKit.CreateColorSequenceFromRecipe("Panel", UIKit.Tokens.Colors.BgPanel)
		frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		local pGrad = Instance.new("UIGradient")
		pGrad.Name = "SurfaceGradient"
		pGrad.Rotation = rot
		pGrad.Color = seq
		pGrad.Parent = frame
	end

	UIKit.AttachStackedStrokes(frame, {
		OuterColor = opts.StrokeColor or UIKit.Tokens.Colors.OutlineInk,
		OuterThickness = opts.StrokeThickness or UIKit.Tokens.Strokes.Panel,
		InnerTransparency = 0.72,
		CornerRadius = radius,
	})

	if opts.NoOrnament ~= true then
		UIKit.AttachPresetOrnament(frame)
	end

	frame.Parent = opts.Parent
	if opts.AddShadow then
		UIKit.AttachDropShadow(frame, UIKit.Tokens.Shadows.OffsetY + 2, UIKit.Tokens.Shadows.Transparency, nil, true)
	end

	return frame
end

export type ButtonOptions = {
	Name: string?,
	Parent: Instance?,
	Text: string?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	LayoutOrder: number?,
	Variant: ("Primary" | "Secondary" | "Accent" | "Success" | "Warning" | "Danger")?,
	Color: Color3?,
	TextColor: Color3?,
	TextSize: number?,
	Use9Slice: boolean?,
	OnClick: (() -&gt; ())?,
}

function UIKit.CreateButton(opts: ButtonOptions): GuiButton
	local variant = opts.Variant or "Primary"
	local variantColors = {
		Primary = UIKit.Tokens.Colors.Primary,
		Secondary = UIKit.Tokens.Colors.Secondary,
		Accent = UIKit.Tokens.Colors.Accent,
		Success = UIKit.Tokens.Colors.Success,
		Warning = UIKit.Tokens.Colors.Warning,
		Danger = UIKit.Tokens.Colors.Danger,
	}
	local fillColor = opts.Color or variantColors[variant] or UIKit.Tokens.Colors.Primary
	local textColor = opts.TextColor or UIKit.PickReadableTextColor(fillColor)
	local assets = UIKit.Assets

	if opts.Use9Slice and assets.Button9SliceId and assets.Button9SliceCenter then
		local imgBtn = Instance.new("ImageButton")
		imgBtn.Name = opts.Name or "ActionButton"
		imgBtn.Size = opts.Size or UDim2.fromOffset(140, 52)
		imgBtn.Position = opts.Position or UDim2.new()
		imgBtn.AnchorPoint = opts.AnchorPoint or Vector2.zero
		imgBtn.LayoutOrder = opts.LayoutOrder or 0
		imgBtn.BackgroundTransparency = 1
		imgBtn.Image = assets.Button9SliceId
		imgBtn.ImageColor3 = fillColor
		imgBtn.ScaleType = Enum.ScaleType.Slice
		imgBtn.SliceCenter = assets.Button9SliceCenter
		imgBtn.SliceScale = assets.ButtonSliceScale or 0.32
		imgBtn.AutoButtonColor = false

		local lbl = Instance.new("TextLabel")
		lbl.Name = "Label"
		lbl.Size = UDim2.new(1, -16, 1, 0)
		lbl.Position = UDim2.fromOffset(8, 0)
		lbl.BackgroundTransparency = 1
		lbl.Text = opts.Text or "Action"
		lbl.TextColor3 = textColor
		lbl.TextSize = opts.TextSize or 15
		lbl.FontFace = UIKit.Tokens.Fonts.Heading
		lbl.Parent = imgBtn
		UIKit.AttachTextStroke(lbl)

		UIKit.EnsureMinTouchTarget(imgBtn)
		UIKit.AttachButtonJuice(imgBtn, imgBtn, opts.OnClick)
		imgBtn.Parent = opts.Parent
		return imgBtn
	end

	local btn = Instance.new("TextButton")
	btn.Name = opts.Name or "ActionButton"
	btn.Size = opts.Size or UDim2.fromOffset(140, 52)
	btn.Position = opts.Position or UDim2.new()
	btn.AnchorPoint = opts.AnchorPoint or Vector2.zero
	btn.LayoutOrder = opts.LayoutOrder or 0
	-- Leave BackgroundColor3 unmodified only when an ancestor StyleLink binds UIStyles so :Hover/:Press apply.
	local hasStyleLink = false
	local curAnc: Instance? = opts.Parent
	while curAnc do
		if curAnc:FindFirstChildOfClass("StyleLink") ~= nil then
			hasStyleLink = true
			break
		end
		curAnc = curAnc.Parent
	end
	if opts.Color ~= nil or ReplicatedStorage:FindFirstChild("UIStyles") == nil or not hasStyleLink then
		btn.BackgroundColor3 = fillColor
		btn.TextColor3 = textColor
	elseif opts.TextColor ~= nil then
		btn.TextColor3 = textColor
	end
	btn.Text = opts.Text or "Action"
	btn.TextSize = opts.TextSize or 15
	btn.FontFace = UIKit.Tokens.Fonts.Heading
	btn.AutoButtonColor = false
	btn.BorderSizePixel = 0

	local variantTag = if variantColors[variant] then ("Button" .. variant) else "ButtonPrimary"
	CollectionService:AddTag(btn, variantTag)

	local corner = Instance.new("UICorner")
	corner.Name = "Corner"
	corner.CornerRadius = UIKit.Tokens.Radii.Button
	corner.Parent = btn

	UIKit.AttachStackedStrokes(btn, {
		OuterColor = UIKit.Tokens.Colors.OutlineInk,
		OuterThickness = math.max(2.5, UIKit.Tokens.Strokes.OuterInk * 0.8),
		InnerTransparency = 0.45,
		CornerRadius = UIKit.Tokens.Radii.Button,
	})
	UIKit.AttachTextStroke(btn, UIKit.Tokens.Colors.OutlineInk, UIKit.Tokens.Strokes.Text * 0.85, 0.15, textColor)

	local grad = Instance.new("UIGradient")
	grad.Name = "Highlight"
	grad.Rotation = -38
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(0.28, Color3.fromRGB(250, 252, 255)),
		ColorSequenceKeypoint.new(0.66, Color3.fromRGB(232, 236, 246)),
		ColorSequenceKeypoint.new(1.0, Color3.fromRGB(184, 192, 212)),
	})
	grad.Parent = btn

	UIKit.EnsureMinTouchTarget(btn)
	UIKit.AttachButtonJuice(btn, btn, opts.OnClick)
	btn.Parent = opts.Parent
	return btn
end

export type GlossyButtonOptions = {
	Name: string?,
	Parent: Instance?,
	Text: string?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	LayoutOrder: number?,
	Variant: ("Primary" | "Secondary" | "Accent" | "Success" | "Warning" | "Danger" | "Gold")?,
	Color: Color3?,
	TextColor: Color3?,
	TextSize: number?,
	CornerRadius: UDim?,
	IconKey: string?,
	IconFallback: string?,
	EnableShine: boolean?,
	ZIndex: number?,
	OnClick: (() -&gt; ())?,
}

function UIKit.CreateGlossyButton(opts: GlossyButtonOptions): GuiButton
	local variant = opts.Variant or "Primary"
	local variantColors: { [string]: Color3 } = {
		Primary = UIKit.Tokens.Colors.Primary,
		Secondary = UIKit.Tokens.Colors.Secondary,
		Accent = UIKit.Tokens.Colors.Accent,
		Success = UIKit.Tokens.Colors.Success,
		Warning = UIKit.Tokens.Colors.Warning,
		Danger = UIKit.Tokens.Colors.Danger,
		Gold = UIKit.Tokens.Colors.Gold,
	}
	local variantTextColors: { [string]: Color3 } = {
		Primary = UIKit.Tokens.Colors.TextOnPrimary,
		Secondary = UIKit.Tokens.Colors.TextOnSecondary,
		Accent = UIKit.Tokens.Colors.TextOnAccent,
		Success = UIKit.Tokens.Colors.TextOnSuccess,
		Warning = UIKit.Tokens.Colors.TextOnWarning,
		Danger = UIKit.Tokens.Colors.TextOnDanger,
		Gold = UIKit.Tokens.Colors.TextOnWarning,
	}
	local fillColor = opts.Color or variantColors[variant] or UIKit.Tokens.Colors.Primary
	local defaultText = variantTextColors[variant] or UIKit.Tokens.Colors.TextPrimary
	local textColor = opts.TextColor or (if opts.Color ~= nil then UIKit.PickReadableTextColor(fillColor) else defaultText)
	local radius = opts.CornerRadius or UIKit.Tokens.Radii.Button
	local sx = UIKit.Tokens.Shadows.OffsetX
	local sy = math.max(3, UIKit.Tokens.Shadows.OffsetY)
	local pressY = math.clamp(UIKit.Tokens.Shadows.PressOffsetY, 2, sy)
	local baseZ = opts.ZIndex or 2

	local root = Instance.new("TextButton")
	root.Name = opts.Name or "GlossyButton"
	root.Size = opts.Size or UDim2.fromOffset(168, 54)
	root.Position = opts.Position or UDim2.new()
	root.AnchorPoint = opts.AnchorPoint or Vector2.zero
	root.LayoutOrder = opts.LayoutOrder or 0
	root.BackgroundTransparency = 1
	root.Text = ""
	root.AutoButtonColor = false
	root.BorderSizePixel = 0
	root.ZIndex = baseZ
	UIKit.EnsureMinTouchTarget(root, 44)

	local faceSize = UDim2.new(1, -math.abs(sx), 1, -sy)
	local faceRestPos = UDim2.fromOffset(0, 0)
	local shadowRestPos = UDim2.fromOffset(sx, sy)

	local dropShadow = Instance.new("Frame")
	dropShadow.Name = "DropShadow"
	dropShadow.Size = faceSize
	dropShadow.Position = shadowRestPos
	dropShadow.BackgroundColor3 = UIKit.Tokens.Shadows.Color
	dropShadow.BackgroundTransparency = math.clamp(UIKit.Tokens.Shadows.Transparency, 0.05, 0.55)
	dropShadow.BorderSizePixel = 0
	dropShadow.ZIndex = baseZ
	dropShadow.Parent = root

	local dCorner = Instance.new("UICorner")
	dCorner.CornerRadius = radius
	dCorner.Parent = dropShadow

	local face = Instance.new("Frame")
	face.Name = "Face"
	face.Size = faceSize
	face.Position = faceRestPos
	face.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	face.BorderSizePixel = 0
	face.ZIndex = baseZ + 1
	face.Parent = root

	local fCorner = Instance.new("UICorner")
	fCorner.CornerRadius = radius
	fCorner.Parent = face

	local recipeKey: any = if opts.Color ~= nil then nil else variant
	local seq, rot = UIKit.CreateColorSequenceFromRecipe(recipeKey, fillColor)
	local grad = Instance.new("UIGradient")
	grad.Name = "GlossGradient"
	grad.Rotation = rot
	grad.Color = seq
	grad.Parent = face

	UIKit.AttachStackedStrokes(face, {
		OuterColor = UIKit.Tokens.Colors.OutlineInk,
		OuterThickness = UIKit.Tokens.Strokes.OuterInk,
		InnerColor = UIKit.Tokens.Colors.InnerHighlight,
		InnerThickness = UIKit.Tokens.Strokes.InnerHighlight,
		InnerTransparency = 0.40,
		CornerRadius = radius,
	})

	-- Try native UIShadow on Face; keep internal DropShadow visible only if UIShadow fails
	local uiShadow = tryAttachUIShadow(
		face,
		UIKit.Tokens.Shadows.Color,
		UIKit.Tokens.Shadows.Transparency,
		UIKit.Tokens.Shadows.BlurRadius,
		sx,
		sy
	)
	if uiShadow then
		dropShadow.Visible = false
	end

	local shineCtrl = nil
	if opts.EnableShine ~= false then
		shineCtrl = UIKit.CreateShineSweep(face, {
			TriggerOnHover = root,
			ZIndex = baseZ + 3,
		})
	end

	local labelLeftOffset = 12
	if opts.IconKey or opts.IconFallback then
		local icon = UIKit.CreateBadgeIcon(face, opts.IconKey or "", opts.IconFallback or "*", fillColor, 26)
		icon.Position = UDim2.new(0, 12, 0.5, 0)
		icon.AnchorPoint = Vector2.new(0, 0.5)
		icon.ZIndex = baseZ + 4
		labelLeftOffset = 44
	end

	local lbl = Instance.new("TextLabel")
	lbl.Name = "Label"
	lbl.Size = UDim2.new(1, -(labelLeftOffset + 12), 1, 0)
	lbl.Position = UDim2.fromOffset(labelLeftOffset, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = opts.Text or "Action"
	lbl.TextColor3 = textColor
	lbl.TextSize = opts.TextSize or 16
	lbl.FontFace = UIKit.Tokens.Fonts.Heading
	lbl.ZIndex = baseZ + 5
	lbl.Parent = face
	UIKit.AttachTextStroke(lbl, UIKit.Tokens.Colors.OutlineInk, UIKit.Tokens.Strokes.Text, 0.1)

	local scale = Instance.new("UIScale")
	scale.Name = "JuiceScale"
	scale.Scale = 1
	scale.Parent = root

	local hoverInfo = TweenInfo.new(0.11, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	local pressInfo = TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local pressedPos = UDim2.fromOffset(math.min(sx, 2), pressY)

	root.MouseEnter:Connect(function()
		UIKit.Tween(scale, hoverInfo, { Scale = 1.03 })
	end)
	root.MouseLeave:Connect(function()
		UIKit.Tween(scale, hoverInfo, { Scale = 1.0 })
		UIKit.Tween(face, pressInfo, { Position = faceRestPos, BackgroundColor3 = Color3.fromRGB(255, 255, 255) })
	end)
	root.MouseButton1Down:Connect(function()
		if UIKit.IsReducedMotion() then
			face.Position = pressedPos
			face.BackgroundColor3 = Color3.fromRGB(224, 224, 232)
			return
		end
		UIKit.Tween(face, pressInfo, { Position = pressedPos, BackgroundColor3 = Color3.fromRGB(224, 224, 232) })
		UIKit.Tween(scale, pressInfo, { Scale = 0.97 })
	end)
	root.MouseButton1Up:Connect(function()
		UIKit.Tween(face, hoverInfo, { Position = faceRestPos, BackgroundColor3 = Color3.fromRGB(255, 255, 255) })
		UIKit.Tween(scale, hoverInfo, { Scale = 1.02 })
	end)
	root.Activated:Connect(function()
		if shineCtrl then
			shineCtrl.Play()
		end
		if opts.OnClick then
			opts.OnClick()
		end
	end)

	root.Parent = opts.Parent
	return root
end

export type GlossyPanelOptions = {
	Name: string?,
	Parent: Instance?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Title: string?,
	HeaderColor: Color3?,
	CornerRadius: UDim?,
	StrokeColor: Color3?,
	ShowRays: boolean?,
	ShowClose: boolean?,
	ZIndex: number?,
	NoOrnament: boolean?,
}

function UIKit.CreateGlossyPanel(opts: GlossyPanelOptions)
	local radius = opts.CornerRadius or UIKit.Tokens.Radii.Panel
	local sy = math.max(4, UIKit.Tokens.Shadows.OffsetY + 1)
	local sx = UIKit.Tokens.Shadows.OffsetX
	local baseZ = opts.ZIndex or 2

	local root = Instance.new("Frame")
	root.Name = opts.Name or "GlossyPanel"
	root.Size = opts.Size or UDim2.fromOffset(380, 280)
	root.Position = opts.Position or UDim2.fromScale(0.5, 0.5)
	root.AnchorPoint = opts.AnchorPoint or Vector2.new(0.5, 0.5)
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.ZIndex = baseZ
	root.Parent = opts.Parent

	local faceSize = UDim2.new(1, -math.abs(sx), 1, -sy)
	local dropShadow = Instance.new("Frame")
	dropShadow.Name = "DropShadow"
	dropShadow.Size = faceSize
	dropShadow.Position = UDim2.fromOffset(sx, sy)
	dropShadow.BackgroundColor3 = UIKit.Tokens.Shadows.Color
	dropShadow.BackgroundTransparency = math.clamp(UIKit.Tokens.Shadows.Transparency, 0.08, 0.55)
	dropShadow.BorderSizePixel = 0
	dropShadow.ZIndex = baseZ
	dropShadow.Parent = root

	local dCorner = Instance.new("UICorner")
	dCorner.CornerRadius = radius
	dCorner.Parent = dropShadow

	local face = Instance.new("Frame")
	face.Name = "Face"
	face.Size = faceSize
	face.Position = UDim2.fromOffset(0, 0)
	face.BackgroundColor3 = UIKit.Tokens.Colors.BgPanel
	face.BorderSizePixel = 0
	face.ZIndex = baseZ + 1
	face.Parent = root

	UIKit.ApplyGlossySurface(face, {
		GradientKey = "Panel",
		BaseColor = UIKit.Tokens.Colors.BgPanel,
		CornerRadius = radius,
		StrokeColor = opts.StrokeColor or UIKit.Tokens.Colors.OutlineInk,
		StrokeThickness = UIKit.Tokens.Strokes.Panel,
		InnerHighlight = true,
	})

	local uiShadow = tryAttachUIShadow(
		face,
		UIKit.Tokens.Shadows.Color,
		UIKit.Tokens.Shadows.Transparency,
		UIKit.Tokens.Shadows.BlurRadius + 4,
		sx,
		sy
	)
	if uiShadow then
		dropShadow.Visible = false
	end

	if opts.NoOrnament ~= true then
		UIKit.AttachPresetOrnament(face)
	end

	if opts.ShowRays and UIKit.Tokens.Motifs.RaysEnabled then
		UIKit.CreateSunburstRays(face, {
			Color = opts.HeaderColor or UIKit.Tokens.Colors.Gold,
			Transparency = 0.84,
			RotateSpeed = 6,
			ZIndex = baseZ + 2,
		})
	end

	local header: Frame? = nil
	local titleLbl: TextLabel? = nil
	local closeBtn: GuiButton? = nil
	local topOffset = 12

	if opts.Title and opts.Title ~= "" then
		topOffset = 58
		local hdr = Instance.new("Frame")
		hdr.Name = "Header"
		hdr.Size = UDim2.new(1, -16, 0, 42)
		hdr.Position = UDim2.fromOffset(8, 8)
		hdr.BorderSizePixel = 0
		hdr.ZIndex = baseZ + 3
		hdr.Parent = face

		UIKit.ApplyGlossySurface(hdr, {
			GradientKey = if opts.HeaderColor then nil else "Primary",
			BaseColor = opts.HeaderColor or UIKit.Tokens.Colors.Primary,
			CornerRadius = UIKit.Tokens.Radii.Small,
			StrokeColor = UIKit.Tokens.Colors.OutlineInk,
			StrokeThickness = math.max(2, UIKit.Tokens.Strokes.Panel * 0.65),
			InnerHighlight = false,
		})

		local tLbl = Instance.new("TextLabel")
		tLbl.Name = "Title"
		tLbl.Size = UDim2.new(1, -60, 1, 0)
		tLbl.Position = UDim2.fromOffset(14, 0)
		tLbl.BackgroundTransparency = 1
		tLbl.Text = opts.Title
		tLbl.TextColor3 = if opts.HeaderColor then UIKit.PickReadableTextColor(opts.HeaderColor) else UIKit.Tokens.Colors.TextOnPrimary
		tLbl.TextSize = 18
		tLbl.TextXAlignment = Enum.TextXAlignment.Left
		tLbl.FontFace = UIKit.Tokens.Fonts.Title
		tLbl.ZIndex = baseZ + 4
		tLbl.Parent = hdr
		UIKit.AttachTextStroke(tLbl, UIKit.Tokens.Colors.OutlineInk, UIKit.Tokens.Strokes.Text, 0.12)

		header = hdr
		titleLbl = tLbl

		if opts.ShowClose ~= false then
			closeBtn = UIKit.CreateButton({
				Name = "CloseButton",
				Parent = hdr,
				Text = "X",
				Variant = "Danger",
				Size = UDim2.fromOffset(44, 44),
				Position = UDim2.new(1, 2, 0.5, 0),
				AnchorPoint = Vector2.new(1, 0.5),
				TextSize = 15,
			})
		end
	end

	local content = Instance.new("Frame")
	content.Name = "Content"
	content.Size = UDim2.new(1, -24, 1, -(topOffset + 12))
	content.Position = UDim2.fromOffset(12, topOffset)
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.ZIndex = baseZ + 3
	content.Parent = face

	return {
		Root = root,
		Face = face,
		Content = content,
		Header = header,
		TitleLabel = titleLbl,
		CloseButton = closeBtn,
	}
end

function UIKit.CreateWindow(opts: GlossyPanelOptions)
	return UIKit.CreateGlossyPanel(opts)
end

function UIKit.CreateBadgeIcon(
	parent: Instance?,
	spriteKey: string,
	fallbackGlyph: string,
	accentColor: Color3,
	sizePx: number?
): GuiObject
	local sz = sizePx or 28
	local assets = UIKit.Assets
	local rectInfo = if assets.IconRects then assets.IconRects[spriteKey] else nil
	if assets.IconAtlasId and rectInfo then
		local img = Instance.new("ImageLabel")
		img.Name = spriteKey .. "Icon"
		img.Size = UDim2.fromOffset(sz, sz)
		img.BackgroundTransparency = 1
		img.Image = assets.IconAtlasId
		img.ImageRectOffset = rectInfo.offset
		img.ImageRectSize = rectInfo.size
		img.ResampleMode = Enum.ResamplerMode.Default
		img.Parent = parent
		return img
	end

	local badge = Instance.new("TextLabel")
	badge.Name = spriteKey .. "Badge"
	badge.Size = UDim2.fromOffset(sz, sz)
	badge.BackgroundColor3 = accentColor
	badge.Text = fallbackGlyph
	badge.TextColor3 = Color3.fromRGB(255, 255, 255)
	badge.TextSize = math.max(12, math.floor(sz * 0.52))
	badge.FontFace = UIKit.Tokens.Fonts.Title
	badge.BorderSizePixel = 0

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UIKit.Tokens.Radii.Pill
	corner.Parent = badge

	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Thickness = 1.2
	stroke.Transparency = 0.55
	stroke.Parent = badge

	badge.Parent = parent
	return badge
end

export type SliderOptions = {
	Name: string?,
	Parent: Instance?,
	Label: string,
	InitialValue: number?,
	Min: number?,
	Max: number?,
	AccentColor: Color3?,
	OnChanged: ((value: number) -&gt; ())?,
}

-- Responsive slider powered by UIDragDetector (TranslateLine) + click-on-track support
function UIKit.CreateSlider(opts: SliderOptions): { Root: Frame, GetValue: () -&gt; number, SetValue: (number) -&gt; () }
	local minV = opts.Min or 0
	local maxV = opts.Max or 100
	local currentV = math.clamp(opts.InitialValue or 75, minV, maxV)
	local accent = opts.AccentColor or UIKit.Tokens.Colors.Primary

	local root = Instance.new("Frame")
	root.Name = opts.Name or "SliderRow"
	root.Size = UDim2.new(1, 0, 0, 78)
	root.BackgroundColor3 = UIKit.Tokens.Colors.BgCard
	root.BackgroundTransparency = 0.25
	root.BorderSizePixel = 0
	root.Parent = opts.Parent

	local rCorner = Instance.new("UICorner")
	rCorner.CornerRadius = UIKit.Tokens.Radii.Small
	rCorner.Parent = root

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.new(0.65, -12, 0, 22)
	title.Position = UDim2.fromOffset(12, 6)
	title.BackgroundTransparency = 1
	title.Text = opts.Label
	title.TextColor3 = UIKit.Tokens.Colors.TextPrimary
	title.TextSize = 14
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.FontFace = UIKit.Tokens.Fonts.Heading
	title.Parent = root

	local valueLbl = Instance.new("TextLabel")
	valueLbl.Name = "ValueLabel"
	valueLbl.Size = UDim2.new(0.35, -12, 0, 22)
	valueLbl.Position = UDim2.new(0.65, 0, 0, 6)
	valueLbl.BackgroundTransparency = 1
	valueLbl.TextColor3 = UIKit.Tokens.Colors.TextSecondary
	valueLbl.TextSize = 14
	valueLbl.TextXAlignment = Enum.TextXAlignment.Right
	valueLbl.FontFace = UIKit.Tokens.Fonts.Mono
	valueLbl.Parent = root

	local trackBtn = Instance.new("TextButton")
	trackBtn.Name = "Track"
	trackBtn.Size = UDim2.new(1, -24, 0, 52)
	trackBtn.Position = UDim2.fromOffset(12, 26)
	trackBtn.BackgroundTransparency = 1
	trackBtn.Text = ""
	trackBtn.AutoButtonColor = false
	trackBtn.Parent = root

	local trackBar = Instance.new("Frame")
	trackBar.Name = "Bar"
	trackBar.Size = UDim2.new(1, 0, 0, 8)
	trackBar.Position = UDim2.fromScale(0, 0.5)
	trackBar.AnchorPoint = Vector2.new(0, 0.5)
	trackBar.BackgroundColor3 = UIKit.Tokens.Colors.BgInput
	trackBar.BorderSizePixel = 0
	trackBar.Parent = trackBtn

	local tCorner = Instance.new("UICorner")
	tCorner.CornerRadius = UIKit.Tokens.Radii.Pill
	tCorner.Parent = trackBar

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0.5, 1)
	fill.BackgroundColor3 = accent
	fill.BorderSizePixel = 0
	fill.Parent = trackBar

	local fCorner = Instance.new("UICorner")
	fCorner.CornerRadius = UIKit.Tokens.Radii.Pill
	fCorner.Parent = fill

	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.Size = UDim2.fromOffset(20, 20)
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.fromScale(0.5, 0.5)
	knob.BackgroundColor3 = Color3.fromRGB(245, 248, 255)
	knob.BorderSizePixel = 0
	knob.Parent = trackBtn

	local kCorner = Instance.new("UICorner")
	kCorner.CornerRadius = UIKit.Tokens.Radii.Pill
	kCorner.Parent = knob

	local kStroke = Instance.new("UIStroke")
	kStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	kStroke.Color = accent
	kStroke.Thickness = 2
	kStroke.Parent = knob

	local function applyRatio(ratio: number, fireCallback: boolean)
		local r = math.clamp(ratio, 0, 1)
		currentV = minV + (maxV - minV) * r
		fill.Size = UDim2.fromScale(r, 1)
		knob.Position = UDim2.fromScale(r, 0.5)
		valueLbl.Text = string.format("%d%%", math.floor(currentV + 0.5))
		if fireCallback and opts.OnChanged then
			opts.OnChanged(currentV)
		end
	end

	local dragOk, detector = pcall(function()
		local d = Instance.new("UIDragDetector")
		d.Name = "SliderDrag"
		d.DragStyle = Enum.UIDragDetectorDragStyle.TranslateLine
		d.ResponseStyle = Enum.UIDragDetectorResponseStyle.Scale
		d.DragAxis = Vector2.new(1, 0)
		d.BoundingUI = trackBtn
		d.Parent = knob
		return d
	end)

	if dragOk and detector then
		local function syncFromKnob()
			local width = math.max(1, trackBtn.AbsoluteSize.X)
			local centerX = knob.AbsolutePosition.X + knob.AbsoluteSize.X * 0.5
			local r = math.clamp((centerX - trackBtn.AbsolutePosition.X) / width, 0, 1)
			applyRatio(r, true)
		end
		detector.DragContinue:Connect(syncFromKnob)
		detector.DragEnd:Connect(syncFromKnob)
	end

	trackBtn.MouseButton1Down:Connect(function(x: number)
		local width = math.max(1, trackBtn.AbsoluteSize.X)
		local r = math.clamp((x - trackBtn.AbsolutePosition.X) / width, 0, 1)
		applyRatio(r, true)
	end)

	applyRatio((currentV - minV) / math.max(1e-4, maxV - minV), false)

	return {
		Root = root,
		GetValue = function()
			return currentV
		end,
		SetValue = function(v: number)
			applyRatio((v - minV) / math.max(1e-4, maxV - minV), true)
		end,
	}
end

function UIKit.CreateToggle(
	parent: Instance?,
	name: string,
	label: string,
	initialState: boolean,
	onChanged: ((enabled: boolean) -&gt; ())?
): { Root: Frame, GetState: () -&gt; boolean, SetState: (boolean) -&gt; () }
	local state = initialState

	local root = Instance.new("Frame")
	root.Name = name
	root.Size = UDim2.new(1, 0, 0, 48)
	root.BackgroundColor3 = UIKit.Tokens.Colors.BgCard
	root.BackgroundTransparency = 0.25
	root.BorderSizePixel = 0
	root.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UIKit.Tokens.Radii.Small
	corner.Parent = root

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -84, 1, 0)
	lbl.Position = UDim2.fromOffset(12, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = label
	lbl.TextColor3 = UIKit.Tokens.Colors.TextPrimary
	lbl.TextSize = 14
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.FontFace = UIKit.Tokens.Fonts.Heading
	lbl.Parent = root

	local switch = Instance.new("TextButton")
	switch.Name = "Switch"
	switch.Size = UDim2.fromOffset(58, 52)
	switch.Position = UDim2.new(1, -10, 0.5, 0)
	switch.AnchorPoint = Vector2.new(1, 0.5)
	switch.BackgroundTransparency = 1
	switch.Text = ""
	switch.Parent = root

	local pill = Instance.new("Frame")
	pill.Name = "Pill"
	pill.Size = UDim2.fromOffset(54, 28)
	pill.Position = UDim2.fromScale(0.5, 0.5)
	pill.AnchorPoint = Vector2.new(0.5, 0.5)
	pill.BorderSizePixel = 0
	pill.Parent = switch

	local pCorner = Instance.new("UICorner")
	pCorner.CornerRadius = UIKit.Tokens.Radii.Pill
	pCorner.Parent = pill

	local thumb = Instance.new("Frame")
	thumb.Name = "Thumb"
	thumb.Size = UDim2.fromOffset(22, 22)
	thumb.AnchorPoint = Vector2.new(0.5, 0.5)
	thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	thumb.BorderSizePixel = 0
	thumb.Parent = pill

	local thCorner = Instance.new("UICorner")
	thCorner.CornerRadius = UIKit.Tokens.Radii.Pill
	thCorner.Parent = thumb

	local function render(animate: boolean)
		local targetColor = if state then UIKit.Tokens.Colors.Success else UIKit.Tokens.Colors.Secondary
		local targetPos = if state then UDim2.new(1, -14, 0.5, 0) else UDim2.new(0, 14, 0.5, 0)
		if animate then
			local info = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			UIKit.Tween(pill, info, { BackgroundColor3 = targetColor })
			UIKit.Tween(thumb, info, { Position = targetPos })
		else
			pill.BackgroundColor3 = targetColor
			thumb.Position = targetPos
		end
	end

	switch.Activated:Connect(function()
		state = not state
		render(true)
		if onChanged then
			onChanged(state)
		end
	end)

	render(false)
	return {
		Root = root,
		GetState = function()
			return state
		end,
		SetState = function(nextState: boolean)
			state = nextState
			render(true)
			if onChanged then
				onChanged(state)
			end
		end,
	}
end

-- Modal Stack Manager: single active modal, backdrop scrim, SelectionGroup focus trapping
function UIKit.CreateModalManager(modalGui: ScreenGui, backdropGui: ScreenGui?)
	local registered: { [string]: { frame: GuiObject, focusTarget: GuiObject? } } = {}
	local activeName: string? = nil
	local previousSelection: GuiObject? = nil
	local listeners: { (active: string?) -&gt; () } = {}

	local manager = {}

	local function emitChange()
		for _, fn in ipairs(listeners) do
			task.spawn(fn, activeName)
		end
	end

	function manager:Register(name: string, frame: GuiObject, defaultFocus: GuiObject?)
		frame.Visible = false
		frame.SelectionGroup = true
		frame.SelectionBehaviorUp = Enum.SelectionBehavior.Stop
		frame.SelectionBehaviorDown = Enum.SelectionBehavior.Stop
		frame.SelectionBehaviorLeft = Enum.SelectionBehavior.Stop
		frame.SelectionBehaviorRight = Enum.SelectionBehavior.Stop
		registered[name] = { frame = frame, focusTarget = defaultFocus }
	end

	function manager:GetActive(): string?
		return activeName
	end

	function manager:IsOpen(name: string): boolean
		return activeName == name
	end

	function manager:OnChanged(fn: (active: string?) -&gt; ())
		table.insert(listeners, fn)
	end

	function manager:CloseAll()
		for _, entry in pairs(registered) do
			entry.frame.Visible = false
			entry.frame.SelectionGroup = false
		end
		activeName = nil
		if backdropGui then
			backdropGui.Enabled = false
		end
		if previousSelection and previousSelection.Parent then
			pcall(function()
				GuiService.SelectedObject = previousSelection
			end)
		end
		previousSelection = nil
		emitChange()
	end

	function manager:Open(name: string)
		local entry = registered[name]
		if not entry then
			warn("[ModalManager] Unknown modal:", name)
			return
		end
		if activeName == name then
			manager:CloseAll()
			return
		end
		if activeName == nil then
			pcall(function()
				previousSelection = GuiService.SelectedObject
			end)
		end
		for otherName, other in pairs(registered) do
			other.frame.Visible = (otherName == name)
			other.frame.SelectionGroup = (otherName == name)
		end
		modalGui.Enabled = true
		if backdropGui then
			backdropGui.Enabled = true
		end
		activeName = name

		local scale = entry.frame:FindFirstChild("ModalPopScale") :: UIScale?
		if not scale then
			local newScale = Instance.new("UIScale")
			newScale.Name = "ModalPopScale"
			newScale.Parent = entry.frame
			scale = newScale
		end
		local popScale = scale :: UIScale
		if not UIKit.IsReducedMotion() then
			popScale.Scale = 0.94
			UIKit.Tween(popScale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1.0 })
		else
			popScale.Scale = 1.0
		end

		if RunService:IsRunning() and UIKit.GetPreferredInput() == Enum.PreferredInput.Gamepad then
			pcall(function()
				GuiService:Select(entry.focusTarget or entry.frame)
			end)
		end
		emitChange()
	end

	function manager:Pop(): boolean
		if activeName ~= nil then
			manager:CloseAll()
			return true
		end
		return false
	end

	if backdropGui then
		local scrim = backdropGui:FindFirstChild("Scrim")
		if scrim and scrim:IsA("GuiButton") then
			scrim.Activated:Connect(function()
				manager:Pop()
			end)
		end
	end

	return manager
end

-- Viewport-clamped Tooltip controller (Hover on Mouse, Selection on Gamepad, Tap on Touch)
function UIKit.CreateTooltipController(tooltipGui: ScreenGui)
	local card = Instance.new("Frame")
	card.Name = "TooltipCard"
	card.AutomaticSize = Enum.AutomaticSize.XY
	card.Size = UDim2.fromOffset(0, 0)
	card.BackgroundColor3 = UIKit.Tokens.Colors.BgDeep
	card.BackgroundTransparency = 0.04
	card.BorderSizePixel = 0
	card.Visible = false
	card.Active = false
	card.Parent = tooltipGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UIKit.Tokens.Radii.Small
	corner.Parent = card

	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = UIKit.Tokens.Colors.BorderBright
	stroke.Thickness = 1.5
	stroke.Parent = card

	local sizeCap = Instance.new("UISizeConstraint")
	sizeCap.MinSize = Vector2.new(150, 44)
	sizeCap.MaxSize = Vector2.new(270, 220)
	sizeCap.Parent = card

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 8)
	pad.PaddingBottom = UDim.new(0, 8)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = card

	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Vertical
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 3)
	list.Parent = card

	local titleLbl = Instance.new("TextLabel")
	titleLbl.Name = "Title"
	titleLbl.AutomaticSize = Enum.AutomaticSize.XY
	titleLbl.Size = UDim2.fromOffset(0, 0)
	titleLbl.LayoutOrder = 1
	titleLbl.BackgroundTransparency = 1
	titleLbl.TextColor3 = UIKit.Tokens.Colors.TextPrimary
	titleLbl.TextSize = 15
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.FontFace = UIKit.Tokens.Fonts.Heading
	titleLbl.Active = false
	titleLbl.Parent = card

	local subLbl = Instance.new("TextLabel")
	subLbl.Name = "Subtitle"
	subLbl.AutomaticSize = Enum.AutomaticSize.XY
	subLbl.Size = UDim2.fromOffset(0, 0)
	subLbl.LayoutOrder = 2
	subLbl.BackgroundTransparency = 1
	subLbl.TextColor3 = UIKit.Tokens.Colors.Gold
	subLbl.TextSize = 12
	subLbl.TextXAlignment = Enum.TextXAlignment.Left
	subLbl.FontFace = UIKit.Tokens.Fonts.Body
	subLbl.Active = false
	subLbl.Parent = card

	local bodyLbl = Instance.new("TextLabel")
	bodyLbl.Name = "Body"
	bodyLbl.AutomaticSize = Enum.AutomaticSize.XY
	bodyLbl.Size = UDim2.fromOffset(0, 0)
	bodyLbl.LayoutOrder = 3
	bodyLbl.BackgroundTransparency = 1
	bodyLbl.TextWrapped = true
	bodyLbl.TextColor3 = UIKit.Tokens.Colors.TextSecondary
	bodyLbl.TextSize = 13
	bodyLbl.TextXAlignment = Enum.TextXAlignment.Left
	bodyLbl.FontFace = UIKit.Tokens.Fonts.Body
	bodyLbl.Active = false
	bodyLbl.Parent = card

	local controller = { Card = card }

	function controller:Show(title: string, subtitle: string?, body: string?, anchorPos: Vector2?, accent: Color3?)
		titleLbl.Text = title
		subLbl.Visible = (subtitle ~= nil and subtitle ~= "")
		subLbl.Text = subtitle or ""
		subLbl.TextColor3 = accent or UIKit.Tokens.Colors.Gold
		bodyLbl.Visible = (body ~= nil and body ~= "")
		bodyLbl.Text = body or ""
		stroke.Color = accent or UIKit.Tokens.Colors.BorderBright

		card.Visible = true
		tooltipGui.Enabled = true

		local vp = tooltipGui.AbsoluteSize
		local cs = card.AbsoluteSize
		local w = math.max(160, cs.X)
		local h = math.max(56, cs.Y)
		local margin = 12
		local rawX = if anchorPos then anchorPos.X + 16 else (vp.X * 0.5)
		local rawY = if anchorPos then anchorPos.Y + 16 else (vp.Y * 0.5)
		if rawX + w + margin &gt; vp.X and anchorPos then
			rawX = anchorPos.X - w - 12
		end
		local maxX = math.max(margin, vp.X - w - margin)
		local maxY = math.max(margin, vp.Y - h - margin)
		card.Position = UDim2.fromOffset(math.clamp(rawX, margin, maxX), math.clamp(rawY, margin, maxY))
	end

	function controller:Hide()
		card.Visible = false
	end

	function controller:BindHover(target: GuiObject, getData: () -&gt; { title: string, subtitle: string?, body: string?, accent: Color3? })
		target.MouseEnter:Connect(function(x: number, y: number)
			if UIKit.GetPreferredInput() == Enum.PreferredInput.Touch then
				return
			end
			local info = getData()
			local pos = Vector2.new(x, y) - tooltipGui.AbsolutePosition
			controller:Show(info.title, info.subtitle, info.body, pos, info.accent)
		end)
		target.MouseMoved:Connect(function(x: number, y: number)
			if card.Visible and UIKit.GetPreferredInput() ~= Enum.PreferredInput.Touch then
				local info = getData()
				local pos = Vector2.new(x, y) - tooltipGui.AbsolutePosition
				controller:Show(info.title, info.subtitle, info.body, pos, info.accent)
			end
		end)
		target.MouseLeave:Connect(function()
			controller:Hide()
		end)
		target.SelectionGained:Connect(function()
			local info = getData()
			local abs = target.AbsolutePosition - tooltipGui.AbsolutePosition + Vector2.new(target.AbsoluteSize.X, 0)
			controller:Show(info.title, info.subtitle, info.body, abs, info.accent)
		end)
		target.SelectionLost:Connect(function()
			controller:Hide()
		end)
	end

	return controller
end

-- FIFO / capped non-blocking Toast Queue
function UIKit.CreateToastQueue(toastGui: ScreenGui, maxVisible: number?)
	local cap = maxVisible or 3
	local stack = toastGui:FindFirstChild("ToastStack") :: Frame?
	if not stack then
		local f = Instance.new("Frame")
		f.Name = "ToastStack"
		f.Size = UDim2.new(0, 320, 0, 260)
		f.Position = UDim2.new(0.5, 0, 0, 12)
		f.AnchorPoint = Vector2.new(0.5, 0)
		f.BackgroundTransparency = 1
		f.Active = false
		f.Parent = toastGui

		local list = Instance.new("UIListLayout")
		list.FillDirection = Enum.FillDirection.Vertical
		list.HorizontalAlignment = Enum.HorizontalAlignment.Center
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.Padding = UDim.new(0, 8)
		list.Parent = f
		stack = f
	end

	local stackFrame = stack :: Frame
	local activeCount = 0
	local orderSeq = 0
	local pending: { ToastRequest } = {}
	local kindColors: { [string]: Color3 } = {
		Info = UIKit.Tokens.Colors.Primary,
		Success = UIKit.Tokens.Colors.Success,
		Reward = UIKit.Tokens.Colors.Gold,
		Warning = UIKit.Tokens.Colors.Warning,
		Error = UIKit.Tokens.Colors.Danger,
	}

	local queueObj = {}

	local function spawnToast(req: ToastRequest)
		activeCount += 1
		orderSeq += 1
		local accent = kindColors[req.kind or "Info"] or UIKit.Tokens.Colors.Primary
		local duration = req.duration or 2.6

		local banner = Instance.new("Frame")
		banner.Name = "Toast_" .. tostring(orderSeq)
		banner.Size = UDim2.new(1, 0, 0, 56)
		banner.LayoutOrder = orderSeq
		banner.BackgroundColor3 = UIKit.Tokens.Colors.BgDeep
		banner.BackgroundTransparency = 0.06
		banner.BorderSizePixel = 0
		banner.Active = false
		banner.Parent = stackFrame

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UIKit.Tokens.Radii.Small
		corner.Parent = banner

		local stroke = Instance.new("UIStroke")
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Color = accent
		stroke.Thickness = 1.6
		stroke.Parent = banner

		local bar = Instance.new("Frame")
		bar.Size = UDim2.new(0, 5, 1, -12)
		bar.Position = UDim2.fromOffset(6, 6)
		bar.BackgroundColor3 = accent
		bar.BorderSizePixel = 0
		bar.Parent = banner
		local bCorner = Instance.new("UICorner")
		bCorner.CornerRadius = UIKit.Tokens.Radii.Pill
		bCorner.Parent = bar

		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, -28, 0, 22)
		title.Position = UDim2.fromOffset(20, 6)
		title.BackgroundTransparency = 1
		title.Text = req.title
		title.TextColor3 = UIKit.Tokens.Colors.TextPrimary
		title.TextSize = 14
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.FontFace = UIKit.Tokens.Fonts.Heading
		title.Parent = banner

		local msg = Instance.new("TextLabel")
		msg.Size = UDim2.new(1, -28, 0, 18)
		msg.Position = UDim2.fromOffset(20, 28)
		msg.BackgroundTransparency = 1
		msg.Text = req.message or ""
		msg.TextColor3 = UIKit.Tokens.Colors.TextSecondary
		msg.TextSize = 12
		msg.TextXAlignment = Enum.TextXAlignment.Left
		msg.FontFace = UIKit.Tokens.Fonts.Body
		msg.Parent = banner

		local scale = Instance.new("UIScale")
		scale.Scale = if UIKit.IsReducedMotion() then 1 else 0.9
		scale.Parent = banner
		if not UIKit.IsReducedMotion() then
			UIKit.Tween(scale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		end

		task.delay(duration, function()
			if banner.Parent then
				if not UIKit.IsReducedMotion() then
					local outInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
					local tw = UIKit.Tween(banner, outInfo, { BackgroundTransparency = 1 })
					UIKit.Tween(title, outInfo, { TextTransparency = 1 })
					UIKit.Tween(msg, outInfo, { TextTransparency = 1 })
					UIKit.Tween(bar, outInfo, { BackgroundTransparency = 1 })
					UIKit.Tween(stroke, outInfo, { Transparency = 1 })
					if tw then
						tw.Completed:Wait()
					end
				end
				banner:Destroy()
			end
			activeCount = math.max(0, activeCount - 1)
			if #pending &gt; 0 and activeCount &lt; cap then
				local nxt = table.remove(pending, 1)
				if nxt then
					spawnToast(nxt)
				end
			end
		end)
	end

	function queueObj:Push(req: ToastRequest)
		toastGui.Enabled = true
		if activeCount &lt; cap then
			spawnToast(req)
		else
			table.insert(pending, req)
		end
	end

	function queueObj:GetActiveCount(): number
		return activeCount
	end

	return queueObj
end

-- ViewportFrame 3D Model Previewer with WorldModel + ViewportCamera auto-framing
function UIKit.CreateViewportPreview(parent: Instance, opts: { Size: UDim2?, Position: UDim2?, AutoSpin: boolean? }?)
	local cfg = opts or {}
	local vf = Instance.new("ViewportFrame")
	vf.Name = "ModelViewport"
	vf.Size = cfg.Size or UDim2.fromScale(1, 1)
	vf.Position = cfg.Position or UDim2.new()
	vf.BackgroundTransparency = 1
	vf.Ambient = Color3.fromRGB(205, 212, 228)
	vf.LightColor = Color3.fromRGB(255, 244, 224)
	vf.LightDirection = Vector3.new(-1, -1, -0.8)
	vf.Parent = parent

	local world = Instance.new("WorldModel")
	world.Name = "World"
	world.Parent = vf

	local cam = Instance.new("ViewportCamera")
	cam.Name = "PreviewCamera"
	cam.FieldOfView = 35
	cam.Parent = vf
	vf.CurrentCamera = cam

	local currentSubject: Instance? = nil
	local spinEnabled = cfg.AutoSpin == true
	local angle = 0.35
	local dist = 6
	local targetCenter = Vector3.zero
	local conn: RBXScriptConnection? = nil

	local function updateCamera()
		local eye = targetCenter + Vector3.new(math.sin(angle) * dist, dist * 0.35, math.cos(angle) * dist)
		cam.CFrame = CFrame.lookAt(eye, targetCenter)
	end

	local function syncSpinConnection()
		if conn then
			conn:Disconnect()
			conn = nil
		end
		if spinEnabled and RunService:IsRunning() and vf.Parent then
			conn = RunService.RenderStepped:Connect(function(dt: number)
				if not vf.Visible then
					return
				end
				angle += dt * 0.75
				updateCamera()
			end)
		end
	end

	vf.AncestryChanged:Connect(function(_, newParent)
		if not newParent and conn then
			conn:Disconnect()
			conn = nil
		end
	end)

	local api = {
		Frame = vf,
		World = world,
		Camera = cam,
	}

	function api:SetModel(source: Instance)
		if currentSubject then
			currentSubject:Destroy()
			currentSubject = nil
		end
		local clone = source:Clone()
		clone.Parent = world
		currentSubject = clone

		local boxCf, boxSize
		if clone:IsA("Model") then
			boxCf, boxSize = clone:GetBoundingBox()
			clone:PivotTo(CFrame.new(-boxCf.Position) * clone:GetPivot())
			boxCf, boxSize = clone:GetBoundingBox()
		elseif clone:IsA("BasePart") then
			clone.CFrame = CFrame.new(0, 0, 0) * clone.CFrame.Rotation
			boxCf = clone.CFrame
			boxSize = clone.Size
		else
			boxCf = CFrame.new()
			boxSize = Vector3.new(3, 3, 3)
		end
		targetCenter = boxCf.Position
		local maxExtent = math.max(boxSize.X, boxSize.Y, boxSize.Z, 1)
		dist = (maxExtent * 0.5) / math.tan(math.rad(cam.FieldOfView * 0.5)) * 1.48
		updateCamera()
	end

	function api:SetAutoSpin(enabled: boolean)
		spinEnabled = enabled
		syncSpinConnection()
	end

	function api:Destroy()
		if conn then
			conn:Disconnect()
			conn = nil
		end
		vf:Destroy()
	end

	syncSpinConnection()
	return api
end

-- Responsive UIScale binder keeping Desktop/Tablet/Phone crisp
function UIKit.BindResponsiveScale(gui: ScreenGui, minScale: number?, maxScale: number?): UIScale
	local existing = gui:FindFirstChild("ResponsiveScale") :: UIScale?
	local uiScale = existing or Instance.new("UIScale")
	uiScale.Name = "ResponsiveScale"
	uiScale.Parent = gui

	local lo = minScale or 0.86
	local hi = maxScale or 1.08

	local function refresh()
		local abs = gui.AbsoluteSize
		if abs.X &lt;= 0 or abs.Y &lt;= 0 then
			return
		end
		local ratio = math.min(abs.X / 1280, abs.Y / 720)
		local target = math.clamp(ratio, lo, hi)
		-- Ensure comfortable readability on phone landscape/portrait while keeping &gt;=52px buttons &gt;=44px physical
		if abs.X &lt; 920 and abs.Y &lt; 500 then
			target = math.clamp(abs.Y / 410, lo, 0.94)
		end
		uiScale.Scale = target
	end

	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(refresh)
	refresh()
	return uiScale
end

-- =========================================================================
-- Composable Non-Template Layout Primitives (v0.5)
-- =========================================================================

export type ArcGaugeOptions = {
	Name: string?,
	Parent: Instance?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Label: string?,
	Unit: string?,
	Value: number?,
	Max: number?,
	Min: number?,
	StartAngleDeg: number?,
	SweepAngleDeg: number?,
	TickCount: number?,
	SegmentCount: number?,
	FillColor: Color3?,
	SecondaryColor: Color3?,
	TrackColor: Color3?,
	GlowEnabled: boolean?,
	ShowTicks: boolean?,
	ShowNeedle: boolean?,
	OrbMode: boolean?,
	ZIndex: number?,
}

function UIKit.CreateArcGauge(opts: ArcGaugeOptions?)
	local o = (opts or {}) :: ArcGaugeOptions
	local baseZ = o.ZIndex or 4
	local minVal = o.Min or 0
	local maxVal = math.max(minVal + 1e-4, o.Max or 100)
	local currentVal = math.clamp(o.Value or 75, minVal, maxVal)
	local startDeg = if o.StartAngleDeg ~= nil then o.StartAngleDeg else -135
	local sweepDeg = if o.SweepAngleDeg ~= nil then o.SweepAngleDeg else 270
	local tickCount = math.clamp(o.TickCount or 11, 3, 24)
	local segCount = math.clamp(o.SegmentCount or 24, 8, 40)
	local fillCol = o.FillColor or UIKit.Tokens.Colors.Primary
	local secCol = o.SecondaryColor or UIKit.Tokens.Colors.Accent
	local trackCol = o.TrackColor or UIKit.Tokens.Colors.BgInput
	local orbMode = o.OrbMode == true
	local showTicks = o.ShowTicks ~= false
	local showNeedle = if o.ShowNeedle ~= nil then o.ShowNeedle else (not orbMode)
	local glowEnabled = o.GlowEnabled ~= false

	local root = Instance.new("Frame")
	root.Name = o.Name or "ArcGauge"
	root.Size = o.Size or UDim2.fromOffset(148, 148)
	root.Position = o.Position or UDim2.fromScale(0.5, 0.5)
	root.AnchorPoint = resolveDefaultAnchorPoint(o.Position, o.AnchorPoint)
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.ZIndex = baseZ
	root.Parent = o.Parent

	local aspect = Instance.new("UIAspectRatioConstraint")
	aspect.AspectRatio = 1
	aspect.Parent = root

	local glowFrame: Frame? = nil
	if glowEnabled then
		local glow = Instance.new("Frame")
		glow.Name = "GlowRing"
		glow.Size = UDim2.fromScale(0.98, 0.98)
		glow.Position = UDim2.fromScale(0.5, 0.5)
		glow.AnchorPoint = Vector2.new(0.5, 0.5)
		glow.BackgroundColor3 = fillCol
		glow.BackgroundTransparency = 0.84
		glow.BorderSizePixel = 0
		glow.Active = false
		glow.ZIndex = baseZ
		glow.Parent = root

		local gCorner = Instance.new("UICorner")
		gCorner.CornerRadius = UDim.new(1, 0)
		gCorner.Parent = glow

		local gStroke = Instance.new("UIStroke")
		gStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		gStroke.Color = fillCol
		gStroke.Thickness = 4
		gStroke.Transparency = 0.45
		gStroke.Parent = glow
		glowFrame = glow
	end

	local dial = Instance.new("Frame")
	dial.Name = "Dial"
	dial.Size = UDim2.fromScale(0.88, 0.88)
	dial.Position = UDim2.fromScale(0.5, 0.5)
	dial.AnchorPoint = Vector2.new(0.5, 0.5)
	dial.BackgroundColor3 = UIKit.Tokens.Colors.BgPanel
	dial.BackgroundTransparency = 0.04
	dial.BorderSizePixel = 0
	dial.ZIndex = baseZ + 1
	dial.Parent = root

	local dCorner = Instance.new("UICorner")
	dCorner.CornerRadius = UDim.new(0.5, 0)
	dCorner.Parent = dial

	UIKit.AttachStackedStrokes(dial, {
		OuterColor = UIKit.Tokens.Colors.OutlineInk,
		OuterThickness = math.max(2.5, UIKit.Tokens.Strokes.OuterInk * 0.75),
		InnerColor = UIKit.Tokens.Colors.BorderBright,
		InnerThickness = 1.5,
		InnerTransparency = 0.55,
		CornerRadius = UDim.new(0.5, 0),
	})

	local orbCore = Instance.new("Frame")
	orbCore.Name = "OrbFill"
	orbCore.Size = UDim2.fromScale(0.76, 0.76)
	orbCore.Position = UDim2.fromScale(0.5, 0.5)
	orbCore.AnchorPoint = Vector2.new(0.5, 0.5)
	orbCore.BackgroundColor3 = fillCol
	orbCore.BackgroundTransparency = if orbMode then 0.05 else 0.92
	orbCore.BorderSizePixel = 0
	orbCore.Visible = orbMode
	orbCore.ZIndex = baseZ + 2
	orbCore.Parent = dial

	local oCorner = Instance.new("UICorner")
	oCorner.CornerRadius = UDim.new(1, 0)
	oCorner.Parent = orbCore

	local orbGrad = Instance.new("UIGradient")
	orbGrad.Name = "OrbLiquidGradient"
	orbGrad.Rotation = -90
	orbGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, fillCol:Lerp(Color3.fromRGB(16, 12, 24), 0.25)),
		ColorSequenceKeypoint.new(0.65, fillCol),
		ColorSequenceKeypoint.new(1, secCol),
	})
	orbGrad.Parent = orbCore

	local segFrames: { Frame } = {}
	for i = 1, segCount do
		local frac = (i - 1) / math.max(1, segCount - 1)
		local deg = startDeg + frac * sweepDeg
		local rad = math.rad(deg)
		local rx = 0.5 + math.sin(rad) * 0.41
		local ry = 0.5 - math.cos(rad) * 0.41

		local seg = Instance.new("Frame")
		seg.Name = string.format("ArcSeg_%02d", i)
		seg.Size = UDim2.fromScale(0.085, 0.055)
		seg.Position = UDim2.fromScale(rx, ry)
		seg.AnchorPoint = Vector2.new(0.5, 0.5)
		seg.Rotation = deg
		seg.BackgroundColor3 = trackCol
		seg.BorderSizePixel = 0
		seg.ZIndex = baseZ + 3
		seg.Parent = dial

		local sCorner = Instance.new("UICorner")
		sCorner.CornerRadius = UDim.new(1, 0)
		sCorner.Parent = seg
		table.insert(segFrames, seg)
	end

	if showTicks then
		for i = 1, tickCount do
			local frac = (i - 1) / math.max(1, tickCount - 1)
			local deg = startDeg + frac * sweepDeg
			local rad = math.rad(deg)
			local rx = 0.5 + math.sin(rad) * 0.31
			local ry = 0.5 - math.cos(rad) * 0.31

			local tick = Instance.new("Frame")
			tick.Name = string.format("Tick_%02d", i)
			tick.Size = UDim2.fromOffset(2, if (i == 1 or i == tickCount or i == math.ceil(tickCount / 2)) then 8 else 5)
			tick.Position = UDim2.fromScale(rx, ry)
			tick.AnchorPoint = Vector2.new(0.5, 0.5)
			tick.Rotation = deg
			tick.BackgroundColor3 = UIKit.Tokens.Colors.TextMuted
			tick.BackgroundTransparency = 0.25
			tick.BorderSizePixel = 0
			tick.ZIndex = baseZ + 3
			tick.Parent = dial
		end
	end

	local needlePivot = Instance.new("Frame")
	needlePivot.Name = "NeedlePivot"
	needlePivot.Size = UDim2.fromScale(1, 1)
	needlePivot.Position = UDim2.fromScale(0.5, 0.5)
	needlePivot.AnchorPoint = Vector2.new(0.5, 0.5)
	needlePivot.BackgroundTransparency = 1
	needlePivot.Visible = showNeedle
	needlePivot.ZIndex = baseZ + 4
	needlePivot.Parent = dial

	local needleArm = Instance.new("Frame")
	needleArm.Name = "NeedleArm"
	needleArm.Size = UDim2.new(0, 3, 0.34, 0)
	needleArm.Position = UDim2.fromScale(0.5, 0.5)
	needleArm.AnchorPoint = Vector2.new(0.5, 1)
	needleArm.BackgroundColor3 = secCol
	needleArm.BorderSizePixel = 0
	needleArm.ZIndex = baseZ + 4
	needleArm.Parent = needlePivot

	local nCorner = Instance.new("UICorner")
	nCorner.CornerRadius = UDim.new(1, 0)
	nCorner.Parent = needleArm

	local valueLbl = Instance.new("TextLabel")
	valueLbl.Name = "ValueLabel"
	valueLbl.Size = UDim2.new(0.76, 0, 0.28, 0)
	valueLbl.Position = UDim2.fromScale(0.5, 0.44)
	valueLbl.AnchorPoint = Vector2.new(0.5, 0.5)
	valueLbl.BackgroundTransparency = 1
	valueLbl.TextColor3 = UIKit.Tokens.Colors.TextPrimary
	valueLbl.TextSize = 20
	valueLbl.TextScaled = true
	valueLbl.FontFace = UIKit.Tokens.Fonts.Mono
	valueLbl.ZIndex = baseZ + 5
	valueLbl.Parent = dial
	UIKit.AttachTextStroke(valueLbl, UIKit.Tokens.Colors.OutlineInk, 1.8, 0.1)

	local vConstraint = Instance.new("UITextSizeConstraint")
	vConstraint.MinTextSize = 11
	vConstraint.MaxTextSize = 24
	vConstraint.Parent = valueLbl

	local titleLbl = Instance.new("TextLabel")
	titleLbl.Name = "TitleLabel"
	titleLbl.Size = UDim2.new(0.72, 0, 0.18, 0)
	titleLbl.Position = UDim2.fromScale(0.5, 0.67)
	titleLbl.AnchorPoint = Vector2.new(0.5, 0.5)
	titleLbl.BackgroundTransparency = 1
	titleLbl.Text = o.Label or "GAUGE"
	titleLbl.TextColor3 = UIKit.Tokens.Colors.TextSecondary
	titleLbl.TextSize = 12
	titleLbl.TextTruncate = Enum.TextTruncate.AtEnd
	titleLbl.FontFace = UIKit.Tokens.Fonts.Title
	titleLbl.ZIndex = baseZ + 5
	titleLbl.Parent = dial
	UIKit.AttachTextStroke(titleLbl, UIKit.Tokens.Colors.OutlineInk, 1.4, 0.15)

	local function refreshVisuals()
		local span = math.max(1e-4, maxVal - minVal)
		local ratio = math.clamp((currentVal - minVal) / span, 0, 1)
		local activeSegs = ratio * segCount
		for idx, seg in ipairs(segFrames) do
			local segT = (idx - 1) / math.max(1, segCount - 1)
			local segColor = fillCol:Lerp(secCol, segT)
			if idx &lt;= math.floor(activeSegs) then
				seg.BackgroundColor3 = segColor
				seg.BackgroundTransparency = 0
			elseif idx - 1 &lt; activeSegs then
				seg.BackgroundColor3 = segColor
				seg.BackgroundTransparency = 0.35
			else
				seg.BackgroundColor3 = trackCol
				seg.BackgroundTransparency = 0.25
			end
		end

		local targetAngle = startDeg + ratio * sweepDeg
		if showNeedle then
			if UIKit.IsReducedMotion() then
				needlePivot.Rotation = targetAngle
			else
				UIKit.Tween(needlePivot, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Rotation = targetAngle })
			end
		end

		if orbMode then
			if ratio &lt;= 0.01 then
				orbGrad.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0.0, 0.88),
					NumberSequenceKeypoint.new(1.0, 0.88),
				})
			elseif ratio &gt;= 0.99 then
				orbGrad.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0.0, 0.06),
					NumberSequenceKeypoint.new(1.0, 0.06),
				})
			else
				local cut = math.clamp(ratio, 0.02, 0.96)
				orbGrad.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0.0, 0.06),
					NumberSequenceKeypoint.new(cut, 0.14),
					NumberSequenceKeypoint.new(math.min(0.985, cut + 0.02), 0.88),
					NumberSequenceKeypoint.new(1.0, 0.88),
				})
			end
		end

		local numTxt = tostring(math.floor(currentVal + 0.5))
		local unitSuffix = if o.Unit and o.Unit ~= "" then (" " .. o.Unit) else ""
		valueLbl.Text = numTxt .. unitSuffix
	end

	refreshVisuals()

	local api = {
		Root = root,
		Dial = dial,
		OrbFill = orbCore,
		Glow = glowFrame,
		ValueLabel = valueLbl,
		TitleLabel = titleLbl,
	} :: any

	function api:SetValue(value: number, nextMax: number?)
		if nextMax ~= nil then
			maxVal = math.max(minVal + 1e-4, nextMax)
		end
		currentVal = math.clamp(value, minVal, maxVal)
		refreshVisuals()
	end

	function api:GetValue(): number
		return currentVal
	end

	function api:SetMax(nextMax: number)
		maxVal = math.max(minVal + 1e-4, nextMax)
		currentVal = math.clamp(currentVal, minVal, maxVal)
		refreshVisuals()
	end

	function api:SetColors(nextFill: Color3, nextSecondary: Color3?)
		fillCol = nextFill
		if nextSecondary then
			secCol = nextSecondary
		end
		orbCore.BackgroundColor3 = fillCol
		orbGrad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, fillCol:Lerp(Color3.fromRGB(16, 12, 24), 0.25)),
			ColorSequenceKeypoint.new(0.65, fillCol),
			ColorSequenceKeypoint.new(1, secCol),
		})
		needleArm.BackgroundColor3 = secCol
		refreshVisuals()
	end

	return api
end

export type RadialWheelItem = {
	Id: string?,
	Label: string,
	IconKey: string?,
	IconFallback: string?,
	Color: Color3?,
	Description: string?,
}

export type RadialWheelOptions = {
	Name: string?,
	Parent: Instance?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	RadiusPx: number?,
	SegmentSizePx: number?,
	HubSizePx: number?,
	StartAngleDeg: number?,
	CenterTitle: string?,
	Items: { RadialWheelItem }?,
	ZIndex: number?,
	OnSelect: ((index: number, item: RadialWheelItem) -&gt; ())?,
	OnCenterClick: (() -&gt; ())?,
}

function UIKit.CreateRadialWheel(opts: RadialWheelOptions?)
	local o = (opts or {}) :: RadialWheelOptions
	local baseZ = o.ZIndex or 8
	local segSize = math.max(44, o.SegmentSizePx or 58)
	local hubSize = math.max(48, o.HubSizePx or 72)
	local radiusPx = math.max(math.ceil(hubSize * 0.5 + segSize * 0.5 + 12), o.RadiusPx or 108)
	local startDeg = if o.StartAngleDeg ~= nil then o.StartAngleDeg else -90
	local centerDefault = o.CenterTitle or "SELECT"

	local wheelDim = (radiusPx + math.ceil(segSize * 0.5) + 14) * 2
	local root = Instance.new("Frame")
	root.Name = o.Name or "RadialWheel"
	root.Size = UDim2.fromOffset(wheelDim, wheelDim)
	root.Position = o.Position or UDim2.fromScale(0.5, 0.5)
	root.AnchorPoint = o.AnchorPoint or Vector2.new(0.5, 0.5)
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.ZIndex = baseZ
	root.Parent = o.Parent

	local ringBack = Instance.new("Frame")
	ringBack.Name = "RingBackdrop"
	ringBack.Size = UDim2.fromOffset(radiusPx * 2 + segSize + 12, radiusPx * 2 + segSize + 12)
	ringBack.Position = UDim2.fromScale(0.5, 0.5)
	ringBack.AnchorPoint = Vector2.new(0.5, 0.5)
	ringBack.BackgroundColor3 = UIKit.Tokens.Colors.BgDeep
	ringBack.BackgroundTransparency = 0.22
	ringBack.BorderSizePixel = 0
	ringBack.Active = false
	ringBack.ZIndex = baseZ
	ringBack.Parent = root

	local rbCorner = Instance.new("UICorner")
	rbCorner.CornerRadius = UDim.new(1, 0)
	rbCorner.Parent = ringBack

	local rbStroke = Instance.new("UIStroke")
	rbStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	rbStroke.Color = UIKit.Tokens.Colors.BorderBright
	rbStroke.Thickness = 2
	rbStroke.Transparency = 0.35
	rbStroke.Parent = ringBack

	local hub = Instance.new("TextButton")
	hub.Name = "CenterHub"
	hub.Size = UDim2.fromOffset(hubSize, hubSize)
	hub.Position = UDim2.fromScale(0.5, 0.5)
	hub.AnchorPoint = Vector2.new(0.5, 0.5)
	hub.BackgroundColor3 = UIKit.Tokens.Colors.BgPanel
	hub.Text = ""
	hub.AutoButtonColor = false
	hub.BorderSizePixel = 0
	hub.ZIndex = baseZ + 4
	hub.Parent = root
	UIKit.EnsureMinTouchTarget(hub, 44)

	local hubCorner = Instance.new("UICorner")
	hubCorner.CornerRadius = UDim.new(1, 0)
	hubCorner.Parent = hub

	UIKit.AttachStackedStrokes(hub, {
		OuterColor = UIKit.Tokens.Colors.OutlineInk,
		OuterThickness = math.max(2.5, UIKit.Tokens.Strokes.OuterInk * 0.7),
		InnerColor = UIKit.Tokens.Colors.Accent,
		InnerThickness = 1.6,
		InnerTransparency = 0.25,
		CornerRadius = UDim.new(1, 0),
	})

	local hubLabel = Instance.new("TextLabel")
	hubLabel.Name = "HubLabel"
	hubLabel.Size = UDim2.new(1, -10, 1, -10)
	hubLabel.Position = UDim2.fromScale(0.5, 0.5)
	hubLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	hubLabel.BackgroundTransparency = 1
	hubLabel.Text = centerDefault
	hubLabel.TextColor3 = UIKit.Tokens.Colors.TextPrimary
	hubLabel.TextSize = 12
	hubLabel.TextWrapped = true
	hubLabel.TextTruncate = Enum.TextTruncate.AtEnd
	hubLabel.FontFace = UIKit.Tokens.Fonts.Heading
	hubLabel.ZIndex = baseZ + 5
	hubLabel.Parent = hub
	UIKit.AttachTextStroke(hubLabel, UIKit.Tokens.Colors.OutlineInk, 0.8, 0.35)

	UIKit.AttachButtonJuice(hub, hub, function()
		if o.OnCenterClick then
			o.OnCenterClick()
		end
	end)

	local defaultItems: { RadialWheelItem } = {
		{ Id = "scan", Label = "Scan", IconKey = "gem", IconFallback = "S", Color = UIKit.Tokens.Colors.Accent },
		{ Id = "shield", Label = "Shield", IconKey = "shield", IconFallback = "D", Color = UIKit.Tokens.Colors.Primary },
		{ Id = "pulse", Label = "Pulse", IconKey = "bolt", IconFallback = "P", Color = UIKit.Tokens.Colors.Warning },
		{ Id = "repair", Label = "Repair", IconKey = "heart", IconFallback = "+", Color = UIKit.Tokens.Colors.Success },
		{ Id = "boost", Label = "Boost", IconKey = "star", IconFallback = "B", Color = UIKit.Tokens.Colors.Secondary },
		{ Id = "comms", Label = "Comms", IconKey = "crown", IconFallback = "C", Color = UIKit.Tokens.Colors.Gold },
	}
	local items: { RadialWheelItem } = if o.Items and #o.Items &gt; 0 then o.Items else defaultItems
	local segments: { TextButton } = {}
	local selectedIdx: number? = nil

	local function updateSelectionVisuals()
		for idx, seg in ipairs(segments) do
			local itemData = items[idx]
			local active = (selectedIdx == idx)
			local segColor = (itemData and itemData.Color) or UIKit.Tokens.Colors.Primary
			local bgColor = if active then segColor else UIKit.Tokens.Colors.BgPanel
			seg.BackgroundColor3 = bgColor
			local lblObj = seg:FindFirstChild("Label")
			if lblObj and lblObj:IsA("TextLabel") then
				local readable = UIKit.PickReadableTextColor(bgColor)
				lblObj.TextColor3 = readable
				UIKit.AttachTextStroke(lblObj, UIKit.Tokens.Colors.OutlineInk, 1.0, 0.25, readable)
			end
			local outer = seg:FindFirstChild("OuterStroke")
			if outer and outer:IsA("UIStroke") then
				outer.Color = if active then UIKit.Tokens.Colors.Gold else UIKit.Tokens.Colors.OutlineInk
				outer.Thickness = if active then 3.5 else 2.5
			end
		end
		if selectedIdx and items[selectedIdx] then
			hubLabel.Text = items[selectedIdx].Label
		else
			hubLabel.Text = centerDefault
		end
	end

	local function rebuildSegments(nextItems: { RadialWheelItem })
		for _, oldSeg in ipairs(segments) do
			oldSeg:Destroy()
		end
		table.clear(segments)
		items = if #nextItems &gt; 0 then nextItems else defaultItems
		local count = #items
		for i = 1, count do
			local item = items[i]
			local deg = startDeg + (i - 1) * (360 / count)
			local rad = math.rad(deg)
			local px = math.round(math.cos(rad) * radiusPx)
			local py = math.round(math.sin(rad) * radiusPx)
			local itemCol = item.Color or UIKit.Tokens.Colors.Primary

			local segBtn = Instance.new("TextButton")
			segBtn.Name = "Sector_" .. tostring(i)
			segBtn.Size = UDim2.fromOffset(segSize, segSize)
			segBtn.Position = UDim2.new(0.5, px, 0.5, py)
			segBtn.AnchorPoint = Vector2.new(0.5, 0.5)
			segBtn.BackgroundColor3 = UIKit.Tokens.Colors.BgPanel
			segBtn.Text = ""
			segBtn.AutoButtonColor = false
			segBtn.BorderSizePixel = 0
			segBtn.ZIndex = baseZ + 2
			segBtn:SetAttribute("SectorId", item.Id or item.Label)
			segBtn.Parent = root
			UIKit.EnsureMinTouchTarget(segBtn, 44)

			local corner = Instance.new("UICorner")
			corner.CornerRadius = UIKit.Tokens.Radii.Button
			corner.Parent = segBtn

			UIKit.AttachStackedStrokes(segBtn, {
				OuterColor = UIKit.Tokens.Colors.OutlineInk,
				OuterThickness = 2.5,
				InnerColor = itemCol,
				InnerThickness = 1.5,
				InnerTransparency = 0.25,
				CornerRadius = UIKit.Tokens.Radii.Button,
			})

			local icon = UIKit.CreateBadgeIcon(segBtn, item.IconKey or "star", item.IconFallback or "*", itemCol, math.max(20, math.floor(segSize * 0.40)))
			icon.Position = UDim2.fromScale(0.5, 0.34)
			icon.AnchorPoint = Vector2.new(0.5, 0.5)
			icon.ZIndex = baseZ + 3

			local lbl = Instance.new("TextLabel")
			lbl.Name = "Label"
			lbl.Size = UDim2.new(1, -6, 0, 16)
			lbl.Position = UDim2.new(0.5, 0, 1, -4)
			lbl.AnchorPoint = Vector2.new(0.5, 1)
			lbl.BackgroundTransparency = 1
			lbl.Text = item.Label
			lbl.TextColor3 = UIKit.Tokens.Colors.TextPrimary
			lbl.TextSize = 10
			lbl.TextTruncate = Enum.TextTruncate.AtEnd
			lbl.FontFace = UIKit.Tokens.Fonts.Heading
			lbl.ZIndex = baseZ + 3
			lbl.Parent = segBtn
			UIKit.AttachTextStroke(lbl, UIKit.Tokens.Colors.OutlineInk, 1.2, 0.12)

			segBtn.MouseEnter:Connect(function()
				hubLabel.Text = item.Label
			end)
			segBtn.MouseLeave:Connect(function()
				updateSelectionVisuals()
			end)
			UIKit.AttachButtonJuice(segBtn, segBtn, function()
				selectedIdx = i
				updateSelectionVisuals()
				if o.OnSelect then
					o.OnSelect(i, item)
				end
			end)

			table.insert(segments, segBtn)
		end
		selectedIdx = nil
		updateSelectionVisuals()
	end

	rebuildSegments(items)

	local api = {
		Root = root,
		Hub = hub,
		Segments = segments,
	} :: any

	function api:SetSelected(index: number?)
		if index ~= nil and index &gt;= 1 and index &lt;= #items then
			selectedIdx = index
		else
			selectedIdx = nil
		end
		updateSelectionVisuals()
	end

	function api:GetSelected(): number?
		return selectedIdx
	end

	function api:SetItems(nextItems: { RadialWheelItem })
		rebuildSegments(nextItems)
	end

	return api
end

export type CardFanItem = {
	Id: string?,
	Title: string,
	Cost: (number | string)?,
	Body: string?,
	RarityColor: Color3?,
	IconKey: string?,
	IconFallback: string?,
}

export type CardFanOptions = {
	Name: string?,
	Parent: Instance?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	CardSize: Vector2?,
	MaxAngleDeg: number?,
	ArcDropPx: number?,
	HoverLiftPx: number?,
	Cards: { CardFanItem }?,
	ZIndex: number?,
	OnCardClick: ((index: number, card: CardFanItem, button: GuiButton) -&gt; ())?,
}

function UIKit.CreateCardFan(opts: CardFanOptions?)
	local o = (opts or {}) :: CardFanOptions
	local baseZ = o.ZIndex or 6
	local cardSize = o.CardSize or Vector2.new(112, 152)
	local cardW = math.max(52, cardSize.X)
	local cardH = math.max(64, cardSize.Y)
	local maxAngle = math.clamp(o.MaxAngleDeg or 22, 0, 45)
	local arcDrop = math.max(0, o.ArcDropPx or 24)
	local hoverLift = math.max(8, o.HoverLiftPx or 22)
	local minHeight = cardH + arcDrop + hoverLift + 16

	local root = Instance.new("Frame")
	root.Name = o.Name or "CardFan"
	root.Size = o.Size or UDim2.fromOffset(560, math.max(214, minHeight))
	root.Position = o.Position or UDim2.new(0.5, 0, 1, -12)
	root.AnchorPoint = o.AnchorPoint or Vector2.new(0.5, 1)
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.ZIndex = baseZ
	root.Parent = o.Parent

	local defaultCards: { CardFanItem } = {
		{ Id = "strike", Title = "Sun Strike", Cost = 1, Body = "Deal 12 DMG", RarityColor = UIKit.Tokens.Rarity.Common, IconKey = "sword", IconFallback = "S" },
		{ Id = "guard", Title = "Iron Ward", Cost = 1, Body = "Gain 10 Block", RarityColor = UIKit.Tokens.Rarity.Uncommon, IconKey = "shield", IconFallback = "G" },
		{ Id = "nova", Title = "Arc Nova", Cost = 2, Body = "18 AoE + Burn", RarityColor = UIKit.Tokens.Rarity.Rare, IconKey = "bolt", IconFallback = "N" },
		{ Id = "surge", Title = "Mana Surge", Cost = 0, Body = "Draw 2 Cards", RarityColor = UIKit.Tokens.Rarity.Epic, IconKey = "gem", IconFallback = "M" },
		{ Id = "crown", Title = "Royal Decree", Cost = 3, Body = "Double Buffs", RarityColor = UIKit.Tokens.Rarity.Legendary, IconKey = "crown", IconFallback = "R" },
	}
	local cards: { CardFanItem } = if o.Cards and #o.Cards &gt; 0 then o.Cards else defaultCards
	local cardButtons: { GuiButton } = {}
	local selectedIdx: number? = nil

	local function rebuildCards(nextCards: { CardFanItem })
		for _, oldBtn in ipairs(cardButtons) do
			oldBtn:Destroy()
		end
		table.clear(cardButtons)
		cards = if #nextCards &gt; 0 then nextCards else defaultCards
		local count = #cards
		local totalSpan = math.min(420, math.max(0, (count - 1) * math.floor(cardW * 0.78)))
		local halfSpan = totalSpan * 0.5

		for i = 1, count do
			local card = cards[i]
			local t = if count &lt;= 1 then 0 else (-1 + 2 * (i - 1) / (count - 1))
			local angleDeg = t * maxAngle
			local arcY = math.round((t * t) * arcDrop)
			local xOff = math.round(t * halfSpan)
			local baseYOff = -(8 + arcDrop) + arcY
			local restPos = UDim2.new(0.5, xOff, 1, baseYOff)
			local liftPos = UDim2.new(0.5, xOff, 1, baseYOff - hoverLift)
			local restZ = baseZ + i
			local rarityCol = card.RarityColor or UIKit.Tokens.Colors.Primary

			local btn = Instance.new("TextButton")
			btn.Name = "Card_" .. tostring(i)
			btn.Size = UDim2.fromOffset(cardW, cardH)
			btn.Position = restPos
			btn.AnchorPoint = Vector2.new(0.5, 1)
			btn.Rotation = angleDeg
			btn.BackgroundColor3 = UIKit.Tokens.Colors.BgPanel
			btn.Text = ""
			btn.AutoButtonColor = false
			btn.BorderSizePixel = 0
			btn.ZIndex = restZ
			btn:SetAttribute("CardId", card.Id or card.Title)
			btn.Parent = root
			UIKit.EnsureMinTouchTarget(btn, 44)

			local corner = Instance.new("UICorner")
			corner.CornerRadius = UIKit.Tokens.Radii.Button
			corner.Parent = btn

			UIKit.ApplyGlossySurface(btn, {
				GradientKey = "Panel",
				BaseColor = UIKit.Tokens.Colors.BgPanel,
				CornerRadius = UIKit.Tokens.Radii.Button,
				StrokeColor = UIKit.Tokens.Colors.OutlineInk,
				StrokeThickness = 2.6,
				InnerHighlight = true,
			})

			local stripe = Instance.new("Frame")
			stripe.Name = "RarityHeader"
			stripe.Size = UDim2.new(1, -10, 0, 24)
			stripe.Position = UDim2.fromOffset(5, 6)
			stripe.BackgroundColor3 = rarityCol
			stripe.BorderSizePixel = 0
			stripe.ZIndex = restZ + 1
			stripe.Parent = btn

			local stCorner = Instance.new("UICorner")
			stCorner.CornerRadius = UIKit.Tokens.Radii.Xs
			stCorner.Parent = stripe

			local titleLbl = Instance.new("TextLabel")
			titleLbl.Name = "Title"
			titleLbl.Size = UDim2.new(1, -28, 1, 0)
			titleLbl.Position = UDim2.fromOffset(24, 0)
			titleLbl.BackgroundTransparency = 1
			titleLbl.Text = card.Title
			titleLbl.TextColor3 = UIKit.PickReadableTextColor(rarityCol)
			titleLbl.TextSize = 11
			titleLbl.TextXAlignment = Enum.TextXAlignment.Left
			titleLbl.TextTruncate = Enum.TextTruncate.AtEnd
			titleLbl.FontFace = UIKit.Tokens.Fonts.Title
			titleLbl.ZIndex = restZ + 2
			titleLbl.Parent = stripe

			local costBadge = Instance.new("Frame")
			costBadge.Name = "CostBadge"
			costBadge.Size = UDim2.fromOffset(24, 24)
			costBadge.Position = UDim2.fromOffset(2, 2)
			costBadge.BackgroundColor3 = UIKit.Tokens.Colors.Gold
			costBadge.BorderSizePixel = 0
			costBadge.ZIndex = restZ + 3
			costBadge.Parent = btn

			local cbCorner = Instance.new("UICorner")
			cbCorner.CornerRadius = UDim.new(1, 0)
			cbCorner.Parent = costBadge

			local cbStroke = Instance.new("UIStroke")
			cbStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			cbStroke.Color = UIKit.Tokens.Colors.OutlineInk
			cbStroke.Thickness = 1.6
			cbStroke.Parent = costBadge

			local costLbl = Instance.new("TextLabel")
			costLbl.Name = "CostText"
			costLbl.Size = UDim2.fromScale(1, 1)
			costLbl.BackgroundTransparency = 1
			costLbl.Text = tostring(if card.Cost ~= nil then card.Cost else 1)
			costLbl.TextColor3 = UIKit.PickReadableTextColor(UIKit.Tokens.Colors.Gold)
			costLbl.TextSize = 12
			costLbl.FontFace = UIKit.Tokens.Fonts.Mono
			costLbl.ZIndex = restZ + 4
			costLbl.Parent = costBadge

			local artBox = Instance.new("Frame")
			artBox.Name = "ArtMedallion"
			artBox.Size = UDim2.new(1, -16, 0, math.max(36, math.floor(cardH * 0.34)))
			artBox.Position = UDim2.fromOffset(8, 34)
			artBox.BackgroundColor3 = UIKit.Tokens.Colors.BgCard
			artBox.BorderSizePixel = 0
			artBox.ZIndex = restZ + 1
			artBox.Parent = btn

			local artCorner = Instance.new("UICorner")
			artCorner.CornerRadius = UIKit.Tokens.Radii.Xs
			artCorner.Parent = artBox

			local icon = UIKit.CreateBadgeIcon(artBox, card.IconKey or "star", card.IconFallback or "*", rarityCol, 28)
			icon.Position = UDim2.fromScale(0.5, 0.5)
			icon.AnchorPoint = Vector2.new(0.5, 0.5)
			icon.ZIndex = restZ + 2

			local bodyLbl = Instance.new("TextLabel")
			bodyLbl.Name = "Body"
			bodyLbl.Size = UDim2.new(1, -14, 1, -(42 + math.max(36, math.floor(cardH * 0.34))))
			bodyLbl.Position = UDim2.fromOffset(7, 38 + math.max(36, math.floor(cardH * 0.34)))
			bodyLbl.BackgroundTransparency = 1
			bodyLbl.Text = card.Body or ""
			bodyLbl.TextColor3 = UIKit.Tokens.Colors.TextSecondary
			bodyLbl.TextSize = 11
			bodyLbl.TextWrapped = true
			bodyLbl.TextTruncate = Enum.TextTruncate.AtEnd
			bodyLbl.FontFace = UIKit.Tokens.Fonts.Body
			bodyLbl.ZIndex = restZ + 2
			bodyLbl.Parent = btn

			local scale = Instance.new("UIScale")
			scale.Name = "HoverScale"
			scale.Scale = 1
			scale.Parent = btn

			local liftTween = TweenInfo.new(0.14, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			local restTween = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

			local function setHovered(hovering: boolean)
				if hovering then
					btn.ZIndex = baseZ + count + 10
					UIKit.Tween(btn, liftTween, { Position = liftPos, Rotation = angleDeg * 0.25 })
					UIKit.Tween(scale, liftTween, { Scale = 1.06 })
				else
					btn.ZIndex = restZ
					UIKit.Tween(btn, restTween, { Position = restPos, Rotation = angleDeg })
					UIKit.Tween(scale, restTween, { Scale = 1.0 })
				end
			end

			btn.MouseEnter:Connect(function()
				setHovered(true)
			end)
			btn.MouseLeave:Connect(function()
				if selectedIdx ~= i then
					setHovered(false)
				end
			end)
			btn.SelectionGained:Connect(function()
				setHovered(true)
			end)
			btn.SelectionLost:Connect(function()
				if selectedIdx ~= i then
					setHovered(false)
				end
			end)
			btn.Activated:Connect(function()
				selectedIdx = i
				if o.OnCardClick then
					o.OnCardClick(i, card, btn)
				end
			end)

			table.insert(cardButtons, btn)
		end
	end

	rebuildCards(cards)

	local api = {
		Root = root,
		Cards = cardButtons,
	} :: any

	function api:SetCards(nextCards: { CardFanItem })
		selectedIdx = nil
		rebuildCards(nextCards)
	end

	function api:SetSelected(index: number?)
		selectedIdx = index
	end

	return api
end

export type BookTabItem = {
	Id: string?,
	Label: string,
	Color: Color3?,
	IconKey: string?,
	IconFallback: string?,
}

export type BookSpreadOptions = {
	Name: string?,
	Parent: Instance?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	BookTitle: string?,
	Tabs: { BookTabItem }?,
	PageColor: Color3?,
	CoverColor: Color3?,
	ShowClose: boolean?,
	ZIndex: number?,
	OnTabChanged: ((index: number, tabId: string, leftPage: Frame, rightPage: Frame) -&gt; ())?,
	OnClose: (() -&gt; ())?,
}

function UIKit.CreateBookSpread(opts: BookSpreadOptions?)
	local o = (opts or {}) :: BookSpreadOptions
	local baseZ = o.ZIndex or 12
	local tabWidth = 64
	local isLight = UIKit.Tokens.Meta.SurfaceMode == "light"
	local pageColor = o.PageColor or (if isLight then UIKit.Tokens.Colors.BgPanel else UIKit.Tokens.Colors.BgCard)
	local coverColor = o.CoverColor or UIKit.Tokens.Colors.Primary:Lerp(UIKit.Tokens.Colors.OutlineInk, 0.45)
	local pageInk = UIKit.PickReadableTextColor(pageColor)

	local root = Instance.new("Frame")
	root.Name = o.Name or "BookSpread"
	root.Size = o.Size or UDim2.fromOffset(680, 420)
	root.Position = o.Position or UDim2.fromScale(0.5, 0.5)
	root.AnchorPoint = o.AnchorPoint or Vector2.new(0.5, 0.5)
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.ZIndex = baseZ
	root.Parent = o.Parent

	local tabColumn = Instance.new("Frame")
	tabColumn.Name = "BookmarkTabs"
	tabColumn.Size = UDim2.new(0, tabWidth + 6, 1, -48)
	tabColumn.Position = UDim2.new(1, -(tabWidth + 6), 0, 28)
	tabColumn.BackgroundTransparency = 1
	tabColumn.BorderSizePixel = 0
	tabColumn.ZIndex = baseZ + 1
	tabColumn.Parent = root

	local tabList = Instance.new("UIListLayout")
	tabList.FillDirection = Enum.FillDirection.Vertical
	tabList.HorizontalAlignment = Enum.HorizontalAlignment.Right
	tabList.SortOrder = Enum.SortOrder.LayoutOrder
	tabList.Padding = UDim.new(0, 8)
	tabList.Parent = tabColumn

	local cover = Instance.new("Frame")
	cover.Name = "BookCover"
	cover.Size = UDim2.new(1, -(tabWidth - 6), 1, 0)
	cover.Position = UDim2.fromOffset(0, 0)
	cover.BackgroundColor3 = coverColor
	cover.BorderSizePixel = 0
	cover.ZIndex = baseZ + 2
	cover.Parent = root

	local cCorner = Instance.new("UICorner")
	cCorner.CornerRadius = UIKit.Tokens.Radii.Panel
	cCorner.Parent = cover

	UIKit.AttachStackedStrokes(cover, {
		OuterColor = UIKit.Tokens.Colors.OutlineInk,
		OuterThickness = UIKit.Tokens.Strokes.Panel,
		InnerColor = UIKit.Tokens.Colors.Gold,
		InnerThickness = 1.6,
		InnerTransparency = 0.45,
		CornerRadius = UIKit.Tokens.Radii.Panel,
	})

	local spread = Instance.new("Frame")
	spread.Name = "Spread"
	spread.Size = UDim2.new(1, -20, 1, -20)
	spread.Position = UDim2.fromOffset(10, 10)
	spread.BackgroundTransparency = 1
	spread.BorderSizePixel = 0
	spread.ZIndex = baseZ + 3
	spread.Parent = cover

	local function buildPage(pageName: string, posXScale: number, posXOffset: number): Frame
		local page = Instance.new("Frame")
		page.Name = pageName
		page.Size = UDim2.new(0.5, -3, 1, 0)
		page.Position = UDim2.new(posXScale, posXOffset, 0, 0)
		page.BackgroundColor3 = pageColor
		page.BorderSizePixel = 0
		page.ZIndex = baseZ + 3
		page.Parent = spread

		local pCorner = Instance.new("UICorner")
		pCorner.CornerRadius = UIKit.Tokens.Radii.Small
		pCorner.Parent = page

		local pStroke = Instance.new("UIStroke")
		pStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		pStroke.Color = UIKit.Tokens.Colors.BorderSubtle
		pStroke.Thickness = 1.5
		pStroke.Transparency = 0.2
		pStroke.Parent = page

		local pad = Instance.new("UIPadding")
		pad.PaddingTop = UDim.new(0, 14)
		pad.PaddingBottom = UDim.new(0, 14)
		pad.PaddingLeft = UDim.new(0, 16)
		pad.PaddingRight = UDim.new(0, 16)
		pad.Parent = page

		return page
	end

	local leftPage = buildPage("LeftPage", 0, 0)
	local rightPage = buildPage("RightPage", 0.5, 3)

	local hasBookTitle = false
	if o.BookTitle and o.BookTitle ~= "" then
		hasBookTitle = true
		local titleHdr = Instance.new("TextLabel")
		titleHdr.Name = "BookTitle"
		titleHdr.Size = UDim2.new(1, 0, 0, 26)
		titleHdr.BackgroundTransparency = 1
		titleHdr.Text = o.BookTitle
		titleHdr.TextColor3 = pageInk
		titleHdr.TextSize = 18
		titleHdr.TextXAlignment = Enum.TextXAlignment.Left
		titleHdr.TextTruncate = Enum.TextTruncate.AtEnd
		titleHdr.FontFace = UIKit.Tokens.Fonts.Title
		titleHdr.ZIndex = baseZ + 4
		titleHdr.Parent = leftPage
	end

	local leftContent = Instance.new("Frame")
	leftContent.Name = "PageContent"
	leftContent.BackgroundTransparency = 1
	leftContent.BorderSizePixel = 0
	leftContent.Position = if hasBookTitle then UDim2.fromOffset(0, 30) else UDim2.fromOffset(0, 0)
	leftContent.Size = if hasBookTitle then UDim2.new(1, 0, 1, -30) else UDim2.fromScale(1, 1)
	leftContent.ZIndex = baseZ + 4
	leftContent.Parent = leftPage

	local spineShadow = Instance.new("Frame")
	spineShadow.Name = "SpineShadow"
	spineShadow.Size = UDim2.new(0, 24, 1, 4)
	spineShadow.Position = UDim2.fromScale(0.5, 0.5)
	spineShadow.AnchorPoint = Vector2.new(0.5, 0.5)
	spineShadow.BackgroundColor3 = UIKit.Tokens.Colors.OutlineInk
	spineShadow.BackgroundTransparency = 0
	spineShadow.BorderSizePixel = 0
	spineShadow.Active = false
	spineShadow.ZIndex = baseZ + 5
	spineShadow.Parent = spread

	local spineGrad = Instance.new("UIGradient")
	spineGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0.0, 1.0),
		NumberSequenceKeypoint.new(0.35, 0.72),
		NumberSequenceKeypoint.new(0.50, 0.30),
		NumberSequenceKeypoint.new(0.65, 0.72),
		NumberSequenceKeypoint.new(1.0, 1.0),
	})
	spineGrad.Parent = spineShadow

	local spineCrease = Instance.new("Frame")
	spineCrease.Name = "SpineCrease"
	spineCrease.Size = UDim2.new(0, 2, 1, -8)
	spineCrease.Position = UDim2.fromScale(0.5, 0.5)
	spineCrease.AnchorPoint = Vector2.new(0.5, 0.5)
	spineCrease.BackgroundColor3 = UIKit.Tokens.Colors.OutlineInk
	spineCrease.BackgroundTransparency = 0.25
	spineCrease.BorderSizePixel = 0
	spineCrease.Active = false
	spineCrease.ZIndex = baseZ + 6
	spineCrease.Parent = spineShadow

	local closeBtn: GuiButton? = nil
	if o.ShowClose ~= false then
		closeBtn = UIKit.CreateButton({
			Name = "CloseButton",
			Parent = cover,
			Text = "X",
			Variant = "Danger",
			Size = UDim2.fromOffset(44, 44),
			Position = UDim2.new(1, -8, 0, 8),
			AnchorPoint = Vector2.new(1, 0),
			TextSize = 15,
			OnClick = function()
				if o.OnClose then
					o.OnClose()
				else
					root.Visible = false
				end
			end,
		})
		if closeBtn then
			closeBtn.ZIndex = baseZ + 8
		end
	end

	local defaultTabs: { BookTabItem } = {
		{ Id = "quests", Label = "Quests", Color = UIKit.Tokens.Colors.Primary },
		{ Id = "bestiary", Label = "Index", Color = UIKit.Tokens.Colors.Secondary },
		{ Id = "recipes", Label = "Craft", Color = UIKit.Tokens.Colors.Success },
		{ Id = "map", Label = "Map", Color = UIKit.Tokens.Colors.Accent },
	}
	local tabs: { BookTabItem } = if o.Tabs and #o.Tabs &gt; 0 then o.Tabs else defaultTabs
	local tabButtons: { TextButton } = {}
	local activeIndex = 1

	local function refreshTabs()
		for idx, btn in ipairs(tabButtons) do
			local tData = tabs[idx]
			local isActive = (idx == activeIndex)
			local tCol = (tData and tData.Color) or UIKit.Tokens.Colors.Primary
			btn.BackgroundColor3 = if isActive then tCol else UIKit.Tokens.Colors.BgPanel
			btn.Size = if isActive then UDim2.fromOffset(tabWidth + 6, 48) else UDim2.fromOffset(tabWidth - 2, 46)
			local txt = btn:FindFirstChild("TabLabel")
			if txt and txt:IsA("TextLabel") then
				txt.TextColor3 = if isActive then UIKit.PickReadableTextColor(tCol) else UIKit.Tokens.Colors.TextSecondary
			end
		end
	end

	for idx, tab in ipairs(tabs) do
		local tCol = tab.Color or UIKit.Tokens.Colors.Primary
		local tabBtn = Instance.new("TextButton")
		tabBtn.Name = "Tab_" .. tostring(tab.Id or idx)
		tabBtn.LayoutOrder = idx
		tabBtn.Size = UDim2.fromOffset(tabWidth, 46)
		tabBtn.BackgroundColor3 = tCol
		tabBtn.Text = ""
		tabBtn.AutoButtonColor = false
		tabBtn.BorderSizePixel = 0
		tabBtn.ZIndex = baseZ + 1
		tabBtn:SetAttribute("TabId", tab.Id or tab.Label)
		tabBtn.Parent = tabColumn
		UIKit.EnsureMinTouchTarget(tabBtn, 44)

		local tCorner = Instance.new("UICorner")
		tCorner.CornerRadius = UIKit.Tokens.Radii.Small
		tCorner.Parent = tabBtn

		local tStroke = Instance.new("UIStroke")
		tStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		tStroke.Color = UIKit.Tokens.Colors.OutlineInk
		tStroke.Thickness = 2.4
		tStroke.Parent = tabBtn

		local tLbl = Instance.new("TextLabel")
		tLbl.Name = "TabLabel"
		tLbl.Size = UDim2.new(1, -8, 1, 0)
		tLbl.Position = UDim2.fromOffset(6, 0)
		tLbl.BackgroundTransparency = 1
		tLbl.Text = tab.Label
		tLbl.TextColor3 = UIKit.Tokens.Colors.TextPrimary
		tLbl.TextSize = 11
		tLbl.TextTruncate = Enum.TextTruncate.AtEnd
		tLbl.FontFace = UIKit.Tokens.Fonts.Title
		tLbl.ZIndex = baseZ + 2
		tLbl.Parent = tabBtn

		UIKit.AttachButtonJuice(tabBtn, tabBtn, function()
			activeIndex = idx
			refreshTabs()
			if o.OnTabChanged then
				o.OnTabChanged(idx, tab.Id or tab.Label, leftContent, rightPage)
			end
		end)

		table.insert(tabButtons, tabBtn)
	end

	refreshTabs()

	local api = {
		Root = root,
		Cover = cover,
		LeftPage = leftContent,
		LeftPageRaw = leftPage,
		RightPage = rightPage,
		SpineShadow = spineShadow,
		TabButtons = tabButtons,
		CloseButton = closeBtn,
	} :: any

	function api:SetActiveTab(indexOrId: number | string)
		if typeof(indexOrId) == "number" then
			activeIndex = math.clamp(indexOrId, 1, #tabs)
		else
			for i, t in ipairs(tabs) do
				if t.Id == indexOrId or t.Label == indexOrId then
					activeIndex = i
					break
				end
			end
		end
		refreshTabs()
		local chosen = tabs[activeIndex]
		if chosen and o.OnTabChanged then
			o.OnTabChanged(activeIndex, chosen.Id or chosen.Label, leftContent, rightPage)
		end
	end

	function api:GetActiveTab(): number
		return activeIndex
	end

	return api
end

return UIKit
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_11">
      <Properties>
        <string name="Name">ProjectScaffold</string>
        <ProtectedString name="Source">--!strict
--[[
	ProjectScaffold
	Idempotently creates and cleans up canonical Studio Explorer folders across
	standard Roblox services. Supports an isolated `rootPrefix` and `CollectionService`
	tag so tests and automated workflows never collide with existing place hierarchy.
]]

local CollectionService = game:GetService("CollectionService")

export type FolderNode = {
	name: string,
	children: { FolderNode }?,
}

export type ServiceLayout = {
	serviceName: string,
	folders: { FolderNode },
}

export type ScaffoldOptions = {
	rootPrefix: string?,
	tag: string?,
	services: { [string]: Instance }?,
	includeWorkspaceSubfolders: boolean?,
}

export type ScaffoldReport = {
	tag: string,
	rootPrefix: string,
	created: { string },
	existing: { string },
	totalManaged: number,
}

export type CleanupReport = {
	tag: string,
	rootPrefix: string,
	removed: { string },
	remainingCount: number,
}

local DEFAULT_TAG = "RobloxLuauCodingScaffold"
local MANAGED_ATTR = "LuauSkillScaffoldManaged"

local CANONICAL_LAYOUT: { ServiceLayout } = {
	{
		serviceName = "ReplicatedFirst",
		folders = {
			{ name = "Loading" },
		},
	},
	{
		serviceName = "ReplicatedStorage",
		folders = {
			{ name = "Shared", children = { { name = "Config" }, { name = "Types" }, { name = "Util" } } },
			{ name = "Remotes" },
			{ name = "Inputs" },
			{ name = "Assets" },
		},
	},
	{
		serviceName = "ServerScriptService",
		folders = {
			{ name = "Services" },
			{ name = "Systems" },
			{ name = "Security" },
		},
	},
	{
		serviceName = "ServerStorage",
		folders = {
			{ name = "Maps" },
			{ name = "Prefabs" },
			{ name = "ServerModules" },
		},
	},
	{
		serviceName = "StarterGui",
		folders = {},
	},
	{
		serviceName = "StarterPack",
		folders = {},
	},
	{
		serviceName = "StarterPlayer",
		folders = {},
	},
	{
		serviceName = "SoundService",
		folders = {
			{ name = "SoundGroups" },
		},
	},
	{
		serviceName = "Workspace",
		folders = {
			{ name = "World" },
			{ name = "NPCs" },
			{ name = "Interactables" },
		},
	},
}

local ProjectScaffold = {}

local function resolveService(serviceName: string, overrides: { [string]: Instance }?): Instance?
	if overrides and overrides[serviceName] then
		return overrides[serviceName]
	end
	local ok, svc = pcall(function()
		return game:GetService(serviceName)
	end)
	if ok then
		return svc
	end
	return nil
end

local function ensureFolder(parent: Instance, folderName: string, tag: string, report: ScaffoldReport): Folder
	local existing = parent:FindFirstChild(folderName)
	if existing and existing:IsA("Folder") then
		if tag ~= "" and not CollectionService:HasTag(existing, tag) then
			CollectionService:AddTag(existing, tag)
		end
		existing:SetAttribute(MANAGED_ATTR, true)
		table.insert(report.existing, existing:GetFullName())
		return existing
	end

	local folder = Instance.new("Folder")
	folder.Name = folderName
	folder:SetAttribute(MANAGED_ATTR, true)
	if tag ~= "" then
		CollectionService:AddTag(folder, tag)
	end
	folder.Parent = parent
	table.insert(report.created, folder:GetFullName())
	return folder
end

local function createTree(parent: Instance, nodes: { FolderNode }, tag: string, report: ScaffoldReport)
	for _, node in nodes do
		local folder = ensureFolder(parent, node.name, tag, report)
		if node.children then
			createTree(folder, node.children, tag, report)
		end
	end
end

function ProjectScaffold.GetCanonicalLayout(): { ServiceLayout }
	return CANONICAL_LAYOUT
end

function ProjectScaffold.Apply(options: ScaffoldOptions?): ScaffoldReport
	local opts: ScaffoldOptions = options or {}
	local rootPrefix = opts.rootPrefix or ""
	local tag = opts.tag or DEFAULT_TAG
	local includeWorkspace = if opts.includeWorkspaceSubfolders == nil then true else opts.includeWorkspaceSubfolders

	local report: ScaffoldReport = {
		tag = tag,
		rootPrefix = rootPrefix,
		created = {},
		existing = {},
		totalManaged = 0,
	}

	for _, layout in CANONICAL_LAYOUT do
		if layout.serviceName == "Workspace" and not includeWorkspace then
			continue
		end

		local service = resolveService(layout.serviceName, opts.services)
		if not service then
			continue
		end

		if layout.serviceName == "StarterPlayer" then
			local playerScripts = service:FindFirstChild("StarterPlayerScripts")
			local charScripts = service:FindFirstChild("StarterCharacterScripts")
			if playerScripts then
				local targetRoot = if rootPrefix ~= ""
					then ensureFolder(playerScripts, rootPrefix, tag, report)
					else playerScripts
				ensureFolder(targetRoot, "Controllers", tag, report)
				ensureFolder(targetRoot, "Components", tag, report)
			end
			if charScripts and rootPrefix ~= "" then
				ensureFolder(charScripts, rootPrefix, tag, report)
			end
			continue
		end

		local rootParent: Instance = service
		if rootPrefix ~= "" then
			rootParent = ensureFolder(service, rootPrefix, tag, report)
		end

		createTree(rootParent, layout.folders, tag, report)
	end

	report.totalManaged = #report.created + #report.existing
	return report
end

function ProjectScaffold.Cleanup(options: ScaffoldOptions?): CleanupReport
	local opts: ScaffoldOptions = options or {}
	local rootPrefix = opts.rootPrefix or ""
	local tag = opts.tag or DEFAULT_TAG

	local report: CleanupReport = {
		tag = tag,
		rootPrefix = rootPrefix,
		removed = {},
		remainingCount = 0,
	}

	-- Remove scoped rootPrefix folders first when specified
	if rootPrefix ~= "" then
		local searchRoots: { Instance } = {}
		for _, layout in CANONICAL_LAYOUT do
			local svc = resolveService(layout.serviceName, opts.services)
			if svc then
				table.insert(searchRoots, svc)
				if layout.serviceName == "StarterPlayer" then
					local ps = svc:FindFirstChild("StarterPlayerScripts")
					local cs = svc:FindFirstChild("StarterCharacterScripts")
					if ps then
						table.insert(searchRoots, ps)
					end
					if cs then
						table.insert(searchRoots, cs)
					end
				end
			end
		end

		for _, parent in searchRoots do
			local target = parent:FindFirstChild(rootPrefix)
			if target and target:IsA("Folder") and target:GetAttribute(MANAGED_ATTR) == true then
				table.insert(report.removed, target:GetFullName())
				target:Destroy()
			end
		end
	end

	-- Remove any remaining instances tagged with `tag` and marked managed
	if tag ~= "" then
		local tagged = CollectionService:GetTagged(tag)
		for _, inst in tagged do
			if inst.Parent ~= nil and inst:GetAttribute(MANAGED_ATTR) == true then
				if rootPrefix == "" or string.find(inst:GetFullName(), rootPrefix, 1, true) ~= nil then
					table.insert(report.removed, inst:GetFullName())
					inst:Destroy()
				end
			end
		end

		for _, inst in CollectionService:GetTagged(tag) do
			if inst.Parent ~= nil and inst:GetAttribute(MANAGED_ATTR) == true then
				if rootPrefix == "" or string.find(inst:GetFullName(), rootPrefix, 1, true) ~= nil then
					report.remainingCount += 1
				end
			end
		end
	end

	return report
end

return ProjectScaffold
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_12">
      <Properties>
        <string name="Name">SafeRemoteGateway</string>
        <ProtectedString name="Source">--!strict
--[[
	SafeRemoteGateway
	Centralized server-side networking gateway providing:
	1. Typed runtime argument &amp; nested dictionary validation (rejects NaN, Inf,
	   oversized strings, non-string table keys, mixed array/dict tables, deep nesting).
	2. Per-player token-bucket rate limiting with automatic PlayerRemoving cleanup.
	3. Clean RemoteEvent and UnreliableRemoteEvent registration + SimulateIncoming helper
	   for deterministic unit/Studio Edit-mode testing.
]]

export type FieldKind =
	"string"
	| "number"
	| "integer"
	| "boolean"
	| "Vector3"
	| "CFrame"
	| "Color3"
	| "Instance"
	| "table"

export type FieldSchema = {
	kind: FieldKind,
	optional: boolean?,
	min: number?,
	max: number?,
	maxLength: number?,
	className: string?,
	keys: { [string]: FieldSchema }?,
	allowExtraKeys: boolean?,
	maxDepth: number?,
}

export type RouteSchema = {
	args: { FieldSchema },
}

export type RateLimitConfig = {
	capacity: number,
	refillPerSecond: number,
}

export type DropCallback = (player: Player?, routeName: string, reason: string) -&gt; ()

export type GatewayOptions = {
	onDrop: DropCallback?,
	clock: (() -&gt; number)?,
}

export type RouteHandler = (player: Player, ...any) -&gt; ()

type TokenBucket = {
	tokens: number,
	lastRefill: number,
}

type RegisteredRoute = {
	name: string,
	kind: "Reliable" | "Unreliable",
	remote: RemoteEvent | UnreliableRemoteEvent,
	schema: RouteSchema,
	rateLimit: RateLimitConfig,
	handler: RouteHandler,
	connection: RBXScriptConnection?,
	buckets: { [string]: TokenBucket },
}

local DEFAULT_MAX_STRING_LENGTH = 4096
local DEFAULT_MAX_TABLE_DEPTH = 3
local DEFAULT_MAX_TABLE_KEYS = 64

local SafeRemoteGateway = {}
SafeRemoteGateway.__index = SafeRemoteGateway

export type Gateway = typeof(setmetatable({} :: {
	_remotesFolder: Instance?,
	_routes: { [string]: RegisteredRoute },
	_connections: { RBXScriptConnection },
	_onDrop: DropCallback?,
	_clock: () -&gt; number,
	_destroyed: boolean,
}, SafeRemoteGateway))

local function isFiniteNumber(n: number): boolean
	-- NaN fails self-equality; math.huge / -math.huge fail abs bound
	return n == n and math.abs(n) &lt; math.huge
end

local function isFiniteVector3(v: Vector3): boolean
	return isFiniteNumber(v.X) and isFiniteNumber(v.Y) and isFiniteNumber(v.Z)
end

local function isFiniteCFrame(cf: CFrame): boolean
	local pos = cf.Position
	local right = cf.RightVector
	local up = cf.UpVector
	return isFiniteVector3(pos) and isFiniteVector3(right) and isFiniteVector3(up)
end

local function validateTableValue(tbl: { [any]: any }, schema: FieldSchema, depth: number, maxDepth: number): (boolean, string?)
	if depth &gt; maxDepth then
		return false, `table depth exceeded limit ({maxDepth})`
	end

	local hasIntKey = false
	local hasStringKey = false
	local keyCount = 0
	local intCount = 0
	local maxIntKey = 0

	for k, v in tbl do
		keyCount += 1
		if keyCount &gt; DEFAULT_MAX_TABLE_KEYS then
			return false, `table key count exceeded limit ({DEFAULT_MAX_TABLE_KEYS})`
		end

		local kType = typeof(k)
		if kType == "number" then
			if k &lt; 1 or k % 1 ~= 0 then
				return false, "array index must be a positive integer"
			end
			hasIntKey = true
			intCount += 1
			if k &gt; maxIntKey then
				maxIntKey = k
			end
		elseif kType == "string" then
			hasStringKey = true
		else
			return false, `unsupported table key type '{kType}'`
		end

		if hasIntKey and hasStringKey then
			return false, "mixed array and dictionary keys are rejected by remote serialization rules"
		end

		if kType == "string" and schema.keys then
			local fieldSpec = schema.keys[k]
			if not fieldSpec then
				if not schema.allowExtraKeys then
					return false, `unexpected table key '{k}'`
				end
			end
		end

		-- Recurse on explicit key schema or nested tables to enforce depth and table-shape hygiene
		if schema.keys and kType == "string" and schema.keys[k] then
			local ok, err = SafeRemoteGateway.ValidateField(schema.keys[k], v, depth + 1, maxDepth)
			if not ok then
				return false, `key '{k}': {err}`
			end
		elseif typeof(v) == "table" then
			local subSchema: FieldSchema = { kind = "table", maxDepth = maxDepth }
			local ok, err = validateTableValue(v :: { [any]: any }, subSchema, depth + 1, maxDepth)
			if not ok then
				return false, `key '{k}': {err}`
			end
		end
	end

	if hasIntKey and intCount ~= maxIntKey then
		return false, "sparse array with nil holes is rejected by remote serialization rules"
	end

	-- Verify required keys when schema.keys is defined
	if schema.keys then
		for expectedKey, expectedSpec in schema.keys do
			if not expectedSpec.optional and tbl[expectedKey] == nil then
				return false, `missing required key '{expectedKey}'`
			end
		end
	end

	return true, nil
end

function SafeRemoteGateway.ValidateField(schema: FieldSchema, value: unknown, depth: number?, maxDepthOverride: number?): (boolean, string?)
	local currentDepth = depth or 1
	local maxDepth = maxDepthOverride or schema.maxDepth or DEFAULT_MAX_TABLE_DEPTH

	if value == nil then
		if schema.optional then
			return true, nil
		end
		return false, `expected '{schema.kind}', got nil`
	end

	local kind = schema.kind
	local actualType = typeof(value)

	if kind == "integer" then
		if actualType ~= "number" then
			return false, `expected integer, got {actualType}`
		end
		local num = value :: number
		if not isFiniteNumber(num) then
			return false, "non-finite number (NaN/Inf)"
		end
		if num % 1 ~= 0 then
			return false, "expected integer without fractional part"
		end
		if schema.min and num &lt; schema.min then
			return false, `value {num} below min {schema.min}`
		end
		if schema.max and num &gt; schema.max then
			return false, `value {num} above max {schema.max}`
		end
		return true, nil
	elseif kind == "number" then
		if actualType ~= "number" then
			return false, `expected number, got {actualType}`
		end
		local num = value :: number
		if not isFiniteNumber(num) then
			return false, "non-finite number (NaN/Inf)"
		end
		if schema.min and num &lt; schema.min then
			return false, `value {num} below min {schema.min}`
		end
		if schema.max and num &gt; schema.max then
			return false, `value {num} above max {schema.max}`
		end
		return true, nil
	elseif kind == "string" then
		if actualType ~= "string" then
			return false, `expected string, got {actualType}`
		end
		local str = value :: string
		local cap = schema.maxLength or DEFAULT_MAX_STRING_LENGTH
		if #str &gt; cap then
			return false, `string byte length {#str} exceeds cap {cap}`
		end
		return true, nil
	elseif kind == "boolean" then
		if actualType ~= "boolean" then
			return false, `expected boolean, got {actualType}`
		end
		return true, nil
	elseif kind == "Vector3" then
		if actualType ~= "Vector3" then
			return false, `expected Vector3, got {actualType}`
		end
		if not isFiniteVector3(value :: Vector3) then
			return false, "non-finite Vector3 component"
		end
		return true, nil
	elseif kind == "CFrame" then
		if actualType ~= "CFrame" then
			return false, `expected CFrame, got {actualType}`
		end
		if not isFiniteCFrame(value :: CFrame) then
			return false, "non-finite CFrame component"
		end
		return true, nil
	elseif kind == "Color3" then
		if actualType ~= "Color3" then
			return false, `expected Color3, got {actualType}`
		end
		local col = value :: Color3
		if not (isFiniteNumber(col.R) and isFiniteNumber(col.G) and isFiniteNumber(col.B)) then
			return false, "non-finite Color3 component"
		end
		return true, nil
	elseif kind == "Instance" then
		if actualType ~= "Instance" then
			return false, `expected Instance, got {actualType}`
		end
		local inst = value :: Instance
		if inst.Parent == nil then
			return false, "rejected unparented Instance"
		end
		if schema.className and not inst:IsA(schema.className) then
			return false, `expected {schema.className}, got {inst.ClassName}`
		end
		return true, nil
	elseif kind == "table" then
		if actualType ~= "table" then
			return false, `expected table, got {actualType}`
		end
		return validateTableValue(value :: { [any]: any }, schema, currentDepth, maxDepth)
	end

	return false, `unknown schema kind '{kind}'`
end

function SafeRemoteGateway.ValidateArgs(schema: RouteSchema, ...: any): (boolean, string?)
	local argCount = select("#", ...)
	local expectedArgs = schema.args
	if argCount &gt; #expectedArgs then
		return false, `too many arguments ({argCount} &gt; {#expectedArgs})`
	end

	for i = 1, #expectedArgs do
		local val: unknown = if i &lt;= argCount then select(i, ...) else nil
		local ok, reason = SafeRemoteGateway.ValidateField(expectedArgs[i], val)
		if not ok then
			return false, `arg #{i}: {reason}`
		end
	end

	return true, nil
end

function SafeRemoteGateway.Create(remotesFolder: Instance?, options: GatewayOptions?): Gateway
	local opts: GatewayOptions = options or {}
	local clockFn = opts.clock or os.clock
	local self = setmetatable({
		_remotesFolder = remotesFolder,
		_routes = {} :: { [string]: RegisteredRoute },
		_connections = {} :: { RBXScriptConnection },
		_onDrop = opts.onDrop,
		_clock = clockFn,
		_destroyed = false,
	}, SafeRemoteGateway)
	return self
end

local function playerBucketKey(playerOrKey: any): string
	if typeof(playerOrKey) == "Instance" and playerOrKey:IsA("Player") then
		return tostring(playerOrKey.UserId)
	elseif type(playerOrKey) == "table" and playerOrKey.UserId ~= nil then
		return tostring(playerOrKey.UserId)
	end
	return tostring(playerOrKey)
end

function SafeRemoteGateway.ConsumeRateLimit(self: Gateway, playerOrKey: any, routeName: string, nowOverride: number?): boolean
	local route = self._routes[routeName]
	if not route then
		return false
	end

	local now = nowOverride or self._clock()
	local key = playerBucketKey(playerOrKey)
	local limit = route.rateLimit
	local capacity = math.max(1, limit.capacity)
	local refillRate = math.max(0, limit.refillPerSecond)

	local bucket = route.buckets[key]
	if not bucket then
		bucket = {
			tokens = capacity,
			lastRefill = now,
		}
		route.buckets[key] = bucket
	else
		local elapsed = math.max(0, now - bucket.lastRefill)
		bucket.tokens = math.min(capacity, bucket.tokens + elapsed * refillRate)
		bucket.lastRefill = now
	end

	if bucket.tokens &lt; 1 then
		return false
	end

	bucket.tokens -= 1
	return true
end

function SafeRemoteGateway._ensureRemote(self: Gateway, routeName: string, className: "RemoteEvent" | "UnreliableRemoteEvent"): RemoteEvent | UnreliableRemoteEvent
	assert(not self._destroyed, "SafeRemoteGateway has been destroyed")
	local parent = self._remotesFolder
	assert(parent ~= nil, "remotesFolder must be provided before registering routes")

	local existing = parent:FindFirstChild(routeName)
	if existing then
		assert(existing:IsA(className), `Existing remote '{routeName}' has class '{existing.ClassName}', expected '{className}'`)
		return existing :: RemoteEvent | UnreliableRemoteEvent
	end

	local remote = Instance.new(className)
	remote.Name = routeName
	remote.Parent = parent
	return remote :: RemoteEvent | UnreliableRemoteEvent
end

function SafeRemoteGateway._dispatch(self: Gateway, route: RegisteredRoute, player: any, ...: any): (boolean, string?)
	if self._destroyed then
		return false, "gateway destroyed"
	end

	if not self:ConsumeRateLimit(player, route.name) then
		if self._onDrop then
			self._onDrop(player :: Player?, route.name, "rate limit exceeded")
		end
		return false, "rate limit exceeded"
	end

	local valid, reason = SafeRemoteGateway.ValidateArgs(route.schema, ...)
	if not valid then
		if self._onDrop then
			self._onDrop(player :: Player?, route.name, reason or "validation failed")
		end
		return false, reason
	end

	route.handler(player :: Player, ...)
	return true, nil
end

function SafeRemoteGateway.RegisterReliable(
	self: Gateway,
	routeName: string,
	schema: RouteSchema,
	rateLimit: RateLimitConfig,
	handler: RouteHandler
): RemoteEvent
	assert(self._routes[routeName] == nil, `Route '{routeName}' already registered`)
	local remote = self:_ensureRemote(routeName, "RemoteEvent") :: RemoteEvent

	local route: RegisteredRoute = {
		name = routeName,
		kind = "Reliable",
		remote = remote,
		schema = schema,
		rateLimit = rateLimit,
		handler = handler,
		buckets = {},
		connection = nil,
	}

	local okConn, connOrErr = pcall(function()
		return remote.OnServerEvent:Connect(function(player: Player, ...: any)
			self:_dispatch(route, player, ...)
		end)
	end)
	if okConn and connOrErr ~= nil then
		route.connection = connOrErr
		table.insert(self._connections, connOrErr)
	end

	self._routes[routeName] = route
	return remote
end

function SafeRemoteGateway.RegisterUnreliable(
	self: Gateway,
	routeName: string,
	schema: RouteSchema,
	rateLimit: RateLimitConfig,
	handler: RouteHandler
): UnreliableRemoteEvent
	assert(self._routes[routeName] == nil, `Route '{routeName}' already registered`)
	local remote = self:_ensureRemote(routeName, "UnreliableRemoteEvent") :: UnreliableRemoteEvent

	local route: RegisteredRoute = {
		name = routeName,
		kind = "Unreliable",
		remote = remote,
		schema = schema,
		rateLimit = rateLimit,
		handler = handler,
		buckets = {},
		connection = nil,
	}

	local okConn, connOrErr = pcall(function()
		return remote.OnServerEvent:Connect(function(player: Player, ...: any)
			self:_dispatch(route, player, ...)
		end)
	end)
	if okConn and connOrErr ~= nil then
		route.connection = connOrErr
		table.insert(self._connections, connOrErr)
	end

	self._routes[routeName] = route
	return remote
end

function SafeRemoteGateway.SimulateIncoming(self: Gateway, routeName: string, mockPlayer: any, ...: any): (boolean, string?)
	local route = self._routes[routeName]
	if not route then
		return false, `unknown route '{routeName}'`
	end
	return self:_dispatch(route, mockPlayer, ...)
end

function SafeRemoteGateway.BindPlayerCleanup(self: Gateway, playersService: Players): RBXScriptConnection
	assert(not self._destroyed, "SafeRemoteGateway has been destroyed")
	local conn = playersService.PlayerRemoving:Connect(function(player: Player)
		local key = playerBucketKey(player)
		for _, route in self._routes do
			route.buckets[key] = nil
		end
	end)
	table.insert(self._connections, conn)
	return conn
end

function SafeRemoteGateway.Destroy(self: Gateway)
	if self._destroyed then
		return
	end
	self._destroyed = true
	for _, conn in self._connections do
		if conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(self._connections)
	for _, route in self._routes do
		table.clear(route.buckets)
	end
	table.clear(self._routes)
end

return SafeRemoteGateway
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_13">
      <Properties>
        <string name="Name">ArchitectureSecurityAudit</string>
        <ProtectedString name="Source">--!strict
--[[
	ArchitectureSecurityAudit
	Read-only DataModel auditor that inspects Roblox Studio places (or scoped roots)
	and returns structured PASS / WARN / FAIL findings for common Explorer placement,
	networking, security, physics authority, and modern Luau hygiene pitfalls.
]]

export type Severity = "PASS" | "WARN" | "FAIL"

export type AuditFinding = {
	id: string,
	severity: Severity,
	path: string,
	message: string,
	recommendation: string,
}

export type AuditSummary = {
	pass: number,
	warn: number,
	fail: number,
	totalFindings: number,
	totalScriptsScanned: number,
}

export type AuditOptions = {
	roots: { Instance }?,
	checkWorkspaceParts: boolean?,
	checkServicesConfig: boolean?,
}

export type AuditReport = {
	summary: AuditSummary,
	findings: { AuditFinding },
}

local DEPRECATED_GLOBALS = {
	{ token = "wa" .. "it", replacement = "task.wait" },
	{ token = "sp" .. "awn", replacement = "task.spawn" },
	{ token = "de" .. "lay", replacement = "task.delay" },
}

local SECRET_NAME_PATTERNS = {
	"secret",
	"apikey",
	"api_key",
	"admin",
	"webhook",
	"privatekey",
	"serverconfig",
	"datastore",
	"loottable",
}

local REPLICATED_SERVICE_NAMES = {
	"Workspace",
	"ReplicatedFirst",
	"ReplicatedStorage",
	"StarterGui",
	"StarterPack",
	"StarterPlayer",
	"Teams",
	"SoundService",
}

local DEFAULT_SCAN_SERVICES = {
	"Workspace",
	"Lighting",
	"MaterialService",
	"ReplicatedFirst",
	"ReplicatedStorage",
	"ServerScriptService",
	"ServerStorage",
	"StarterGui",
	"StarterPack",
	"StarterPlayer",
	"Teams",
	"SoundService",
	"TextChatService",
}

local ArchitectureSecurityAudit = {}

local function safeGetService(name: string): Instance?
	local ok, svc = pcall(function()
		return game:GetService(name)
	end)
	if ok then
		return svc
	end
	return nil
end

local function safeReadSource(inst: Instance): string?
	if not inst:IsA("LuaSourceContainer") then
		return nil
	end
	local ok, src = pcall(function()
		return (inst :: any).Source :: string
	end)
	if ok and type(src) == "string" then
		return src
	end
	return nil
end

local function stripCommentsForScan(src: string): string
	-- Strip block comments first, then single-line comments
	local noBlocks = string.gsub(src, "%-%-%[%[.-%]%]", "")
	local noLines = string.gsub(noBlocks, "%-%-[^\r\n]*", "")
	return noLines
end

local function hasBareCall(cleanSrc: string, token: string): boolean
	local idx = 1
	while true do
		local s, e = string.find(cleanSrc, token, idx, true)
		if not s or not e then
			break
		end
		local before = if s &gt; 1 then string.sub(cleanSrc, s - 1, s - 1) else ""
		local after = string.sub(cleanSrc, e + 1)
		local validPrev = (before == "" or string.match(before, "[%w_.:]") == nil)
		local validNext = (string.match(after, "^%s*%(") ~= nil)
		if validPrev and validNext then
			return true
		end
		idx = e + 1
	end
	return false
end

local function isInsideService(inst: Instance, serviceName: string): boolean
	local svc = safeGetService(serviceName)
	return svc ~= nil and inst:IsDescendantOf(svc)
end

local function isInAnyReplicatedContainer(inst: Instance): boolean
	for _, svcName in REPLICATED_SERVICE_NAMES do
		if isInsideService(inst, svcName) then
			return true
		end
	end
	return false
end

local function modelHasPhysicsRigOrVehicle(model: Instance): boolean
	for _, child in model:GetDescendants() do
		if
			child:IsA("Humanoid")
			or child:IsA("VehicleSeat")
			or child:IsA("Seat")
			or child:IsA("AnimationController")
			or child:IsA("Constraint")
			or child:IsA("JointInstance")
		then
			return true
		end
	end
	return false
end

local function matchesSecretKeyword(name: string): string?
	local lower = string.lower(name)
	for _, kw in SECRET_NAME_PATTERNS do
		if string.find(lower, kw, 1, true) ~= nil then
			return kw
		end
	end
	return nil
end

local function addFinding(report: AuditReport, finding: AuditFinding)
	table.insert(report.findings, finding)
	if finding.severity == "PASS" then
		report.summary.pass += 1
	elseif finding.severity == "WARN" then
		report.summary.warn += 1
	else
		report.summary.fail += 1
	end
	report.summary.totalFindings += 1
end

local function inspectScriptInstance(report: AuditReport, inst: Instance, checkWorkspaceParts: boolean)
	if inst:GetAttribute("LuauSkillAuditIgnore") == true then
		return
	end

	-- SEC-01: Scripts inside ServerStorage never execute
	if inst:IsA("Script") and isInsideService(inst, "ServerStorage") then
		addFinding(report, {
			id = "SEC-01",
			severity = "FAIL",
			path = inst:GetFullName(),
			message = "Executable Script placed inside ServerStorage (Scripts inside ServerStorage do not run).",
			recommendation = "Move server Script to ServerScriptService or convert into a ModuleScript required by ServerScriptService.",
		})
	end

	-- SEC-03: Replicated container exposure checks
	if isInAnyReplicatedContainer(inst) then
		if inst:IsA("Script") and inst.RunContext == Enum.RunContext.Server then
			addFinding(report, {
				id = "SEC-03",
				severity = "WARN",
				path = inst:GetFullName(),
				message = "Script with RunContext.Server located inside a replicated container instead of ServerScriptService.",
				recommendation = "Keep all server Scripts in ServerScriptService to isolate server architecture from clients.",
			})
		end

		local kw = matchesSecretKeyword(inst.Name)
		if kw then
			addFinding(report, {
				id = "SEC-03",
				severity = "WARN",
				path = inst:GetFullName(),
				message = `Replicated script/module name matches sensitive keyword '{kw}'; all replicated bytecode can be decompiled.`,
				recommendation = "Verify no secrets, admin keys, or server-only reward/drop formulas exist here; move server logic to ServerScriptService/ServerStorage.",
			})
		end

		-- ARCH-02: Scattered legacy scripts directly under BaseParts/Models in Workspace
		if checkWorkspaceParts and isInsideService(inst, "Workspace") and (inst:IsA("Script") or inst:IsA("LocalScript")) then
			if inst.Parent and (inst.Parent:IsA("BasePart") or inst.Parent:IsA("Model")) then
				addFinding(report, {
					id = "ARCH-02",
					severity = "WARN",
					path = inst:GetFullName(),
					message = `Legacy per-object {inst.ClassName} attached inside Workspace {inst.Parent.ClassName}.`,
					recommendation = "Tag the object with CollectionService and drive behavior from one modular service in ServerScriptService or StarterPlayerScripts.",
				})
			end
		end
	end

	local src = safeReadSource(inst)
	if src == nil then
		return
	end

	report.summary.totalScriptsScanned += 1

	-- ARCH-01: Missing --!strict directive (ignoring tiny 1-line comments if intentional)
	local firstLine = string.match(src, "^([^\r\n]*)") or ""
	if string.find(firstLine, "--!strict", 1, true) == nil then
		local sev: Severity = "WARN"
		local msg = "Missing '--!strict' type-checking directive on line 1."
		if string.find(firstLine, "--!nocheck", 1, true) ~= nil then
			msg = "Script explicitly disables type checking with '--!nocheck'."
		end
		addFinding(report, {
			id = "ARCH-01",
			severity = sev,
			path = inst:GetFullName(),
			message = msg,
			recommendation = "Add '--!strict' on line 1 to catch nil/type bugs before runtime.",
		})
	end

	local cleanSrc = stripCommentsForScan(src)

	-- SEC-04: Deprecated blocking scheduler calls
	for _, dep in DEPRECATED_GLOBALS do
		if hasBareCall(cleanSrc, dep.token) then
			addFinding(report, {
				id = "SEC-04",
				severity = "FAIL",
				path = inst:GetFullName(),
				message = `Deprecated scheduler call '{dep.token}(...)' detected.`,
				recommendation = `Replace with '{dep.replacement}(...)' to avoid 30Hz throttling.`,
			})
		end
	end

	-- SEC-05: RemoteFunction:InvokeClient hang/crash hazard
	if string.find(cleanSrc, ":InvokeClient", 1, true) ~= nil then
		addFinding(report, {
			id = "SEC-05",
			severity = "FAIL",
			path = inst:GetFullName(),
			message = "RemoteFunction:InvokeClient(...) usage detected.",
			recommendation = "Replace InvokeClient with one-way RemoteEvent:FireClient + server timeout validation; clients can hang or throw errors.",
		})
	end
end

function ArchitectureSecurityAudit.Run(options: AuditOptions?): AuditReport
	local opts: AuditOptions = options or {}
	local checkWorkspaceParts = if opts.checkWorkspaceParts == nil then true else opts.checkWorkspaceParts
	local checkServicesConfig = if opts.checkServicesConfig == nil then (opts.roots == nil) else opts.checkServicesConfig

	local report: AuditReport = {
		summary = {
			pass = 0,
			warn = 0,
			fail = 0,
			totalFindings = 0,
			totalScriptsScanned = 0,
		},
		findings = {},
	}

	-- Global Service Security &amp; StarterGui Checks
	if checkServicesConfig then
		local sss = safeGetService("ServerScriptService") :: ServerScriptService?
		if sss then
			local okLoad, loadEnabled = pcall(function()
				return (sss :: any).LoadStringEnabled
			end)
			if not okLoad then
				addFinding(report, {
					id = "SEC-02",
					severity = "PASS",
					path = "ServerScriptService.LoadStringEnabled",
					message = "ServerScriptService.LoadStringEnabled is restricted/NotScriptable in this identity.",
					recommendation = "Verify LoadStringEnabled remains unchecked in Studio Explorer Properties.",
				})
			elseif loadEnabled then
				addFinding(report, {
					id = "SEC-02",
					severity = "FAIL",
					path = "ServerScriptService.LoadStringEnabled",
					message = "ServerScriptService.LoadStringEnabled is enabled (RCE risk).",
					recommendation = "Set ServerScriptService.LoadStringEnabled = false.",
				})
			else
				addFinding(report, {
					id = "SEC-02",
					severity = "PASS",
					path = "ServerScriptService.LoadStringEnabled",
					message = "ServerScriptService.LoadStringEnabled is disabled (false).",
					recommendation = "Keep false in production.",
				})
			end
		end

		local soundSvc = safeGetService("SoundService") :: SoundService?
		if soundSvc then
			local okRespect, respectEnabled = pcall(function()
				return (soundSvc :: any).RespectFilteringEnabled
			end)
			if not okRespect then
				addFinding(report, {
					id = "SEC-06",
					severity = "WARN",
					path = "SoundService.RespectFilteringEnabled",
					message = "SoundService.RespectFilteringEnabled could not be read in this execution context.",
					recommendation = "Verify SoundService.RespectFilteringEnabled = true in Studio Properties.",
				})
			elseif not respectEnabled then
				addFinding(report, {
					id = "SEC-06",
					severity = "FAIL",
					path = "SoundService.RespectFilteringEnabled",
					message = "SoundService.RespectFilteringEnabled is false (clients can globally play sounds).",
					recommendation = "Set SoundService.RespectFilteringEnabled = true.",
				})
			else
				addFinding(report, {
					id = "SEC-06",
					severity = "PASS",
					path = "SoundService.RespectFilteringEnabled",
					message = "SoundService.RespectFilteringEnabled is true.",
					recommendation = "Keep true.",
				})
			end
		end

		-- ARCH-04: ResetOnSpawn = false nested inside Folder under StarterGui
		local starterGui = safeGetService("StarterGui")
		if starterGui then
			for _, desc in starterGui:GetDescendants() do
				if desc:IsA("ScreenGui") then
					if not desc.ResetOnSpawn and desc.Parent ~= starterGui then
						addFinding(report, {
							id = "ARCH-04",
							severity = "WARN",
							path = desc:GetFullName(),
							message = "ScreenGui with ResetOnSpawn = false is nested inside a non-root container.",
							recommendation = "Make ScreenGui a direct child of StarterGui so ResetOnSpawn = false persists across respawns.",
						})
					end
				end
			end
		end
	end

	-- Collect scan roots
	local roots: { Instance } = {}
	if opts.roots then
		roots = opts.roots
	else
		for _, svcName in DEFAULT_SCAN_SERVICES do
			local svc = safeGetService(svcName)
			if svc then
				table.insert(roots, svc)
			end
		end
	end

	local serverStorageScriptFails = 0
	for _, root in roots do
		local candidates: { Instance } = { root }
		for _, d in root:GetDescendants() do
			table.insert(candidates, d)
		end

		for _, inst in candidates do
			if inst:IsA("LuaSourceContainer") then
				local beforeFails = report.summary.fail
				inspectScriptInstance(report, inst, checkWorkspaceParts)
				if inst:IsA("Script") and isInsideService(inst, "ServerStorage") and report.summary.fail &gt; beforeFails then
					serverStorageScriptFails += 1
				end
			elseif checkWorkspaceParts and inst:IsA("BasePart") and not inst:IsA("Terrain") then
				if isInsideService(inst, "Workspace") and not inst.Anchored then
					local modelAncestor = inst:FindFirstAncestorOfClass("Model")
					local inRigOrVehicle = modelAncestor ~= nil and modelHasPhysicsRigOrVehicle(modelAncestor)
					local okConn, connected = pcall(function()
						return inst:GetConnectedParts(true)
					end)
					local hasAnchoredWeld = false
					if okConn and type(connected) == "table" then
						for _, other in connected :: { Instance } do
							if other:IsA("BasePart") and other.Anchored then
								hasAnchoredWeld = true
								break
							end
						end
					end
					if not inRigOrVehicle and not hasAnchoredWeld then
						addFinding(report, {
							id = "ARCH-03",
							severity = "WARN",
							path = inst:GetFullName(),
							message = "Unanchored BasePart in Workspace with no Humanoid/Vehicle/Constraint rig or anchored weld.",
							recommendation = "Anchor static props/architecture (Anchored = true), or lock ownership server-side via SetNetworkOwner(nil) if dynamic.",
						})
					end
				end
			end
		end
	end

	if checkServicesConfig and serverStorageScriptFails == 0 then
		addFinding(report, {
			id = "SEC-01",
			severity = "PASS",
			path = "ServerStorage",
			message = "Zero executable Scripts misplaced inside ServerStorage.",
			recommendation = "Continue placing executable server Scripts in ServerScriptService only.",
		})
	end

	return report
end

return ArchitectureSecurityAudit
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_14">
      <Properties>
        <string name="Name">StudioRuntimeSmokeTest</string>
        <ProtectedString name="Source">--!strict
--[[
	StudioRuntimeSmokeTest
	Self-contained, isolated verification suite for Studio Edit/Run testing.
	Tests:
	  1. ProjectScaffold idempotent apply + cleanup (when module injected or found as sibling).
	  2. SafeRemoteGateway valid payload pass, bad-type/NaN/Inf/mixed-table reject, and token-bucket rate limiting.
	  3. ArchitectureSecurityAudit detection of intentionally planted insecure fixtures (SEC-01, ARCH-01).
	  4. CollectionService tag add/remove signals + Instance Attribute sync.
	  5. Parallel Luau Actor ownership, SharedTable atomic increment, SharedTableRegistry cleanup,
	     Actor:SendMessage, and live task.desynchronize/synchronize when invoked inside an Actor context.
	  6. Complete cleanup verification leaving zero temporary instances or connections.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local SharedTableRegistry = game:GetService("SharedTableRegistry")
local Workspace = game:GetService("Workspace")

export type SmokeDependencies = {
	scaffold: any?,
	gateway: any?,
	audit: any?,
}

export type SmokeResult = {
	allPassed: boolean,
	passed: { string },
	failed: { string },
	skipped: { string },
	details: { [string]: any },
	cleanupVerified: boolean,
}

local StudioRuntimeSmokeTest = {}

local function resolveModule(provided: any, siblingName: string): any
	if provided ~= nil then
		return provided
	end
	if typeof(script) == "Instance" and script.Parent then
		local sibling = script.Parent:FindFirstChild(siblingName)
		if sibling and sibling:IsA("ModuleScript") then
			local ok, mod = pcall(require, sibling)
			if ok then
				return mod
			end
		end
	end
	return nil
end

local function recordPass(res: SmokeResult, name: string, detail: any?)
	table.insert(res.passed, name)
	if detail ~= nil then
		res.details[name] = detail
	end
end

local function recordFail(res: SmokeResult, name: string, errMsg: string)
	table.insert(res.failed, `{name}: {errMsg}`)
	res.allPassed = false
	res.details[name] = { error = errMsg }
end

local function recordSkip(res: SmokeResult, name: string, reason: string)
	table.insert(res.skipped, `{name}: {reason}`)
	res.details[name] = { skipped = reason }
end

function StudioRuntimeSmokeTest.Run(deps: SmokeDependencies?): SmokeResult
	local passedDeps: SmokeDependencies = deps or {}
	local scaffoldMod = resolveModule(passedDeps.scaffold, "project_scaffold")
	local gatewayMod = resolveModule(passedDeps.gateway, "safe_remote_gateway")
	local auditMod = resolveModule(passedDeps.audit, "architecture_security_audit")

	local nonce = `{math.floor(os.clock() * 1000)}_{math.random(1000, 9999)}`
	local tmpPrefix = `_LuauSkillSmoke_{nonce}`
	local sharedTableKey = `_LuauSkillSmokeST_{nonce}`

	local result: SmokeResult = {
		allPassed = true,
		passed = {},
		failed = {},
		skipped = {},
		details = {},
		cleanupVerified = false,
	}

	local tempWorkspaceFolder = Instance.new("Folder")
	tempWorkspaceFolder.Name = tmpPrefix
	tempWorkspaceFolder.Parent = Workspace

	local tempRemotesFolder = Instance.new("Folder")
	tempRemotesFolder.Name = tmpPrefix
	tempRemotesFolder.Parent = ReplicatedStorage

	local tempServerStorageFolder = Instance.new("Folder")
	tempServerStorageFolder.Name = tmpPrefix
	tempServerStorageFolder.Parent = ServerStorage

	local connections: { RBXScriptConnection } = {}
	local gatewayInstance: any = nil

	local function track(conn: RBXScriptConnection)
		table.insert(connections, conn)
	end

	-- Wrap test suite in pcall so cleanup ALWAYS executes cleanly
	local suiteOk, suiteErr = pcall(function()
		-- 1. ProjectScaffold idempotency &amp; cleanup
		if scaffoldMod then
			local firstReport = scaffoldMod.Apply({
				rootPrefix = `{tmpPrefix}_Scaffold`,
				tag = `Tag_{tmpPrefix}`,
			})
			local secondReport = scaffoldMod.Apply({
				rootPrefix = `{tmpPrefix}_Scaffold`,
				tag = `Tag_{tmpPrefix}`,
			})
			local cleanupReport = scaffoldMod.Cleanup({
				rootPrefix = `{tmpPrefix}_Scaffold`,
				tag = `Tag_{tmpPrefix}`,
			})
			if #firstReport.created &gt; 0 and #secondReport.created == 0 and cleanupReport.remainingCount == 0 then
				recordPass(result, "ProjectScaffold_Idempotency_And_Cleanup", {
					createdFirst = #firstReport.created,
					createdSecond = #secondReport.created,
					removed = #cleanupReport.removed,
				})
			else
				recordFail(
					result,
					"ProjectScaffold_Idempotency_And_Cleanup",
					`first={#firstReport.created}, second={#secondReport.created}, rem={cleanupReport.remainingCount}`
				)
			end
		else
			recordSkip(result, "ProjectScaffold_Idempotency_And_Cleanup", "project_scaffold module not provided")
		end

		-- 2. SafeRemoteGateway schema validation + token bucket rate limit
		if gatewayMod then
			local nowClock = 100.0
			local drops: { string } = {}
			local acceptedCount = 0

			local gw = gatewayMod.Create(tempRemotesFolder, {
				clock = function(): number
					return nowClock
				end,
				onDrop = function(_player: Player?, _route: string, reason: string)
					table.insert(drops, reason)
				end,
			})
			gatewayInstance = gw

			gw:RegisterReliable(
				"EquipSlot",
				{
					args = {
						{ kind = "integer", min = 1, max = 9 },
						{
							kind = "table",
							maxDepth = 2,
							keys = {
								tag = { kind = "string", maxLength = 16 },
							},
						},
					},
				},
				{ capacity = 2, refillPerSecond = 1 },
				function(_player: Player, _slot: number, _meta: { tag: string })
					acceptedCount += 1
				end
			)

			gw:RegisterUnreliable(
				"LookTelemetry",
				{ args = { { kind = "Vector3" } } },
				{ capacity = 1, refillPerSecond = 2 },
				function(_player: Player, _dir: Vector3) end
			)

			local mockPlayer = { UserId = 424242, Name = "SmokeTester" }

			local okValid = gw:SimulateIncoming("EquipSlot", mockPlayer, 3, { tag = "sword" })
			local okBadType, errBadType = gw:SimulateIncoming("EquipSlot", mockPlayer, "not_int", { tag = "sword" })
			-- Consume remaining token with bad-schema? No, rate limit runs first, so replenish time cleanly:
			nowClock += 5.0
			local okMixedTable, errMixed = gw:SimulateIncoming("EquipSlot", mockPlayer, 2, { tag = "ok", [1] = "mixed" } :: any)
			nowClock += 5.0
			local okNaN, errNaN = gw:SimulateIncoming("LookTelemetry", mockPlayer, Vector3.new(0 / 0, 1, 0))
			local okSparse, errSparse = gatewayMod.ValidateArgs({ args = { { kind = "table" } } }, { [1] = "a", [3] = "c" })

			-- Test burst rate limit: capacity = 2, zero time elapsed -&gt; 2 pass, 3rd drops
			nowClock += 5.0
			local b1 = gw:SimulateIncoming("EquipSlot", mockPlayer, 1, { tag = "a" })
			local b2 = gw:SimulateIncoming("EquipSlot", mockPlayer, 2, { tag = "b" })
			local b3, errB3 = gw:SimulateIncoming("EquipSlot", mockPlayer, 3, { tag = "c" })

			gw:Destroy()
			gatewayInstance = nil

			local checksOk = okValid == true
				and not okBadType and errBadType ~= nil
				and not okMixedTable and errMixed ~= nil
				and not okNaN and errNaN ~= nil
				and not okSparse and errSparse ~= nil
				and b1 == true and b2 == true and b3 == false and errB3 == "rate limit exceeded"
				and acceptedCount == 3

			if checksOk then
				recordPass(result, "SafeRemoteGateway_Schema_And_RateLimit", {
					accepted = acceptedCount,
					dropsCaptured = #drops,
					mixedReason = errMixed,
					nanReason = errNaN,
				})
			else
				recordFail(
					result,
					"SafeRemoteGateway_Schema_And_RateLimit",
					`okValid={okValid}, okBad={okBadType}, okMix={okMixedTable}, okNaN={okNaN}, burst=({b1},{b2},{b3})`
				)
			end
		else
			recordSkip(result, "SafeRemoteGateway_Schema_And_RateLimit", "safe_remote_gateway module not provided")
		end

		-- 3. ArchitectureSecurityAudit on controlled isolated bad fixtures
		if auditMod then
			local badScript = Instance.new("Script")
			badScript.Name = "BrokenInServerStorage"
			badScript.Disabled = true
			badScript.Source = "local x = 1\n" -- intentionally missing --!strict
			badScript.Parent = tempServerStorageFolder

			local loosePart = Instance.new("Part")
			loosePart.Name = "StrayUnanchoredPart"
			loosePart.Anchored = false
			loosePart.Parent = tempWorkspaceFolder

			local auditReport = auditMod.Run({
				roots = { tempServerStorageFolder, tempWorkspaceFolder },
				checkWorkspaceParts = true,
				checkServicesConfig = false,
			})

			local hasSec01 = false
			local hasArch01 = false
			local hasArch03 = false
			for _, f in auditReport.findings do
				if f.id == "SEC-01" and f.severity == "FAIL" then
					hasSec01 = true
				elseif f.id == "ARCH-01" and f.severity == "WARN" then
					hasArch01 = true
				elseif f.id == "ARCH-03" and f.severity == "WARN" then
					hasArch03 = true
				end
			end

			if hasSec01 and hasArch01 and hasArch03 then
				recordPass(result, "ArchitectureSecurityAudit_FixtureDetection", {
					sec01 = hasSec01,
					arch01 = hasArch01,
					arch03 = hasArch03,
					summary = auditReport.summary,
				})
			else
				recordFail(
					result,
					"ArchitectureSecurityAudit_FixtureDetection",
					`Expected SEC-01/ARCH-01/ARCH-03 got sec01={hasSec01}, arch01={hasArch01}, arch03={hasArch03}`
				)
			end
		else
			recordSkip(result, "ArchitectureSecurityAudit_FixtureDetection", "architecture_security_audit module not provided")
		end

		-- 4. CollectionService + Attribute lifecycle
		local testTag = `SmokeTag_{nonce}`
		local addedCount = 0
		local removedCount = 0
		local attrValueSeen: any = nil

		local taggedPart = Instance.new("Part")
		taggedPart.Name = "TaggedLifecyclePart"
		taggedPart.Anchored = true
		taggedPart.Parent = tempWorkspaceFolder

		track(CollectionService:GetInstanceAddedSignal(testTag):Connect(function(inst: Instance)
			if inst == taggedPart then
				addedCount += 1
			end
		end))
		track(CollectionService:GetInstanceRemovedSignal(testTag):Connect(function(inst: Instance)
			if inst == taggedPart then
				removedCount += 1
			end
		end))
		track(taggedPart:GetAttributeChangedSignal("Health"):Connect(function()
			attrValueSeen = taggedPart:GetAttribute("Health")
		end))

		CollectionService:AddTag(taggedPart, testTag)
		taggedPart:SetAttribute("Health", 75)
		task.wait()
		CollectionService:RemoveTag(taggedPart, testTag)
		task.wait()

		if addedCount == 1 and removedCount == 1 and attrValueSeen == 75 then
			recordPass(result, "CollectionService_And_Attribute_Lifecycle", {
				added = addedCount,
				removed = removedCount,
				attr = attrValueSeen,
			})
		else
			recordFail(
				result,
				"CollectionService_And_Attribute_Lifecycle",
				`added={addedCount}, removed={removedCount}, attr={tostring(attrValueSeen)}`
			)
		end

		-- 5. Parallel Luau: Actor + SharedTable + SendMessage + desynchronize/synchronize
		local actor = Instance.new("Actor")
		actor.Name = "SmokeParallelActor"
		actor.Parent = tempWorkspaceFolder

		local workerNode = Instance.new("Folder")
		workerNode.Name = "WorkerChild"
		workerNode.Parent = actor

		local sharedTbl = SharedTable.new({ count = 10 })
		SharedTableRegistry:SetSharedTable(sharedTableKey, sharedTbl)
		local fetched = SharedTableRegistry:GetSharedTable(sharedTableKey)
		local prevVal = SharedTable.increment(fetched, "count", 5)

		local callerActor = if typeof(script) == "Instance" then script:GetActor() else nil
		local parallelModeUsed = "edit-caller-contract-verified"
		local messageReceived = false

		if callerActor ~= nil then
			-- Invoked directly inside an Actor VM: exercise live BindToMessage + desynchronize/synchronize
			local bindOk = pcall(function()
				callerActor:BindToMessage("SmokePing", function(payload: number)
					if payload == 99 then
						messageReceived = true
					end
				end)
				callerActor:SendMessage("SmokePing", 99)
				task.desynchronize()
				SharedTable.increment(fetched, "count", 1)
				task.synchronize()
			end)
			parallelModeUsed = if bindOk then "actor-vm-live-parallel" else "actor-vm-error"
		else
			-- Caller is outside an Actor (e.g., Studio Edit CommandBar / MCP execute_luau):
			-- verify SendMessage enqueue from non-Actor works without calling forbidden non-Actor BindToMessage/desynchronize
			actor:SendMessage("SmokePing", 99)
		end

		local finalCount = fetched["count"]
		local actorOwnerOk = workerNode:GetActor() == actor
		local sendMessageOk = callerActor == nil or messageReceived
		SharedTableRegistry:SetSharedTable(sharedTableKey, nil)

		if actorOwnerOk and prevVal == 10 and finalCount &gt;= 15 and sendMessageOk then
			recordPass(result, "ParallelLuau_Actor_And_SharedTable", {
				actorOwnerOk = actorOwnerOk,
				prevCount = prevVal,
				finalCount = finalCount,
				mode = parallelModeUsed,
				isRunning = RunService:IsRunning(),
			})
		else
			recordFail(
				result,
				"ParallelLuau_Actor_And_SharedTable",
				`actorOwner={actorOwnerOk}, prev={prevVal}, final={finalCount}, msg={sendMessageOk}`
			)
		end
	end)

	-- Guaranteed cleanup
	if gatewayInstance then
		pcall(function()
			gatewayInstance:Destroy()
		end)
	end
	for _, conn in connections do
		if conn.Connected then
			conn:Disconnect()
		end
	end
	pcall(function()
		SharedTableRegistry:SetSharedTable(sharedTableKey, nil)
	end)
	tempWorkspaceFolder:Destroy()
	tempRemotesFolder:Destroy()
	tempServerStorageFolder:Destroy()

	result.cleanupVerified = Workspace:FindFirstChild(tmpPrefix) == nil
		and ReplicatedStorage:FindFirstChild(tmpPrefix) == nil
		and ServerStorage:FindFirstChild(tmpPrefix) == nil

	if not suiteOk then
		recordFail(result, "SmokeSuiteUnhandledError", tostring(suiteErr))
	end
	if not result.cleanupVerified then
		recordFail(result, "CleanupVerification", "Temporary smoke test folders remained in DataModel")
	end

	return result
end

return StudioRuntimeSmokeTest
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_15">
      <Properties>
        <string name="Name">ControllerManagerRig</string>
        <ProtectedString name="Source">--!strict
--[[
	ControllerManagerRig
	Configures modern Roblox physics character controllers (ControllerManager +
	GroundController + AirController + ClimbController + SwimController +
	ControllerPartSensor) on R15 or custom character rigs, with deterministic
	dash, jump impulse, and state evaluation helpers.
]]

local CollectionService = game:GetService("CollectionService")

export type ControllerRigConfig = {
	baseMoveSpeed: number?,
	sprintMultiplier: number?,
	groundOffset: number?,
	floorSearchDistance: number?,
	ladderSearchDistance: number?,
	airControlForce: number?,
	turnSpeedFactor: number?,
	disableHumanoidStateMachine: boolean?,
	tag: string?,
}

export type ControllerRigBundle = {
	character: Model,
	rootPart: BasePart,
	manager: ControllerManager,
	groundController: GroundController,
	airController: AirController,
	climbController: ClimbController,
	swimController: SwimController,
	floorSensor: ControllerPartSensor,
	climbSensor: ControllerPartSensor,
}

local DEFAULT_TAG = "SharpControllerManagerManaged"

local ControllerManagerRig = {}

local function getOrCreate(parent: Instance, className: string, name: string, tag: string): Instance
	local existing = parent:FindFirstChild(name)
	if existing and existing.ClassName == className then
		CollectionService:AddTag(existing, tag)
		return existing
	end
	if existing then
		existing:Destroy()
	end
	local inst = Instance.new(className)
	inst.Name = name
	CollectionService:AddTag(inst, tag)
	inst.Parent = parent
	return inst
end

function ControllerManagerRig.Attach(character: Model, config: ControllerRigConfig?): ControllerRigBundle
	local cfg: ControllerRigConfig = config or {}
	local tag = cfg.tag or DEFAULT_TAG
	local rootPart = (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart or character:FindFirstChildWhichIsA("BasePart")) :: BasePart?
	assert(rootPart ~= nil, "Character Model must contain a HumanoidRootPart or BasePart.")

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hipHeight = if humanoid then math.max(1.5, humanoid.HipHeight) else 2.0
	local groundOffset = cfg.groundOffset or hipHeight

	if humanoid and (if cfg.disableHumanoidStateMachine == nil then true else cfg.disableHumanoidStateMachine) then
		pcall(function()
			humanoid.EvaluateStateMachine = false
		end)
	end

	local floorSensor = getOrCreate(rootPart, "ControllerPartSensor", "GroundSensor", tag) :: ControllerPartSensor
	floorSensor.SensorMode = Enum.SensorMode.Floor
	floorSensor.UpdateType = Enum.SensorUpdateType.OnRead
	floorSensor.SearchDistance = cfg.floorSearchDistance or (groundOffset + 1.25)

	local climbSensor = getOrCreate(rootPart, "ControllerPartSensor", "ClimbSensor", tag) :: ControllerPartSensor
	climbSensor.SensorMode = Enum.SensorMode.Ladder
	climbSensor.UpdateType = Enum.SensorUpdateType.OnRead
	climbSensor.SearchDistance = cfg.ladderSearchDistance or 1.75

	local manager = getOrCreate(character, "ControllerManager", "ControllerManager", tag) :: ControllerManager
	manager.RootPart = rootPart
	manager.BaseMoveSpeed = cfg.baseMoveSpeed or 18
	manager.BaseTurnSpeed = cfg.turnSpeedFactor or 8
	manager.GroundSensor = floorSensor
	manager.ClimbSensor = climbSensor
	manager.MovingDirection = Vector3.zero
	manager.FacingDirection = rootPart.CFrame.LookVector

	local groundCtrl = getOrCreate(manager, "GroundController", "GroundController", tag) :: GroundController
	groundCtrl.GroundOffset = groundOffset
	groundCtrl.AccelerationTime = 0.08
	groundCtrl.DecelerationTime = 0.06
	groundCtrl.Friction = 2.0
	groundCtrl.FrictionWeight = 1.0
	groundCtrl.StandForce = 20000
	groundCtrl.StandSpeed = 20
	groundCtrl.BalanceRigidityEnabled = true

	local airCtrl = getOrCreate(manager, "AirController", "AirController", tag) :: AirController
	airCtrl.MoveMaxForce = cfg.airControlForce or 12000
	airCtrl.MaintainLinearMomentum = true
	airCtrl.MaintainAngularMomentum = false
	airCtrl.BalanceRigidityEnabled = true

	local climbCtrl = getOrCreate(manager, "ClimbController", "ClimbController", tag) :: ClimbController
	climbCtrl.AccelerationTime = 0.05
	climbCtrl.MoveMaxForce = 10000

	local swimCtrl = getOrCreate(manager, "SwimController", "SwimController", tag) :: SwimController
	swimCtrl.AccelerationTime = 0.12

	manager.ActiveController = groundCtrl
	character:SetAttribute("SharpControllerSpeed", manager.BaseMoveSpeed)
	character:SetAttribute("SharpSprintMultiplier", cfg.sprintMultiplier or 1.45)

	return {
		character = character,
		rootPart = rootPart,
		manager = manager,
		groundController = groundCtrl,
		airController = airCtrl,
		climbController = climbCtrl,
		swimController = swimCtrl,
		floorSensor = floorSensor,
		climbSensor = climbSensor,
	}
end

function ControllerManagerRig.StepState(
	bundle: ControllerRigBundle,
	worldMoveDir: Vector3,
	facingDir: Vector3?,
	isSprinting: boolean?
): string
	local moveUnit = if worldMoveDir.Magnitude &gt; 1e-3 then Vector3.new(worldMoveDir.X, 0, worldMoveDir.Z).Unit else Vector3.zero
	local baseSpeed = (bundle.character:GetAttribute("SharpControllerSpeed") :: number?) or 18
	local sprintMult = (bundle.character:GetAttribute("SharpSprintMultiplier") :: number?) or 1.45
	bundle.manager.BaseMoveSpeed = if isSprinting then baseSpeed * sprintMult else baseSpeed
	bundle.manager.MovingDirection = moveUnit

	if facingDir and facingDir.Magnitude &gt; 1e-3 then
		bundle.manager.FacingDirection = Vector3.new(facingDir.X, 0, facingDir.Z).Unit
	elseif moveUnit.Magnitude &gt; 1e-3 then
		bundle.manager.FacingDirection = moveUnit
	end

	if bundle.climbSensor.SensedPart ~= nil then
		bundle.manager.ActiveController = bundle.climbController
		return "Climb"
	elseif bundle.floorSensor.SensedPart ~= nil then
		bundle.manager.ActiveController = bundle.groundController
		return "Ground"
	else
		bundle.manager.ActiveController = bundle.airController
		return "Air"
	end
end

function ControllerManagerRig.PerformDash(
	bundle: ControllerRigBundle,
	direction: Vector3?,
	dashSpeedStudsPerSec: number?,
	upwardBoost: number?
): Vector3
	local dir = direction or bundle.manager.FacingDirection
	local flat = Vector3.new(dir.X, 0, dir.Z)
	local unit = if flat.Magnitude &gt; 1e-3 then flat.Unit else Vector3.new(0, 0, -1)
	local speed = dashSpeedStudsPerSec or 68
	local up = upwardBoost or 8
	local velocity = unit * speed + Vector3.new(0, up, 0)
	bundle.rootPart.AssemblyLinearVelocity = velocity
	bundle.character:SetAttribute("LastDashTimestamp", os.clock())
	return velocity
end

function ControllerManagerRig.Cleanup(tag: string?): number
	local targetTag = tag or DEFAULT_TAG
	local removed = 0
	for _, inst in ipairs(CollectionService:GetTagged(targetTag)) do
		if inst.Parent then
			inst:Destroy()
			removed += 1
		end
	end
	return removed
end

return ControllerManagerRig
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_16">
      <Properties>
        <string name="Name">WeaponToolAssembler</string>
        <ProtectedString name="Source">--!strict
--[[
	WeaponToolAssembler
	Builds Motor6D weapon/holster socket bindings, combo state machines, and
	modern Input Action System (InputContext -&gt; InputAction -&gt; InputBinding)
	hierarchies without legacy server Scripts inside Tool instances.
]]

local CollectionService = game:GetService("CollectionService")

export type WeaponSpec = {
	weaponId: string,
	displayName: string,
	gripPartName: string?,
	holsterPartName: string?,
	gripOffsetCFrame: CFrame?,
	holsterOffsetCFrame: CFrame?,
	comboCount: number?,
	comboResetWindowSec: number?,
	baseDamage: number?,
	attackCooldownSec: number?,
	rangeStuds: number?,
	bladeSize: Vector3?,
	tag: string?,
}

export type ComboState = {
	weaponId: string,
	equipped: boolean,
	blocking: boolean,
	comboStep: number,
	maxCombo: number,
	lastSwingTime: number,
	cooldownSec: number,
	comboResetWindowSec: number,
}

local DEFAULT_TAG = "SharpWeaponSystemManaged"

local WeaponToolAssembler = {}

function WeaponToolAssembler.BuildInputContext(parent: Instance, contextName: string?, tag: string?): Instance
	local ctxName = contextName or "CombatInputContext"
	local managedTag = tag or DEFAULT_TAG

	local existing = parent:FindFirstChild(ctxName)
	if existing then
		existing:Destroy()
	end

	local okIas, ctxOrErr = pcall(function()
		local ctx = Instance.new("InputContext")
		ctx.Name = ctxName
		CollectionService:AddTag(ctx, managedTag)

		local actions = {
			{ name = "AttackPrimary", key = Enum.KeyCode.MouseLeftButton, gamepad = Enum.KeyCode.ButtonR2, touchBtn = true },
			{ name = "AttackHeavy", key = Enum.KeyCode.R, gamepad = Enum.KeyCode.ButtonY, touchBtn = true },
			{ name = "BlockHold", key = Enum.KeyCode.F, gamepad = Enum.KeyCode.ButtonL2, touchBtn = true },
			{ name = "Dash", key = Enum.KeyCode.Q, gamepad = Enum.KeyCode.ButtonB, touchBtn = true },
			{ name = "ToggleEquip", key = Enum.KeyCode.One, gamepad = Enum.KeyCode.DPadUp, touchBtn = false },
		}

		for _, spec in ipairs(actions) do
			local act = Instance.new("InputAction")
			act.Name = spec.name
			act.Type = Enum.InputActionType.Bool
			act.Parent = ctx

			local kbBind = Instance.new("InputBinding")
			kbBind.Name = "KeyboardMouseBinding"
			kbBind.KeyCode = spec.key
			kbBind.Parent = act

			local gpBind = Instance.new("InputBinding")
			gpBind.Name = "GamepadBinding"
			gpBind.KeyCode = spec.gamepad
			gpBind.Parent = act
		end

		ctx.Parent = parent
		return ctx
	end)

	if okIas and ctxOrErr then
		return ctxOrErr :: Instance
	end

	-- Fallback Folder descriptor if InputContext is disabled in older Studio FFlags
	local fallback = Instance.new("Folder")
	fallback.Name = ctxName
	fallback:SetAttribute("InputSystemKind", "FallbackDescriptor")
	CollectionService:AddTag(fallback, managedTag)
	fallback.Parent = parent
	return fallback
end

function WeaponToolAssembler.AssembleWeaponModel(spec: WeaponSpec, parent: Instance?): (Model, BasePart)
	local managedTag = spec.tag or DEFAULT_TAG
	local model = Instance.new("Model")
	model.Name = spec.weaponId
	model:SetAttribute("WeaponId", spec.weaponId)
	model:SetAttribute("DisplayName", spec.displayName)
	model:SetAttribute("BaseDamage", spec.baseDamage or 25)
	model:SetAttribute("AttackCooldownSec", spec.attackCooldownSec or 0.42)
	model:SetAttribute("RangeStuds", spec.rangeStuds or 8.5)
	model:SetAttribute("MaxCombo", spec.comboCount or 3)
	CollectionService:AddTag(model, managedTag)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.4, 1.2, 0.4)
	handle.CanCollide = false
	handle.CanQuery = false
	handle.CanTouch = false
	handle.Massless = true
	handle.Color = Color3.fromRGB(95, 102, 118)
	handle.Material = Enum.Material.Metal
	handle.Parent = model

	local blade = Instance.new("Part")
	blade.Name = "BladeHitbox"
	blade.Size = spec.bladeSize or Vector3.new(0.35, 3.8, 0.8)
	blade.CFrame = handle.CFrame * CFrame.new(0, 2.4, 0)
	blade.CanCollide = false
	blade.CanQuery = false
	blade.CanTouch = false
	blade.Massless = true
	blade.Color = Color3.fromRGB(210, 220, 235)
	blade.Material = Enum.Material.Metal
	blade.Parent = model

	local weld = Instance.new("WeldConstraint")
	weld.Name = "BladeWeld"
	weld.Part0 = handle
	weld.Part1 = blade
	weld.Parent = handle

	local gripAtt = Instance.new("Attachment")
	gripAtt.Name = "GripAttachment"
	gripAtt.Parent = handle

	local trailTop = Instance.new("Attachment")
	trailTop.Name = "TrailTipAttachment"
	trailTop.Position = Vector3.new(0, blade.Size.Y * 0.5, 0)
	trailTop.Parent = blade

	local trailBase = Instance.new("Attachment")
	trailBase.Name = "TrailBaseAttachment"
	trailBase.Position = Vector3.new(0, -blade.Size.Y * 0.5, 0)
	trailBase.Parent = blade

	local trail = Instance.new("Trail")
	trail.Name = "SwingTrail"
	trail.Attachment0 = trailBase
	trail.Attachment1 = trailTop
	trail.Enabled = false
	trail.Lifetime = 0.18
	trail.MinLength = 0.05
	trail.FaceCamera = false
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 1.0),
	})
	trail.Parent = blade

	model.PrimaryPart = handle
	if parent then
		model.Parent = parent
	end
	return model, handle
end

function WeaponToolAssembler.BindToCharacter(
	character: Model,
	weaponModel: Model,
	spec: WeaponSpec,
	equipped: boolean
): Motor6D
	local handle = (weaponModel.PrimaryPart or weaponModel:FindFirstChild("Handle")) :: BasePart?
	assert(handle ~= nil, "Weapon Model must have a PrimaryPart or Handle.")

	local handName = spec.gripPartName or "RightHand"
	local holsterName = spec.holsterPartName or "UpperTorso"
	local targetPartName = if equipped then handName else holsterName
	local hostPart = (character:FindFirstChild(targetPartName) or character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart) :: BasePart?
	assert(hostPart ~= nil, "Character lacks target socket part for WeaponToolAssembler.")

	weaponModel.Parent = character
	local motorName = "WeaponMotor_" .. spec.weaponId
	local existingMotor = hostPart:FindFirstChild(motorName)
	if existingMotor and existingMotor:IsA("Motor6D") then
		existingMotor:Destroy()
	end

	-- Remove any motor on the other socket part
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("Motor6D") and d.Name == motorName then
			d:Destroy()
		end
	end

	local motor = Instance.new("Motor6D")
	motor.Name = motorName
	motor.Part0 = hostPart
	motor.Part1 = handle
	motor.C0 = if equipped
		then (spec.gripOffsetCFrame or CFrame.new(0, -0.15, 0) * CFrame.Angles(math.rad(-90), 0, 0))
		else (spec.holsterOffsetCFrame or CFrame.new(-0.85, -0.6, 0.55) * CFrame.Angles(0, 0, math.rad(135)))
	motor.C1 = CFrame.identity
	motor.Parent = hostPart

	character:SetAttribute("EquippedWeaponId", if equipped then spec.weaponId else "")
	return motor
end

function WeaponToolAssembler.CreateComboState(spec: WeaponSpec): ComboState
	return {
		weaponId = spec.weaponId,
		equipped = true,
		blocking = false,
		comboStep = 0,
		maxCombo = spec.comboCount or 3,
		lastSwingTime = 0,
		cooldownSec = spec.attackCooldownSec or 0.42,
		comboResetWindowSec = spec.comboResetWindowSec or 1.25,
	}
end

function WeaponToolAssembler.TryAdvanceCombo(state: ComboState, nowClock: number?): (boolean, number, string)
	local now = nowClock or os.clock()
	if not state.equipped then
		return false, state.comboStep, "NOT_EQUIPPED"
	end
	if state.blocking then
		return false, state.comboStep, "BLOCKING"
	end
	if (now - state.lastSwingTime) &lt; state.cooldownSec then
		return false, state.comboStep, "ON_COOLDOWN"
	end
	if (now - state.lastSwingTime) &gt; state.comboResetWindowSec or state.comboStep &gt;= state.maxCombo then
		state.comboStep = 1
	else
		state.comboStep += 1
	end
	state.lastSwingTime = now
	return true, state.comboStep, "SWING_" .. tostring(state.comboStep)
end

function WeaponToolAssembler.Cleanup(tag: string?): number
	local targetTag = tag or DEFAULT_TAG
	local removed = 0
	for _, inst in ipairs(CollectionService:GetTagged(targetTag)) do
		if inst.Parent then
			inst:Destroy()
			removed += 1
		end
	end
	return removed
end

return WeaponToolAssembler
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_17">
      <Properties>
        <string name="Name">CombatHitboxAndProjectile</string>
        <ProtectedString name="Source">--!strict
--[[
	CombatHitboxAndProjectile
	Server-authoritative melee Shapecast / GetPartBoundsInBox hit detection,
	anti-exploit reach/cooldown/angle/LOS validator, and stepped raycast
	ballistic projectile simulator (gravity, drag, pierce, bounce).
]]

local Workspace = game:GetService("Workspace")

export type MeleeSweepSpec = {
	originCFrame: CFrame,
	boxSize: Vector3,
	sweepDirection: Vector3?,
	excludeInstances: { Instance }?,
	maxTargets: number?,
	alreadyHitModels: { [Model]: boolean }?,
}

export type HitRecord = {
	targetModel: Model,
	humanoid: Humanoid?,
	hitPart: BasePart,
	hitPosition: Vector3,
	distanceStuds: number,
}

export type ServerValidationSpec = {
	attackerRoot: BasePart,
	targetRoot: BasePart,
	maxRangeStuds: number,
	maxHalfAngleDeg: number?,
	pingSeconds: number?,
	lastAttackClock: number?,
	minCooldownSec: number?,
	nowClock: number?,
	requireLineOfSight: boolean?,
	excludeInstances: { Instance }?,
}

export type ProjectileSpec = {
	origin: Vector3,
	initialVelocity: Vector3,
	gravity: Vector3?,
	dragCoefficient: number?,
	maxLifetimeSec: number?,
	maxBounces: number?,
	bounciness: number?,
	excludeInstances: { Instance }?,
}

export type ProjectileStepResult = {
	position: Vector3,
	velocity: Vector3,
	elapsedSec: number,
	bounces: number,
	alive: boolean,
	hitPart: BasePart?,
	hitNormal: Vector3?,
}

local CombatHitboxAndProjectile = {}

local function resolveCharacterModel(part: Instance): Model?
	local cur: Instance? = part
	while cur and cur ~= Workspace do
		if cur:IsA("Model") and (cur:FindFirstChildOfClass("Humanoid") or cur:GetAttribute("IsDamageableTarget") == true) then
			return cur
		end
		cur = cur.Parent
	end
	return nil
end

function CombatHitboxAndProjectile.SweepMeleeHitbox(spec: MeleeSweepSpec): { HitRecord }
	local exclude = spec.excludeInstances or {}
	local maxTargets = spec.maxTargets or 8
	local seen: { [Model]: boolean } = spec.alreadyHitModels or {}
	local hits: { HitRecord } = {}

	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = exclude
	overlapParams.MaxParts = 32

	-- 1. Check immediate oriented bounding box overlap at t = 0
	local boxParts = Workspace:GetPartBoundsInBox(spec.originCFrame, spec.boxSize, overlapParams)
	for _, part in ipairs(boxParts) do
		local model = resolveCharacterModel(part)
		if model and not seen[model] then
			seen[model] = true
			local hum = model:FindFirstChildOfClass("Humanoid")
			if not hum or hum.Health &gt; 0 then
				local dist = (part.Position - spec.originCFrame.Position).Magnitude
				table.insert(hits, {
					targetModel = model,
					humanoid = hum,
					hitPart = part,
					hitPosition = part.Position,
					distanceStuds = dist,
				})
				if #hits &gt;= maxTargets then
					return hits
				end
			end
		end
	end

	-- 2. Continuous Shapecast (Blockcast) along sweepDirection if non-zero
	local dir = spec.sweepDirection
	if dir and dir.Magnitude &gt; 1e-3 and #hits &lt; maxTargets then
		local rayParams = RaycastParams.new()
		rayParams.FilterType = Enum.RaycastFilterType.Exclude
		rayParams.FilterDescendantsInstances = exclude
		rayParams.IgnoreWater = true

		local castRes = Workspace:Blockcast(spec.originCFrame, spec.boxSize, dir, rayParams)
		if castRes and castRes.Instance then
			local model = resolveCharacterModel(castRes.Instance)
			if model and not seen[model] then
				seen[model] = true
				local hum = model:FindFirstChildOfClass("Humanoid")
				if not hum or hum.Health &gt; 0 then
					table.insert(hits, {
						targetModel = model,
						humanoid = hum,
						hitPart = castRes.Instance,
						hitPosition = castRes.Position,
						distanceStuds = castRes.Distance,
					})
				end
			end
		end
	end

	return hits
end

function CombatHitboxAndProjectile.ValidateServerHit(spec: ServerValidationSpec): (boolean, string)
	local now = spec.nowClock or os.clock()
	if spec.lastAttackClock and spec.minCooldownSec then
		if (now - spec.lastAttackClock) &lt; (spec.minCooldownSec * 0.85) then
			return false, "COOLDOWN_VIOLATION"
		end
	end

	local delta = spec.targetRoot.Position - spec.attackerRoot.Position
	local dist = delta.Magnitude
	local pingGrace = math.clamp((spec.pingSeconds or 0.06) * 24.0, 1.5, 7.5)
	if dist &gt; (spec.maxRangeStuds + pingGrace) then
		return false, "OUT_OF_RANGE"
	end

	local maxHalfAngle = spec.maxHalfAngleDeg or 105
	if dist &gt; 0.5 and maxHalfAngle &lt; 180 then
		local dirUnit = Vector3.new(delta.X, 0, delta.Z)
		local lookFlat = Vector3.new(spec.attackerRoot.CFrame.LookVector.X, 0, spec.attackerRoot.CFrame.LookVector.Z)
		if dirUnit.Magnitude &gt; 1e-3 and lookFlat.Magnitude &gt; 1e-3 then
			local dot = lookFlat.Unit:Dot(dirUnit.Unit)
			local minCos = math.cos(math.rad(maxHalfAngle))
			if dot &lt; minCos then
				return false, "OUT_OF_FACING_CONE"
			end
		end
	end

	local requireLOS = if spec.requireLineOfSight == nil then true else spec.requireLineOfSight
	if requireLOS then
		local rayParams = RaycastParams.new()
		rayParams.FilterType = Enum.RaycastFilterType.Exclude
		local filter: { Instance } = { spec.attackerRoot.Parent :: Instance, spec.targetRoot.Parent :: Instance }
		if spec.excludeInstances then
			for _, ex in ipairs(spec.excludeInstances) do
				table.insert(filter, ex)
			end
		end
		rayParams.FilterDescendantsInstances = filter
		rayParams.IgnoreWater = true

		local losHit = Workspace:Raycast(spec.attackerRoot.Position, delta, rayParams)
		if losHit and losHit.Instance and losHit.Instance.CanCollide then
			return false, "LINE_OF_SIGHT_BLOCKED"
		end
	end

	return true, "VALID_HIT"
end

function CombatHitboxAndProjectile.SimulateProjectileTrajectory(
	spec: ProjectileSpec,
	stepDt: number?,
	maxSteps: number?
): { ProjectileStepResult }
	local dt = math.clamp(stepDt or (1 / 60), 1 / 240, 0.1)
	local stepsLimit = maxSteps or 120
	local gravity = spec.gravity or Vector3.new(0, -Workspace.Gravity, 0)
	local drag = spec.dragCoefficient or 0.02
	local maxLifetime = spec.maxLifetimeSec or 3.0
	local maxBounces = spec.maxBounces or 0
	local bounciness = math.clamp(spec.bounciness or 0.6, 0, 1)

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = spec.excludeInstances or {}
	rayParams.IgnoreWater = true

	local pos = spec.origin
	local vel = spec.initialVelocity
	local elapsed = 0.0
	local bounces = 0
	local history: { ProjectileStepResult } = {}

	for _ = 1, stepsLimit do
		if elapsed &gt;= maxLifetime then
			break
		end
		local nextVel = (vel + gravity * dt) * math.max(0, 1 - drag * dt)
		local displacement = (vel + nextVel) * 0.5 * dt
		local hit = Workspace:Raycast(pos, displacement, rayParams)

		elapsed += dt
		if hit and hit.Instance then
			if bounces &lt; maxBounces then
				bounces += 1
				local n = hit.Normal
				pos = hit.Position + n * 0.05
				vel = (nextVel - 2 * nextVel:Dot(n) * n) * bounciness
				table.insert(history, {
					position = pos,
					velocity = vel,
					elapsedSec = elapsed,
					bounces = bounces,
					alive = true,
					hitPart = hit.Instance,
					hitNormal = n,
				})
			else
				pos = hit.Position
				vel = Vector3.zero
				table.insert(history, {
					position = pos,
					velocity = vel,
					elapsedSec = elapsed,
					bounces = bounces,
					alive = false,
					hitPart = hit.Instance,
					hitNormal = hit.Normal,
				})
				break
			end
		else
			pos = pos + displacement
			vel = nextVel
			table.insert(history, {
				position = pos,
				velocity = vel,
				elapsedSec = elapsed,
				bounces = bounces,
				alive = elapsed &lt; maxLifetime,
				hitPart = nil,
				hitNormal = nil,
			})
		end
	end

	return history
end

function CombatHitboxAndProjectile.AlignModelToDirection(
	model: Model,
	position: Vector3,
	direction: Vector3,
	localForwardAxis: Vector3?,
	neutralizePivotOffset: boolean?
): CFrame
	local dirUnit = if direction.Magnitude &gt; 1e-4 then direction.Unit else Vector3.new(0, 0, -1)
	local fwd = if localForwardAxis and localForwardAxis.Magnitude &gt; 1e-4 then localForwardAxis.Unit else Vector3.new(0, 0, -1)
	local upRef = if math.abs(dirUnit:Dot(Vector3.new(0, 1, 0))) &gt; 0.99 then Vector3.new(0, 0, 1) else Vector3.new(0, 1, 0)
	local baseCF = CFrame.lookAt(position, position + dirUnit, upRef)

	-- Map arbitrary localForwardAxis (e.g. +Z FBX projectile nose) onto world LookVector (-Z)
	local targetLocalLook = Vector3.new(0, 0, -1)
	local dot = math.clamp(fwd:Dot(targetLocalLook), -1, 1)
	local axisAlign = CFrame.identity
	if dot &lt; -0.999 then
		axisAlign = CFrame.Angles(0, math.pi, 0)
	elseif dot &lt; 0.999 then
		local rotAxis = fwd:Cross(targetLocalLook)
		if rotAxis.Magnitude &gt; 1e-4 then
			axisAlign = CFrame.fromAxisAngle(rotAxis.Unit, math.acos(dot))
		end
	end

	local pp = model.PrimaryPart
	local shouldResetPivot = if neutralizePivotOffset == nil then true else neutralizePivotOffset
	if pp and shouldResetPivot then
		pp.PivotOffset = CFrame.identity
		model.WorldPivot = pp.CFrame
	end

	local finalCF = baseCF * axisAlign
	model:PivotTo(finalCF)
	return finalCF
end

function CombatHitboxAndProjectile.ComputeCrosshairAimRay(
	camera: Camera?,
	reticleGui: GuiObject?,
	muzzleOrigin: Vector3,
	excludeInstances: { Instance }?,
	maxRange: number?
): (Vector3, Vector3)
	if not camera then
		return muzzleOrigin, Vector3.new(0, 0, -1)
	end
	local vp = camera.ViewportSize
	local sx = vp.X * 0.5
	local sy = vp.Y * 0.5
	local screenRay: Ray
	if reticleGui then
		local center = reticleGui.AbsolutePosition + reticleGui.AbsoluteSize * 0.5
		screenRay = camera:ScreenPointToRay(center.X, center.Y)
	else
		screenRay = camera:ViewportPointToRay(sx, sy)
	end

	local range = maxRange or 300
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = excludeInstances or {}
	rayParams.IgnoreWater = true

	local aimHit = Workspace:Raycast(screenRay.Origin, screenRay.Direction * range, rayParams)
	local aimTarget = if aimHit then aimHit.Position else (screenRay.Origin + screenRay.Direction * range)
	local delta = aimTarget - muzzleOrigin
	local dir = if delta.Magnitude &gt; 0.25 then delta.Unit else screenRay.Direction.Unit
	return muzzleOrigin, dir
end

return CombatHitboxAndProjectile
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_18">
      <Properties>
        <string name="Name">AudioBusGraphBuilder</string>
        <ProtectedString name="Source">--!strict
--[[
	AudioBusGraphBuilder
	Builds Roblox's modern node-based Audio Wiring topology under SoundService
	(AudioPlayer -&gt; Wire -&gt; AudioFader / AudioCompressor / AudioReverb -&gt;
	AudioEmitter / AudioListener -&gt; AudioDeviceOutput) and provides built-in
	rbxasset://sounds/* playback helpers.
]]

local CollectionService = game:GetService("CollectionService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

export type BusName = "Master" | "BGM" | "SFX" | "UI" | "Ambient"

export type AudioGraphConfig = {
	masterVolume: number?,
	bgmVolume: number?,
	sfxVolume: number?,
	uiVolume: number?,
	ambientVolume: number?,
	enableSidechainDucking: boolean?,
	tag: string?,
}

export type AudioGraphBundle = {
	container: Folder,
	deviceOutput: Instance,
	masterFader: Instance,
	buses: { [BusName]: Instance },
	wiresCreated: number,
	usingModernAudioApi: boolean,
}

local DEFAULT_TAG = "SharpAudioGraphManaged"

local BUILTIN_SOUNDS: { [string]: { assetId: string, bus: BusName, volume: number, looped: boolean } } = {
	UI_ButtonClick = { assetId = "rbxasset://sounds/button.wav", bus = "UI", volume = 0.65, looped = false },
	UI_QuestPing = { assetId = "rbxasset://sounds/electronicpingshort.wav", bus = "UI", volume = 0.75, looped = false },
	Combat_SwordSlash = { assetId = "rbxasset://sounds/swordslash.wav", bus = "SFX", volume = 0.85, looped = false },
	Combat_SwordLunge = { assetId = "rbxasset://sounds/lunge.wav", bus = "SFX", volume = 0.90, looped = false },
	Movement_Footstep = { assetId = "rbxasset://sounds/action_footsteps_plastic.mp3", bus = "SFX", volume = 0.50, looped = true },
}

local AudioBusGraphBuilder = {
	BuiltInSounds = BUILTIN_SOUNDS,
}

local function connectWire(parent: Instance, name: string, source: Instance, target: Instance, targetPin: string?, tag: string): Instance?
	local ok, wireOrErr = pcall(function()
		local w = Instance.new("Wire")
		w.Name = name
		w.SourceInstance = source
		w.TargetInstance = target
		if targetPin and #targetPin &gt; 0 then
			w.TargetName = targetPin
		end
		CollectionService:AddTag(w, tag)
		w.Parent = parent
		return w
	end)
	if ok then
		return wireOrErr :: Instance
	end
	return nil
end

function AudioBusGraphBuilder.BuildMasterGraph(config: AudioGraphConfig?): AudioGraphBundle
	local cfg: AudioGraphConfig = config or {}
	local tag = cfg.tag or DEFAULT_TAG

	local existing = SoundService:FindFirstChild("SharpAudioBuses")
	if existing then
		existing:Destroy()
	end

	local container = Instance.new("Folder")
	container.Name = "SharpAudioBuses"
	CollectionService:AddTag(container, tag)
	container.Parent = SoundService

	local wiresCount = 0
	local okModern, bundleOrErr = pcall(function()
		local deviceOut = Instance.new("AudioDeviceOutput")
		deviceOut.Name = "MainDeviceOutput"
		CollectionService:AddTag(deviceOut, tag)
		deviceOut.Parent = container

		local masterFader = Instance.new("AudioFader")
		masterFader.Name = "MasterFader"
		masterFader.Volume = cfg.masterVolume or 1.0
		CollectionService:AddTag(masterFader, tag)
		masterFader.Parent = container

		if connectWire(container, "Wire_Master_To_Output", masterFader, deviceOut, nil, tag) then
			wiresCount += 1
		end

		local bgmFader = Instance.new("AudioFader")
		bgmFader.Name = "BGM_Bus"
		bgmFader.Volume = cfg.bgmVolume or 0.70
		CollectionService:AddTag(bgmFader, tag)
		bgmFader.Parent = container

		local bgmComp = Instance.new("AudioCompressor")
		bgmComp.Name = "BGM_DuckingCompressor"
		bgmComp.Threshold = -18
		bgmComp.Ratio = 6
		bgmComp.Attack = 0.03
		bgmComp.Release = 0.25
		CollectionService:AddTag(bgmComp, tag)
		bgmComp.Parent = container

		if connectWire(container, "Wire_BGM_To_Comp", bgmFader, bgmComp, nil, tag) then
			wiresCount += 1
		end
		if connectWire(container, "Wire_BGMComp_To_Master", bgmComp, masterFader, nil, tag) then
			wiresCount += 1
		end

		local sfxFader = Instance.new("AudioFader")
		sfxFader.Name = "SFX_Bus"
		sfxFader.Volume = cfg.sfxVolume or 0.90
		CollectionService:AddTag(sfxFader, tag)
		sfxFader.Parent = container

		local sfxReverb = Instance.new("AudioReverb")
		sfxReverb.Name = "SFX_Reverb"
		sfxReverb.WetLevel = -12
		sfxReverb.DryLevel = 0
		CollectionService:AddTag(sfxReverb, tag)
		sfxReverb.Parent = container

		if connectWire(container, "Wire_SFX_To_Reverb", sfxFader, sfxReverb, nil, tag) then
			wiresCount += 1
		end
		if connectWire(container, "Wire_SFXReverb_To_Master", sfxReverb, masterFader, nil, tag) then
			wiresCount += 1
		end

		if if cfg.enableSidechainDucking == nil then true else cfg.enableSidechainDucking then
			if connectWire(container, "Wire_SFX_Sidechain_BGM", sfxFader, bgmComp, "Sidechain", tag) then
				wiresCount += 1
			end
		end

		local uiFader = Instance.new("AudioFader")
		uiFader.Name = "UI_Bus"
		uiFader.Volume = cfg.uiVolume or 0.85
		CollectionService:AddTag(uiFader, tag)
		uiFader.Parent = container
		if connectWire(container, "Wire_UI_To_Master", uiFader, masterFader, nil, tag) then
			wiresCount += 1
		end

		local ambFader = Instance.new("AudioFader")
		ambFader.Name = "Ambient_Bus"
		ambFader.Volume = cfg.ambientVolume or 0.65
		CollectionService:AddTag(ambFader, tag)
		ambFader.Parent = container
		if connectWire(container, "Wire_Ambient_To_Master", ambFader, masterFader, nil, tag) then
			wiresCount += 1
		end

		-- Attach a default 3D AudioListener to CurrentCamera if present
		local cam = Workspace.CurrentCamera
		if cam then
			local oldListener = cam:FindFirstChild("SharpCameraAudioListener")
			if oldListener then
				oldListener:Destroy()
			end
			local listener = Instance.new("AudioListener")
			listener.Name = "SharpCameraAudioListener"
			listener.AudioInteractionGroup = "SharpWorldAudio"
			CollectionService:AddTag(listener, tag)
			listener.Parent = cam
			if connectWire(container, "Wire_Listener_To_SFX", listener, sfxFader, nil, tag) then
				wiresCount += 1
			end
		end

		return {
			container = container,
			deviceOutput = deviceOut,
			masterFader = masterFader,
			buses = {
				Master = masterFader,
				BGM = bgmFader,
				SFX = sfxFader,
				UI = uiFader,
				Ambient = ambFader,
			},
			wiresCreated = wiresCount,
			usingModernAudioApi = true,
		}
	end)

	if okModern and bundleOrErr then
		return bundleOrErr :: AudioGraphBundle
	end

	-- Fallback SoundGroup hierarchy if AudioPlayer/Wire FFlags are disabled
	local masterSg = Instance.new("SoundGroup")
	masterSg.Name = "Master"
	masterSg.Volume = cfg.masterVolume or 1.0
	CollectionService:AddTag(masterSg, tag)
	masterSg.Parent = container

	local busesFallback: { [BusName]: Instance } = { Master = masterSg }
	for _, bName in ipairs({ "BGM", "SFX", "UI", "Ambient" } :: { BusName }) do
		local sg = Instance.new("SoundGroup")
		sg.Name = bName .. "_Bus"
		sg.Volume = 0.8
		CollectionService:AddTag(sg, tag)
		sg.Parent = masterSg
		busesFallback[bName] = sg
	end

	return {
		container = container,
		deviceOutput = masterSg,
		masterFader = masterSg,
		buses = busesFallback,
		wiresCreated = 0,
		usingModernAudioApi = false,
	}
end

function AudioBusGraphBuilder.SpawnAudioPlayer2D(
	bundle: AudioGraphBundle,
	soundKeyOrAssetId: string,
	busName: BusName?,
	autoPlay: boolean?,
	tag: string?
): Instance
	local managedTag = tag or DEFAULT_TAG
	local preset = BUILTIN_SOUNDS[soundKeyOrAssetId]
	local assetId = if preset then preset.assetId else soundKeyOrAssetId
	local targetBusName: BusName = busName or (if preset then preset.bus else "SFX")
	local volume = if preset then preset.volume else 0.8
	local looped = if preset then preset.looped else false
	local targetBus = bundle.buses[targetBusName] or bundle.masterFader

	if bundle.usingModernAudioApi then
		local player = Instance.new("AudioPlayer")
		player.Name = "AudioPlayer_" .. soundKeyOrAssetId
		player.Asset = assetId
		player.Volume = volume
		player.Looping = looped
		CollectionService:AddTag(player, managedTag)
		player.Parent = bundle.container
		connectWire(bundle.container, "Wire_" .. player.Name, player, targetBus, nil, managedTag)
		if autoPlay then
			pcall(function()
				player:Play()
			end)
		end
		return player
	else
		local snd = Instance.new("Sound")
		snd.Name = "Sound_" .. soundKeyOrAssetId
		snd.SoundId = assetId
		snd.Volume = volume
		snd.Looped = looped
		if targetBus:IsA("SoundGroup") then
			snd.SoundGroup = targetBus
		end
		CollectionService:AddTag(snd, managedTag)
		snd.Parent = bundle.container
		if autoPlay then
			pcall(function()
				snd:Play()
			end)
		end
		return snd
	end
end

function AudioBusGraphBuilder.Attach3DEmitter(
	hostPartOrAttachment: Instance,
	soundKeyOrAssetId: string,
	tag: string?
): (Instance, Instance?)
	local managedTag = tag or DEFAULT_TAG
	local preset = BUILTIN_SOUNDS[soundKeyOrAssetId]
	local assetId = if preset then preset.assetId else soundKeyOrAssetId
	local volume = if preset then preset.volume else 0.85

	local okModern, pOrErr, eOrErr = pcall(function()
		local player = Instance.new("AudioPlayer")
		player.Name = "SpatialPlayer_" .. soundKeyOrAssetId
		player.Asset = assetId
		player.Volume = volume
		CollectionService:AddTag(player, managedTag)
		player.Parent = hostPartOrAttachment

		local emitter = Instance.new("AudioEmitter")
		emitter.Name = "SpatialEmitter_" .. soundKeyOrAssetId
		emitter.AudioInteractionGroup = "SharpWorldAudio"
		CollectionService:AddTag(emitter, managedTag)
		emitter.Parent = hostPartOrAttachment

		connectWire(hostPartOrAttachment, "Wire_Player_To_Emitter", player, emitter, nil, managedTag)
		return player, emitter
	end)

	if okModern and pOrErr then
		return pOrErr :: Instance, eOrErr :: Instance?
	end

	local snd = Instance.new("Sound")
	snd.Name = "SpatialSound_" .. soundKeyOrAssetId
	snd.SoundId = assetId
	snd.Volume = volume
	snd.RollOffMaxDistance = 80
	snd.RollOffMinDistance = 8
	CollectionService:AddTag(snd, managedTag)
	snd.Parent = hostPartOrAttachment
	return snd, nil
end

function AudioBusGraphBuilder.Cleanup(tag: string?): number
	local targetTag = tag or DEFAULT_TAG
	local removed = 0
	for _, inst in ipairs(CollectionService:GetTagged(targetTag)) do
		if inst.Parent then
			inst:Destroy()
			removed += 1
		end
	end
	return removed
end

return AudioBusGraphBuilder
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_19">
      <Properties>
        <string name="Name">VfxPresetAndHighlightPool</string>
        <ProtectedString name="Source">--!strict
--[[
	VfxPresetAndHighlightPool
	Provides:
	1. Deterministic one-shot ParticleEmitter burst presets (Rate = 0 + :Emit(n))
	   with power-of-two FlipbookLayout support and built-in rbxasset://textures/particles/*.
	2. A hard-capped Highlight Pool Manager (max 28 active Highlights, safely under
	   Roblox's 31 simultaneous Highlight engine limit) with LRU eviction.
]]

local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

export type VfxPresetKind = "HitSparks" | "ExplosionFlipbook" | "LevelUpNova" | "DashSmoke"

export type HighlightSlot = {
	highlight: Highlight,
	inUse: boolean,
	assignedAt: number,
	target: Instance?,
}

export type HighlightPool = {
	container: Folder,
	maxSlots: number,
	slots: { HighlightSlot },
}

local MAX_SAFE_HIGHLIGHTS = 28
local DEFAULT_TAG = "SharpVfxAndHighlightManaged"

local VfxPresetAndHighlightPool = {
	MAX_SAFE_HIGHLIGHTS = MAX_SAFE_HIGHLIGHTS,
}

function VfxPresetAndHighlightPool.CreateEmitterPreset(
	presetKind: VfxPresetKind,
	parent: Instance,
	emitImmediatelyCount: number?,
	tag: string?
): ParticleEmitter
	local managedTag = tag or DEFAULT_TAG
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "VFX_" .. presetKind
	pe.Rate = 0 -- Strict burst discipline: Rate = 0 + :Emit(n)
	CollectionService:AddTag(pe, managedTag)

	if presetKind == "HitSparks" then
		pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		pe.Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), Color3.fromRGB(255, 95, 40))
		pe.LightEmission = 0.85
		pe.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.55),
			NumberSequenceKeypoint.new(1, 0.0),
		})
		pe.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.0),
			NumberSequenceKeypoint.new(1, 1.0),
		})
		pe.Lifetime = NumberRange.new(0.18, 0.35)
		pe.Speed = NumberRange.new(16, 32)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Drag = 6.0
	elseif presetKind == "ExplosionFlipbook" then
		pe.Texture = "rbxasset://textures/particles/explosion01_implosion_main.dds"
		pcall(function()
			pe.FlipbookLayout = Enum.ParticleFlipbookLayout.Grid4x4
			pe.FlipbookMode = Enum.ParticleFlipbookMode.OneShot
		end)
		pe.LightEmission = 0.75
		pe.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1.5),
			NumberSequenceKeypoint.new(0.5, 4.2),
			NumberSequenceKeypoint.new(1, 5.0),
		})
		pe.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05),
			NumberSequenceKeypoint.new(0.8, 0.35),
			NumberSequenceKeypoint.new(1, 1.0),
		})
		pe.Lifetime = NumberRange.new(0.35, 0.55)
		pe.Speed = NumberRange.new(2, 8)
		pe.SpreadAngle = Vector2.new(90, 90)
	elseif presetKind == "LevelUpNova" then
		pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		pe.Color = ColorSequence.new(Color3.fromRGB(110, 235, 255), Color3.fromRGB(185, 130, 255))
		pe.LightEmission = 1.0
		pe.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.8),
			NumberSequenceKeypoint.new(0.7, 1.2),
			NumberSequenceKeypoint.new(1, 0.0),
		})
		pe.Lifetime = NumberRange.new(0.5, 0.9)
		pe.Speed = NumberRange.new(12, 24)
		pe.SpreadAngle = Vector2.new(180, 45)
		pe.Acceleration = Vector3.new(0, 14, 0)
	else -- DashSmoke
		pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
		pe.Color = ColorSequence.new(Color3.fromRGB(200, 210, 225))
		pe.LightEmission = 0.1
		pe.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1.2),
			NumberSequenceKeypoint.new(1, 2.8),
		})
		pe.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(1, 1.0),
		})
		pe.Lifetime = NumberRange.new(0.25, 0.45)
		pe.Speed = NumberRange.new(4, 10)
		pe.SpreadAngle = Vector2.new(60, 30)
	end

	pe.Parent = parent
	if emitImmediatelyCount and emitImmediatelyCount &gt; 0 then
		pe:Emit(emitImmediatelyCount)
	end
	return pe
end

function VfxPresetAndHighlightPool.CreateHighlightPool(maxSlots: number?, tag: string?): HighlightPool
	local managedTag = tag or DEFAULT_TAG
	local capped = math.clamp(maxSlots or MAX_SAFE_HIGHLIGHTS, 1, MAX_SAFE_HIGHLIGHTS)

	local existing = Workspace:FindFirstChild("_SharpHighlightPool")
	if existing then
		existing:Destroy()
	end

	local folder = Instance.new("Folder")
	folder.Name = "_SharpHighlightPool"
	folder:SetAttribute("MaxHighlightCap", capped)
	CollectionService:AddTag(folder, managedTag)
	folder.Parent = Workspace

	local slots: { HighlightSlot } = table.create(capped)
	for i = 1, capped do
		local hl = Instance.new("Highlight")
		hl.Name = string.format("PooledHighlight_%02d", i)
		hl.Enabled = false
		hl.Adornee = nil
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.FillTransparency = 1
		hl.OutlineTransparency = 1
		CollectionService:AddTag(hl, managedTag)
		hl.Parent = folder
		slots[i] = {
			highlight = hl,
			inUse = false,
			assignedAt = 0,
			target = nil,
		}
	end

	return {
		container = folder,
		maxSlots = capped,
		slots = slots,
	}
end

function VfxPresetAndHighlightPool.AcquireHighlight(
	pool: HighlightPool,
	target: Instance,
	fillColor: Color3?,
	outlineColor: Color3?,
	fillTransparency: number?,
	outlineTransparency: number?
): (Highlight, boolean)
	-- 1. Check if target already has an active highlight in the pool
	for _, slot in ipairs(pool.slots) do
		if slot.inUse and slot.target == target then
			slot.assignedAt = os.clock()
			slot.highlight.FillColor = fillColor or Color3.fromRGB(255, 80, 80)
			slot.highlight.OutlineColor = outlineColor or Color3.fromRGB(255, 255, 255)
			slot.highlight.FillTransparency = fillTransparency or 0.30
			slot.highlight.OutlineTransparency = outlineTransparency or 0.0
			return slot.highlight, false
		end
	end

	-- 2. Find first free slot, or evict oldest (LRU) so we NEVER exceed 28 active Highlights
	local chosenSlot: HighlightSlot? = nil
	local evicted = false
	for _, slot in ipairs(pool.slots) do
		if not slot.inUse then
			chosenSlot = slot
			break
		end
	end

	if not chosenSlot then
		evicted = true
		local oldest = pool.slots[1]
		for i = 2, #pool.slots do
			if pool.slots[i].assignedAt &lt; oldest.assignedAt then
				oldest = pool.slots[i]
			end
		end
		chosenSlot = oldest
	end

	assert(chosenSlot ~= nil, "HighlightPool must have at least 1 slot")
	chosenSlot.inUse = true
	chosenSlot.assignedAt = os.clock()
	chosenSlot.target = target
	chosenSlot.highlight.Adornee = target
	chosenSlot.highlight.FillColor = fillColor or Color3.fromRGB(255, 80, 80)
	chosenSlot.highlight.OutlineColor = outlineColor or Color3.fromRGB(255, 255, 255)
	chosenSlot.highlight.FillTransparency = fillTransparency or 0.30
	chosenSlot.highlight.OutlineTransparency = outlineTransparency or 0.0
	chosenSlot.highlight.Enabled = true
	return chosenSlot.highlight, evicted
end

function VfxPresetAndHighlightPool.ReleaseHighlight(pool: HighlightPool, targetOrHighlight: Instance): boolean
	for _, slot in ipairs(pool.slots) do
		if slot.target == targetOrHighlight or slot.highlight == targetOrHighlight then
			slot.inUse = false
			slot.target = nil
			slot.highlight.Enabled = false
			slot.highlight.Adornee = nil
			slot.highlight.FillTransparency = 1
			slot.highlight.OutlineTransparency = 1
			return true
		end
	end
	return false
end

function VfxPresetAndHighlightPool.GetActiveCount(pool: HighlightPool): number
	local c = 0
	for _, slot in ipairs(pool.slots) do
		if slot.inUse then
			c += 1
		end
	end
	return c
end

function VfxPresetAndHighlightPool.Cleanup(tag: string?): number
	local targetTag = tag or DEFAULT_TAG
	local removed = 0
	for _, inst in ipairs(CollectionService:GetTagged(targetTag)) do
		if inst.Parent then
			inst:Destroy()
			removed += 1
		end
	end
	return removed
end

return VfxPresetAndHighlightPool
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_20">
      <Properties>
        <string name="Name">CameraShakeAndCutscene</string>
        <ProtectedString name="Source">--!strict
--[[
	CameraShakeAndCutscene
	Provides:
	1. Perlin-noise trauma camera shake (`shakeIntensity = trauma^2`) safe for
	   `Enum.RenderPriority.Camera.Value + 1`.
	2. Catmull-Rom CFrame spline evaluator for cinematic camera paths with
	   smooth orientation slerp and non-destructive camera state restoration.
]]

export type TraumaShaker = {
	trauma: number,
	decayPerSec: number,
	maxOffsetStuds: Vector3,
	maxRotDeg: Vector3,
	frequency: number,
	seed: number,
	elapsed: number,
}

export type CutsceneKeyframe = {
	cframe: CFrame,
	fov: number?,
	focusDistance: number?,
}

local CameraShakeAndCutscene = {}

function CameraShakeAndCutscene.CreateTraumaShaker(
	decayPerSec: number?,
	maxOffsetStuds: Vector3?,
	maxRotDeg: Vector3?,
	frequency: number?,
	seed: number?
): TraumaShaker
	return {
		trauma = 0.0,
		decayPerSec = decayPerSec or 1.35,
		maxOffsetStuds = maxOffsetStuds or Vector3.new(1.2, 1.2, 0.4),
		maxRotDeg = maxRotDeg or Vector3.new(4.5, 4.5, 6.0),
		frequency = frequency or 22.0,
		seed = seed or 1337,
		elapsed = 0.0,
	}
end

function CameraShakeAndCutscene.AddTrauma(shaker: TraumaShaker, amount: number): number
	shaker.trauma = math.clamp(shaker.trauma + amount, 0.0, 1.0)
	return shaker.trauma
end

function CameraShakeAndCutscene.StepTraumaShake(shaker: TraumaShaker, dt: number): CFrame
	if shaker.trauma &lt;= 1e-4 then
		shaker.trauma = 0.0
		return CFrame.identity
	end
	shaker.elapsed += dt
	local t = shaker.elapsed * shaker.frequency
	local s = shaker.seed
	local shake = shaker.trauma * shaker.trauma -- Quadratic trauma falloff feels natural

	local nx = math.noise(t, s + 1.1, 0.0)
	local ny = math.noise(t, s + 2.3, 0.0)
	local nz = math.noise(t, s + 3.7, 0.0)
	local rx = math.noise(t, s + 5.1, 1.0)
	local ry = math.noise(t, s + 7.3, 1.0)
	local rz = math.noise(t, s + 9.7, 1.0)

	local offset = Vector3.new(
		nx * shaker.maxOffsetStuds.X * shake,
		ny * shaker.maxOffsetStuds.Y * shake,
		nz * shaker.maxOffsetStuds.Z * shake
	)
	local rot = CFrame.Angles(
		math.rad(rx * shaker.maxRotDeg.X * shake),
		math.rad(ry * shaker.maxRotDeg.Y * shake),
		math.rad(rz * shaker.maxRotDeg.Z * shake)
	)

	shaker.trauma = math.max(0.0, shaker.trauma - shaker.decayPerSec * dt)
	return CFrame.new(offset) * rot
end

local function catmullRomVector3(p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3, t: number): Vector3
	local t2 = t * t
	local t3 = t2 * t
	return 0.5 * (
		(2 * p1)
		+ (-p0 + p2) * t
		+ (2 * p0 - 5 * p1 + 4 * p2 - p3) * t2
		+ (-p0 + 3 * p1 - 3 * p2 + p3) * t3
	)
end

function CameraShakeAndCutscene.EvaluateSpline(
	waypoints: { CutsceneKeyframe },
	alpha: number
): (CFrame, number, number)
	local n = #waypoints
	assert(n &gt;= 2, "Cutscene spline requires at least 2 waypoints.")

	local clamped = math.clamp(alpha, 0.0, 1.0)
	local scaled = clamped * (n - 1)
	local segIdx = math.clamp(math.floor(scaled) + 1, 1, n - 1)
	local localT = scaled - (segIdx - 1)

	local w0 = waypoints[math.max(1, segIdx - 1)]
	local w1 = waypoints[segIdx]
	local w2 = waypoints[math.min(n, segIdx + 1)]
	local w3 = waypoints[math.min(n, segIdx + 2)]

	local pos = catmullRomVector3(w0.cframe.Position, w1.cframe.Position, w2.cframe.Position, w3.cframe.Position, localT)
	local rotCf = (w1.cframe - w1.cframe.Position):Lerp(w2.cframe - w2.cframe.Position, localT)
	local fov1 = w1.fov or 70
	local fov2 = w2.fov or 70
	local fov = fov1 + (fov2 - fov1) * localT

	local fd1 = w1.focusDistance or 15
	local fd2 = w2.focusDistance or 15
	local focusDist = fd1 + (fd2 - fd1) * localT

	return CFrame.new(pos) * rotCf, fov, focusDist
end

return CameraShakeAndCutscene
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_21">
      <Properties>
        <string name="Name">SessionLockedDataStore</string>
        <ProtectedString name="Source">--!strict
--[[
	SessionLockedDataStore
	ProfileStore-grade player profile manager with:
	- UpdateAsync session locking (prevents item duplication across server hops)
	- Schema version migration
	- Automatic offline Studio in-memory mock fallback when API access is disabled
	- Clean release on PlayerRemoving / BindToClose
]]

local DataStoreService = game:GetService("DataStoreService")

export type ProfileMeta = {
	schemaVersion: number,
	sessionLockJobId: string?,
	sessionLockTimestamp: number,
	sessionLoadCount: number,
	updatedAt: number,
}

export type PlayerProfile&lt;T&gt; = {
	userId: number,
	key: string,
	data: T,
	meta: ProfileMeta,
	processedReceipts: { string },
	usingMockStore: boolean,
}

export type StoreConfig&lt;T&gt; = {
	storeName: string,
	schemaVersion: number,
	defaultDataFactory: () -&gt; T,
	migrator: ((oldVersion: number, rawData: any) -&gt; T)?,
	lockTimeoutSec: number?,
	forceMock: boolean?,
}

local MAX_RECEIPT_HISTORY = 100
local DEFAULT_LOCK_TIMEOUT_SEC = 180

local SessionLockedDataStore = {}

local function deepCopy&lt;V&gt;(val: V): V
	if type(val) ~= "table" then
		return val
	end
	local copy: { [any]: any } = {}
	for k, v in pairs(val :: any) do
		copy[deepCopy(k)] = deepCopy(v)
	end
	return (copy :: any) :: V
end

function SessionLockedDataStore.CreateManager&lt;T&gt;(config: StoreConfig&lt;T&gt;)
	local lockTimeout = config.lockTimeoutSec or DEFAULT_LOCK_TIMEOUT_SEC
	local activeProfiles: { [number]: PlayerProfile&lt;T&gt; } = {}
	local mockBackingStore: { [string]: any } = {}
	local liveStore: GlobalDataStore? = nil
	local useMock = if config.forceMock ~= nil then config.forceMock else (game.PlaceId == 0)

	if not useMock then
		local okStore, storeOrErr = pcall(function()
			return DataStoreService:GetDataStore(config.storeName)
		end)
		if okStore and storeOrErr then
			liveStore = storeOrErr
		else
			useMock = true
		end
	end

	local currentJobId = if #game.JobId &gt; 0 then game.JobId else "StudioLocalSession"

	local function rawUpdateAsync(key: string, transformFn: (oldVal: any) -&gt; any): (boolean, any)
		if not useMock and liveStore then
			local okUpd, resOrErr = pcall(function()
				return liveStore:UpdateAsync(key, transformFn)
			end)
			if okUpd then
				return true, resOrErr
			end
			-- Fallback to mock store if Studio API access is disabled
			useMock = true
		end

		local existing = deepCopy(mockBackingStore[key])
		local updated = transformFn(existing)
		if updated ~= nil then
			mockBackingStore[key] = deepCopy(updated)
		end
		return true, deepCopy(mockBackingStore[key])
	end

	local manager = {}

	function manager.LoadProfile(userId: number, stealStaleLock: boolean?): (boolean, PlayerProfile&lt;T&gt;?, string)
		local key = "Player_" .. tostring(userId)
		local now = os.time()
		local lockBlockedByOtherServer = false

		local ok, rawEnvelope = rawUpdateAsync(key, function(oldEnvelope: any): any
			if type(oldEnvelope) ~= "table" then
				local freshData = config.defaultDataFactory()
				return {
					data = freshData,
					meta = {
						schemaVersion = config.schemaVersion,
						sessionLockJobId = currentJobId,
						sessionLockTimestamp = now,
						sessionLoadCount = 1,
						updatedAt = now,
					},
					processedReceipts = {},
				}
			end

			local meta: ProfileMeta = oldEnvelope.meta or {
				schemaVersion = 1,
				sessionLockJobId = nil,
				sessionLockTimestamp = 0,
				sessionLoadCount = 0,
				updatedAt = now,
			}

			local lockedByOther = meta.sessionLockJobId ~= nil
				and meta.sessionLockJobId ~= currentJobId
				and (now - (meta.sessionLockTimestamp or 0)) &lt; lockTimeout

			if lockedByOther and not stealStaleLock then
				lockBlockedByOtherServer = true
				return nil
			end

			local data: T = oldEnvelope.data
			if (meta.schemaVersion or 1) &lt; config.schemaVersion and config.migrator then
				data = config.migrator(meta.schemaVersion or 1, data)
			end
			-- Reconcile missing top-level default keys
			local defaults = config.defaultDataFactory()
			if type(data) == "table" and type(defaults) == "table" then
				for k, defVal in pairs(defaults :: any) do
					if (data :: any)[k] == nil then
						(data :: any)[k] = deepCopy(defVal)
					end
				end
			end

			meta.schemaVersion = config.schemaVersion
			meta.sessionLockJobId = currentJobId
			meta.sessionLockTimestamp = now
			meta.sessionLoadCount = (meta.sessionLoadCount or 0) + 1
			meta.updatedAt = now

			oldEnvelope.data = data
			oldEnvelope.meta = meta
			oldEnvelope.processedReceipts = oldEnvelope.processedReceipts or {}
			return oldEnvelope
		end)

		if not ok or lockBlockedByOtherServer or type(rawEnvelope) ~= "table" then
			return false, nil, if lockBlockedByOtherServer then "SESSION_LOCKED_BY_OTHER_SERVER" else "DATASTORE_ERROR"
		end

		local profile: PlayerProfile&lt;T&gt; = {
			userId = userId,
			key = key,
			data = rawEnvelope.data,
			meta = rawEnvelope.meta,
			processedReceipts = rawEnvelope.processedReceipts or {},
			usingMockStore = useMock,
		}
		activeProfiles[userId] = profile
		return true, profile, "LOADED"
	end

	function manager.GetActiveProfile(userId: number): PlayerProfile&lt;T&gt;?
		return activeProfiles[userId]
	end

	function manager.SaveProfile(userId: number, releaseSessionLock: boolean?): (boolean, string)
		local profile = activeProfiles[userId]
		if not profile then
			return false, "NO_ACTIVE_PROFILE"
		end

		local now = os.time()
		local lockOwnershipLost = false
		local ok, _ = rawUpdateAsync(profile.key, function(oldEnvelope: any): any
			if type(oldEnvelope) == "table" and type(oldEnvelope.meta) == "table" then
				local existingOwner = oldEnvelope.meta.sessionLockJobId
				if existingOwner ~= nil and existingOwner ~= currentJobId then
					lockOwnershipLost = true
					return nil
				end
			end

			profile.meta.updatedAt = now
			if releaseSessionLock then
				profile.meta.sessionLockJobId = nil
			else
				profile.meta.sessionLockJobId = currentJobId
				profile.meta.sessionLockTimestamp = now
			end

			while #profile.processedReceipts &gt; MAX_RECEIPT_HISTORY do
				table.remove(profile.processedReceipts, 1)
			end

			return {
				data = deepCopy(profile.data),
				meta = deepCopy(profile.meta),
				processedReceipts = deepCopy(profile.processedReceipts),
			}
		end)

		if lockOwnershipLost then
			activeProfiles[userId] = nil
			return false, "LOCK_OWNERSHIP_LOST"
		end
		if releaseSessionLock then
			activeProfiles[userId] = nil
		end
		return ok, if releaseSessionLock then "RELEASED" else "SAVED"
	end

	function manager.FlushAllProfiles(): number
		local flushed = 0
		local ids: { number } = {}
		for uid in pairs(activeProfiles) do
			table.insert(ids, uid)
		end
		for _, uid in ipairs(ids) do
			local ok = manager.SaveProfile(uid, true)
			if ok then
				flushed += 1
			end
		end
		return flushed
	end

	return manager
end

return SessionLockedDataStore
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_22">
      <Properties>
        <string name="Name">EconomyInventoryQuestService</string>
        <ProtectedString name="Source">--!strict
--[[
	EconomyInventoryQuestService
	Server-authoritative player economy ledger (Coins, Gems, XP, Level),
	stackable &amp; unique inventory items, Shop catalog validator, Quest tracker,
	Promo-Code redeemer, leaderstats synchronizer, and pity-backed weighted loot roller.
]]

export type PlayerEconomyData = {
	Currencies: { [string]: number },
	Level: number,
	XP: number,
	Inventory: { [string]: number },
	EquippedItems: { [string]: string },
	Quests: { [string]: { progress: number, target: number, claimed: boolean } },
	RedeemedCodes: { [string]: boolean },
	LootPityCounter: number,
}

export type ShopItemSpec = {
	itemId: string,
	displayName: string,
	currency: string,
	price: number,
	maxStack: number?,
}

export type LootDropSpec = {
	itemId: string,
	rarity: "Common" | "Rare" | "Epic" | "Legendary",
	weight: number,
}

local EconomyInventoryQuestService = {}

function EconomyInventoryQuestService.CreateDefaultData(): PlayerEconomyData
	return {
		Currencies = {
			Coins = 250,
			Gems = 25,
		},
		Level = 1,
		XP = 0,
		Inventory = {
			StarterSword = 1,
			HealthPotion = 3,
		},
		EquippedItems = {
			PrimaryWeapon = "StarterSword",
		},
		Quests = {
			DefeatBandits = { progress = 0, target = 5, claimed = false },
			CollectRelics = { progress = 0, target = 3, claimed = false },
		},
		RedeemedCodes = {},
		LootPityCounter = 0,
	}
end

function EconomyInventoryQuestService.AddCurrency(
	data: PlayerEconomyData,
	currencyName: string,
	amount: number
): (boolean, number)
	if amount ~= amount or math.abs(amount) == math.huge then
		return false, data.Currencies[currencyName] or 0
	end
	local cur = data.Currencies[currencyName] or 0
	local nextVal = cur + math.floor(amount)
	if nextVal &lt; 0 then
		return false, cur
	end
	data.Currencies[currencyName] = nextVal
	return true, nextVal
end

function EconomyInventoryQuestService.AddXP(data: PlayerEconomyData, xpGain: number): (number, number, boolean)
	if xpGain &lt;= 0 then
		return data.Level, data.XP, false
	end
	data.XP += math.floor(xpGain)
	local leveledUp = false
	while true do
		local xpNeeded = data.Level * 100
		if data.XP &gt;= xpNeeded then
			data.XP -= xpNeeded
			data.Level += 1
			leveledUp = true
		else
			break
		end
	end
	return data.Level, data.XP, leveledUp
end

function EconomyInventoryQuestService.PurchaseShopItem(
	data: PlayerEconomyData,
	item: ShopItemSpec,
	quantity: number?
): (boolean, string)
	local qty = math.max(1, math.floor(quantity or 1))
	local totalCost = item.price * qty
	local currentBal = data.Currencies[item.currency] or 0
	if currentBal &lt; totalCost then
		return false, "INSUFFICIENT_FUNDS"
	end

	local currentStack = data.Inventory[item.itemId] or 0
	local maxStack = item.maxStack or 999
	if currentStack + qty &gt; maxStack then
		return false, "MAX_STACK_EXCEEDED"
	end

	data.Currencies[item.currency] = currentBal - totalCost
	data.Inventory[item.itemId] = currentStack + qty
	return true, "PURCHASE_SUCCESS"
end

function EconomyInventoryQuestService.AdvanceQuest(
	data: PlayerEconomyData,
	questId: string,
	delta: number,
	rewardCurrency: string?,
	rewardAmount: number?
): (boolean, string)
	local q = data.Quests[questId]
	if not q then
		return false, "QUEST_NOT_FOUND"
	end
	if q.claimed then
		return false, "ALREADY_CLAIMED"
	end
	q.progress = math.min(q.target, q.progress + math.max(0, math.floor(delta)))
	if q.progress &gt;= q.target then
		q.claimed = true
		local cur = rewardCurrency or "Coins"
		local amt = rewardAmount or 150
		EconomyInventoryQuestService.AddCurrency(data, cur, amt)
		return true, "QUEST_COMPLETED_AND_REWARDED"
	end
	return true, "QUEST_PROGRESS_UPDATED"
end

function EconomyInventoryQuestService.RedeemPromoCode(
	data: PlayerEconomyData,
	code: string,
	codeCatalog: { [string]: { currency: string, amount: number } }
): (boolean, string)
	local normalized = string.upper(string.gsub(code, "%s+", ""))
	if data.RedeemedCodes[normalized] then
		return false, "CODE_ALREADY_REDEEMED"
	end
	local reward = codeCatalog[normalized]
	if not reward then
		return false, "INVALID_CODE"
	end
	data.RedeemedCodes[normalized] = true
	EconomyInventoryQuestService.AddCurrency(data, reward.currency, reward.amount)
	return true, "CODE_REDEEMED"
end

function EconomyInventoryQuestService.RollWeightedLoot(
	data: PlayerEconomyData,
	lootTable: { LootDropSpec },
	pityThreshold: number?,
	rng: Random?
): LootDropSpec
	assert(#lootTable &gt; 0, "Loot table must contain at least 1 entry.")
	local pityLimit = pityThreshold or 20
	data.LootPityCounter += 1

	if data.LootPityCounter &gt;= pityLimit then
		for _, entry in ipairs(lootTable) do
			if entry.rarity == "Legendary" then
				data.LootPityCounter = 0
				data.Inventory[entry.itemId] = (data.Inventory[entry.itemId] or 0) + 1
				return entry
			end
		end
	end

	local totalWeight = 0
	for _, entry in ipairs(lootTable) do
		totalWeight += math.max(1, entry.weight)
	end

	local randomGen = rng or Random.new()
	local roll = randomGen:NextInteger(1, totalWeight)
	local cursor = 0
	local chosen = lootTable[1]
	for _, entry in ipairs(lootTable) do
		cursor += math.max(1, entry.weight)
		if roll &lt;= cursor then
			chosen = entry
			break
		end
	end

	if chosen.rarity == "Legendary" then
		data.LootPityCounter = 0
	end
	data.Inventory[chosen.itemId] = (data.Inventory[chosen.itemId] or 0) + 1
	return chosen
end

function EconomyInventoryQuestService.SyncLeaderstats(player: Instance, data: PlayerEconomyData): Folder
	local existing = player:FindFirstChild("leaderstats")
	local folder: Folder
	if existing and existing:IsA("Folder") then
		folder = existing
	else
		if existing then
			existing:Destroy()
		end
		folder = Instance.new("Folder")
		folder.Name = "leaderstats"
		folder.Parent = player
	end

	local function setIntStat(statName: string, val: number)
		local iv = folder:FindFirstChild(statName)
		if not iv or not iv:IsA("IntValue") then
			if iv then
				iv:Destroy()
			end
			iv = Instance.new("IntValue")
			iv.Name = statName
			iv.Parent = folder
		end
		(iv :: IntValue).Value = math.floor(val)
	end

	setIntStat("Level", data.Level)
	setIntStat("Coins", data.Currencies.Coins or 0)
	setIntStat("Gems", data.Currencies.Gems or 0)
	return folder
end

return EconomyInventoryQuestService
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_23">
      <Properties>
        <string name="Name">MonetizationReceiptHandler</string>
        <ProtectedString name="Source">--!strict
--[[
	MonetizationReceiptHandler
	Idempotent MarketplaceService.ProcessReceipt processor complying with
	`rbx-process-receipt-misuse`:
	1. Deduplicates PurchaseId before granting rewards.
	2. Atomically persists the profile + PurchaseId to DataStore BEFORE returning
	   Enum.ProductPurchaseDecision.PurchaseGranted.
	3. Returns NotProcessedYet if profile is missing or DataStore save fails.
]]

export type ReceiptInfo = {
	PurchaseId: string,
	PlayerId: number,
	ProductId: number,
	CurrencySpent: number?,
}

export type ProductGrantFn&lt;T&gt; = (data: T, receipt: ReceiptInfo) -&gt; boolean

local MonetizationReceiptHandler = {}

function MonetizationReceiptHandler.CreateProcessor&lt;T&gt;(
	profileManager: {
		GetActiveProfile: (userId: number) -&gt; any,
		SaveProfile: (userId: number, releaseSessionLock: boolean?) -&gt; (boolean, string),
	},
	productHandlers: { [number]: ProductGrantFn&lt;T&gt; }
)
	local processor = {}

	function processor.ProcessReceipt(receiptInfo: ReceiptInfo): (Enum.ProductPurchaseDecision, string)
		local profile = profileManager.GetActiveProfile(receiptInfo.PlayerId)
		if not profile then
			return Enum.ProductPurchaseDecision.NotProcessedYet, "PROFILE_NOT_LOADED"
		end

		-- 1. Idempotency check: was this PurchaseId already fulfilled and saved?
		for _, seenId in ipairs(profile.processedReceipts) do
			if seenId == receiptInfo.PurchaseId then
				return Enum.ProductPurchaseDecision.PurchaseGranted, "ALREADY_PROCESSED_IDEMPOTENT"
			end
		end

		local handler = productHandlers[receiptInfo.ProductId]
		if not handler then
			return Enum.ProductPurchaseDecision.NotProcessedYet, "UNKNOWN_PRODUCT_ID"
		end

		-- 2. Execute grant handler inside pcall
		local okGrant, grantedOrErr = pcall(handler, profile.data, receiptInfo)
		if not okGrant or not grantedOrErr then
			return Enum.ProductPurchaseDecision.NotProcessedYet, "GRANT_HANDLER_FAILED"
		end

		-- 3. Record PurchaseId and immediately flush to DataStore BEFORE returning PurchaseGranted
		table.insert(profile.processedReceipts, receiptInfo.PurchaseId)
		local okSave, saveStatus = profileManager.SaveProfile(receiptInfo.PlayerId, false)
		if not okSave then
			-- Roll back PurchaseId marker in memory so next retry can re-attempt cleanly
			if profile.processedReceipts[#profile.processedReceipts] == receiptInfo.PurchaseId then
				table.remove(profile.processedReceipts)
			end
			return Enum.ProductPurchaseDecision.NotProcessedYet, "SAVE_FAILED_" .. tostring(saveStatus)
		end

		return Enum.ProductPurchaseDecision.PurchaseGranted, "GRANTED_AND_PERSISTED"
	end

	return processor
end

return MonetizationReceiptHandler
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_24">
      <Properties>
        <string name="Name">NpcAiDirector</string>
        <ProtectedString name="Source">--!strict
--[[
	NpcAiDirector
	Centralized CollectionService + PathfindingService NPC AI state machine
	(`Idle`, `Patrol`, `Chase`, `Attack`, `LeashReturn`, `Dead`) with:
	- Server network ownership lock (`SetNetworkOwner(nil)`)
	- Recompute throttling (`&gt;= 0.45s`) &amp; blocked-waypoint invalidation
	- Leash radius enforcement
]]

local CollectionService = game:GetService("CollectionService")
local PathfindingService = game:GetService("PathfindingService")
local Workspace = game:GetService("Workspace")

export type NpcState = "Idle" | "Patrol" | "Chase" | "Attack" | "LeashReturn" | "Dead"

export type NpcConfig = {
	npcId: string,
	displayName: string?,
	maxHealth: number?,
	moveSpeed: number?,
	aggroRangeStuds: number?,
	attackRangeStuds: number?,
	maxLeashDistStuds: number?,
	attackCooldownSec: number?,
	attackDamage: number?,
	patrolPoints: { Vector3 }?,
	agentRadius: number?,
	agentHeight: number?,
	tag: string?,
}

export type NpcAgent = {
	model: Model,
	rootPart: BasePart,
	humanoid: Humanoid,
	config: NpcConfig,
	state: NpcState,
	spawnOrigin: Vector3,
	patrolIndex: number,
	lastPathComputeClock: number,
	lastAttackClock: number,
	waypoints: { PathWaypoint },
	currentWaypointIdx: number,
	targetPosition: Vector3?,
}

local DEFAULT_TAG = "SharpNpcAgentManaged"

local NpcAiDirector = {}

function NpcAiDirector.SpawnNpcRig(position: Vector3, config: NpcConfig, parent: Instance?): NpcAgent
	local managedTag = config.tag or DEFAULT_TAG
	local model = Instance.new("Model")
	model.Name = config.npcId
	model:SetAttribute("NpcId", config.npcId)
	model:SetAttribute("DisplayName", config.displayName or config.npcId)
	model:SetAttribute("IsDamageableTarget", true)
	model:SetAttribute("AIState", "Idle")
	CollectionService:AddTag(model, managedTag)

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.CFrame = CFrame.new(position)
	root.Anchored = false
	root.CanCollide = true
	root.Color = Color3.fromRGB(165, 75, 75)
	root.Parent = model

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1.2, 1.2, 1.2)
	head.CFrame = root.CFrame * CFrame.new(0, 1.6, 0)
	head.CanCollide = false
	head.Massless = true
	head.Parent = model

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = head
	weld.Parent = root

	local hum = Instance.new("Humanoid")
	hum.MaxHealth = config.maxHealth or 100
	hum.Health = hum.MaxHealth
	hum.WalkSpeed = config.moveSpeed or 14
	hum.Parent = model

	model.PrimaryPart = root
	model.Parent = parent or Workspace

	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	return {
		model = model,
		rootPart = root,
		humanoid = hum,
		config = config,
		state = "Idle",
		spawnOrigin = position,
		patrolIndex = 1,
		lastPathComputeClock = 0,
		lastAttackClock = 0,
		waypoints = {},
		currentWaypointIdx = 1,
		targetPosition = nil,
	}
end

function NpcAiDirector.ComputePathWaypoints(agent: NpcAgent, destination: Vector3): (boolean, { PathWaypoint })
	local path = PathfindingService:CreatePath({
		AgentRadius = agent.config.agentRadius or 2.0,
		AgentHeight = agent.config.agentHeight or 5.0,
		AgentCanJump = true,
		AgentCanClimb = true,
		WaypointSpacing = 4.0,
		Costs = {
			Water = 15.0,
			DangerZone = math.huge,
		},
	})

	local okComp, _ = pcall(function()
		path:ComputeAsync(agent.rootPart.Position, destination)
	end)

	if okComp and path.Status == Enum.PathStatus.Success then
		local wps = path:GetWaypoints()
		agent.waypoints = wps
		agent.currentWaypointIdx = math.min(2, #wps)
		return true, wps
	end

	-- Direct fallback waypoint when navmesh is unbaked in empty test region
	local directWp = {
		PathWaypoint.new(agent.rootPart.Position, Enum.PathWaypointAction.Walk),
		PathWaypoint.new(destination, Enum.PathWaypointAction.Walk),
	}
	agent.waypoints = directWp
	agent.currentWaypointIdx = 2
	return false, directWp
end

function NpcAiDirector.EvaluateTick(
	agent: NpcAgent,
	candidateTargets: { Vector3 },
	nowClock: number?
): (NpcState, string)
	local now = nowClock or os.clock()
	if agent.humanoid.Health &lt;= 0 then
		agent.state = "Dead"
		agent.model:SetAttribute("AIState", "Dead")
		return "Dead", "HUMANOID_DEAD"
	end

	local pos = agent.rootPart.Position
	local distFromSpawn = (pos - agent.spawnOrigin).Magnitude
	local maxLeash = agent.config.maxLeashDistStuds or 85.0
	local aggroRange = agent.config.aggroRangeStuds or 36.0
	local attackRange = agent.config.attackRangeStuds or 6.0

	-- 1. Leash check
	if distFromSpawn &gt; maxLeash and agent.state ~= "LeashReturn" then
		agent.state = "LeashReturn"
		agent.targetPosition = agent.spawnOrigin
		agent.humanoid.Health = agent.humanoid.MaxHealth
		agent.model:SetAttribute("AIState", "LeashReturn")
		return "LeashReturn", "EXCEEDED_LEASH_RADIUS"
	end

	if agent.state == "LeashReturn" then
		if distFromSpawn &lt;= 5.0 then
			agent.state = "Idle"
			agent.model:SetAttribute("AIState", "Idle")
			return "Idle", "RETURNED_TO_SPAWN"
		end
		agent.humanoid:MoveTo(agent.spawnOrigin)
		return "LeashReturn", "MOVING_TO_SPAWN"
	end

	-- 2. Find nearest target within aggroRange &amp; within leash
	local nearestTarget: Vector3? = nil
	local nearestDist = aggroRange
	for _, tPos in ipairs(candidateTargets) do
		local d = (tPos - pos).Magnitude
		local dSpawn = (tPos - agent.spawnOrigin).Magnitude
		if d &lt;= nearestDist and dSpawn &lt;= maxLeash then
			nearestDist = d
			nearestTarget = tPos
		end
	end

	if nearestTarget then
		agent.targetPosition = nearestTarget
		if nearestDist &lt;= attackRange then
			agent.state = "Attack"
			agent.model:SetAttribute("AIState", "Attack")
			local cd = agent.config.attackCooldownSec or 1.0
			if (now - agent.lastAttackClock) &gt;= cd then
				agent.lastAttackClock = now
				return "Attack", "PERFORMED_ATTACK"
			end
			return "Attack", "ATTACK_COOLDOWN"
		else
			agent.state = "Chase"
			agent.model:SetAttribute("AIState", "Chase")
			if (now - agent.lastPathComputeClock) &gt;= 0.45 then
				agent.lastPathComputeClock = now
				NpcAiDirector.ComputePathWaypoints(agent, nearestTarget)
			end
			agent.humanoid:MoveTo(nearestTarget)
			return "Chase", "CHASING_TARGET"
		end
	end

	-- 3. Patrol or Idle
	local pts = agent.config.patrolPoints
	if pts and #pts &gt; 0 then
		agent.state = "Patrol"
		agent.model:SetAttribute("AIState", "Patrol")
		local wp = pts[agent.patrolIndex]
		if (wp - pos).Magnitude &lt;= 4.0 then
			agent.patrolIndex = (agent.patrolIndex % #pts) + 1
			wp = pts[agent.patrolIndex]
		end
		agent.humanoid:MoveTo(wp)
		return "Patrol", "PATROLLING_WAYPOINT_" .. tostring(agent.patrolIndex)
	end

	agent.state = "Idle"
	agent.model:SetAttribute("AIState", "Idle")
	return "Idle", "HOLDING_POSITION"
end

function NpcAiDirector.Cleanup(tag: string?): number
	local targetTag = tag or DEFAULT_TAG
	local removed = 0
	for _, inst in ipairs(CollectionService:GetTagged(targetTag)) do
		if inst.Parent then
			inst:Destroy()
			removed += 1
		end
	end
	return removed
end

return NpcAiDirector
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_25">
      <Properties>
        <string name="Name">DialogueAndInteraction</string>
        <ProtectedString name="Source">--!strict
--[[
	DialogueAndInteraction
	Configures server-validated ProximityPrompts and branching NPC dialogue
	trees compatible with `NpcDialogGui` (`02_roblox_gui`).
]]

local CollectionService = game:GetService("CollectionService")

export type DialogueChoice = {
	text: string,
	nextNodeId: string?,
	grantQuestId: string?,
	requiredTag: string?,
}

export type DialogueNode = {
	nodeId: string,
	speakerName: string,
	speakerTitle: string?,
	bodyText: string,
	choices: { DialogueChoice },
}

export type DialogueTree = {
	npcId: string,
	rootNodeId: string,
	nodes: { [string]: DialogueNode },
}

local DEFAULT_TAG = "SharpDialoguePromptManaged"

local DialogueAndInteraction = {}

function DialogueAndInteraction.AttachInteractPrompt(
	targetPartOrModel: Instance,
	actionText: string,
	objectText: string,
	maxDistance: number?,
	holdDuration: number?,
	tag: string?
): ProximityPrompt
	local managedTag = tag or DEFAULT_TAG
	local existing = targetPartOrModel:FindFirstChild("SharpInteractPrompt")
	if existing and existing:IsA("ProximityPrompt") then
		existing:Destroy()
	end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "SharpInteractPrompt"
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.MaxActivationDistance = maxDistance or 10.0
	prompt.HoldDuration = holdDuration or 0.0
	prompt.RequiresLineOfSight = true
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	CollectionService:AddTag(prompt, managedTag)
	prompt.Parent = targetPartOrModel
	return prompt
end

function DialogueAndInteraction.ValidateServerPromptTrigger(
	prompt: ProximityPrompt,
	characterRootPosition: Vector3,
	promptWorldPosition: Vector3
): (boolean, string)
	if not prompt.Enabled then
		return false, "PROMPT_DISABLED"
	end
	local dist = (characterRootPosition - promptWorldPosition).Magnitude
	if dist &gt; (prompt.MaxActivationDistance + 6.0) then
		return false, "OUT_OF_ACTIVATION_DISTANCE"
	end
	return true, "VALID_INTERACTION"
end

function DialogueAndInteraction.SelectDialogueChoice(
	tree: DialogueTree,
	currentNodeId: string,
	choiceIndex: number,
	playerTags: { [string]: boolean }?
): (boolean, DialogueNode?, string?, string)
	local node = tree.nodes[currentNodeId]
	if not node then
		return false, nil, nil, "NODE_NOT_FOUND"
	end
	local choice = node.choices[choiceIndex]
	if not choice then
		return false, nil, nil, "INVALID_CHOICE_INDEX"
	end
	if choice.requiredTag and (not playerTags or not playerTags[choice.requiredTag]) then
		return false, node, nil, "MISSING_REQUIRED_TAG_" .. choice.requiredTag
	end
	if not choice.nextNodeId or choice.nextNodeId == "" then
		return true, nil, choice.grantQuestId, "DIALOGUE_COMPLETE"
	end
	local nextNode = tree.nodes[choice.nextNodeId]
	if not nextNode then
		return false, nil, nil, "NEXT_NODE_MISSING"
	end
	return true, nextNode, choice.grantQuestId, "ADVANCED_TO_" .. choice.nextNodeId
end

function DialogueAndInteraction.Cleanup(tag: string?): number
	local targetTag = tag or DEFAULT_TAG
	local removed = 0
	for _, inst in ipairs(CollectionService:GetTagged(targetTag)) do
		if inst.Parent then
			inst:Destroy()
			removed += 1
		end
	end
	return removed
end

return DialogueAndInteraction
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_26">
      <Properties>
        <string name="Name">RoundAndWaveDirector</string>
        <ProtectedString name="Source">--!strict
--[[
	RoundAndWaveDirector
	Server-authoritative game mode loop &amp; wave defense director:
	`Lobby` -&gt; `Intermission` -&gt; `MapVote` -&gt; `ActiveRound` -&gt; `Victory` / `Defeat` -&gt; `Reset`
]]

export type RoundPhase = "Lobby" | "Intermission" | "MapVote" | "ActiveRound" | "Victory" | "Defeat"

export type WaveSpec = {
	waveNumber: number,
	enemyCount: number,
	enemyHealthMultiplier: number,
	rewardCoins: number,
}

export type DirectorState = {
	phase: RoundPhase,
	currentWave: number,
	maxWaves: number,
	enemiesRemaining: number,
	selectedMap: string,
	mapVotes: { [string]: number },
	roundNumber: number,
}

local RoundAndWaveDirector = {}

function RoundAndWaveDirector.CreateDirector(maxWaves: number?, defaultMap: string?): DirectorState
	return {
		phase = "Lobby",
		currentWave = 0,
		maxWaves = maxWaves or 5,
		enemiesRemaining = 0,
		selectedMap = defaultMap or "AlpineCitadel",
		mapVotes = {},
		roundNumber = 0,
	}
end

function RoundAndWaveDirector.CastMapVote(state: DirectorState, mapId: string, weight: number?): number
	local w = math.max(1, math.floor(weight or 1))
	state.mapVotes[mapId] = (state.mapVotes[mapId] or 0) + w
	return state.mapVotes[mapId]
end

function RoundAndWaveDirector.ResolveWinningMap(state: DirectorState, fallbackMap: string?): string
	local bestMap = fallbackMap or state.selectedMap
	local bestScore = -1
	for mapId, votes in pairs(state.mapVotes) do
		if votes &gt; bestScore or (votes == bestScore and mapId &lt; bestMap) then
			bestScore = votes
			bestMap = mapId
		end
	end
	state.selectedMap = bestMap
	return bestMap
end

function RoundAndWaveDirector.ComputeWaveSpec(waveNumber: number): WaveSpec
	local w = math.max(1, math.floor(waveNumber))
	return {
		waveNumber = w,
		enemyCount = 4 + w * 3,
		enemyHealthMultiplier = tonumber(string.format("%.2f", 1.0 + (w - 1) * 0.25)) or 1.0,
		rewardCoins = 50 + w * 35,
	}
end

function RoundAndWaveDirector.StartNextWave(state: DirectorState): (boolean, WaveSpec?, RoundPhase)
	if state.currentWave &gt;= state.maxWaves then
		state.phase = "Victory"
		state.enemiesRemaining = 0
		return false, nil, state.phase
	end
	if state.currentWave == 0 then
		state.roundNumber += 1
	end
	state.currentWave += 1
	state.phase = "ActiveRound"
	local spec = RoundAndWaveDirector.ComputeWaveSpec(state.currentWave)
	state.enemiesRemaining = spec.enemyCount
	return true, spec, state.phase
end

function RoundAndWaveDirector.RecordEnemyDefeated(state: DirectorState, count: number?): (number, boolean, RoundPhase)
	local defeated = math.max(1, math.floor(count or 1))
	state.enemiesRemaining = math.max(0, state.enemiesRemaining - defeated)
	if state.enemiesRemaining == 0 and state.phase == "ActiveRound" then
		if state.currentWave &gt;= state.maxWaves then
			state.phase = "Victory"
		end
		return 0, true, state.phase
	end
	return state.enemiesRemaining, false, state.phase
end

function RoundAndWaveDirector.ResetToLobby(state: DirectorState): RoundPhase
	state.phase = "Lobby"
	state.currentWave = 0
	state.enemiesRemaining = 0
	table.clear(state.mapVotes)
	return state.phase
end

return RoundAndWaveDirector
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_27">
      <Properties>
        <string name="Name">PoissonSurfaceScatter</string>
        <ProtectedString name="Source">--!strict
--[[
	PoissonSurfaceScatter
	Deterministic spatial-hashed Poisson-disc raycast scatter engine for Roblox
	Terrain and world geometry. Filters by altitude, slope angle, and
	Enum.Material, aligns to surface normal, and parents under a managed Folder.
]]

local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

export type ScatterConfig = {
	minXZ: Vector2,
	maxXZ: Vector2,
	rayStartY: number?,
	rayDropDistance: number?,
	minAltitudeY: number?,
	maxAltitudeY: number?,
	maxSlopeDeg: number?,
	minSpacingStuds: number?,
	maxCount: number?,
	candidateAttempts: number?,
	seed: number?,
	normalAlignmentAlpha: number?,
	scaleRange: Vector2?,
	excludedMaterials: { [Enum.Material]: boolean }?,
	folderName: string?,
	tag: string?,
}

export type ScatterPlacement = {
	position: Vector3,
	normal: Vector3,
	cframe: CFrame,
	scale: number,
	material: Enum.Material,
}

export type ScatterReport = {
	placedCount: number,
	rejectedWaterOrMaterial: number,
	rejectedSlope: number,
	rejectedAltitude: number,
	rejectedSpacing: number,
	folderPath: string,
}

local DEFAULT_TAG = "SharpWorldScatterManaged"

local PoissonSurfaceScatter = {}

local function alignToNormal(upVector: Vector3, yawRad: number, normalAlignAlpha: number): CFrame
	local targetUp = Vector3.yAxis:Lerp(upVector, math.clamp(normalAlignAlpha, 0, 1)).Unit
	local refForward = Vector3.new(math.sin(yawRad), 0, math.cos(yawRad))
	local right = refForward:Cross(targetUp)
	if right.Magnitude &lt; 1e-4 then
		right = Vector3.xAxis
	else
		right = right.Unit
	end
	local forward = targetUp:Cross(right).Unit
	return CFrame.fromMatrix(Vector3.zero, right, targetUp, -forward)
end

function PoissonSurfaceScatter.GeneratePlacements(
	config: ScatterConfig,
	excludeInstances: { Instance }?
): ({ ScatterPlacement }, ScatterReport)
	local rng = Random.new(config.seed or 42)
	local minSpacing = math.max(1.0, config.minSpacingStuds or 12.0)
	local minSpacingSq = minSpacing * minSpacing
	local cellSize = minSpacing
	local maxCount = config.maxCount or 60
	local attempts = config.candidateAttempts or (maxCount * 6)
	local rayStartY = config.rayStartY or 260.0
	local rayDrop = config.rayDropDistance or 320.0
	local minAlt = config.minAltitudeY or -500.0
	local maxAlt = config.maxAltitudeY or 500.0
	local maxSlopeDeg = config.maxSlopeDeg or 34.0
	local alignAlpha = config.normalAlignmentAlpha or 0.35
	local scaleRange = config.scaleRange or Vector2.new(0.85, 1.20)

	local excludedMats: { [Enum.Material]: boolean } = config.excludedMaterials or {
		[Enum.Material.Water] = true,
		[Enum.Material.Cobblestone] = true,
		[Enum.Material.Pavement] = true,
		[Enum.Material.CrackedLava] = true,
	}

	local grid: { [string]: { Vector2 } } = {}
	local placements: { ScatterPlacement } = {}
	local rejMat = 0
	local rejSlope = 0
	local rejAlt = 0
	local rejSpace = 0

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = excludeInstances or {}
	rayParams.IgnoreWater = false

	local function isTooClose(pt2D: Vector2): boolean
		local gx = math.floor(pt2D.X / cellSize)
		local gz = math.floor(pt2D.Y / cellSize)
		for dx = -1, 1 do
			for dz = -1, 1 do
				local key = tostring(gx + dx) .. ":" .. tostring(gz + dz)
				local bucket = grid[key]
				if bucket then
					for _, existing in ipairs(bucket) do
						local diff = pt2D - existing
						if diff:Dot(diff) &lt; minSpacingSq then
							return true
						end
					end
				end
			end
		end
		return false
	end

	local function insertGrid(pt2D: Vector2)
		local gx = math.floor(pt2D.X / cellSize)
		local gz = math.floor(pt2D.Y / cellSize)
		local key = tostring(gx) .. ":" .. tostring(gz)
		local bucket = grid[key]
		if not bucket then
			bucket = {}
			grid[key] = bucket
		end
		table.insert(bucket, pt2D)
	end

	for _ = 1, attempts do
		if #placements &gt;= maxCount then
			break
		end
		local wx = rng:NextNumber(config.minXZ.X, config.maxXZ.X)
		local wz = rng:NextNumber(config.minXZ.Y, config.maxXZ.Y)
		local pt2D = Vector2.new(wx, wz)

		if isTooClose(pt2D) then
			rejSpace += 1
			continue
		end

		local hit = Workspace:Raycast(Vector3.new(wx, rayStartY, wz), Vector3.new(0, -rayDrop, 0), rayParams)
		if not hit then
			continue
		end

		if excludedMats[hit.Material] then
			rejMat += 1
			continue
		end

		local y = hit.Position.Y
		if y &lt; minAlt or y &gt; maxAlt then
			rejAlt += 1
			continue
		end

		local slopeDeg = math.deg(math.acos(math.clamp(hit.Normal.Y, -1, 1)))
		if slopeDeg &gt; maxSlopeDeg then
			rejSlope += 1
			continue
		end

		insertGrid(pt2D)
		local yaw = rng:NextNumber(0, math.pi * 2)
		local scale = rng:NextNumber(scaleRange.X, scaleRange.Y)
		local rotCf = alignToNormal(hit.Normal, yaw, alignAlpha)
		table.insert(placements, {
			position = hit.Position,
			normal = hit.Normal,
			cframe = CFrame.new(hit.Position) * rotCf,
			scale = scale,
			material = hit.Material,
		})
	end

	return placements, {
		placedCount = #placements,
		rejectedWaterOrMaterial = rejMat,
		rejectedSlope = rejSlope,
		rejectedAltitude = rejAlt,
		rejectedSpacing = rejSpace,
		folderPath = "Workspace." .. (config.folderName or "SharpScatteredProps"),
	}
end

function PoissonSurfaceScatter.ScatterStylizedTreesAndRocks(config: ScatterConfig): (Folder, ScatterReport)
	local managedTag = config.tag or DEFAULT_TAG
	local folderName = config.folderName or "SharpScatteredProps"
	local existing = Workspace:FindFirstChild(folderName)
	if existing then
		existing:Destroy()
	end

	local folder = Instance.new("Folder")
	folder.Name = folderName
	CollectionService:AddTag(folder, managedTag)
	folder.Parent = Workspace

	local placements, report = PoissonSurfaceScatter.GeneratePlacements(config, { folder })
	for idx, p in ipairs(placements) do
		local isRock = (idx % 4 == 0)
		local model = Instance.new("Model")
		model.Name = if isRock then string.format("Rock_%03d", idx) else string.format("PineTree_%03d", idx)
		pcall(function()
			model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
		end)
		CollectionService:AddTag(model, managedTag)

		if isRock then
			local rock = Instance.new("Part")
			rock.Name = "Boulder"
			rock.Size = Vector3.new(3.6, 2.4, 3.2) * p.scale
			rock.CFrame = p.cframe * CFrame.new(0, rock.Size.Y * 0.35, 0)
			rock.Anchored = true
			rock.Material = Enum.Material.Slate
			rock.Color = Color3.fromRGB(112, 116, 122)
			rock.CanTouch = false
			rock.Parent = model
			model.PrimaryPart = rock
		else
			local trunk = Instance.new("Part")
			trunk.Name = "Trunk"
			trunk.Size = Vector3.new(1.4, 7.0, 1.4) * p.scale
			trunk.CFrame = p.cframe * CFrame.new(0, trunk.Size.Y * 0.5, 0)
			trunk.Anchored = true
			trunk.Material = Enum.Material.Wood
			trunk.Color = Color3.fromRGB(108, 78, 54)
			trunk.CanTouch = false
			trunk.Parent = model

			local canopy = Instance.new("Part")
			canopy.Name = "Canopy"
			canopy.Shape = Enum.PartType.Ball
			canopy.Size = Vector3.new(6.2, 7.4, 6.2) * p.scale
			canopy.CFrame = trunk.CFrame * CFrame.new(0, trunk.Size.Y * 0.55, 0)
			canopy.Anchored = true
			canopy.CanCollide = false
			canopy.CanTouch = false
			canopy.Material = Enum.Material.Grass
			canopy.Color = Color3.fromRGB(58, 118, 68)
			canopy.Parent = model
			model.PrimaryPart = trunk
		end

		model.Parent = folder
	end

	report.folderPath = folder:GetFullName()
	return folder, report
end

function PoissonSurfaceScatter.Cleanup(tag: string?): number
	local targetTag = tag or DEFAULT_TAG
	local removed = 0
	for _, inst in ipairs(CollectionService:GetTagged(targetTag)) do
		if inst.Parent then
			inst:Destroy()
			removed += 1
		end
	end
	return removed
end

return PoissonSurfaceScatter
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_28">
      <Properties>
        <string name="Name">ModularSocketAssembler</string>
        <ProtectedString name="Source">--!strict
--[[
	ModularSocketAssembler
	Snaps modular 3D architecture kits (walls, arches, corridors, floors) together
	using named Attachment sockets (`SnapSocket_North`, `SnapSocket_South`,
	`SnapSocket_East`, `SnapSocket_West`) and PivotTo math.
]]

local CollectionService = game:GetService("CollectionService")

local DEFAULT_TAG = "SharpModularKitManaged"

local ModularSocketAssembler = {}

function ModularSocketAssembler.CreateModularSegment(
	name: string,
	size: Vector3,
	originCFrame: CFrame,
	parent: Instance?,
	tag: string?
): Model
	local managedTag = tag or DEFAULT_TAG
	local model = Instance.new("Model")
	model.Name = name
	CollectionService:AddTag(model, managedTag)

	local part = Instance.new("Part")
	part.Name = "StructureBody"
	part.Size = size
	part.CFrame = originCFrame
	part.Anchored = true
	part.CanTouch = false
	part.Material = Enum.Material.Limestone
	part.Color = Color3.fromRGB(214, 206, 192)
	part.Parent = model

	local halfX = size.X * 0.5
	local halfZ = size.Z * 0.5

	local sockets = {
		{ name = "SnapSocket_North", pos = Vector3.new(0, 0, -halfZ), rot = CFrame.Angles(0, 0, 0) },
		{ name = "SnapSocket_South", pos = Vector3.new(0, 0, halfZ), rot = CFrame.Angles(0, math.pi, 0) },
		{ name = "SnapSocket_East", pos = Vector3.new(halfX, 0, 0), rot = CFrame.Angles(0, -math.pi * 0.5, 0) },
		{ name = "SnapSocket_West", pos = Vector3.new(-halfX, 0, 0), rot = CFrame.Angles(0, math.pi * 0.5, 0) },
	}

	for _, s in ipairs(sockets) do
		local att = Instance.new("Attachment")
		att.Name = s.name
		att.CFrame = CFrame.new(s.pos) * s.rot
		att.Parent = part
	end

	model.PrimaryPart = part
	if parent then
		model.Parent = parent
	end
	return model
end

function ModularSocketAssembler.FindSocket(model: Model, socketName: string): Attachment?
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Attachment") and d.Name == socketName then
			return d
		end
	end
	return nil
end

function ModularSocketAssembler.SnapModelToSocket(
	newModel: Model,
	sourceSocketName: string,
	targetModel: Model,
	targetSocketName: string
): (boolean, CFrame?, string)
	local srcAtt = ModularSocketAssembler.FindSocket(newModel, sourceSocketName)
	if not srcAtt then
		return false, nil, "SOURCE_SOCKET_NOT_FOUND:" .. sourceSocketName
	end
	local tgtAtt = ModularSocketAssembler.FindSocket(targetModel, targetSocketName)
	if not tgtAtt then
		return false, nil, "TARGET_SOCKET_NOT_FOUND:" .. targetSocketName
	end

	-- Sockets point outward; rotate 180 deg around Y so sourceSocket faces targetSocket flush
	local desiredSocketWorldCF = tgtAtt.WorldCFrame * CFrame.Angles(0, math.pi, 0)
	local pivotToSourceOffset = newModel:GetPivot():ToObjectSpace(srcAtt.WorldCFrame)
	local targetPivotCF = desiredSocketWorldCF * pivotToSourceOffset:Inverse()
	newModel:PivotTo(targetPivotCF)

	local snapErrorStuds = (srcAtt.WorldCFrame.Position - tgtAtt.WorldCFrame.Position).Magnitude
	if snapErrorStuds &gt; 1e-2 then
		return false, targetPivotCF, string.format("SNAP_ALIGNMENT_DRIFT:%.4f", snapErrorStuds)
	end
	return true, targetPivotCF, "SNAPPED_FLUSH"
end

function ModularSocketAssembler.Cleanup(tag: string?): number
	local targetTag = tag or DEFAULT_TAG
	local removed = 0
	for _, inst in ipairs(CollectionService:GetTagged(targetTag)) do
		if inst.Parent then
			inst:Destroy()
			removed += 1
		end
	end
	return removed
end

return ModularSocketAssembler
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SHARP_MOD_29">
      <Properties>
        <string name="Name">SceneBudgetOptimizer</string>
        <ProtectedString name="Source">--!strict
--[[
	SceneBudgetOptimizer
	Audits and optimizes Workspace scene geometry for StreamingEnabled and
	frame-time budgets:
	- Disables CastShadow &amp; CanTouch on small decorative parts (&lt; smallPartThresholdStuds)
	- Sets ModelStreamingMode = Atomic on multi-part gameplay/prop Models
	- Reports unanchored parts, total BaseParts, and shadow-casting counts
]]

local Workspace = game:GetService("Workspace")

export type OptimizationConfig = {
	targetRoot: Instance?,
	smallPartDiagonalStuds: number?,
	disableCanTouchOnStaticProps: boolean?,
	enforceAtomicOnMultiPartModels: boolean?,
	dryRun: boolean?,
}

export type OptimizationReport = {
	totalBasePartsScanned: number,
	totalModelsScanned: number,
	shadowsDisabledCount: number,
	canTouchDisabledCount: number,
	atomicModelsConfiguredCount: number,
	unanchoredPartsCount: number,
	streamingEnabled: boolean,
}

local SceneBudgetOptimizer = {}

function SceneBudgetOptimizer.OptimizeScene(config: OptimizationConfig?): OptimizationReport
	local cfg: OptimizationConfig = config or {}
	local root = cfg.targetRoot or Workspace
	local smallThreshold = cfg.smallPartDiagonalStuds or 5.5
	local disableTouch = if cfg.disableCanTouchOnStaticProps == nil then true else cfg.disableCanTouchOnStaticProps
	local enforceAtomic = if cfg.enforceAtomicOnMultiPartModels == nil then true else cfg.enforceAtomicOnMultiPartModels
	local dryRun = if cfg.dryRun == nil then false else cfg.dryRun

	local totalParts = 0
	local totalModels = 0
	local shadowsDisabled = 0
	local touchDisabled = 0
	local atomicConfigured = 0
	local unanchoredCount = 0

	for _, desc in ipairs(root:GetDescendants()) do
		if desc:IsA("BasePart") and not desc:IsA("Terrain") then
			totalParts += 1
			if not desc.Anchored then
				unanchoredCount += 1
			end
			if desc.Size.Magnitude &lt;= smallThreshold and desc.CastShadow then
				shadowsDisabled += 1
				if not dryRun then
					desc.CastShadow = false
				end
			end
			if disableTouch and desc.Anchored and desc.CanTouch then
				touchDisabled += 1
				if not dryRun then
					desc.CanTouch = false
				end
			end
		elseif desc:IsA("Model") then
			totalModels += 1
			if enforceAtomic then
				local okMode, curMode = pcall(function()
					return desc.ModelStreamingMode
				end)
				if okMode and curMode == Enum.ModelStreamingMode.Default then
					atomicConfigured += 1
					if not dryRun then
						pcall(function()
							desc.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
						end)
					end
				end
			end
		end
	end

	return {
		totalBasePartsScanned = totalParts,
		totalModelsScanned = totalModels,
		shadowsDisabledCount = shadowsDisabled,
		canTouchDisabledCount = touchDisabled,
		atomicModelsConfiguredCount = atomicConfigured,
		unanchoredPartsCount = unanchoredCount,
		streamingEnabled = Workspace.StreamingEnabled,
	}
end

return SceneBudgetOptimizer
</ProtectedString>
      </Properties>
    </Item>
  </Item>
</roblox>